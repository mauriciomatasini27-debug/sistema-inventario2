{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=rpdrzvrmuuglfavynyph&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
      "enabled": false
    }
  },
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/deepseek-v4.1-flash-free",
  "instructions": [
    "AGENTS.md",
    ".opencode/pstack-opencode.md",
    ".opencode/pstack-models.md"
  ],
  "agent": {
    "poteto-agent": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash-free",
      "description": "Routing target for /poteto-mode. Reads the poteto-mode SKILL.md in full before work.",
      "prompt": "{file:./.opencode/poteto-agent.prompt.md}"
    },
    "comment-sicko": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash-free",
      "description": "Comment-hater reviewer used by the no-comments skill. Flags comments, never writes application code.",
      "prompt": "{file:./.opencode/comment-sicko.prompt.md}",
      "permission": {
        "edit": "deny"
      }
    },
    "pstack-worker": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash-free",
      "description": "pstack worker role: swarm workers, explorers, investigators, arena/architect runners."
    },
    "pstack-judge": {
      "mode": "subagent",
      "model": "opencode/glm-5.3-flash-free",
      "description": "pstack judgment/prose role: synthesizers, explainers, judges, reviewers."
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "provider": {
    "opencode": {
      "models": {
        "deepseek-v4.1-flash-free": {
          "limit": {
            "context": 250000,
            "output": 32000
          }
        },
        "big-pickle": {
          "limit": {
            "context": 250000,
            "output": 32000
          }
        },
        "longcat-2.5-preview-free": {
          "limit": {
            "context": 250000,
            "output": 32000
          }
        },
        "glm-5.3-flash-free": {
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "mimo-v2.6-flash-free": {
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "beam-free": {
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "minimax-m3.1-flash-free": {
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        }
      }
    }
  }
}
