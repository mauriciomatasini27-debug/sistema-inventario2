{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr create *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr edit *", "effect": "allow" },
    { "action": "shell", "resource": "gh auth status *", "effect": "allow" },
    { "action": "shell", "resource": "git push * main", "effect": "deny" },
    { "action": "shell", "resource": "git push * main *", "effect": "deny" },
    { "action": "shell", "resource": "git push *:main*", "effect": "deny" },
    { "action": "shell", "resource": "git push", "effect": "deny" },
    { "action": "shell", "resource": "git push origin", "effect": "deny" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "deny" }
  ],
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=rpdrzvrmuuglfavynyph&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
      "enabled": true
    }
  },
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/deepseek-v4.1-flash-free",
  "instructions": [
    "AGENTS.md",
    ".opencode/pstack-opencode.md",
    ".opencode/pstack-models.md"
  ],
  "agent": {
    "pstack-worker": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "pstack worker role: swarm workers, explorers, investigators, arena/architect runners."
    },
    "pstack-judge": {
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code",
      "description": "pstack judgment/prose role: synthesizers, explainers, judges, reviewers."
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "provider": {
    "opencode": {
      "models": {
        "deepseek-v4.1-flash-free": {
          "limit": {
            "context": 250000,
            "output": 32000
          }
        },
        "big-pickle": {
          "limit": {
            "context": 250000,
            "output": 32000
          }
        },
        "longcat-2.5-preview-free": {
          "limit": {
            "context": 250000,
            "output": 32000
          }
        },
        "glm-5.3-flash-free": {
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "mimo-v2.6-flash-free": {
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "beam-free": {
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "minimax-m3.1-flash-free": {
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        }
      }
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".astro/**",
      ".vercel/**",
      "test-results/**",
      "playwright-report/**",
      ".pstack-tmp/**",
      "docs/_origen-docx/**",
      "*.log"
    ]
  }
}
