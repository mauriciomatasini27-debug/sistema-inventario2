---
import { moduloIndice } from "../../lib/panel-modulos.js";

const asistente = moduloIndice("asistente");
---
<div class="asistente-trigger" data-modulo-indice={asistente.id}>
  <button type="button" id="asistente-abrir" class="asistente-abrir" hidden>
    Preguntale al negocio
  </button>
  <p class="mini asistente-trigger-estado" id="asistente-trigger-estado" role="status" hidden></p>
</div>

<dialog id="asistente-drawer" class="asistente-drawer" aria-labelledby="asistente-titulo">
  <div class="asistente-drawer-panel">
    <header class="asistente-drawer-head">
      <h2 id="asistente-titulo">Preguntale al negocio</h2>
      <button type="button" id="asistente-cerrar" class="asistente-cerrar">
        Cerrar
      </button>
    </header>
    <div class="asistente-drawer-body">
      <p class="mini">Probá con una de estas preguntas o escribí la tuya.</p>
      <div class="asistente-chips" id="asistente-chips" role="group" aria-label="Preguntas sugeridas" hidden></div>
      <p class="asistente-chips-aviso" id="asistente-chips-aviso" hidden>Probá con una de estas.</p>
      <div class="asistente-medidor" id="asistente-medidor" hidden>
        <p class="asistente-medidor-texto" id="asistente-medidor-texto"></p>
        <div
          class="asistente-medidor-barra"
          id="asistente-medidor-barra"
          role="progressbar"
          aria-label="Consultas del asistente usadas este mes"
          aria-valuemin="0"
          aria-valuemax="0"
          aria-valuenow="0"
        >
          <span class="asistente-medidor-relleno" id="asistente-medidor-relleno"></span>
        </div>
      </div>
      <form id="asistente-form" class="asistente-form">
        <label class="asistente-label" for="asistente-pregunta">Tu pregunta</label>
        <div class="asistente-fila">
          <input
            id="asistente-pregunta"
            name="pregunta"
            type="text"
            maxlength="500"
            required
            autocomplete="off"
            placeholder="¿Cuánto vendí este mes?"
          />
          <button type="submit" id="asistente-enviar">Preguntar</button>
        </div>
      </form>
      <p class="asistente-respuesta" id="asistente-respuesta" aria-live="polite"></p>
      <ul class="asistente-cifras" id="asistente-cifras" hidden></ul>
      <a class="asistente-reporte" id="asistente-reporte" hidden>Ver reporte</a>
      <p class="mini" id="asistente-estado" role="status"></p>
      <button type="button" id="asistente-reintentar" class="asistente-reintentar" hidden>
        Reintentar
      </button>
    </div>
  </div>
</dialog>

<style>
  [hidden] {
    display: none !important;
  }
  .asistente-trigger {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .asistente-abrir {
    min-height: 44px;
    border: 0;
    border-radius: 999px;
    padding: 10px 22px;
    font: inherit;
    font-weight: 700;
    background: var(--llama);
    color: var(--tinta);
    cursor: pointer;
  }
  .asistente-abrir:focus-visible,
  .asistente-cerrar:focus-visible,
  .asistente-fila button:focus-visible,
  .asistente-reintentar:focus-visible,
  .asistente-reporte:focus-visible {
    outline: 2px solid var(--texto);
    outline-offset: 2px;
  }
  :global(.asistente-chip:focus-visible) {
    outline: 2px solid var(--texto);
    outline-offset: 2px;
  }
  .asistente-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(420px, 100vw);
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--card);
    color: var(--texto);
    box-shadow: 0 0 0 1px var(--borde), 0 12px 40px var(--sombra);
  }
  .asistente-drawer::backdrop {
    background: color-mix(in srgb, var(--tinta) 45%, transparent);
  }
  .asistente-drawer-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }
  .asistente-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px;
    border-bottom: 1px solid var(--borde);
  }
  .asistente-drawer-head h2 {
    margin: 0;
    font-size: 20px;
    color: var(--texto);
  }
  .asistente-cerrar {
    min-height: 44px;
    border: 1px solid var(--borde);
    border-radius: 999px;
    padding: 8px 16px;
    background: var(--card);
    color: var(--texto);
    font: inherit;
    cursor: pointer;
  }
  .asistente-drawer-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .asistente-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  :global(.asistente-chip) {
    min-height: 44px;
    border: 1px solid var(--borde);
    border-radius: 999px;
    padding: 8px 14px;
    background: var(--card);
    color: var(--texto);
    font: inherit;
    font-size: 14px;
    text-align: left;
    cursor: pointer;
  }
  :global(.asistente-chip.chip-resaltado) {
    border-color: var(--llama);
    background: color-mix(in srgb, var(--llama) 22%, var(--card));
    font-weight: 700;
  }
  :global(.asistente-chip:disabled) {
    opacity: 0.55;
    cursor: default;
  }
  .asistente-medidor {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .asistente-medidor-texto {
    margin: 0;
    font-size: 14px;
    color: var(--texto);
    font-variant-numeric: tabular-nums;
  }
  .asistente-medidor-barra {
    height: 8px;
    border-radius: 999px;
    background: var(--borde);
    overflow: hidden;
  }
  .asistente-medidor-relleno {
    display: block;
    width: 0;
    height: 100%;
    border-radius: 999px;
    background: var(--llama);
  }
  .asistente-chips-aviso {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--texto);
  }
  .asistente-form {
    margin: 0;
  }
  .asistente-label {
    display: block;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .asistente-fila {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .asistente-fila input {
    flex: 1 1 200px;
    min-height: 44px;
    border: 1px solid var(--borde);
    border-radius: 999px;
    padding: 8px 14px;
    background: var(--card);
    color: var(--texto);
    font: inherit;
    font-size: 16px;
  }
  .asistente-fila input:disabled {
    opacity: 0.6;
  }
  .asistente-fila button,
  .asistente-reintentar {
    min-height: 44px;
    border: 0;
    border-radius: 999px;
    padding: 10px 22px;
    font: inherit;
    font-weight: 700;
    background: var(--llama);
    color: var(--tinta);
    cursor: pointer;
  }
  .asistente-reintentar {
    align-self: flex-start;
  }
  .asistente-fila button:disabled,
  .asistente-reintentar:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .asistente-respuesta {
    font-size: 15px;
    margin: 0;
    white-space: pre-wrap;
  }
  .asistente-respuesta.rechazada {
    color: var(--muted);
  }
  .asistente-cifras {
    list-style: none;
    margin: 0;
    padding: 0;
    font-variant-numeric: tabular-nums;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  :global(.asistente-cifras li) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    font-size: 14px;
  }
  :global(.asistente-cifras li + li) {
    border-top: 1px solid var(--borde);
  }
  :global(.asistente-cifras li b) {
    font-weight: 700;
    text-align: right;
    white-space: nowrap;
  }
  .asistente-reporte {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    align-self: flex-start;
    color: var(--texto);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 480px) {
    .asistente-drawer {
      inset: 0;
      width: 100%;
      height: 100dvh;
    }
  }
</style>

<script>
  import {
    MENSAJE_NO_CONFIGURADO,
    transicion,
    vistaChat,
    type EstadoChat,
    type EventoChat,
    type RespuestaChat,
  } from "../../lib/asistente-chat.js";

  interface Cifra {
    etiqueta: string;
    valor: string;
  }
  interface Reporte {
    href: string;
    etiqueta: string;
  }
  interface Pregunta {
    texto: string;
    herramienta?: string;
  }
  interface CupoAPI {
    usado: number;
    cupo: number;
    restante: number;
    agotado: boolean;
    reinicia_el: string | null;
    explicacion?: string | undefined;
  }
  interface RespuestaAPI {
    incluido?: boolean;
    explicacion?: string;
    preguntas?: Pregunta[];
    cupo?: unknown;
    codigo?: string;
    error?: string;
    texto?: string;
    reinicia_el?: unknown;
    rechazada?: boolean;
    fueraDeCatalogo?: boolean;
    cifras?: Cifra[];
    reporte?: Reporte;
  }

  const abrir = document.getElementById("asistente-abrir");
  const drawer = document.getElementById("asistente-drawer");
  const cerrar = document.getElementById("asistente-cerrar");
  const triggerEstado = document.getElementById("asistente-trigger-estado");
  const form = document.getElementById("asistente-form");
  const input = document.getElementById("asistente-pregunta");
  const enviar = document.getElementById("asistente-enviar");
  const chips = document.getElementById("asistente-chips");
  const avisoChips = document.getElementById("asistente-chips-aviso");
  const respuesta = document.getElementById("asistente-respuesta");
  const cifras = document.getElementById("asistente-cifras");
  const reporte = document.getElementById("asistente-reporte");
  const estado = document.getElementById("asistente-estado");
  const medidor = document.getElementById("asistente-medidor");
  const medidorTexto = document.getElementById("asistente-medidor-texto");
  const medidorBarra = document.getElementById("asistente-medidor-barra");
  const medidorRelleno = document.getElementById("asistente-medidor-relleno");
  const reintentar = document.getElementById("asistente-reintentar");

  if (
    !(abrir instanceof HTMLButtonElement) ||
    !(drawer instanceof HTMLDialogElement) ||
    !(cerrar instanceof HTMLButtonElement) ||
    !(triggerEstado instanceof HTMLElement) ||
    !(form instanceof HTMLFormElement) ||
    !(input instanceof HTMLInputElement) ||
    !(enviar instanceof HTMLButtonElement) ||
    !(chips instanceof HTMLElement) ||
    !(avisoChips instanceof HTMLElement) ||
    !(respuesta instanceof HTMLElement) ||
    !(cifras instanceof HTMLUListElement) ||
    !(reporte instanceof HTMLAnchorElement) ||
    !(estado instanceof HTMLElement) ||
    !(medidor instanceof HTMLElement) ||
    !(medidorTexto instanceof HTMLElement) ||
    !(medidorBarra instanceof HTMLElement) ||
    !(medidorRelleno instanceof HTMLElement) ||
    !(reintentar instanceof HTMLButtonElement)
  ) {
    throw new Error("asistente: faltan elementos del drawer");
  }

  let disparador: HTMLElement = abrir;
  let chat: EstadoChat = { tipo: "inactivo" };
  let cupoActual: CupoAPI | null = null;
  const TIMEOUT_MS = 20_000;

  async function leerJson(r: Response): Promise<RespuestaAPI> {
    const crudo = await r.text();
    if (crudo === "") return {};
    try {
      const valor: unknown = JSON.parse(crudo);
      return typeof valor === "object" && valor !== null ? (valor as RespuestaAPI) : {};
    } catch (error) {
      console.warn("[asistente] respuesta no JSON", error);
      return {};
    }
  }

  function ocultarBoton(explicacion: string): void {
    abrir.hidden = true;
    triggerEstado.textContent = explicacion;
    triggerEstado.hidden = explicacion === "";
  }

  function mostrarBoton(): void {
    abrir.hidden = false;
    triggerEstado.textContent = "";
    triggerEstado.hidden = true;
  }

  function fechaReinicioTexto(reinicia_el: string | null | undefined): string {
    if (typeof reinicia_el !== "string") return "";
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(reinicia_el);
    if (!m) return "";
    return `${Number(m[3])}/${Number(m[2])}`;
  }

  function mensajeSinCupo(explicacion: string | undefined, reinicia_el: string | null | undefined): string {
    if (typeof explicacion === "string" && explicacion.trim() !== "") return explicacion;
    const fecha = fechaReinicioTexto(reinicia_el);
    return fecha
      ? `Llegaste al cupo del mes. Se reinicia el ${fecha}.`
      : "Llegaste al cupo mensual del asistente.";
  }

  function leerCupo(valor: unknown): CupoAPI | null {
    if (typeof valor !== "object" || valor === null) return null;
    const fila = valor as Record<string, unknown>;
    if (
      typeof fila["usado"] !== "number" ||
      typeof fila["cupo"] !== "number" ||
      typeof fila["restante"] !== "number"
    ) {
      return null;
    }
    return {
      usado: fila["usado"],
      cupo: fila["cupo"],
      restante: fila["restante"],
      agotado: fila["agotado"] === true,
      reinicia_el: typeof fila["reinicia_el"] === "string" ? fila["reinicia_el"] : null,
      explicacion: typeof fila["explicacion"] === "string" ? fila["explicacion"] : undefined,
    };
  }

  function pintarMedidor(cupo: CupoAPI | null): void {
    cupoActual = cupo;
    if (cupo === null || !Number.isFinite(cupo.cupo) || cupo.cupo <= 0) {
      medidor.hidden = true;
      return;
    }
    const usado = Math.max(0, cupo.usado);
    const restante = Math.max(0, cupo.restante);
    medidorTexto.textContent = `Te quedan ${restante} de ${cupo.cupo} consultas este mes`;
    medidorBarra.setAttribute("aria-valuemax", String(cupo.cupo));
    medidorBarra.setAttribute("aria-valuenow", String(Math.min(usado, cupo.cupo)));
    medidorRelleno.style.width = `${Math.min(100, Math.round((usado / cupo.cupo) * 100))}%`;
    medidor.hidden = false;
  }

  function bajarMedidor(): void {
    if (cupoActual === null) return;
    const usado = cupoActual.usado + 1;
    pintarMedidor({
      ...cupoActual,
      usado,
      restante: Math.max(0, cupoActual.cupo - usado),
      agotado: usado >= cupoActual.cupo,
    });
  }

  function marcarMedidorAgotado(): void {
    if (cupoActual === null) return;
    pintarMedidor({ ...cupoActual, usado: cupoActual.cupo, restante: 0, agotado: true });
  }

  function limpiarResultado(): void {
    respuesta.textContent = "";
    respuesta.classList.remove("rechazada");
    cifras.textContent = "";
    cifras.hidden = true;
    reporte.hidden = true;
    reporte.removeAttribute("href");
    reporte.textContent = "Ver reporte";
    avisoChips.hidden = true;
    for (const chip of chips.querySelectorAll<HTMLButtonElement>("[data-asistente-chip]")) {
      chip.classList.remove("chip-resaltado");
    }
  }

  function pintarChips(preguntas: Pregunta[]): void {
    chips.textContent = "";
    for (const pregunta of preguntas) {
      if (typeof pregunta.texto !== "string" || pregunta.texto.trim() === "") continue;
      const boton = document.createElement("button");
      boton.type = "button";
      boton.className = "asistente-chip";
      boton.dataset.asistenteChip = "";
      boton.textContent = pregunta.texto;
      boton.disabled = !vistaChat(chat).puedeEnviar;
      boton.addEventListener("click", () => {
        input.value = pregunta.texto;
        void enviarPregunta(pregunta.texto);
      });
      chips.appendChild(boton);
    }
    chips.hidden = chips.children.length === 0;
  }

  function pintarCifras(lista: ReadonlyArray<Cifra> | undefined): void {
    cifras.textContent = "";
    if (!Array.isArray(lista)) {
      cifras.hidden = true;
      return;
    }
    for (const cifra of lista) {
      if (typeof cifra.etiqueta !== "string" || typeof cifra.valor !== "string") continue;
      const item = document.createElement("li");
      const etiqueta = document.createElement("span");
      etiqueta.textContent = cifra.etiqueta;
      const valor = document.createElement("b");
      valor.textContent = cifra.valor;
      item.append(etiqueta, valor);
      cifras.appendChild(item);
    }
    cifras.hidden = cifras.children.length === 0;
  }

  function pintarReporte(destino: Reporte | undefined): void {
    if (!destino || typeof destino.href !== "string" || typeof destino.etiqueta !== "string") {
      reporte.hidden = true;
      reporte.removeAttribute("href");
      return;
    }
    reporte.href = destino.href;
    reporte.textContent = `Ver ${destino.etiqueta}`;
    reporte.hidden = false;
  }

  function pintarRespuesta(respuestaChat: RespuestaChat): void {
    respuesta.textContent = respuestaChat.texto;
    respuesta.classList.toggle("rechazada", respuestaChat.rechazada);
    if (respuestaChat.fueraDeCatalogo === true) {
      avisoChips.hidden = false;
      for (const chip of chips.querySelectorAll<HTMLButtonElement>("[data-asistente-chip]")) {
        chip.classList.add("chip-resaltado");
      }
    }
    pintarCifras(respuestaChat.cifras);
    pintarReporte(respuestaChat.reporte);
    input.value = "";
    respuesta.scrollIntoView({ block: "nearest" });
  }

  function render(): void {
    const vista = vistaChat(chat);
    input.disabled = !vista.puedeEnviar;
    enviar.disabled = !vista.puedeEnviar;
    for (const chip of chips.querySelectorAll<HTMLButtonElement>("[data-asistente-chip]")) {
      chip.disabled = !vista.puedeEnviar;
    }
    respuesta.setAttribute("aria-busy", vista.ocupado ? "true" : "false");
    estado.setAttribute("role", chat.tipo === "error" ? "alert" : "status");
    estado.textContent = chat.tipo === "enviando" ? "Consultando…" : vista.mensaje;
    reintentar.hidden = !vista.mostrarReintentar;
    if (chat.tipo === "respondiendo") pintarRespuesta(chat.respuesta);
  }

  function aplicar(evento: EventoChat): void {
    chat = transicion(chat, evento);
    render();
  }

  async function cargarPreguntas(): Promise<void> {
    try {
      const r = await fetch("/api/asistente");
      if (!r.ok) throw new Error("http " + r.status);
      const j = await leerJson(r);
      if (!j.incluido) {
        ocultarBoton(j.explicacion || "Tu plan no incluye el asistente IA.");
        return;
      }
      pintarChips(Array.isArray(j.preguntas) ? j.preguntas : []);
      mostrarBoton();
      const cupo = leerCupo(j.cupo);
      pintarMedidor(cupo);
      if (cupo?.agotado === true) {
        aplicar({
          tipo: "cupo_agotado",
          mensaje: mensajeSinCupo(cupo.explicacion, cupo.reinicia_el),
          reinicia_el: cupo.reinicia_el,
        });
      }
    } catch (error) {
      console.warn("[asistente] no pudimos verificar el plan", error);
      mostrarBoton();
    }
  }

  async function lanzarConsulta(pregunta: string): Promise<void> {
    if (navigator.onLine === false) {
      aplicar({ tipo: "error_red" });
      return;
    }
    const controlador = new AbortController();
    const timer = setTimeout(() => controlador.abort(), TIMEOUT_MS);
    try {
      const r = await fetch("/api/asistente", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ pregunta }),
        signal: controlador.signal,
      });
      const j = await leerJson(r);
      if (r.status === 429 && j.codigo === "sin_cupo") {
        marcarMedidorAgotado();
        const reinicia = typeof j.reinicia_el === "string" ? j.reinicia_el : null;
        aplicar({
          tipo: "respuesta_sin_cupo",
          mensaje: mensajeSinCupo(j.error || j.texto, reinicia),
          reinicia_el: reinicia,
        });
        return;
      }
      if (r.status === 403 && j.codigo === "fuera_de_plan") {
        const explicacion = j.error || "Tu plan no incluye el asistente IA.";
        aplicar({ tipo: "fuera_de_plan", mensaje: explicacion });
        ocultarBoton(explicacion);
        drawer.close();
        return;
      }
      if (r.status === 503 && j.codigo === "asistente_no_configurado") {
        aplicar({ tipo: "no_configurado", mensaje: j.error || MENSAJE_NO_CONFIGURADO });
        return;
      }
      if (!r.ok) {
        aplicar({ tipo: "error_servidor" });
        return;
      }
      const respuestaChat: RespuestaChat = {
        texto: typeof j.texto === "string" ? j.texto : "",
        rechazada: j.rechazada === true,
        fueraDeCatalogo: j.fueraDeCatalogo === true,
        cifras: Array.isArray(j.cifras) ? j.cifras : undefined,
        reporte: j.reporte,
      };
      if (!respuestaChat.rechazada) bajarMedidor();
      aplicar({ tipo: "respuesta_ok", respuesta: respuestaChat });
      // La consulta que gastó la última del mes deja el chat sin cupo sin
      // esperar al 429 de la próxima: la respuesta queda a la vista.
      if (cupoActual?.agotado === true) {
        aplicar({
          tipo: "cupo_agotado",
          mensaje: mensajeSinCupo(undefined, cupoActual.reinicia_el),
          reinicia_el: cupoActual.reinicia_el,
        });
      }
    } catch (error) {
      if (controlador.signal.aborted) {
        aplicar({ tipo: "timeout" });
      } else if (navigator.onLine === false || error instanceof TypeError) {
        aplicar({ tipo: "error_red" });
      } else {
        console.warn("[asistente] no pudimos consultar", error);
        aplicar({ tipo: "error_servidor" });
      }
    } finally {
      clearTimeout(timer);
    }
  }

  async function enviarPregunta(pregunta: string): Promise<void> {
    const siguiente = transicion(chat, { tipo: "enviar", pregunta });
    if (siguiente === chat) return;
    chat = siguiente;
    limpiarResultado();
    render();
    if (chat.tipo === "enviando") await lanzarConsulta(chat.pregunta);
  }

  abrir.addEventListener("click", () => {
    if (drawer.open) return;
    disparador = document.activeElement instanceof HTMLElement ? document.activeElement : abrir;
    drawer.showModal();
    // A 360 px el teclado taparía los chips: el foco queda en el primer control del drawer.
    if (window.matchMedia("(min-width: 481px)").matches) input.focus();
  });

  cerrar.addEventListener("click", () => drawer.close());

  // El reporte de ventas vive en este mismo /panel (#kpi-strip): cerrar el
  // drawer deja ver el destino del link.
  reporte.addEventListener("click", () => drawer.close());

  drawer.addEventListener("close", () => {
    disparador.focus({ preventScroll: true });
  });

  drawer.addEventListener("click", (event) => {
    if (event.target !== drawer) return;
    const caja = drawer.getBoundingClientRect();
    const fuera =
      event.clientX < caja.left ||
      event.clientX > caja.right ||
      event.clientY < caja.top ||
      event.clientY > caja.bottom;
    if (fuera) drawer.close();
  });

  reintentar.addEventListener("click", () => {
    const siguiente = transicion(chat, { tipo: "reintentar" });
    if (siguiente === chat || siguiente.tipo !== "enviando") return;
    chat = siguiente;
    limpiarResultado();
    render();
    void lanzarConsulta(siguiente.pregunta);
  });

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    void enviarPregunta(input.value.trim());
  });

  void cargarPreguntas();
</script>
