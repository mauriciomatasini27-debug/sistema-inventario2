---
import { ANTENA_MODO, CUERPO_MODO } from "../../lib/modo.js";

const vars = [
  `--modo-antena-calmado:${ANTENA_MODO.calmado}`,
  `--modo-antena-pensando:${ANTENA_MODO.pensando}`,
  `--modo-antena-exito:${ANTENA_MODO.exito}`,
  `--modo-antena-alerta:${ANTENA_MODO.alerta}`,
  `--modo-antena-minimizado:${ANTENA_MODO.minimizado}`,
  `--modo-cuerpo-a:${CUERPO_MODO[0]}`,
  `--modo-cuerpo-b:${CUERPO_MODO[1]}`,
  `--modo-cuerpo-c:${CUERPO_MODO[2]}`,
].join(";");
---

<div
  class="modo"
  data-modo
  data-modo-estado="calmado"
  data-modo-gesto="flotar"
  data-modo-confeti="no"
  data-modo-cobrando="no"
  style={vars}
>
  <button
    type="button"
    class="modo-abrir modo-control"
    aria-expanded="false"
    aria-controls="panel-modo"
    aria-label="Modo, calmado"
  >
    <svg class="modo-figura" viewBox="0 0 36 36" width="36" height="36" aria-hidden="true">
      <defs>
        {/* TB-159: el fill de SVG no toma el atajo --gradiente-llama, así que los stops repiten ese degradado. */}
        <linearGradient id="llama-modo" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="var(--modo-cuerpo-a)"></stop>
          <stop offset="45%" stop-color="var(--modo-cuerpo-b)"></stop>
          <stop offset="100%" stop-color="var(--modo-cuerpo-c)"></stop>
        </linearGradient>
      </defs>
      <g class="modo-confeti">
        <rect x="1" y="6" width="2.2" height="2.2" fill="var(--color-llama)"></rect>
        <rect x="32" y="4" width="2.2" height="2.2" fill="var(--color-ok-oscuro)"></rect>
        <rect x="4" y="1" width="2.2" height="2.2" fill="var(--color-pendiente-oscuro)"></rect>
        <rect x="30" y="1" width="2.2" height="2.2" fill="var(--color-star-warm)"></rect>
      </g>
      <line x1="18" y1="8" x2="18" y2="4.2" stroke="var(--color-void)" stroke-width="1.4"></line>
      <circle class="modo-antena" cx="18" cy="3" r="2.1"></circle>
      <rect x="6" y="8" width="24" height="22" rx="8" fill="url(#llama-modo)"></rect>
      <rect class="modo-visor" x="9" y="13" width="18" height="8" rx="3" fill="var(--color-void)"></rect>
      <g class="modo-ojos-abiertos">
        <circle cx="14" cy="17" r="2.15" fill="var(--color-llama)"></circle>
        <circle cx="22" cy="17" r="2.15" fill="var(--color-llama)"></circle>
        <circle cx="14.7" cy="16.3" r="0.65" fill="var(--color-star-white)"></circle>
        <circle cx="22.7" cy="16.3" r="0.65" fill="var(--color-star-white)"></circle>
      </g>
      <g class="modo-ojos-sonrisa">
        <path d="M12 17.6 Q14 15.2 16 17.6" fill="none" stroke="var(--color-llama)" stroke-width="1.6" stroke-linecap="round"></path>
        <path d="M20 17.6 Q22 15.2 24 17.6" fill="none" stroke="var(--color-llama)" stroke-width="1.6" stroke-linecap="round"></path>
      </g>
      <g class="modo-ojos-cerrados">
        <path d="M12 17 H16" stroke="var(--color-llama)" stroke-width="1.4" stroke-linecap="round"></path>
        <path d="M20 17 H24" stroke="var(--color-llama)" stroke-width="1.4" stroke-linecap="round"></path>
      </g>
      <g class="modo-puntos">
        <circle cx="14" cy="26.2" r="1" fill="var(--color-void)"></circle>
        <circle cx="18" cy="26.2" r="1" fill="var(--color-void)"></circle>
        <circle cx="22" cy="26.2" r="1" fill="var(--color-void)"></circle>
      </g>
      <text class="modo-bang" x="26.2" y="12" font-size="8" font-weight="700" fill="var(--color-peligro)">!</text>
    </svg>
  </button>
  <div id="panel-modo" class="modo-panel" role="dialog" aria-labelledby="panel-modo-titulo" hidden>
    <div class="modo-panel-cabeza">
      <h2 id="panel-modo-titulo">Modo</h2>
      <button type="button" class="modo-cerrar modo-control">Cerrar</button>
    </div>
    <p class="modo-vacio">Sin avisos por ahora.</p>
    <ul class="modo-avisos" hidden></ul>
    <button type="button" class="modo-minimizar modo-control">Minimizar</button>
  </div>
</div>

<style is:global>
  .modo { position: relative; flex: 0 0 auto; }
  .modo-control {
    min-width: 44px;
    min-height: 44px;
    box-sizing: border-box;
  }
  .modo-abrir {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .modo-figura {
    width: 36px;
    height: 36px;
    display: block;
    overflow: visible;
  }
  .modo[data-modo-cobrando="si"] {
    margin-inline-start: auto;
  }
  .modo[data-modo-cobrando="si"] .modo-figura {
    width: 28px;
    height: 28px;
  }
  .modo-antena { fill: var(--modo-antena-calmado); }
  .modo[data-modo-estado="calmado"] .modo-antena,
  .modo[data-modo-estado="minimizado"] .modo-antena { fill: var(--modo-antena-calmado); }
  .modo[data-modo-estado="pensando"] .modo-antena { fill: var(--modo-antena-pensando); }
  .modo[data-modo-estado="exito"] .modo-antena { fill: var(--modo-antena-exito); }
  .modo[data-modo-estado="alerta"] .modo-antena { fill: var(--modo-antena-alerta); }
  .modo-ojos-sonrisa,
  .modo-ojos-cerrados,
  .modo-puntos,
  .modo-bang,
  .modo-confeti { display: none; }
  .modo[data-modo-estado="exito"] .modo-ojos-abiertos { display: none; }
  .modo[data-modo-estado="exito"] .modo-ojos-sonrisa { display: block; }
  .modo[data-modo-estado="minimizado"] .modo-ojos-abiertos { display: none; }
  .modo[data-modo-estado="minimizado"] .modo-ojos-cerrados { display: block; }
  .modo[data-modo-estado="pensando"] .modo-puntos { display: block; }
  .modo[data-modo-estado="alerta"] .modo-bang { display: block; }
  .modo-panel {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    z-index: 20;
    width: min(280px, calc(100vw - 32px));
    padding: 12px;
    border: 1px solid var(--color-mid);
    border-radius: 16px;
    background: var(--color-charcoal);
    color: var(--color-star-white);
    box-sizing: border-box;
  }
  .modo-panel[hidden] { display: none !important; }
  .modo-panel-cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .modo-panel h2 { margin: 0; font-size: 16px; }
  .modo-cerrar,
  .modo-minimizar {
    border: 1px solid var(--color-mid);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .modo-minimizar { margin-top: 8px; }
  .modo-vacio { margin: 8px 0 0; font-size: 14px; }
  .modo-avisos { list-style: none; margin: 8px 0 0; padding: 0; }
  .modo-avisos a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-star-white);
  }
  .modo-ojos-abiertos,
  .modo-ojos-sonrisa,
  .modo-ojos-cerrados {
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .modo[data-modo-gesto="flotar"] .modo-figura {
      animation: modo-flotar 2.4s ease-in-out infinite;
    }
    .modo[data-modo-gesto="flotar"] .modo-ojos-abiertos {
      animation: modo-parpadeo 3.2s ease-in-out infinite;
    }
    .modo[data-modo-gesto="mecer"] .modo-figura {
      animation: modo-mecer 1.1s ease-in-out infinite;
    }
    .modo[data-modo-gesto="saltar"] .modo-figura {
      animation: modo-salto 0.6s ease-in-out 1;
    }
    .modo[data-modo-gesto="sacudir"] .modo-figura {
      animation: modo-sacudir 0.45s ease-in-out infinite;
    }
    .modo[data-modo-gesto="flotar-lento"] .modo-figura {
      animation: modo-flotar 6.4s ease-in-out infinite;
    }
    .modo[data-modo-confeti="si"] .modo-confeti {
      display: block;
      animation: modo-confeti 0.7s ease-out 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .modo,
    .modo * {
      animation: none !important;
    }
    .modo-confeti { display: none !important; }
  }
  @keyframes modo-flotar {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2px); }
  }
  @keyframes modo-parpadeo {
    0%, 86%, 100% { transform: scaleY(1); }
    92% { transform: scaleY(0.12); }
  }
  @keyframes modo-mecer {
    0%, 100% { transform: rotate(-6deg); }
    50% { transform: rotate(6deg); }
  }
  @keyframes modo-salto {
    0%, 100% { transform: translateY(0); }
    40% { transform: translateY(-6px); }
  }
  @keyframes modo-sacudir {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-1.5px); }
    75% { transform: translateX(1.5px); }
  }
  @keyframes modo-confeti {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(-8px); }
  }
  @media print {
    .modo { display: none !important; }
  }
</style>

<script>
  import {
    alternarPanel,
    alternarReposo,
    alTecla,
    aplicarEvento,
    avisosModo,
    cerrarPanel,
    conAvisos,
    crearNodoModo,
    esEstadoModo,
    fijarEstado,
    gestoModo,
    leerCuentaOpcional,
    leerStockBajo,
    muestraConfeti,
    type AvisoModo,
    type NodoModo,
  } from "../../lib/modo.js";

  const raiz = document.querySelector<HTMLElement>("[data-modo]");
  const abrir = raiz?.querySelector<HTMLButtonElement>(".modo-abrir");
  const panel = document.getElementById("panel-modo");
  const cerrar = raiz?.querySelector<HTMLButtonElement>(".modo-cerrar");
  const minimizar = raiz?.querySelector<HTMLButtonElement>(".modo-minimizar");
  const lista = raiz?.querySelector<HTMLElement>(".modo-avisos");
  const vacio = raiz?.querySelector<HTMLElement>(".modo-vacio");
  const reducido = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (raiz && abrir && panel && cerrar && minimizar && lista && vacio) {
    let nodo = crearNodoModo();
    const inicial = raiz.dataset.modoEstado ?? "";
    if (esEstadoModo(inicial)) nodo = fijarEstado(nodo, inicial);

    const pintarAvisos = (avisos: readonly AvisoModo[]) => {
      lista.replaceChildren();
      for (const aviso of avisos) {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = aviso.href;
        link.className = "modo-aviso";
        link.textContent = aviso.texto;
        item.append(link);
        lista.append(item);
      }
      const hay = avisos.length > 0;
      lista.hidden = !hay;
      vacio.hidden = hay;
    };

    const pintar = (siguiente: NodoModo) => {
      nodo = siguiente;
      raiz.dataset.modoEstado = nodo.estado;
      raiz.dataset.modoGesto = gestoModo(nodo.estado, reducido.matches);
      raiz.dataset.modoConfeti = muestraConfeti(nodo.estado, reducido.matches) ? "si" : "no";
      abrir.setAttribute("aria-label", nodo.ariaLabel);
      abrir.setAttribute("aria-expanded", nodo.ariaExpanded ? "true" : "false");
      panel.hidden = !nodo.panelAbierto;
      minimizar.textContent = nodo.estado === "minimizado" ? "Mostrar" : "Minimizar";
      pintarAvisos(nodo.avisos);
    };

    const aplicarAvisos = (stockBajo: number | null, fiadoAtrasado: number | null) => {
      pintar(conAvisos(nodo, avisosModo({ stockBajo, fiadoAtrasado })));
    };

    pintar(nodo);

    abrir.addEventListener("click", () => {
      const estaba = nodo.panelAbierto;
      pintar(alternarPanel(nodo));
      if (!estaba) cerrar.focus();
    });
    cerrar.addEventListener("click", () => {
      pintar(cerrarPanel(nodo));
      abrir.focus();
    });
    minimizar.addEventListener("click", () => {
      const reposo = alternarReposo(nodo);
      const cierra = reposo.estado === "minimizado";
      pintar(cierra ? cerrarPanel(reposo) : reposo);
      if (cierra) abrir.focus();
    });
    document.addEventListener("keydown", (event) => {
      const siguiente = alTecla(nodo, event.key);
      if (siguiente === nodo) return;
      pintar(siguiente);
      abrir.focus();
    });
    document.addEventListener("pointerdown", (event) => {
      if (!nodo.panelAbierto) return;
      if (!(event.target instanceof Node) || raiz.contains(event.target)) return;
      pintar(cerrarPanel(nodo));
    });
    reducido.addEventListener("change", () => pintar(nodo));

    // TB-159: el fiado atrasado no tiene un total en la app. Solo se lee si alguien ya lo publicó.
    const fiadoActual = () => leerCuentaOpcional(document.body.dataset.fiadoAtrasado);

    const avisoStock = document.getElementById("aviso-stock");
    if (avisoStock) {
      const leer = () => {
        aplicarAvisos(leerStockBajo(avisoStock.textContent, avisoStock.hidden), fiadoActual());
      };
      leer();
      new MutationObserver(leer).observe(avisoStock, {
        attributes: true,
        childList: true,
        characterData: true,
        subtree: true,
      });
    } else {
      if (nodo.estado !== "minimizado") pintar(aplicarEvento(nodo, "cargar"));
      fetch("/api/sales/resumen")
        .then((r) => (r.ok ? r.json() : null))
        .then((crudo: unknown) => {
          const stock = typeof crudo === "object" && crudo !== null && "stock_bajo" in crudo
            ? Number((crudo as { stock_bajo?: unknown }).stock_bajo ?? 0)
            : 0;
          aplicarAvisos(Number.isFinite(stock) ? stock : 0, fiadoActual());
        })
        .catch((error: unknown) => {
          console.warn("[modo] no pudimos leer el resumen", error);
          aplicarAvisos(0, fiadoActual());
        });
    }
  }
</script>
