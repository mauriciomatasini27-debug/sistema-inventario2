---
import "../../styles/global.css";
import "../../styles/navegacion.css";
import "../../styles/tema.css";
import { Toaster } from "../ui/Toaster";
import ConfirmDialog from "../ui/ConfirmDialog.astro";
import TemaInicial from "../ui/TemaInicial.astro";
import NavTablero from "./NavTablero.astro";
import PanelTopbar from "./PanelTopbar.astro";
import { control } from "../../lib/store.js";
import { membershipActiva, resolverRolEfectivo, resolverSesion } from "../../lib/control.js";
import { tenantDeRequest } from "../../lib/tenant-context.js";
import { datosCuentaBarra } from "../../lib/panel-topbar.js";
import { enmascararEmail } from "../../modules/auth/auditoria.js";
import { rolParaNav } from "../../lib/panel-modulos.js";
import ReportesComercioDialog from "./ReportesComercioDialog.astro";
import type { DestinoPanel } from "../../lib/panel-modulos.js";

interface Props {
  titulo: string;
  subtitulo?: string;
  activo?: DestinoPanel;
  // P1-35: nombre del comercio activo cuando la página lo conoce.
  comercio?: string;
  // TB-158: Inicio arma su propio h1. El resto de las pantallas usa el del shell.
  ocultarTitulo?: boolean;
}
const { titulo, subtitulo = "", activo, comercio = "", ocultarTitulo = false } = Astro.props;

const sesionCtx = resolverSesion(Astro.request);
let nombreCrudo: string | null = null;
let rolMembresia: "dueno" | "empleado" | null = null;
if (sesionCtx) {
  const u = control.users.get(sesionCtx.googleSub);
  nombreCrudo = u?.nombre?.trim() || (u?.email ? enmascararEmail(u.email) : null);
  const tenantRes = tenantDeRequest(Astro.request);
  const tenantId = tenantRes.ok ? tenantRes.tenantId : sesionCtx.tenantId;
  if (tenantId) {
    const m = membershipActiva(tenantId, sesionCtx.googleSub);
    if (m) rolMembresia = m.rol;
  }
} else {
  const nav = rolParaNav(resolverRolEfectivo(Astro.request));
  rolMembresia = nav.rol;
}
const cuentaBarra = datosCuentaBarra(nombreCrudo, rolMembresia);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Panel</title>
    <TemaInicial />
    <style is:global>
      body { margin: 0; background: var(--tema-fondo); color: var(--tema-texto); font-family: var(--font-sans); }
      .panel-shell { max-width: none; margin: 0; padding: 0; }
      /* TB-158: el padding de 16px es más específico que el del nav y tapaba la barra. */
      .panel-shell .tablero-contenido {
        max-width: 1180px;
        margin: 0 auto;
        padding: 16px;
        padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
        box-sizing: border-box;
      }
      @media (min-width: 900px) {
        .panel-shell .tablero-contenido { padding-bottom: 16px; }
      }
      /* TB-BARRA-SUPERIOR: la barra sale del padding de 16px y queda ancho completo. */
      /* P1-46: un display de la nav gana al atributo hidden. Sin esto el módulo fuera de plan sigue en Más. */
      [data-modulo-indice][hidden] { display: none !important; }
      .panel-shell main { padding-bottom: 32px; }
      /* Alias que ya usaban el asistente y el upsell. Apuntan a tokens, sin paleta nueva. */
      .panel-shell {
        --tinta: var(--tema-texto);
        --texto: var(--tema-texto);
        --llama: var(--color-llama);
        --llama-hover: var(--color-llama-hover);
        --muted: var(--tema-texto-suave);
        --card: var(--tema-superficie);
        --borde: var(--tema-linea);
        --linea: var(--tema-linea);
        --texto-suave: var(--tema-texto-suave);
        --blanco: var(--color-star-white);
      }
      .panel-shell h1 { margin: 20px 0 4px; font-size: clamp(24px, 3.4vw, 36px); font-weight: 600; }
      .panel-shell .sub { margin: 0 0 16px; color: var(--tema-texto-suave); font-size: 14px; }
      .panel-shell .grid { display: grid; gap: 16px; grid-template-columns: 1fr; }
      .panel-shell .grid.dos { margin-top: 16px; }
      @media (min-width: 900px) {
        .panel-shell .grid.dos { grid-template-columns: 1fr 1fr; }
      }
      .panel-shell .card { min-width: 0; padding: 16px; border: 1px solid var(--tema-linea); border-radius: 16px; background: var(--tema-superficie); }
      @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .panel-shell .card { background: var(--tema-vidrio); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
      }
      @media (prefers-reduced-transparency: reduce) {
        .panel-shell .card { background: var(--tema-superficie); -webkit-backdrop-filter: none; backdrop-filter: none; }
      }
      .panel-shell .card h2 { margin: 0 0 8px; font-size: 18px; }
      .panel-shell .estado { margin-top: 8px; color: var(--tema-texto-suave); font-size: 12px; }
      .panel-shell .kpi { display: flex; flex-wrap: wrap; gap: 24px; }
      .panel-shell .kpi b { display: block; font-size: clamp(26px, 4vw, 40px); font-weight: 600; }
      .panel-shell .kpi small { color: var(--tema-texto-suave); font-size: 12px; }
      .panel-shell table { width: 100%; border-collapse: collapse; font-size: 13px; }
      .panel-shell th { text-align: left; color: var(--tema-texto-suave); font-weight: 500; padding: 6px; border-bottom: 1px solid var(--tema-linea); }
      .panel-shell td { padding: 8px 6px; border-bottom: 1px solid var(--tema-linea); }
      .panel-shell ul.lista { list-style: none; margin: 0; padding: 0; font-size: 13px; }
      .panel-shell ul.lista li { padding: 8px 0; border-bottom: 1px solid var(--tema-linea); }
      .panel-shell form { display: grid; gap: 8px; }
      .panel-shell label { display: grid; gap: 4px; min-width: 0; font-size: 13px; color: var(--tema-texto-suave); }
      .panel-shell input, .panel-shell select, .panel-shell button:not(.tema-toggle):not([data-nav-mas]):not(.upsell-ahora):not(.asistente-abrir):not(.asistente-cerrar):not(.asistente-reintentar):not(#asistente-enviar):not(.modo-control):not(.fiado-fila):not(.panel-cuenta-switch):not(.topbar-panel-avatar):not(.panel-buscar-inline):not(.panel-buscar-abrir) { min-height: 44px; font-size: 16px; border-radius: 8px; padding: 8px 10px; font-family: inherit; }
      .panel-shell .opciones button { min-height: 44px; font-size: 16px; padding: 8px 12px; font-family: inherit; }
      .panel-shell input, .panel-shell select { border: 1px solid var(--tema-linea); background: var(--tema-superficie); color: var(--tema-texto); }
      .panel-shell label > input, .panel-shell label > select { box-sizing: border-box; width: 100%; min-width: 0; }
      .panel-shell select { text-overflow: ellipsis; }
      .panel-shell button:not(.tema-toggle):not([data-nav-mas]):not(.upsell-ahora):not(.asistente-abrir):not(.asistente-cerrar):not(.asistente-reintentar):not(#asistente-enviar):not(.modo-control):not(.fiado-fila):not(.panel-cuenta-switch):not(.topbar-panel-avatar):not(.panel-buscar-inline):not(.panel-buscar-abrir):not(.cerrar-sesion--menu) { border: 0; border-radius: 999px; padding: 8px 16px; background: var(--color-star-glow); color: var(--color-star-white); font-weight: 600; cursor: pointer; }
      .panel-shell .opciones button { border-radius: 12px; padding: 8px 12px; background: var(--tema-superficie); color: var(--tema-texto); font-weight: 500; border: 1px solid var(--tema-linea); }
      .panel-shell button:not(.tema-toggle):not([data-nav-mas]):not(.upsell-ahora):not(.asistente-abrir):not(.asistente-cerrar):not(.asistente-reintentar):not(#asistente-enviar):not(.modo-control):not(.fiado-fila):not(.panel-cuenta-switch):not(.topbar-panel-avatar):not(.panel-buscar-inline):not(.panel-buscar-abrir):not(.cerrar-sesion--menu):hover { filter: brightness(0.92); }
      .panel-shell button:disabled { opacity: 0.6; cursor: progress; }
      .panel-shell .fila { display: flex; flex-wrap: wrap; gap: 8px; align-items: end; }
      .panel-shell .fila > label { flex: 1 1 120px; }
      .panel-shell a:not(.nav-link):not(.atajo):not(.upsell-ver):not(.logo):not(.modo-aviso):not(.topbar-panel-marca) { color: var(--tema-acento); }
      .panel-shell .error-campo { margin: 4px 0 0; color: var(--estado-peligro); font-size: 12px; font-weight: 600; }
      .panel-shell .error-campo::before { content: "⚠ "; }
      .panel-shell input[aria-invalid="true"], .panel-shell select[aria-invalid="true"], .panel-shell textarea[aria-invalid="true"] { border-color: var(--estado-peligro); }
      .tablero.panel-shell .resumen-pantalla {
        margin: 0 0 12px;
        font-size: 14px;
        color: var(--tema-texto-suave);
      }
      .tablero.panel-shell .acciones-rapidas {
        display: grid;
        gap: 8px;
        grid-template-columns: 1fr 1fr;
        margin: 0 0 16px;
      }
      .tablero.panel-shell .accion-rapida {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 14px;
        border-radius: 999px;
        border: 1px solid var(--tema-linea);
        background: var(--tema-superficie);
        color: var(--tema-texto);
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        text-align: center;
        box-sizing: border-box;
      }
      .tablero.panel-shell .accion-rapida--completo { grid-column: 1 / -1; }
      .tablero.panel-shell .accion-rapida:hover { border-color: var(--tema-texto); }
      .tablero.panel-shell .accion-rapida:focus-visible {
        outline: 2px solid var(--tema-acento);
        outline-offset: 2px;
      }
      /* TB-163 / TB-TEMA-CLARO: piel B solo con data-tema=oscuro; en claro mandan tema.css. */
      :root[data-tema="oscuro"] .tablero.panel-shell {
        background: var(--color-void);
        color: var(--color-star-white);
        --tema-fondo: var(--color-void);
        --tema-superficie: var(--color-charcoal);
        --tema-linea: var(--color-mid);
        --tema-texto: var(--color-star-white);
        --tema-texto-suave: var(--color-muted-dark);
        --tema-acento: var(--color-pendiente-oscuro);
        --tema-barra: var(--color-void);
        --tema-vidrio: var(--color-charcoal);
        --tema-fila-hover: color-mix(in srgb, var(--color-star-white) 6%, transparent);
        --tema-fila-seleccionada: color-mix(in srgb, var(--color-star-glow) 14%, transparent);
        --tema-borde-encabezado: var(--color-mid);
        --tema-enfasis: var(--color-star-glow);
        --card: var(--color-charcoal);
        --borde: var(--color-mid);
        --linea: var(--color-mid);
        --muted: var(--color-muted-dark);
        --texto-suave: var(--color-muted-dark);
        --texto: var(--color-star-white);
        --tinta: var(--color-void);
      }
      :root[data-tema="oscuro"] .tablero.panel-shell .sub,
      :root[data-tema="oscuro"] .tablero.panel-shell .estado,
      :root[data-tema="oscuro"] .tablero.panel-shell .bignum small { color: var(--color-muted-dark); }
      :root[data-tema="oscuro"] .tablero.panel-shell .card {
        background: var(--color-charcoal);
        border-color: var(--color-mid);
        color: var(--color-star-white);
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
      }
      :root[data-tema="oscuro"] .tablero.panel-shell .atajos a:not(.sg-flame-cta) {
        background: var(--color-charcoal);
        color: var(--color-star-white);
        border-color: var(--color-mid);
      }
      :root[data-tema="oscuro"] .tablero.panel-shell input,
      :root[data-tema="oscuro"] .tablero.panel-shell select,
      :root[data-tema="oscuro"] .tablero.panel-shell textarea {
        background: var(--color-charcoal);
        border-color: var(--color-mid);
        color: var(--color-star-white);
      }
      :root[data-tema="oscuro"] .tablero.panel-shell th { color: var(--color-muted-dark); border-color: var(--color-mid); }
      :root[data-tema="oscuro"] .tablero.panel-shell td,
      :root[data-tema="oscuro"] .tablero.panel-shell ul.lista li { border-color: var(--color-mid); }
      :root[data-tema="oscuro"] .tablero.panel-shell button:not(.tema-toggle):not([data-nav-mas]):not(.upsell-ahora):not(.asistente-abrir):not(.asistente-cerrar):not(.asistente-reintentar):not(#asistente-enviar):not(.modo-control):not(.fiado-fila):not(.panel-cuenta-switch):not(.topbar-panel-avatar):not(.panel-buscar-inline):not(.panel-buscar-abrir):not(.cerrar-sesion--menu):hover {
        background: var(--color-mid);
        filter: none;
      }
      :root[data-tema="oscuro"] .tablero.panel-shell a:not(.nav-link):not(.atajo):not(.upsell-ver):not(.logo):not(.modo-aviso):not(.accion-rapida):not(.topbar-panel-marca) {
        color: var(--color-star-glow);
      }
      :root[data-tema="oscuro"] .tablero.panel-shell .resumen-pantalla { color: var(--color-muted-dark); }
      :root[data-tema="oscuro"] .tablero.panel-shell .accion-rapida {
        border-color: var(--color-mid);
        background: var(--color-charcoal);
        color: var(--color-star-white);
      }
      :root[data-tema="oscuro"] .tablero.panel-shell .accion-rapida:hover { border-color: var(--color-star-white); }
      :root[data-tema="oscuro"] .tablero.panel-shell .accion-rapida:focus-visible {
        outline-color: var(--color-star-white);
      }
      @media (prefers-reduced-motion: reduce) {
        .tablero.panel-shell, .tablero.panel-shell * {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <div class:list={["panel-shell", "tablero", { "tablero-inicio": activo === "dashboard" }]}>
      <NavTablero activo={activo} />
      <PanelTopbar
        comercio={comercio}
        nombreUsuario={cuentaBarra.nombre}
        rolEtiqueta={cuentaBarra.rol}
        inicialAvatar={cuentaBarra.inicial}
      />
      <div class="tablero-contenido">
        <main>
          {ocultarTitulo ? null : <h1>{titulo}</h1>}
          {subtitulo ? <p class="sub">{subtitulo}</p> : null}
          <slot />
        </main>
      </div>
    </div>
    <Toaster client:idle />
    <ConfirmDialog />
    <ReportesComercioDialog />
  </body>
</html>
