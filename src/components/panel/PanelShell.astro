---
import "../../styles/global.css";
import { Toaster } from "../ui/Toaster";
import TopPills from "./TopPills.astro";
import type { DestinoPanel } from "../../lib/panel-modulos.js";

interface Props {
  titulo: string;
  subtitulo?: string;
  activo?: DestinoPanel;
}
const { titulo, subtitulo = "", activo } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Panel</title>
    <style is:global>
      body { margin: 0; background: var(--color-canvas); color: var(--color-void); font-family: var(--font-sans); }
      .panel-shell { max-width: 1180px; margin: 0 auto; padding: 16px; }
      .panel-shell .topbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .panel-shell .logo { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 16px; border: 1px solid var(--color-linen); border-radius: 999px; background: var(--color-star-white); color: inherit; font-weight: 700; text-decoration: none; }
      .panel-shell nav.pills { display: flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--color-linen); max-width: 100%; overflow-x: auto; }
      .panel-shell nav.pills a { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 14px; border-radius: 999px; color: var(--color-ash); font-size: 14px; text-decoration: none; white-space: nowrap; }
      .panel-shell nav.pills a:hover, .panel-shell nav.pills a.active { background: var(--color-void); color: var(--color-star-white); }
      .panel-shell nav.pills a:focus-visible { outline: 2px solid var(--color-trust); outline-offset: 2px; }
      .panel-shell main { padding-bottom: 32px; }
      .panel-shell h1 { margin: 20px 0 4px; font-size: clamp(24px, 3.4vw, 36px); font-weight: 600; }
      .panel-shell .sub { margin: 0 0 16px; color: var(--color-ash); font-size: 14px; }
      .panel-shell .grid { display: grid; gap: 16px; grid-template-columns: 1fr; }
      .panel-shell .grid.dos { margin-top: 16px; }
      @media (min-width: 900px) {
        .panel-shell .grid.dos { grid-template-columns: 1fr 1fr; }
      }
      .panel-shell .card { min-width: 0; padding: 16px; border: 1px solid var(--color-linen); border-radius: 16px; background: var(--color-star-white); }
      .panel-shell .card h2 { margin: 0 0 8px; font-size: 18px; }
      .panel-shell .estado { margin-top: 8px; color: var(--color-ash); font-size: 12px; }
      .panel-shell .kpi { display: flex; flex-wrap: wrap; gap: 24px; }
      .panel-shell .kpi b { display: block; font-size: clamp(26px, 4vw, 40px); font-weight: 600; }
      .panel-shell .kpi small { color: var(--color-ash); font-size: 12px; }
      .panel-shell table { width: 100%; border-collapse: collapse; font-size: 13px; }
      .panel-shell th { text-align: left; color: var(--color-ash); font-weight: 500; padding: 6px; border-bottom: 1px solid var(--color-linen); }
      .panel-shell td { padding: 8px 6px; border-bottom: 1px solid var(--color-linen); }
      .panel-shell ul.lista { list-style: none; margin: 0; padding: 0; font-size: 13px; }
      .panel-shell ul.lista li { padding: 8px 0; border-bottom: 1px solid var(--color-linen); }
      .panel-shell form { display: grid; gap: 8px; }
      .panel-shell label { display: grid; gap: 4px; font-size: 13px; color: var(--color-ash); }
      .panel-shell input, .panel-shell select, .panel-shell button { min-height: 44px; font-size: 16px; border-radius: 8px; padding: 8px 10px; font-family: inherit; }
      .panel-shell input, .panel-shell select { border: 1px solid var(--color-linen); background: var(--color-star-white); color: var(--color-void); }
      .panel-shell button { border: 0; border-radius: 999px; padding: 8px 16px; background: var(--color-star-glow); color: var(--color-star-white); font-weight: 600; cursor: pointer; }
      .panel-shell button:hover { background: var(--color-void); }
      .panel-shell button:disabled { opacity: 0.6; cursor: progress; }
      .panel-shell .fila { display: flex; flex-wrap: wrap; gap: 8px; align-items: end; }
      .panel-shell .fila > label { flex: 1 1 120px; }
      .panel-shell a { color: var(--color-trust); }
    </style>
  </head>
  <body>
    <div class="panel-shell">
      <header class="topbar">
        <a class="logo" href="/panel">Inventario</a>
        <TopPills activo={activo} />
      </header>
      <main>
        <h1>{titulo}</h1>
        {subtitulo ? <p class="sub">{subtitulo}</p> : null}
        <slot />
      </main>
    </div>
    <Toaster client:idle />
  </body>
</html>
