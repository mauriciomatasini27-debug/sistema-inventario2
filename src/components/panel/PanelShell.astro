---
import "../../styles/global.css";
import "../../styles/tema.css";
import { Toaster } from "../ui/Toaster";
import ConfirmDialog from "../ui/ConfirmDialog.astro";
import TemaInicial from "../ui/TemaInicial.astro";
import TemaToggle from "../ui/TemaToggle.astro";
import CerrarSesion from "../ui/CerrarSesion.astro";
import TopPills from "./TopPills.astro";
import type { DestinoPanel } from "../../lib/panel-modulos.js";

interface Props {
  titulo: string;
  subtitulo?: string;
  activo?: DestinoPanel;
  // P1-35: nombre del comercio activo cuando la página lo conoce.
  comercio?: string;
}
const { titulo, subtitulo = "", activo, comercio = "" } = Astro.props;
const logoTexto = comercio.trim() || "Inventario";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Panel</title>
    <TemaInicial />
    <style is:global>
      body { margin: 0; background: var(--tema-fondo); color: var(--tema-texto); font-family: var(--font-sans); }
      .panel-shell { max-width: 1180px; margin: 0 auto; padding: 16px; }
      .panel-shell .topbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 8px 0; }
      .panel-shell .topbar .tema-toggle { margin-left: auto; }
      /* A 360px la barra ocupa 2-3 filas: fija le comería un tercio de la pantalla. */
      @media (max-width: 640px) { .panel-shell .topbar.vidrio-barra { position: static; } }
      .panel-shell .logo { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 16px; border: 1px solid var(--tema-linea); border-radius: 999px; background: var(--tema-superficie); color: inherit; font-weight: 700; text-decoration: none; }
      .panel-shell nav.pills { display: flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--tema-linea); max-width: 100%; overflow-x: auto; }
      .panel-shell nav.pills a { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 14px; border-radius: 999px; color: var(--tema-texto-suave); font-size: 14px; text-decoration: none; white-space: nowrap; }
      /* P1-46: inline-flex de la pill gana al atributo hidden. Sin esto el módulo fuera de plan sigue en la barra. */
      [data-modulo-indice][hidden] { display: none !important; }
      .panel-shell nav.pills a:hover, .panel-shell nav.pills a.active { background: var(--color-void); color: var(--color-star-white); }
      :root[data-tema="oscuro"] .panel-shell nav.pills a:hover, :root[data-tema="oscuro"] .panel-shell nav.pills a.active { background: var(--color-star-white); color: var(--color-void); }
      .panel-shell nav.pills a:focus-visible { outline: 2px solid var(--tema-acento); outline-offset: 2px; }
      .panel-shell main { padding-bottom: 32px; }
      .panel-shell h1 { margin: 20px 0 4px; font-size: clamp(24px, 3.4vw, 36px); font-weight: 600; }
      .panel-shell .sub { margin: 0 0 16px; color: var(--tema-texto-suave); font-size: 14px; }
      .panel-shell .grid { display: grid; gap: 16px; grid-template-columns: 1fr; }
      .panel-shell .grid.dos { margin-top: 16px; }
      @media (min-width: 900px) {
        .panel-shell .grid.dos { grid-template-columns: 1fr 1fr; }
      }
      .panel-shell .card { min-width: 0; padding: 16px; border: 1px solid var(--tema-linea); border-radius: 16px; background: var(--tema-superficie); }
      @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .panel-shell .card { background: var(--tema-vidrio); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
      }
      @media (prefers-reduced-transparency: reduce) {
        .panel-shell .card { background: var(--tema-superficie); -webkit-backdrop-filter: none; backdrop-filter: none; }
      }
      .panel-shell .card h2 { margin: 0 0 8px; font-size: 18px; }
      .panel-shell .estado { margin-top: 8px; color: var(--tema-texto-suave); font-size: 12px; }
      .panel-shell .kpi { display: flex; flex-wrap: wrap; gap: 24px; }
      .panel-shell .kpi b { display: block; font-size: clamp(26px, 4vw, 40px); font-weight: 600; }
      .panel-shell .kpi small { color: var(--tema-texto-suave); font-size: 12px; }
      .panel-shell table { width: 100%; border-collapse: collapse; font-size: 13px; }
      .panel-shell th { text-align: left; color: var(--tema-texto-suave); font-weight: 500; padding: 6px; border-bottom: 1px solid var(--tema-linea); }
      .panel-shell td { padding: 8px 6px; border-bottom: 1px solid var(--tema-linea); }
      .panel-shell ul.lista { list-style: none; margin: 0; padding: 0; font-size: 13px; }
      .panel-shell ul.lista li { padding: 8px 0; border-bottom: 1px solid var(--tema-linea); }
      .panel-shell form { display: grid; gap: 8px; }
      .panel-shell label { display: grid; gap: 4px; min-width: 0; font-size: 13px; color: var(--tema-texto-suave); }
      .panel-shell input, .panel-shell select, .panel-shell button:not(.tema-toggle) { min-height: 44px; font-size: 16px; border-radius: 8px; padding: 8px 10px; font-family: inherit; }
      .panel-shell input, .panel-shell select { border: 1px solid var(--tema-linea); background: var(--tema-superficie); color: var(--tema-texto); }
      .panel-shell label > input, .panel-shell label > select { box-sizing: border-box; width: 100%; min-width: 0; }
      .panel-shell select { text-overflow: ellipsis; }
      .panel-shell button:not(.tema-toggle) { border: 0; border-radius: 999px; padding: 8px 16px; background: var(--color-star-glow); color: var(--color-star-white); font-weight: 600; cursor: pointer; }
      .panel-shell button:not(.tema-toggle):hover { background: var(--color-void); }
      .panel-shell button:disabled { opacity: 0.6; cursor: progress; }
      .panel-shell .fila { display: flex; flex-wrap: wrap; gap: 8px; align-items: end; }
      .panel-shell .fila > label { flex: 1 1 120px; }
      .panel-shell a { color: var(--tema-acento); }
      .panel-shell .error-campo { margin: 4px 0 0; color: var(--estado-peligro); font-size: 12px; font-weight: 600; }
      .panel-shell .error-campo::before { content: "⚠ "; }
      .panel-shell input[aria-invalid="true"], .panel-shell select[aria-invalid="true"], .panel-shell textarea[aria-invalid="true"] { border-color: var(--estado-peligro); }
    </style>
  </head>
  <body>
    <div class="panel-shell">
      <header class="topbar vidrio-barra">
        <a class="logo" href="/panel" title={comercio.trim() || "Panel del comercio"}>{logoTexto}</a>
        <TopPills activo={activo} />
        <CerrarSesion />
        <TemaToggle />
      </header>
      <main>
        <h1>{titulo}</h1>
        {subtitulo ? <p class="sub">{subtitulo}</p> : null}
        <slot />
      </main>
    </div>
    <Toaster client:idle />
    <ConfirmDialog />
    <script>
      import { aplicarFiltroIndice } from "../../lib/panel-indice-cliente.js";

      fetch("/api/panel/indice")
        .then((r) => (r.ok ? r.json() : null))
        .then((crudo) => {
          aplicarFiltroIndice(crudo, document);
        })
        .catch((error) => {
          console.warn("[panel] no pudimos leer el índice de módulos", error);
        });
    </script>
  </body>
</html>
