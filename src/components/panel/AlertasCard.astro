---
import { moduloIndice } from "../../lib/panel-modulos.js";

const alertas = moduloIndice("alertas");
// P1-45: el historial no es una feature de plan. El dueño llega desde esta tarjeta, fuera de MODULOS_INDICE.
---
<section class="card card-ember card-ember--rojo" id="alertas" data-modulo-indice={alertas.id}>
  <h2>Alertas <a href={alertas.href} aria-label="Configurar alertas">↗</a></h2>
  <div class="mini">Stock mínimo y cantidad a reponer por producto.</div>
  <div class="alertas-accesos">
    <a class="alertas-acceso" href={alertas.href}>Configurar umbrales</a>
    <a class="alertas-acceso" href="/panel/alertas/historial">Historial</a>
  </div>
</section>

<style>
  .alertas-accesos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 8px;
  }
  .alertas-acceso {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--texto);
    font-weight: 700;
    text-underline-offset: 3px;
  }
</style>
