---
interface Props {
  verSaldo?: boolean;
}
const { verSaldo = true } = Astro.props;
---
<div class="kpis" id="kpi-strip" aria-busy="true" data-pendientes="resumen caja" data-ver-saldo={verSaldo ? "si" : "no"}>
  <div class="segbar" id="segbar" title="Ventas del mes por medio">
    <i class="skel skel-barra" aria-hidden="true"></i>
  </div>
  <div class="bignums">
    <div class="bignum" style="--i: 0"><b id="n-tickets"><i class="skel" aria-hidden="true"></i></b><small><i class="kpi-ember ember-ambar" aria-hidden="true"></i>Tickets hoy</small></div>
    <div class="bignum" style="--i: 1"><b id="n-stock"><i class="skel" aria-hidden="true"></i></b><small><i class="kpi-ember ember-coral" aria-hidden="true"></i>Stock bajo</small></div>
    <div class="bignum" style="--i: 2" hidden={!verSaldo}><b id="n-caja"><i class="skel" aria-hidden="true"></i></b><small><i class="kpi-ember ember-vino" aria-hidden="true"></i>Caja total <span class="live">en vivo</span></small></div>
  </div>
</div>
<div class="estado" id="kpi-estado">Resumen: cargando…</div>

<style is:global>
  /* DS-S12: skeleton con shimmer mientras cargan los KPI y entrada escalonada
     al llegar cada valor. Solo tokens de rol (claro y oscuro); `<i>` y no
     `<span>` para que no lo pinten las reglas `.segbar span:nth-child(n)`. */
  .skel.skel-barra { display: block; flex: 1; width: auto; height: 100%; border-radius: 999px; }
  #n-caja .skel { width: 4em; }
  .bignum.listo {
    animation: kpi-entra 240ms ease-out both;
    animation-delay: calc(var(--i, 0) * 60ms);
  }
  @keyframes kpi-entra {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }
  /* Con movimiento reducido: skeleton estático y valores sin entrada. */
  @media (prefers-reduced-motion: reduce) {
    .skel, .bignum.listo { animation: none !important; }
  }
  .segbar { display: flex; height: 34px; border-radius: 999px; overflow: hidden; background: var(--tema-linea); min-width: min(420px, 100%); font-size: 12px; font-weight: 700; }
  .segbar span { display: inline-flex; align-items: center; padding: 0 12px; min-width: 0; overflow: hidden; white-space: nowrap; }
  .segbar span:not(.vacio):nth-child(1) { background: var(--color-void); color: var(--color-star-white); }
  .segbar span:not(.vacio):nth-child(2) { background: var(--color-ember-ambar); color: var(--color-void); }
  .segbar span:not(.vacio):nth-child(3) { background: var(--color-ember-coral); color: var(--color-void); }
  .segbar span:not(.vacio):nth-child(4) { background: var(--color-ember-vino); color: var(--color-star-white); border-radius: 0 999px 999px 0; }
  :root:not([data-tema="oscuro"]) .segbar span:not(.vacio):nth-child(2), :root:not([data-tema="oscuro"]) .segbar span:not(.vacio):nth-child(3) { box-shadow: inset 0 0 0 1px var(--color-ash); }
  .segbar span.vacio { flex: 1; background: var(--tema-linea); color: var(--tema-texto-suave); font-weight: 500; box-shadow: none; }
  .bignums { display: flex; flex-wrap: wrap; column-gap: 28px; row-gap: 8px; }
  .bignum small { color: var(--tema-texto-suave); font-size: 12px; white-space: nowrap; }
  :root[data-tema="oscuro"] .segbar span:not(.vacio):nth-child(1) { background: var(--color-star-white); color: var(--color-void); }
</style>

<script>
  import { formatearCentavos, setTexto } from "../../lib/panel-modulos.js";
  import { kpiListo, pintarKpi } from "../../lib/panel-dashboard.js";

  const verSaldo = document.getElementById("kpi-strip")?.dataset.verSaldo !== "no";
  if (!verSaldo) {
    kpiListo("caja");
  } else fetch("/api/cash/balance").then(async (r) => {
    if (!r.ok) throw new Error("http " + r.status);
    const b = await r.json();
    const medios = b.por_medio || {};
    const total = Object.values(medios).map(Number).reduce((a, v) => a + v, 0);
    pintarKpi("n-caja", formatearCentavos(total));
    setTexto("balance-estado", "Balance en vivo: total " + formatearCentavos(total) + ".");
  }).catch(() => {
    pintarKpi("n-caja", "—");
    setTexto("balance-estado", "Sin conexión con el servidor: caja no disponible.");
  }).finally(() => kpiListo("caja"));
</script>
