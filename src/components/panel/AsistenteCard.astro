---
---
<section class="card card-ember card-ember--ambar" id="asistente-panel">
  <h2>Asistente IA</h2>
  <p class="mini">Preguntá por ventas, stock, deudores o caja. Responde con los datos de tu comercio.</p>
  <form id="asistente-form" class="asistente-form">
    <label class="asistente-label" for="asistente-pregunta">Tu pregunta</label>
    <div class="asistente-fila">
      <input
        id="asistente-pregunta"
        name="pregunta"
        type="text"
        maxlength="500"
        required
        autocomplete="off"
        placeholder="¿Cuánto vendí este mes?"
      />
      <button type="submit" id="asistente-enviar">Preguntar</button>
    </div>
  </form>
  <p class="asistente-respuesta" id="asistente-respuesta" aria-live="polite"></p>
  <p class="mini" id="asistente-estado" role="status"></p>
</section>

<style>
  .asistente-form {
    margin-top: 8px;
  }
  .asistente-label {
    display: block;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .asistente-fila {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .asistente-fila input {
    flex: 1 1 220px;
    min-height: 44px;
    border: 1px solid var(--borde);
    border-radius: 999px;
    padding: 8px 14px;
    background: var(--card);
    color: var(--texto);
    font: inherit;
    font-size: 16px;
  }
  .asistente-fila button {
    min-height: 44px;
    border: 0;
    border-radius: 999px;
    padding: 10px 22px;
    font: inherit;
    font-weight: 700;
    background: var(--llama);
    color: var(--tinta);
    cursor: pointer;
  }
  .asistente-fila button:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .asistente-respuesta {
    font-size: 15px;
    margin: 10px 0 0;
    white-space: pre-wrap;
  }
  .asistente-respuesta.rechazada {
    color: var(--texto-suave);
  }
  .asistente-estado {
    color: var(--muted);
  }
</style>

<script>
  import { toast } from "sonner";

  const form = document.getElementById("asistente-form");
  const input = document.getElementById("asistente-pregunta");
  const enviar = document.getElementById("asistente-enviar");
  const respuesta = document.getElementById("asistente-respuesta");
  const estado = document.getElementById("asistente-estado");

  function ocultarFormulario(explicacion) {
    form.hidden = true;
    estado.textContent = explicacion;
  }

  fetch("/api/asistente")
    .then(async (r) => {
      if (!r.ok) throw new Error("http " + r.status);
      const j = await r.json();
      if (!j.incluido) ocultarFormulario(j.explicacion || "Tu plan no incluye el asistente IA.");
    })
    .catch(() => {
      estado.textContent = "No pudimos verificar tu plan. Igual podés preguntar.";
    });

  form.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const pregunta = input.value.trim();
    if (!pregunta) return;
    enviar.disabled = true;
    respuesta.textContent = "";
    respuesta.classList.remove("rechazada");
    estado.textContent = "Pensando…";
    try {
      const r = await fetch("/api/asistente", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ pregunta }),
      });
      let j: { incluido?: boolean; explicacion?: string; codigo?: string; error?: string; texto?: string; rechazada?: boolean } = {};
      const crudo = await r.text();
      try {
        j = JSON.parse(crudo);
      } catch (e) {
        console.warn("[asistente] respuesta no JSON", e);
      }
      if (r.status === 403 && j.codigo === "fuera_de_plan") {
        ocultarFormulario(j.error || "Tu plan no incluye el asistente IA.");
        return;
      }
      if (r.status === 503 && j.codigo === "asistente_no_configurado") {
        estado.textContent = j.error || "El asistente IA todavía no está configurado.";
        return;
      }
      if (!r.ok) throw new Error(j.error || "http " + r.status);
      respuesta.textContent = j.texto || "";
      respuesta.classList.toggle("rechazada", j.rechazada === true);
      estado.textContent = "";
      input.value = "";
    } catch {
      estado.textContent = "";
      toast.error("No pudimos consultar al asistente. Reintentá en un rato.");
    } finally {
      enviar.disabled = false;
    }
  });
</script>
