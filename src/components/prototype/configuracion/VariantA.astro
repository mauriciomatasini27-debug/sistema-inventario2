---
// PROTOTIPO — /panel/configuracion · Variante A "Formulario clásico"
import {
  PASOS,
  MARKUP_DEFECTO,
  PASO_DEFECTO,
  precioDesdeCosto,
  formatearPesos,
} from "../calculo-precios.js";
const COSTO_EJEMPLO = 100_000; // $1.000
---
<section class="card proto-config">
  <h2>Ajustes de precios</h2>
  <p class="proto-ayuda">Solo el <b>Dueño</b> edita estos valores. El porcentaje se precarga en los productos nuevos; los precios ya cargados no se tocan.</p>

  <div class="proto-campos">
    <label>
      <span>Porcentaje de recargo por defecto</span>
      <span class="proto-con-sufijo">
        <input id="cfg-markup" type="number" min="0.01" max="1000" step="0.5" inputmode="decimal" value={MARKUP_DEFECTO} />
        <span class="proto-sufijo">%</span>
      </span>
    </label>

    <fieldset class="proto-paso">
      <legend>Paso de redondeo</legend>
      <div class="proto-segmento" role="radiogroup" aria-label="Paso de redondeo">
        {PASOS.map((p) => (
          <label class:list={["proto-seg-op", { activo: p.centavos === PASO_DEFECTO }]}>
            <input type="radio" name="cfg-paso" value={p.centavos} checked={p.centavos === PASO_DEFECTO} />
            <span>{p.etiqueta}</span>
          </label>
        ))}
      </div>
    </fieldset>
  </div>

  <div class="proto-ejemplo" aria-live="polite">
    <span>Ejemplo</span>
    <b>Costo {formatearPesos(COSTO_EJEMPLO)} → Precio <span data-preview>{formatearPesos(precioDesdeCosto(COSTO_EJEMPLO, MARKUP_DEFECTO, PASO_DEFECTO))}</span></b>
  </div>

  <div class="proto-acciones">
    <button type="button" class="proto-primario" data-guardar>Guardar</button>
    <a href="/panel/precios">Abrir Precios</a>
  </div>
  <p class="proto-nota">Cambiar el porcentaje aplica <b>hacia adelante</b>. Si querés actualizar los precios que ya están en modo recargo, usá «Recalcular» desde Precios.</p>
</section>

<style>
  .proto-config .proto-ayuda { margin: 0 0 12px; color: var(--tema-texto-suave); font-size: 13px; }
  .proto-campos { display: grid; gap: 14px; }
  .proto-con-sufijo { display: flex; align-items: center; }
  .proto-con-sufijo input { width: 100%; }
  .proto-sufijo { margin-left: 8px; font-size: 16px; color: var(--tema-texto); }
  .proto-paso { border: 0; padding: 0; margin: 0; }
  .proto-paso legend { font-size: 13px; color: var(--tema-texto-suave); margin-bottom: 6px; }
  .proto-segmento { display: flex; gap: 6px; }
  .proto-seg-op { position: relative; flex: 1; }
  .proto-seg-op input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; cursor: pointer; margin: 0; }
  .proto-seg-op span {
    display: flex; align-items: center; justify-content: center; min-height: 44px;
    border: 1px solid var(--tema-linea); border-radius: 8px; background: var(--tema-superficie);
    font-size: 15px; font-weight: 600;
  }
  .proto-seg-op.activo span, .proto-seg-op input:checked + span { background: var(--tema-texto); color: var(--tema-fondo); border-color: var(--tema-texto); }
  .proto-ejemplo { margin-top: 14px; padding: 12px; border-radius: 12px; background: var(--estado-pendiente-tint); color: var(--estado-pendiente); display: grid; gap: 2px; font-size: 14px; }
  .proto-ejemplo span { font-size: 12px; opacity: 0.85; }
  .proto-acciones { display: flex; align-items: center; gap: 12px; margin-top: 14px; }
  .proto-primario { background: var(--color-star-glow); color: var(--color-star-white); font-weight: 600; }
  .proto-nota { margin: 12px 0 0; color: var(--tema-texto-suave); font-size: 12px; }
</style>

<script>
  import { precioDesdeCosto, formatearPesos } from "../calculo-precios.js";
  const $ = (id) => document.getElementById(id);
  const markup = $("cfg-markup") as HTMLInputElement;
  const radios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="cfg-paso"]'));
  const preview = document.querySelector<HTMLElement>("[data-preview]")!;
  const COSTO = 100_000;

  const repintar = () => {
    const m = Number(markup.value) || 0;
    const paso = Number(radios.find((r) => r.checked)?.value) || 1000;
    preview.textContent = formatearPesos(precioDesdeCosto(COSTO, m, paso));
  };
  markup.addEventListener("input", repintar);
  radios.forEach((r) => r.addEventListener("change", repintar));
  document.querySelector<HTMLElement>("[data-guardar]")?.addEventListener("click", () => {
    const ok = document.createElement("p");
    ok.className = "proto-nota";
    ok.textContent = "Guardado (prototipo: no persiste).";
    document.querySelector(".proto-acciones")?.after(ok);
  });
</script>
