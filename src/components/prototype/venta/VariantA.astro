---
// PROTOTIPO — /venta · Variante A "Edición en fila + chips de descuento"
import { MARKUP_DEFECTO } from "../calculo-precios.js";
const LINEAS = [
  { id: "l1", nombre: "Gaseosa 1,5L", qty: 2, precio: 130000 },
  { id: "l2", nombre: "Alfajor", qty: 3, precio: 55000 },
];
const DESCUENTOS = [-5, -10, -20];
---
<div class="proto-venta-a">
  <section class="card vidrio-card">
    <h2 class="proto-titulo">Ticket</h2>
    <ul class="proto-lineas">
      {LINEAS.map((l) => (
        <li class="proto-linea" data-id={l.id} data-base={l.precio}>
          <div class="proto-linea-cab">
            <span class="proto-nombre">{l.nombre}</span>
            <span class="proto-qty">×{l.qty}</span>
          </div>
          <div class="proto-linea-ed">
            <label class="proto-precio-label">Precio
              <input type="text" inputmode="decimal" autocomplete="off" data-precio />
            </label>
            <div class="proto-chips" role="group" aria-label="Descuento de la línea">
              {DESCUENTOS.map((d) => <button type="button" data-dcto={d}>{d}%</button>)}
            </div>
          </div>
          <div class="proto-linea-sub">
            <span data-dcto-info></span>
            <b data-subtotal></b>
          </div>
        </li>
      ))}
    </ul>
    <p class="proto-total">Total: <b data-total></b></p>
  </section>

  <section class="card vidrio-card proto-alta-vuelo">
    <h2 class="proto-titulo">Alta al vuelo</h2>
    <p class="proto-ayuda">Producto nuevo sin precio: calculalo desde el costo.</p>
    <label>Nombre
      <input id="vtA-nombre" type="text" autocomplete="off" placeholder="Nombre del producto nuevo" />
    </label>
    <div class="proto-dos">
      <label>Costo (pesos) <input id="vtA-costo" type="text" inputmode="decimal" autocomplete="off" /></label>
      <label>Recargo <input id="vtA-markup" type="number" min="0.01" max="1000" step="0.5" inputmode="decimal" value={MARKUP_DEFECTO} /></label>
    </div>
    <div class="proto-sugerido" aria-live="polite">
      <span>Precio de venta</span>
      <b data-alta-precio>—</b>
    </div>
    <button type="button" class="proto-primario">Agregar al ticket</button>
  </section>
</div>

<style>
  .proto-venta-a { display: grid; gap: 8px; }
  .proto-titulo { margin: 0 0 8px; font-size: 18px; }
  .proto-ayuda { color: var(--tema-texto-suave); font-size: 13px; margin: 0 0 8px; }
  .proto-lineas { list-style: none; margin: 0; padding: 0; }
  .proto-linea { padding: 10px 0; border-bottom: 1px solid var(--tema-linea); }
  .proto-linea-cab { display: flex; justify-content: space-between; gap: 8px; }
  .proto-nombre { overflow-wrap: anywhere; }
  .proto-qty { color: var(--tema-texto-suave); font-variant-numeric: tabular-nums; }
  .proto-linea-ed { display: grid; gap: 6px; margin-top: 6px; }
  .proto-precio-label { display: grid; gap: 2px; font-size: 12px; color: var(--tema-texto-suave); }
  .proto-precio-label input { margin: 0; }
  .proto-chips { display: flex; gap: 6px; }
  .proto-chips button { width: auto; min-width: 52px; margin: 0; padding-inline: 10px; }
  .proto-linea-sub { display: flex; justify-content: space-between; margin-top: 6px; font-size: 13px; color: var(--tema-texto-suave); }
  .proto-linea-sub b { color: var(--tema-texto); font-variant-numeric: tabular-nums; }
  .proto-total { margin: 10px 0 0; font-size: 16px; text-align: right; }
  .proto-total b { font-variant-numeric: tabular-nums; }
  .proto-dos { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .proto-sugerido { margin-top: 10px; padding: 12px; border-radius: 10px; background: var(--estado-pendiente-tint); color: var(--estado-pendiente); display: grid; gap: 2px; }
  .proto-sugerido span { font-size: 12px; opacity: 0.85; }
  .proto-sugerido b { font-size: 24px; font-variant-numeric: tabular-nums; }
  .proto-primario { margin-top: 10px; background: var(--color-star-glow); color: var(--color-star-white); font-weight: 600; }
</style>

<script>
  import { precioDesdeCosto, formatearPesos, parsearPesos, pesosParaInput } from "../calculo-precios.js";
  const $ = (id) => document.getElementById(id) as HTMLInputElement;
  const lineas = Array.from(document.querySelectorAll<HTMLElement>(".proto-linea"));
  const totalEl = document.querySelector<HTMLElement>("[data-total]")!;

  const pintarLinea = (li: HTMLElement) => {
    const base = Number(li.dataset.base);
    const qty = Number(li.querySelector(".proto-qty")!.textContent!.replace(/\D/g, "")) || 1;
    const precioInput = li.querySelector<HTMLInputElement>("[data-precio]")!;
    const precio = parsearPesos(precioInput.value) ?? base;
    let dctoPct = 0;
    const activo = li.querySelector<HTMLButtonElement>("[data-dcto].activo");
    if (activo) dctoPct = Number(activo.dataset.dcto);
    const unitario = Math.round(precio * (1 + dctoPct / 100));
    const subtotal = unitario * qty;
    li.querySelector<HTMLElement>("[data-dcto-info]")!.textContent = dctoPct !== 0 ? `${dctoPct}% aplicado` : "";
    li.querySelector<HTMLElement>("[data-subtotal]")!.textContent = formatearPesos(subtotal);
    return subtotal;
  };
  const repintarTotal = () => {
    const total = lineas.reduce((acc, li) => acc + pintarLinea(li), 0);
    totalEl.textContent = formatearPesos(total);
  };
  lineas.forEach((li) => {
    const base = Number(li.dataset.base);
    li.querySelector<HTMLInputElement>("[data-precio]")!.value = pesosParaInput(base);
    li.querySelector<HTMLInputElement>("[data-precio]")!.addEventListener("input", repintarTotal);
    li.querySelectorAll<HTMLButtonElement>("[data-dcto]").forEach((b) => {
      b.addEventListener("click", () => {
        const ya = b.classList.contains("activo");
        li.querySelectorAll<HTMLButtonElement>("[data-dcto]").forEach((x) => x.classList.remove("activo"));
        if (!ya) b.classList.add("activo");
        repintarTotal();
      });
    });
  });
  const costo = $("vtA-costo");
  const markup = $("vtA-markup");
  const altaPrecio = document.querySelector<HTMLElement>("[data-alta-precio]")!;
  const repintarAlta = () => {
    const c = parsearPesos(costo.value) ?? 0;
    const m = Number(markup.value) || 0;
    altaPrecio.textContent = c > 0 ? formatearPesos(precioDesdeCosto(c, m, 1000)) : "—";
  };
  costo.addEventListener("input", repintarAlta);
  markup.addEventListener("input", repintarAlta);
  repintarTotal();
</script>
