---
// PROTOTIPO — /venta · Variante A "Barra de total + descuento (sheet)"
import { MARKUP_DEFECTO, formatearPesos } from "../calculo-precios.js";
const LINEAS = [
  { id: "l1", nombre: "Gaseosa 1,5L", qty: 2, precio: 130000 },
  { id: "l2", nombre: "Alfajor", qty: 1, precio: 55000 },
];
const DESCUENTOS = [0, 5, 10, 15, 20];
---
<div class="proto-venta">
  <section class="card vidrio-card">
    <h2 class="proto-titulo">Ticket</h2>
    <ul class="proto-lineas">
      {LINEAS.map((l) => (
        <li class="proto-linea" data-id={l.id} data-precio={l.precio}>
          <span class="proto-nombre">{l.nombre}</span>
          <div class="proto-fila-linea">
            <div class="proto-stepper">
              <button type="button" data-dir="-1" aria-label="Menos">−</button>
              <b class="proto-qty" data-qty>{l.qty}</b>
              <button type="button" data-dir="1" aria-label="Más">+</button>
            </div>
            <button type="button" class="proto-precio" data-precio-boton>{formatearPesos(l.precio)}</button>
            <input type="text" inputmode="decimal" autocomplete="off" class="proto-precio-input" data-precio-input hidden />
          </div>
        </li>
      ))}
    </ul>

    <div class="proto-alta">
      <h2 class="proto-titulo">Producto nuevo (alta al vuelo)</h2>
      <label class="proto-label">Nombre
        <input id="vtA-nombre" type="text" autocomplete="off" placeholder="Nombre del producto" />
      </label>
      <div class="proto-dos">
        <label class="proto-label">Costo
          <input id="vtA-costo" type="text" inputmode="decimal" autocomplete="off" placeholder="0" />
        </label>
        <label class="proto-label">Recargo %
          <input id="vtA-markup" type="number" min="0.01" max="1000" step="0.5" inputmode="decimal" value={MARKUP_DEFECTO} />
        </label>
      </div>
      <div class="proto-sugerido" aria-live="polite">
        <span>Precio de venta</span>
        <b data-alta-precio>—</b>
      </div>
      <button type="button" class="proto-btn proto-btn--primario">Agregar producto</button>
    </div>
  </section>

  <div class="proto-total-bar">
    <div class="proto-total-fila">
      <button type="button" class="proto-btn proto-btn--neutro" data-descuento>Descuento <span data-descuento-val></span></button>
      <p class="proto-total">Total: <b data-total></b></p>
    </div>
    <button type="button" class="proto-btn proto-btn--primario">Cobrar</button>
  </div>

  <div class="proto-sheet" hidden data-sheet>
    <div class="proto-sheet-panel">
      <h3>Descuento del ticket</h3>
      <div class="proto-chips">
        {DESCUENTOS.map((d) => <button type="button" class:list={["proto-chip", { activo: d === 0 }]} data-dcto={d}>{d === 0 ? "Sin desc." : `-${d}%`}</button>)}
      </div>
      <label class="proto-label">Descuento a mano (%)
        <input id="vtA-dcto-manual" type="number" min="0" max="90" step="1" value="0" />
      </label>
      <button type="button" class="proto-btn proto-btn--primario" data-sheet-cerrar>Listo</button>
    </div>
  </div>
</div>

<style>
  .proto-lineas { list-style: none; margin: 0; padding: 0; }
  .proto-linea { padding: 12px 0; border-bottom: 1px solid var(--tema-linea); }
  .proto-nombre { display: block; font-size: 17px; font-weight: 700; margin-bottom: 8px; overflow-wrap: anywhere; }
  .proto-fila-linea { display: flex; align-items: center; gap: 10px; }
  .proto-qty { min-width: 28px; text-align: center; font-size: 20px; font-variant-numeric: tabular-nums; }
  .proto-precio { flex: 1 1 auto; min-height: 48px; border: 1px solid var(--tema-linea) !important; background: var(--tema-superficie) !important; color: var(--tema-texto) !important; border-radius: 12px !important; font-size: 18px; font-weight: 800; font-variant-numeric: tabular-nums; text-align: right; padding: 0 14px; }
  .proto-precio-input { flex: 1 1 auto; min-height: 48px; font-size: 18px; font-weight: 800; text-align: right; }
  .proto-alta { margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--tema-linea); }
  .proto-label { display: grid; gap: 6px; }
  .proto-dos { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 8px 0; }
  .proto-total-bar { margin-top: 4px; display: grid; gap: 10px; padding: 12px; border-radius: 14px; background: var(--tema-superficie); border: 1px solid var(--tema-linea); }
  .proto-total-fila { display: flex; align-items: center; gap: 10px; }
  .proto-total-fila button { flex: 1 1 auto; }
  .proto-total-fila .proto-total { white-space: nowrap; }
  .proto-total b { font-variant-numeric: tabular-nums; }
</style>

<script>
  import { precioDesdeCosto, formatearPesos, parsearPesos, pesosParaInput } from "../calculo-precios.js";
  const lineas = Array.from(document.querySelectorAll<HTMLElement>(".proto-linea"));
  const totalEl = document.querySelector<HTMLElement>("[data-total]")!;
  const dctoVal = document.querySelector<HTMLElement>("[data-descuento-val]")!;
  const sheet = document.querySelector<HTMLElement>("[data-sheet]")!;
  const dctoManual = document.getElementById("vtA-dcto-manual") as HTMLInputElement;
  let descuento = 0;

  const precioDeLinea = (li: HTMLElement) => {
    const input = li.querySelector<HTMLInputElement>("[data-precio-input]")!;
    if (!input.hidden) return parsearPesos(input.value) ?? Number(li.dataset.precio);
    return Number(li.dataset.precio);
  };
  const repintar = () => {
    let subtotal = 0;
    lineas.forEach((li) => {
      const qty = Number(li.querySelector<HTMLElement>("[data-qty]")!.textContent) || 1;
      subtotal += precioDeLinea(li) * qty;
    });
    const total = Math.round(subtotal * (1 - descuento / 100));
    totalEl.textContent = formatearPesos(total);
    dctoVal.textContent = descuento > 0 ? `(-${descuento}%)` : "";
  };
  lineas.forEach((li) => {
    li.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((b) => {
      b.addEventListener("click", () => {
        const qtyEl = li.querySelector<HTMLElement>("[data-qty]")!;
        const dir = Number(b.dataset.dir);
        const qty = Math.max(1, (Number(qtyEl.textContent) || 1) + dir);
        qtyEl.textContent = String(qty);
        repintar();
      });
    });
    const boton = li.querySelector<HTMLButtonElement>("[data-precio-boton]")!;
    const input = li.querySelector<HTMLInputElement>("[data-precio-input]")!;
    boton.addEventListener("click", () => {
      input.value = pesosParaInput(precioDeLinea(li));
      input.hidden = false;
      boton.hidden = true;
      input.focus();
    });
    input.addEventListener("blur", () => {
      const p = parsearPesos(input.value);
      if (p !== null) li.dataset.precio = String(p);
      boton.textContent = formatearPesos(Number(li.dataset.precio));
      input.hidden = true;
      boton.hidden = false;
      repintar();
    });
  });
  document.querySelector<HTMLElement>("[data-descuento]")?.addEventListener("click", () => { sheet.hidden = false; });
  document.querySelector<HTMLElement>("[data-sheet-cerrar]")?.addEventListener("click", () => { sheet.hidden = true; });
  sheet.querySelectorAll<HTMLButtonElement>("[data-dcto]").forEach((b) => {
    b.addEventListener("click", () => {
      descuento = Number(b.dataset.dcto);
      dctoManual.value = String(descuento);
      sheet.querySelectorAll<HTMLButtonElement>("[data-dcto]").forEach((x) => x.classList.toggle("activo", x === b));
      repintar();
    });
  });
  dctoManual.addEventListener("input", () => {
    descuento = Math.max(0, Math.min(90, Number(dctoManual.value) || 0));
    sheet.querySelectorAll<HTMLButtonElement>("[data-dcto]").forEach((x) => x.classList.toggle("activo", Number(x.dataset.dcto) === descuento));
    repintar();
  });

  const costo = document.getElementById("vtA-costo") as HTMLInputElement;
  const markup = document.getElementById("vtA-markup") as HTMLInputElement;
  const altaPrecio = document.querySelector<HTMLElement>("[data-alta-precio]")!;
  const repintarAlta = () => {
    const c = parsearPesos(costo.value) ?? 0;
    const m = Number(markup.value) || 0;
    altaPrecio.textContent = c > 0 ? formatearPesos(precioDesdeCosto(c, m, 1000)) : "—";
  };
  costo.addEventListener("input", repintarAlta);
  markup.addEventListener("input", repintarAlta);
  repintar();
</script>
