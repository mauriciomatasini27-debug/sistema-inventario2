---
// PROTOTIPO — /venta · Variante B "Descuento en el paso de cobro"
import { MARKUP_DEFECTO, formatearPesos } from "../calculo-precios.js";
const LINEAS = [
  { id: "l1", nombre: "Gaseosa 1,5L", qty: 2, precio: 130000 },
  { id: "l2", nombre: "Alfajor", qty: 1, precio: 55000 },
];
const DESCUENTOS = [0, 5, 10, 15, 20];
---
<div class="proto-venta">
  <section class="card vidrio-card" data-ticket>
    <h2 class="proto-titulo">Ticket</h2>
    <ul class="proto-lineas">
      {LINEAS.map((l) => (
        <li class="proto-linea" data-id={l.id} data-precio={l.precio}>
          <div class="proto-linea-cab">
            <span class="proto-nombre">{l.nombre}</span>
            <button type="button" class="proto-quitar" data-quitar aria-label="Quitar">✕</button>
          </div>
          <div class="proto-fila-linea">
            <div class="proto-stepper">
              <button type="button" data-dir="-1" aria-label="Menos">−</button>
              <b class="proto-qty" data-qty>{l.qty}</b>
              <button type="button" data-dir="1" aria-label="Más">+</button>
            </div>
            <button type="button" class="proto-precio" data-precio-boton>{formatearPesos(l.precio)}</button>
            <input type="text" inputmode="decimal" autocomplete="off" class="proto-precio-input" data-precio-input hidden />
          </div>
        </li>
      ))}
    </ul>

    <div class="proto-alta">
      <h2 class="proto-titulo">Producto nuevo (alta al vuelo)</h2>
      <div class="proto-dos">
        <label class="proto-label">Costo
          <input id="vtB-costo" type="text" inputmode="decimal" autocomplete="off" placeholder="0" />
        </label>
        <label class="proto-label">Recargo %
          <input id="vtB-markup" type="number" min="0.01" max="1000" step="0.5" inputmode="decimal" value={MARKUP_DEFECTO} />
        </label>
      </div>
      <div class="proto-sugerido" aria-live="polite"><span>Precio de venta</span><b data-alta-precio>—</b></div>
      <button type="button" class="proto-btn proto-btn--neutro">Agregar producto</button>
    </div>

    <div class="proto-total-bar">
      <p class="proto-total">Total: <b data-total></b></p>
      <button type="button" class="proto-btn proto-btn--primario" data-ir-cobro>Cobrar</button>
    </div>
  </section>

  <section class="card vidrio-card" data-cobro hidden>
    <button type="button" class="proto-volver" data-volver>← Volver al ticket</button>
    <h2 class="proto-titulo">Cobrar</h2>
    <div class="proto-descuento">
      <h3 class="proto-sub">Descuento del ticket</h3>
      <div class="proto-chips">
        {DESCUENTOS.map((d) => <button type="button" class:list={["proto-chip", { activo: d === 0 }]} data-dcto={d}>{d === 0 ? "Sin desc." : `-${d}%`}</button>)}
      </div>
      <label class="proto-label">Descuento a mano (%)
        <input id="vtB-dcto-manual" type="number" min="0" max="90" step="1" value="0" />
      </label>
    </div>
    <label class="proto-label">Medio de pago
      <select id="vtB-medio"><option>Efectivo</option><option>Débito</option><option>Mercado Pago</option><option>QR</option><option>Transferencia</option></select>
    </label>
    <p class="proto-total">Total a cobrar: <b data-cobro-total></b></p>
    <button type="button" class="proto-btn proto-btn--primario">Confirmar cobro</button>
  </section>
</div>

<style>
  .proto-lineas { list-style: none; margin: 0; padding: 0; }
  .proto-linea { padding: 12px 0; border-bottom: 1px solid var(--tema-linea); }
  .proto-linea-cab { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .proto-nombre { font-size: 17px; font-weight: 700; overflow-wrap: anywhere; }
  .proto-quitar { width: 48px; height: 48px; min-width: 48px; min-height: 48px; font-size: 20px; border-radius: 12px; margin: 0; }
  .proto-fila-linea { display: flex; align-items: center; gap: 10px; }
  .proto-qty { min-width: 28px; text-align: center; font-size: 20px; font-variant-numeric: tabular-nums; }
  .proto-precio { flex: 1 1 auto; min-height: 48px; border: 1px solid var(--tema-linea) !important; background: var(--tema-superficie) !important; color: var(--tema-texto) !important; border-radius: 12px !important; font-size: 18px; font-weight: 800; font-variant-numeric: tabular-nums; text-align: right; padding: 0 14px; }
  .proto-precio-input { flex: 1 1 auto; min-height: 48px; font-size: 18px; font-weight: 800; text-align: right; }
  .proto-alta { margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--tema-linea); }
  .proto-label { display: grid; gap: 6px; }
  .proto-dos { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 8px 0; }
  .proto-total-bar { margin-top: 12px; display: grid; gap: 10px; }
  .proto-volver { background: transparent !important; color: var(--tema-texto) !important; text-align: left; font-size: 15px; margin: 0 0 8px; }
  .proto-sub { margin: 0 0 8px; font-size: 15px; }
  .proto-descuento { margin-bottom: 12px; }
</style>

<script>
  import { precioDesdeCosto, formatearPesos, parsearPesos, pesosParaInput } from "../calculo-precios.js";
  const lineas = Array.from(document.querySelectorAll<HTMLElement>(".proto-linea"));
  const totalEl = document.querySelector<HTMLElement>("[data-total]")!;
  const cobroTotalEl = document.querySelector<HTMLElement>("[data-cobro-total]")!;
  const ticket = document.querySelector<HTMLElement>("[data-ticket]")!;
  const cobro = document.querySelector<HTMLElement>("[data-cobro]")!;
  const dctoManual = document.getElementById("vtB-dcto-manual") as HTMLInputElement;
  let descuento = 0;

  const precioDeLinea = (li: HTMLElement) => {
    const input = li.querySelector<HTMLInputElement>("[data-precio-input]")!;
    if (!input.hidden) return parsearPesos(input.value) ?? Number(li.dataset.precio);
    return Number(li.dataset.precio);
  };
  const subtotal = () => {
    let s = 0;
    lineas.forEach((li) => {
      const qty = Number(li.querySelector<HTMLElement>("[data-qty]")!.textContent) || 1;
      s += precioDeLinea(li) * qty;
    });
    return s;
  };
  const repintar = () => {
    const sub = subtotal();
    totalEl.textContent = formatearPesos(sub);
    cobroTotalEl.textContent = formatearPesos(Math.round(sub * (1 - descuento / 100)));
  };
  lineas.forEach((li) => {
    li.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((b) => {
      b.addEventListener("click", () => {
        const qtyEl = li.querySelector<HTMLElement>("[data-qty]")!;
        qtyEl.textContent = String(Math.max(1, (Number(qtyEl.textContent) || 1) + Number(b.dataset.dir)));
        repintar();
      });
    });
    li.querySelector<HTMLButtonElement>("[data-quitar]")?.addEventListener("click", () => {
      li.remove();
      repintar();
    });
    const boton = li.querySelector<HTMLButtonElement>("[data-precio-boton]")!;
    const input = li.querySelector<HTMLInputElement>("[data-precio-input]")!;
    boton.addEventListener("click", () => {
      input.value = pesosParaInput(precioDeLinea(li));
      input.hidden = false; boton.hidden = true; input.focus();
    });
    input.addEventListener("blur", () => {
      const p = parsearPesos(input.value);
      if (p !== null) li.dataset.precio = String(p);
      boton.textContent = formatearPesos(Number(li.dataset.precio));
      input.hidden = true; boton.hidden = false; repintar();
    });
  });
  document.querySelector<HTMLElement>("[data-ir-cobro]")?.addEventListener("click", () => { ticket.hidden = true; cobro.hidden = false; repintar(); });
  document.querySelector<HTMLElement>("[data-volver]")?.addEventListener("click", () => { cobro.hidden = true; ticket.hidden = false; });
  cobro.querySelectorAll<HTMLButtonElement>("[data-dcto]").forEach((b) => {
    b.addEventListener("click", () => {
      descuento = Number(b.dataset.dcto);
      dctoManual.value = String(descuento);
      cobro.querySelectorAll<HTMLButtonElement>("[data-dcto]").forEach((x) => x.classList.toggle("activo", x === b));
      repintar();
    });
  });
  dctoManual.addEventListener("input", () => {
    descuento = Math.max(0, Math.min(90, Number(dctoManual.value) || 0));
    cobro.querySelectorAll<HTMLButtonElement>("[data-dcto]").forEach((x) => x.classList.toggle("activo", Number(x.dataset.dcto) === descuento));
    repintar();
  });

  const costo = document.getElementById("vtB-costo") as HTMLInputElement;
  const markup = document.getElementById("vtB-markup") as HTMLInputElement;
  const altaPrecio = document.querySelector<HTMLElement>("[data-alta-precio]")!;
  const repintarAlta = () => {
    const c = parsearPesos(costo.value) ?? 0;
    const m = Number(markup.value) || 0;
    altaPrecio.textContent = c > 0 ? formatearPesos(precioDesdeCosto(c, m, 1000)) : "—";
  };
  costo.addEventListener("input", repintarAlta);
  markup.addEventListener("input", repintarAlta);
  repintar();
</script>
