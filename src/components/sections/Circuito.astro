---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { circuito } from '../../data/business';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;

const SHORT = ['Depósito', 'Mostrador', 'Venta', 'Cobro', 'Cierre'] as const;
---

<Section variant="linen" id="circuito" embedded={embedded}>
  <SectionHeading title={circuito.title} lead={circuito.lead} />
  <ol class="grid gap-4 md:grid-cols-5">
    {
      circuito.steps.map((step, i) => (
        <li class="galaxy-card rounded-[var(--radius-card)] p-5">
          <p class="text-sm font-medium text-ash-gray">
            Paso {i + 1} · {SHORT[i] ?? `Paso ${i + 1}`}
          </p>
          <p class="mt-2">{step}</p>
        </li>
      ))
    }
  </ol>
</Section>
