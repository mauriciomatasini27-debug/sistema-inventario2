---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { contact, contactConfigured, brand, footer, whatsappWithUtm, type LandingBeat } from '../../data/business';

interface Props {
  beat: Extract<LandingBeat, { tipo: "contacto" }>;
}

const { beat } = Astro.props;

const formId = import.meta.env.PUBLIC_FORMSPREE_FORM_ID?.trim();
const newsletterFormId = import.meta.env.PUBLIC_NEWSLETTER_FORM_ID?.trim() || formId;
const formConfigured = Boolean(formId && formId !== 'tu_form_id_aqui');
const newsletterConfigured = Boolean(newsletterFormId && newsletterFormId !== 'tu_form_id_aqui');

const formAction = formConfigured ? `https://formspree.io/f/${formId}` : undefined;
const newsletterAction = newsletterConfigured ? `https://formspree.io/f/${newsletterFormId}` : undefined;

const siteBase = (
  import.meta.env.PUBLIC_SITE_URL ||
  Astro.site?.href ||
  Astro.url.origin
).replace(/\/$/, '');
const redirectUrl = `${siteBase}/?enviado=1#contacto`;
const newsletterRedirectUrl = `${siteBase}/?newsletter=1#contacto`;
const sent = Astro.url.searchParams.get('enviado') === '1';
const newsletterSent = Astro.url.searchParams.get('newsletter') === '1';

const inputClass =
  'w-full rounded-[var(--radius-card)] border border-nebula-cyan/35 bg-space-mist px-4 py-3 text-void placeholder:text-ash-gray';
---

<Section variant={beat.variant} id={beat.id}>
  <SectionHeading title={beat.nav} lead={footer.contactLead} invert={beat.variant === "dark"} />

  {
    sent && (
      <p
        class="mb-8 rounded-[var(--radius-card)] border border-nebula-cyan/30 bg-galaxy-blue/20 px-4 py-3 text-canvas-white"
        role="status"
      >
        Gracias — recibimos tu mensaje. Te respondemos a la brevedad.
      </p>
    )
  }
  {
    newsletterSent && (
      <p
        class="mb-8 rounded-[var(--radius-card)] border border-nebula-cyan/30 bg-galaxy-blue/20 px-4 py-3 text-canvas-white"
        role="status"
      >
        ¡Listo! Te sumamos a la newsletter.
      </p>
    )
  }

  <footer>
    <div class="grid gap-8 md:grid-cols-2 md:gap-10">
      <div class="galaxy-card rounded-[var(--radius-card)] bg-star-white p-6 text-void md:p-8">
        <h3 class="landing-card-title">Escribinos</h3>
        <p class="mt-2 text-sm text-ash-gray">Contanos tu rubro y qué necesitás para tu mostrador.</p>
        {
          formConfigured ? (
            <form action={formAction} method="POST" class="mt-6 grid gap-3" data-contact-form>
              <input type="hidden" name="_subject" value={`Consulta web — ${brand.name}`} />
              <input type="hidden" name="_next" value={redirectUrl} />
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
              <input type="text" name="name" required placeholder="Nombre" autocomplete="name" class={inputClass} />
              <input type="email" name="email" required placeholder="Email" autocomplete="email" class={inputClass} />
              <textarea name="message" rows="4" required placeholder="Mensaje" class={inputClass}></textarea>
              <button
                type="submit"
                data-submit
                class="sg-flame-cta rounded-[var(--radius-button)] px-5 py-3 text-sm disabled:opacity-60"
              >
                Enviar consulta
              </button>
              <p data-form-error hidden class="text-sm text-ash-gray" role="alert">
                No se pudo enviar. Revisá tu conexión e intentá de nuevo — tus campos se conservan.
              </p>
            </form>
          ) : (
            <p class="mt-6 text-sm text-ash-gray">
              {
                contactConfigured ? (
                  <>
                    Formulario en configuración. Usá WhatsApp o{' '}
                    <a href={`mailto:${contact.email}`} class="text-trust underline">
                      {contact.email}
                    </a>{' '}
                    mientras tanto.
                  </>
                ) : (
                  <>Formulario y contacto en configuración — volvé pronto.</>
                )
              }
            </p>
          )}

        <div class="mt-8 border-t border-nebula-cyan/15 pt-6">
          <p class="text-sm font-medium">WhatsApp y email</p>
          {
            contactConfigured ? (
              <>
                <div class="mt-4 flex flex-wrap gap-3">
                  <a
                    href={whatsappWithUtm('contacto')}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-cta="contacto-whatsapp"
                    class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] bg-whatsapp px-5 py-3 text-sm font-medium text-void transition-colors hover:opacity-90"
                  >
                    WhatsApp {contact.whatsappLabel}
                  </a>
                </div>
                <p class="mt-4 text-sm text-ash-gray">
                  <a href={`mailto:${contact.email}`} class="underline hover:text-nebula-cyan">{contact.email}</a>
                </p>
              </>
            ) : (
              <p class="mt-4 text-sm text-ash-gray">
                WhatsApp y email en configuración — volvé pronto.
              </p>
            )
          }
        </div>
      </div>

      <div class="galaxy-card rounded-[var(--radius-card)] bg-star-white p-6 text-void md:p-8">
        <h3 class="landing-card-title">Newsletter</h3>
        <p class="mt-2 text-sm text-ash-gray">{footer.newsletterLead}</p>
        {
          newsletterConfigured ? (
            <form action={newsletterAction} method="POST" class="mt-6 grid gap-3" data-contact-form>
              <input type="hidden" name="_subject" value={`Newsletter — ${brand.name}`} />
              <input type="hidden" name="_next" value={newsletterRedirectUrl} />
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
              <label class="sr-only" for="newsletter-email">Email</label>
              <input
                id="newsletter-email"
                type="email"
                name="email"
                required
                placeholder="tu@email.com"
                autocomplete="email"
                class={inputClass}
              />
              <button
                type="submit"
                data-submit
                class="sg-flame-cta rounded-[var(--radius-button)] px-5 py-3 text-sm disabled:opacity-60"
              >
                Suscribirme
              </button>
              <p data-form-error hidden class="text-sm text-ash-gray" role="alert">
                No se pudo enviar. Revisá tu conexión e intentá de nuevo.
              </p>
            </form>
          ) : (
            <p class="mt-6 text-sm text-ash-gray">
              {
                contactConfigured ? (
                  <>
                    Escribinos a{' '}
                    <a href={`mailto:${contact.email}?subject=Newsletter`} class="text-trust underline">
                      {contact.email}
                    </a>{' '}
                    con asunto «Newsletter».
                  </>
                ) : (
                  <>Newsletter en configuración — volvé pronto.</>
                )
              }
            </p>
          )
        }

        <div class="mt-8 border-t border-nebula-cyan/15 pt-6">
          <p class="text-sm font-medium">{brand.name}</p>
          <p class="mt-2 text-sm text-ash-gray">{brand.tagline}</p>
        </div>
      </div>
    </div>

    <p class="mt-12 border-t border-nebula-cyan/15 pt-8 text-center text-xs text-canvas-white">
      {footer.copyright}
    </p>
  </footer>
</Section>

<script>
  import { whatsappWithUtm } from '../../data/business';
  const contactoWa = document.querySelector('[data-cta="contacto-whatsapp"]');
  if (contactoWa instanceof HTMLAnchorElement) contactoWa.href = whatsappWithUtm('contacto');
</script>

<script>
  // E13-R5: envío vía fetch para que el error sea visible (antes nunca se mostraba).
  for (const form of document.querySelectorAll('[data-contact-form]')) {
    if (!(form instanceof HTMLFormElement)) continue;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('[data-submit]');
      const err = form.querySelector('[data-form-error]');
      const origLabel = btn?.textContent;
      if (err) err.setAttribute('hidden', '');
      if (btn) {
        btn.setAttribute('disabled', '');
        btn.textContent = 'Enviando…';
      }
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(`formspree ${res.status}`);
        const next = form.querySelector('input[name="_next"]');
        window.location.href =
          next instanceof HTMLInputElement && next.value ? next.value : window.location.href;
      } catch {
        if (err) err.removeAttribute('hidden');
        if (btn) {
          btn.removeAttribute('disabled');
          btn.textContent = 'Reintentar';
          if (origLabel) btn.setAttribute('data-submit-label', origLabel);
        }
      }
    });
  }
</script>
