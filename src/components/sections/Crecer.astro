---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { crecer } from '../../data/business';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

<Section variant="white" id="crecer" embedded={embedded}>
  <SectionHeading title={crecer.title} lead={crecer.lead} />
  <p class="galaxy-card max-w-3xl rounded-[var(--radius-card)] p-5 text-[length:var(--text-body-lg)]">
    {crecer.detail}
  </p>
</Section>
