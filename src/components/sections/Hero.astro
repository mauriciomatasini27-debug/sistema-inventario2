---
import Button from '../ui/Button.astro';
import type { LandingBeat } from '../../data/business';

interface Props {
  beat: Extract<LandingBeat, { tipo: "hero" }>;
}

const { beat } = Astro.props;
---

<section id={beat.id} class="relative flex min-h-[min(88vh,52rem)] items-center overflow-hidden text-void">
  <div
    class="relative z-10 mx-auto w-full max-w-[var(--width-content)] px-6 py-[calc(var(--spacing-section)*1.4)] md:px-10"
  >
    <p class="text-[length:var(--text-body)] font-medium text-trust">{beat.firma}</p>
    <h1
      class="mt-4 max-w-3xl text-[length:var(--text-display)] font-semibold leading-tight tracking-tight text-void"
    >
      {beat.titulo}
    </h1>
    <p class="mt-6 max-w-2xl text-[length:var(--text-body-lg)] text-void">
      {beat.subtitulo}
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      {
        beat.ctas.map((cta, i) => (
          <Button href={cta.href} variant={i === 0 ? "primary" : "ghost-light"}>
            {cta.label}
          </Button>
        ))
      }
    </div>
  </div>
</section>
