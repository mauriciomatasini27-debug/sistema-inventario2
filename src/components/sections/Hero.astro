---
import Button from '../ui/Button.astro';
import { accesos, contact, contactConfigured, hero, whatsappWithUtm } from '../../data/business';
---

<section id="inicio" class="relative flex min-h-[min(88vh,52rem)] items-center overflow-hidden text-void">
  <div
    class="relative z-10 mx-auto w-full max-w-[var(--width-content)] px-6 py-[calc(var(--spacing-section)*1.4)] md:px-10"
  >
    <p class="text-sm font-medium text-ash-gray">{hero.firma}</p>
    <h1
      class="mt-4 max-w-3xl text-[length:var(--text-display)] font-semibold leading-tight tracking-tight text-void"
    >
      {hero.titulo}
    </h1>
    <p class="mt-6 max-w-2xl text-[length:var(--text-body-lg)] text-void">
      {hero.subtitulo}
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="#contacto" variant="primary">Pedir demo</Button>
      <Button href="#checklist" variant="ghost-light">Ver checklist</Button>
      {
        contactConfigured && (
          <>
            <Button href={whatsappWithUtm('hero')} variant="ghost-light" data-cta="hero-whatsapp">
              WhatsApp
            </Button>
            <Button href={`mailto:${contact.email}`} variant="ghost-light">Email</Button>
          </>
        )
      }
    </div>
    <div class="mt-4 flex flex-wrap gap-4">
      <Button href={accesos.comercio.href} variant="ghost-light">{accesos.comercio.label}</Button>
      <Button href={accesos.admin.href} variant="ghost-light">{accesos.admin.label}</Button>
    </div>
  </div>
</section>

<script>
  import { whatsappWithUtm } from '../../data/business';
  const heroWa = document.querySelector('[data-cta="hero-whatsapp"]');
  if (heroWa instanceof HTMLAnchorElement) heroWa.href = whatsappWithUtm('hero');
</script>
