---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { migracion } from '../../data/business';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

<Section variant="linen" id="migracion" embedded={embedded}>
  <SectionHeading title={migracion.title} lead={migracion.lead} />
  <p class="galaxy-card max-w-3xl rounded-[var(--radius-card)] p-5 text-[length:var(--text-body-lg)]">
    {migracion.detail}
  </p>
</Section>
