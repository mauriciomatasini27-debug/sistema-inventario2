---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { checklist } from '../../data/business';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

<Section variant="linen" id="checklist" embedded={embedded}>
  <SectionHeading title={checklist.title} lead={checklist.lead} />
  <ul class="grid max-w-3xl gap-3">
    {
      checklist.items.map((item) => (
        <li>
          <label class="galaxy-card flex cursor-pointer items-start gap-3 rounded-[var(--radius-card)] p-5">
            <input type="checkbox" class="mt-1 h-5 w-5 shrink-0" />
            <span class="text-[length:var(--text-body-lg)]">{item}</span>
          </label>
        </li>
      ))
    }
  </ul>
  <p class="mt-6 max-w-2xl text-ash-gray">{checklist.closing}</p>
  <div class="mt-6">
    <Button href="#contacto" variant="primary">{checklist.cta}</Button>
  </div>
</Section>
