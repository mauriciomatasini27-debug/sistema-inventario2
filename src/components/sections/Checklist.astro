---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import type { LandingBeat } from '../../data/business';

interface Props {
  beat: Extract<LandingBeat, { tipo: "checklist" }>;
}

const { beat } = Astro.props;
---

<Section variant={beat.variant} id={beat.id}>
  <SectionHeading title={beat.title} lead={beat.lead} />
  <ul class="grid max-w-3xl gap-3">
    {
      beat.items.map((item) => (
        <li>
          <label class="galaxy-card flex cursor-pointer items-start gap-3 rounded-[var(--radius-card)] p-5">
            <input type="checkbox" class="mt-1 h-5 w-5 shrink-0" />
            <span class="text-[length:var(--text-body-lg)]">{item}</span>
          </label>
        </li>
      ))
    }
  </ul>
  <p class="mt-6 max-w-2xl text-ash-gray">{beat.closing}</p>
  <div class="mt-6">
    <Button href="#contacto" variant="primary">{beat.cta}</Button>
  </div>
</Section>
