---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { LandingBeat } from '../../data/business';

interface Props {
  beat: Extract<LandingBeat, { tipo: "publico" }>;
}

const { beat } = Astro.props;
---

<Section variant={beat.variant} id={beat.id}>
  <SectionHeading title={beat.title} lead={beat.lead} />
  <div class="grid max-w-3xl gap-8 md:grid-cols-2">
    <div>
      <h3 class="text-[length:var(--text-subheading)] font-medium">{beat.yesTitle}</h3>
      <ul class="mt-4 grid gap-2 text-[length:var(--text-body-lg)]">
        {beat.yes.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div>
      <h3 class="text-[length:var(--text-subheading)] font-medium">{beat.noTitle}</h3>
      <ul class="mt-4 grid gap-2 text-[length:var(--text-body-lg)] text-ash-gray">
        {beat.no.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</Section>
