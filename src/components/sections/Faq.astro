---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { LandingBeat } from '../../data/business';

interface Props {
  beat: Extract<LandingBeat, { tipo: "faq" }>;
}

const { beat } = Astro.props;
---

<Section variant={beat.variant} id={beat.id}>
  <SectionHeading title={beat.title} lead={beat.lead} />
  <div class="grid max-w-3xl gap-4">
    {
      beat.items.map((item) => (
        <details class="galaxy-card rounded-[var(--radius-card)] p-5">
          <summary class="cursor-pointer font-medium">{item.q}</summary>
          <p class="mt-2 text-sm text-ash-gray">{item.a}</p>
        </details>
      ))
    }
  </div>
</Section>
