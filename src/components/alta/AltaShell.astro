---
// TB-ALTA: chrome tablero B para onboarding (sin nav de panel).
import "../../styles/tokens-papel.css";
import "../../styles/navegacion.css";
import "../../styles/tema.css";
import TemaInicial from "../ui/TemaInicial.astro";
import TemaToggle from "../ui/TemaToggle.astro";
import { ANTENA_MODO, CUERPO_MODO } from "../../lib/modo.js";

interface Props {
  tituloPagina: string;
}

const { tituloPagina } = Astro.props;
const modoVars = [
  `--modo-antena-calmado:${ANTENA_MODO.calmado}`,
  `--modo-cuerpo-a:${CUERPO_MODO[0]}`,
  `--modo-cuerpo-b:${CUERPO_MODO[1]}`,
  `--modo-cuerpo-c:${CUERPO_MODO[2]}`,
].join(";");
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{tituloPagina}</title>
    <TemaInicial />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--font-sans);
        background: var(--tema-fondo);
        color: var(--tema-texto);
        padding-left: env(safe-area-inset-left, 0px);
        padding-right: env(safe-area-inset-right, 0px);
      }
      .alta-shell.tablero { min-height: 100dvh; }
      .alta-barra {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        padding: 8px 12px;
        padding-top: calc(8px + env(safe-area-inset-top, 0px));
        border-bottom: 1px solid var(--tema-linea);
        background: var(--tema-barra, var(--tema-fondo));
      }
      .alta-marca {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
        color: var(--tema-texto);
        text-decoration: none;
        font-weight: 600;
        font-size: 15px;
      }
      .alta-modo-mini { display: inline-flex; line-height: 0; }
      .alta-contenido {
        max-width: 360px;
        margin: 0 auto;
        padding: 12px 16px 32px;
      }
      @media (min-width: 900px) {
        .alta-contenido { max-width: 480px; padding-top: 20px; }
      }
      .alta-shell h1 {
        margin: 12px 0 8px;
        font-size: clamp(22px, 5vw, 32px);
        font-weight: 600;
        line-height: 1.2;
      }
      .alta-shell .sub,
      .alta-shell .hint {
        margin: 0 0 12px;
        font-size: 14px;
        color: var(--tema-texto-suave);
        line-height: 1.45;
      }
      .alta-shell .card {
        min-width: 0;
        padding: 16px;
        margin: 8px 0;
        border: 1px solid var(--tema-linea);
        border-radius: 16px;
        background: var(--tema-superficie);
      }
      @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .alta-shell .card {
          background: var(--tema-vidrio);
          -webkit-backdrop-filter: blur(16px);
          backdrop-filter: blur(16px);
        }
      }
      @media (prefers-reduced-transparency: reduce) {
        .alta-shell .card {
          background: var(--tema-superficie);
          -webkit-backdrop-filter: none;
          backdrop-filter: none;
        }
      }
      .alta-shell form { display: grid; gap: 8px; margin: 0; }
      .alta-shell label {
        display: grid;
        gap: 4px;
        min-width: 0;
        font-size: 13px;
        color: var(--tema-texto-suave);
      }
      .alta-shell input,
      .alta-shell select,
      .alta-shell textarea {
        min-height: 44px;
        width: 100%;
        font-family: inherit;
        font-size: 16px;
        border-radius: 8px;
        padding: 8px 10px;
        border: 1px solid var(--tema-linea);
        background: var(--tema-superficie);
        color: var(--tema-texto);
      }
      .alta-shell .check {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        font-size: 14px;
        color: var(--tema-texto);
      }
      .alta-shell .check input {
        width: auto;
        min-height: 24px;
        margin-top: 2px;
      }
      .alta-shell button:not(.tema-toggle) {
        min-height: 44px;
        width: 100%;
        font-family: inherit;
        font-size: 16px;
        border: 0;
        border-radius: 999px;
        padding: 8px 16px;
        background: var(--color-star-glow);
        color: var(--color-star-white);
        font-weight: 600;
        cursor: pointer;
        margin: 6px 0 0;
      }
      .alta-shell button:not(.tema-toggle):disabled { opacity: 0.6; cursor: progress; }
      .alta-shell button:not(.tema-toggle):hover { filter: brightness(0.92); }
      .alta-shell a.btn {
        min-height: 44px;
        display: block;
        text-align: center;
        line-height: 44px;
        font-size: 16px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        margin: 6px 0;
        box-sizing: border-box;
      }
      .alta-shell a.btn--primario {
        background: var(--color-star-glow);
        color: var(--color-star-white);
      }
      .alta-shell a.btn--wa {
        background: var(--color-whatsapp);
        color: var(--color-void);
      }
      .alta-shell a.btn--ghost {
        background: var(--tema-superficie);
        color: var(--tema-texto);
        border: 1px solid var(--tema-linea);
        line-height: 42px;
      }
      .alta-shell button.btn-secundario {
        background: var(--tema-superficie);
        color: var(--tema-texto);
        border: 1px solid var(--tema-linea);
        font-weight: 500;
      }
      .alta-shell #error,
      .alta-shell [role="alert"] {
        color: var(--estado-peligro);
        font-size: 14px;
        white-space: pre-wrap;
      }
      .alta-shell .ok { color: var(--estado-ok); font-weight: 700; }
      .alta-shell .error-campo {
        margin: 4px 0 0;
        color: var(--estado-peligro);
        font-size: 12px;
        font-weight: 600;
      }
      .alta-shell .error-campo::before { content: "⚠ "; }
      .alta-shell input[aria-invalid="true"],
      .alta-shell select[aria-invalid="true"] {
        border-color: var(--estado-peligro);
      }
      .alta-shell ul { padding-left: 20px; font-size: 14px; margin: 0; }
      .alta-shell a:not(.btn):not(.alta-marca) { color: var(--tema-acento); }
      :root[data-tema="oscuro"] .tablero.alta-shell {
        background: var(--color-void);
        color: var(--color-star-white);
        --tema-fondo: var(--color-void);
        --tema-superficie: var(--color-charcoal);
        --tema-linea: var(--color-mid);
        --tema-texto: var(--color-star-white);
        --tema-texto-suave: var(--color-muted-dark);
        --tema-acento: var(--color-pendiente-oscuro);
        --tema-barra: var(--color-void);
        --tema-vidrio: var(--color-charcoal);
      }
      :root[data-tema="oscuro"] .tablero.alta-shell .card {
        background: var(--color-charcoal);
        border-color: var(--color-mid);
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
      }
      :root[data-tema="oscuro"] .tablero.alta-shell input,
      :root[data-tema="oscuro"] .tablero.alta-shell select {
        background: var(--color-charcoal);
        border-color: var(--color-mid);
        color: var(--color-star-white);
      }
      :root[data-tema="oscuro"] .tablero.alta-shell button.btn-secundario,
      :root[data-tema="oscuro"] .tablero.alta-shell a.btn--ghost {
        background: var(--color-charcoal);
        border-color: var(--color-mid);
        color: var(--color-star-white);
      }
      :root[data-tema="oscuro"] .tablero.alta-shell button:not(.tema-toggle):hover {
        background: var(--color-mid);
        filter: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .alta-shell, .alta-shell * {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="alta-shell tablero">
      <header class="alta-barra">
        <span class="alta-marca">
          <span class="alta-modo-mini" style={modoVars} aria-hidden="true">
            <svg viewBox="0 0 36 36" width="28" height="28" aria-hidden="true">
              <linearGradient id="llama-alta-mini" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="var(--modo-cuerpo-a)"></stop>
                <stop offset="45%" stop-color="var(--modo-cuerpo-b)"></stop>
                <stop offset="100%" stop-color="var(--modo-cuerpo-c)"></stop>
              </linearGradient>
              <circle cx="18" cy="3" r="2.1" fill="var(--modo-antena-calmado)"></circle>
              <rect x="6" y="8" width="24" height="22" rx="8" fill="url(#llama-alta-mini)"></rect>
              <rect x="9" y="13" width="18" height="8" rx="3" fill="var(--color-void)"></rect>
              <circle cx="14" cy="17" r="2.15" fill="var(--color-llama)"></circle>
              <circle cx="22" cy="17" r="2.15" fill="var(--color-llama)"></circle>
            </svg>
          </span>
          Modo
        </span>
        <TemaToggle />
      </header>
      <div class="alta-contenido">
        <main>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>