---
// P1-34: el POST /api/auth/logout existía sin UI; AU13/AU8.7 piden salir a mano.
interface Props {
  variante?: "barra" | "menu";
}
const { variante = "barra" } = Astro.props;
---
<button
  type="button"
  class:list={["cerrar-sesion", { "cerrar-sesion--menu": variante === "menu" }]}
  data-cerrar-sesion
>
  {variante === "menu" ? (
    <span class="panel-cuenta-etiq">
      <b>Cerrar sesión</b>
      <small>Salís del panel y volvés al inicio</small>
    </span>
  ) : (
    "Cerrar sesión"
  )}
</button>
<style>
  .cerrar-sesion {
    min-height: 44px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--tema-linea, #ccc);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .cerrar-sesion:disabled {
    opacity: 0.55;
    cursor: wait;
  }
</style>
<script>
  document.querySelectorAll("[data-cerrar-sesion]").forEach((nodo) => {
    nodo.addEventListener("click", async () => {
      const btn = nodo;
      if (btn instanceof HTMLButtonElement) btn.disabled = true;
      try {
        await fetch("/api/auth/logout", { method: "POST", credentials: "same-origin" });
      } catch (err) {
        console.warn("P1-34 logout falló", err);
      }
      location.href = "/";
    });
  });
</script>
