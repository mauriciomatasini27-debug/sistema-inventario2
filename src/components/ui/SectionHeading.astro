---
interface Props {
  title?: string;
  lead?: string;
  invert?: boolean;
  size?: "seccion" | "nota";
}

const { title, lead, invert = false, size = "seccion" } = Astro.props;
---

<header class="mb-10 max-w-3xl">
  {
    title && (
      <h2
        class:list={[
          size === "nota" ? "landing-card-title" : "landing-section-title",
          invert ? "text-canvas-white" : "text-core-cream",
        ]}
      >
        {title}
      </h2>
    )
  }
  {
    lead && (
      <p
        class:list={[
          "landing-lead",
          invert ? "text-canvas-white/80" : "text-ash-gray",
          title && "mt-4",
        ]}
      >
        {lead}
      </p>
    )
  }
</header>
