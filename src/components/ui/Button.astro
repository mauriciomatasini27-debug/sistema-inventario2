---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost-dark' | 'ghost-light';
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const { href, variant = 'primary', class: className, ...rest } = Astro.props;

const base =
  'inline-flex items-center justify-center rounded-[var(--radius-button)] px-6 py-4 text-base';

const variants = {
  primary: 'sg-flame-cta',
  'ghost-dark':
    'border border-canvas-white/50 text-canvas-white bg-transparent font-medium transition-colors hover:opacity-90 hover:border-canvas-white',
  'ghost-light':
    'border border-ash-gray/60 text-void bg-transparent font-medium transition-colors hover:opacity-90 hover:border-void',
};
---

<a href={href} class:list={[base, variants[variant], className]} {...rest}>
  <slot />
</a>
