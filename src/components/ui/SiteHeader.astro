---
import { nav, brand, accesos, ctaPrueba } from '../../data/business';
---

<header
  class="sticky top-0 z-20 border-b border-linen bg-canvas-white/95"
>
  <div
    class="mx-auto grid max-w-[var(--width-content)] grid-cols-[auto_1fr] items-center gap-x-3 gap-y-2 px-4 py-3 md:flex md:flex-wrap md:justify-between md:gap-4 md:px-10 md:py-4"
  >
    <a href="/" class="text-sm font-semibold tracking-wide text-void">{brand.name}</a>
    <nav aria-label="Secciones" class="order-last col-span-2 flex flex-wrap gap-x-5 gap-y-2 text-sm md:order-none">
      {
        nav.map((item) => (
          <a href={item.href} class="text-ash-gray transition-colors hover:text-trust">
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex flex-wrap items-center justify-end gap-3">
      <a
        href={accesos.comercio.href}
        data-astro-prefetch="false"
        class="rounded-[var(--radius-button)] border border-trust/40 px-4 py-2 text-sm font-medium text-void transition-colors hover:border-trust"
      >
        {accesos.comercio.label}
      </a>
      <a
        href={ctaPrueba.href}
        class="sg-flame-cta rounded-[var(--radius-button)] px-4 py-2 text-sm"
      >
        {ctaPrueba.label}
      </a>
      <a
        href={accesos.admin.href}
        data-astro-prefetch="false"
        class="hidden text-xs text-ash-gray transition-colors hover:text-trust md:inline"
      >
        {accesos.admin.label}
      </a>
    </div>
  </div>
</header>
