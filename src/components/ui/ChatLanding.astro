---
import { beatPorId, contact, whatsappWithUtm } from '../../data/business';
import { AVISO_LEY_25326 } from '../../modules/landing/chat';

const sugerencias = beatPorId("faq").items.slice(0, 3);
const waDirecto = whatsappWithUtm('chat');
---

<div class="chat-landing" data-chat-landing>
  <div class="chat-invitacion" data-chat-invitacion hidden aria-live="polite">
    <p class="chat-invitacion-texto" data-chat-invitacion-texto></p>
    <div class="chat-invitacion-acciones" data-chat-invitacion-acciones></div>
    <button type="button" class="chat-invitacion-cerrar" data-chat-invitacion-cerrar aria-label="Cerrar sugerencia">
      ×
    </button>
  </div>

  <button
    type="button"
    class="chat-burbuja chat-burbuja--modo"
    data-chat-abrir
    aria-expanded="false"
    aria-controls="chat-panel"
    aria-label="Abrir chat con Modo"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="chat-icono" viewBox="0 0 36 36" aria-hidden="true">
      <defs>
        <linearGradient id="llama-modo-chat" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="var(--color-llama)"></stop>
          <stop offset="45%" stop-color="var(--color-naranja)"></stop>
          <stop offset="100%" stop-color="var(--color-star-warm)"></stop>
        </linearGradient>
      </defs>
      <line x1="18" y1="8" x2="18" y2="4.2" stroke="var(--color-void)" stroke-width="1.4"></line>
      <circle cx="18" cy="3" r="2.1" fill="var(--color-llama)"></circle>
      <rect x="6" y="8" width="24" height="22" rx="8" fill="url(#llama-modo-chat)"></rect>
      <rect x="9" y="13" width="18" height="8" rx="3" fill="var(--color-void)"></rect>
      <g class="chat-modo-ojos">
        <circle cx="14" cy="17" r="2.15" fill="var(--color-llama)"></circle>
        <circle cx="22" cy="17" r="2.15" fill="var(--color-llama)"></circle>
        <circle cx="14.7" cy="16.3" r="0.65" fill="var(--color-star-white)"></circle>
        <circle cx="22.7" cy="16.3" r="0.65" fill="var(--color-star-white)"></circle>
      </g>
    </svg>
  </button>

  <section
    id="chat-panel"
    class="chat-panel"
    data-chat-panel
    hidden
    role="dialog"
    aria-label="Chat de ayuda"
  >
    <header class="chat-cabecera">
      <span class="chat-saludo">Hola, soy Modo. ¿En qué te ayudo?</span>
      <button type="button" data-chat-cerrar aria-label="Cerrar chat" class="chat-cerrar">×</button>
    </header>

    <div class="chat-wa-bloque">
      <a
        href={waDirecto}
        target="_blank"
        rel="noopener noreferrer"
        data-cta="chat-whatsapp"
        class="chat-wa chat-wa--cta chat-wa--panel"
      >Escribinos por WhatsApp</a>
      <span class="chat-wa-numero">{contact.whatsappLabel}</span>
    </div>

    <div class="chat-mensajes" data-chat-mensajes aria-live="polite"></div>

    <div class="chat-sugerencias" data-chat-sugerencias>
      {sugerencias.map((s) => (
        <button type="button" data-chat-sugerencia={s.q} class="chat-sugerencia">{s.q}</button>
      ))}
    </div>

    <div class="chat-derivacion" data-chat-derivacion hidden>
      <a href={waDirecto} target="_blank" rel="noopener noreferrer" data-chat-derivacion-wa class="chat-wa chat-wa--cta">
        Seguir por WhatsApp
      </a>
      <a href="#contacto" class="chat-form">O dejános tu consulta en el formulario</a>
    </div>

    <form class="chat-formulario" data-chat-form>
      <label class="chat-label" for="chat-entrada">Tu mensaje</label>
      <input id="chat-entrada" class="chat-entrada" data-chat-entrada type="text" autocomplete="off" maxlength="500" />
      <button type="submit" class="chat-enviar">Enviar</button>
    </form>

    <p class="chat-aviso">{AVISO_LEY_25326}</p>
  </section>

  <noscript>
    <a href={waDirecto} target="_blank" rel="noopener noreferrer" data-cta="chat-whatsapp-noscript" class="chat-burbuja" aria-label="WhatsApp">WhatsApp</a>
  </noscript>
</div>

<script>
  import { whatsappWithUtm } from '../../data/business';
  (function () {
    var raiz = document.querySelector('[data-chat-landing]');
    if (!(raiz instanceof HTMLElement)) return;
    var abrir = raiz.querySelector('[data-chat-abrir]');
    var panel = raiz.querySelector('[data-chat-panel]');
    var cerrar = raiz.querySelector('[data-chat-cerrar]');
    var form = raiz.querySelector('[data-chat-form]');
    var entrada = raiz.querySelector('[data-chat-entrada]');
    var mensajes = raiz.querySelector('[data-chat-mensajes]');
    var derivacion = raiz.querySelector('[data-chat-derivacion]');
    var derivacionWa = raiz.querySelector('[data-chat-derivacion-wa]');
    var invitacion = raiz.querySelector('[data-chat-invitacion]');
    var invitacionTexto = raiz.querySelector('[data-chat-invitacion-texto]');
    var invitacionAcciones = raiz.querySelector('[data-chat-invitacion-acciones]');
    var invitacionCerrar = raiz.querySelector('[data-chat-invitacion-cerrar]');
    if (!(abrir instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;
    var waHeader = raiz.querySelector('[data-cta="chat-whatsapp"]');
    if (waHeader instanceof HTMLAnchorElement) waHeader.href = whatsappWithUtm('chat');

    var waUrl = whatsappWithUtm('chat-invite');
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var inviteTimer = 0;
    var rotateTimer = 0;
    var invitePaso = 0;
    var inviteDescartada = false;

    var pasos = [
      {
        texto: '¿Dudas del sistema? Preguntame acá.',
        acciones: [{ label: 'Abrir chat', tipo: 'abrir' }],
      },
      {
        texto: 'Si preferís, seguimos por WhatsApp.',
        acciones: [
          { label: 'WhatsApp', tipo: 'wa', href: waUrl },
          { label: 'Abrir chat', tipo: 'abrir' },
        ],
      },
      {
        texto: 'También podés dejarnos un mensaje en el formulario.',
        acciones: [
          { label: 'Ir al formulario', tipo: 'hash', href: '#contacto' },
          { label: 'WhatsApp', tipo: 'wa', href: waUrl },
        ],
      },
    ];

    function limpiarTimers() {
      if (inviteTimer) window.clearTimeout(inviteTimer);
      if (rotateTimer) window.clearTimeout(rotateTimer);
      inviteTimer = 0;
      rotateTimer = 0;
    }

    function ocultarInvitacion() {
      if (!(invitacion instanceof HTMLElement)) return;
      invitacion.classList.remove('chat-invitacion--visible');
      invitacion.hidden = true;
      abrir.classList.remove('chat-burbuja--aviso');
      limpiarTimers();
    }

    function pintarPaso(paso) {
      if (!(invitacionTexto instanceof HTMLElement) || !(invitacionAcciones instanceof HTMLElement)) return;
      invitacionTexto.textContent = paso.texto;
      invitacionAcciones.replaceChildren();
      paso.acciones.forEach(function (accion) {
        var el;
        if (accion.tipo === 'abrir') {
          el = document.createElement('button');
          el.type = 'button';
          el.className = 'chat-invitacion-btn';
          el.textContent = accion.label;
          el.addEventListener('click', function () {
            ocultarInvitacion();
            abrirChat();
          });
        } else {
          el = document.createElement('a');
          el.className = accion.tipo === 'wa' ? 'chat-invitacion-btn chat-invitacion-btn--wa' : 'chat-invitacion-btn';
          el.textContent = accion.label;
          el.href = accion.href;
          if (accion.tipo === 'wa') {
            el.target = '_blank';
            el.rel = 'noopener noreferrer';
            el.setAttribute('data-cta', 'chat-invite-whatsapp');
          }
        }
        invitacionAcciones.appendChild(el);
      });
    }

    function mostrarInvitacion() {
      if (inviteDescartada || !(invitacion instanceof HTMLElement) || !panel.hidden) return;
      var paso = pasos[invitePaso % pasos.length];
      pintarPaso(paso);
      invitacion.hidden = false;
      void invitacion.offsetWidth;
      invitacion.classList.add('chat-invitacion--visible');
      if (!reduced) {
        abrir.classList.remove('chat-burbuja--aviso');
        void abrir.offsetWidth;
        abrir.classList.add('chat-burbuja--aviso');
      }
      rotateTimer = window.setTimeout(function () {
        invitePaso += 1;
        if (invitePaso >= pasos.length) {
          ocultarInvitacion();
          return;
        }
        invitacion.classList.remove('chat-invitacion--visible');
        window.setTimeout(function () {
          mostrarInvitacion();
        }, reduced ? 0 : 180);
      }, reduced ? 5000 : 6500);
    }

    function programarInvitacion() {
      if (inviteDescartada) return;
      limpiarTimers();
      inviteTimer = window.setTimeout(mostrarInvitacion, reduced ? 1200 : 3500);
    }

    if (invitacionCerrar instanceof HTMLButtonElement) {
      invitacionCerrar.addEventListener('click', function () {
        inviteDescartada = true;
        ocultarInvitacion();
      });
    }

    var ultimoFoco = null;
    function enfocables() {
      var nodos = panel.querySelectorAll('a[href], button:not([disabled]), input');
      return Array.prototype.filter.call(nodos, function (el) { return el.offsetParent !== null; });
    }
    function abrirChat() {
      ocultarInvitacion();
      ultimoFoco = document.activeElement;
      panel.hidden = false;
      abrir.setAttribute('aria-expanded', 'true');
      var f = enfocables();
      if (f[0] instanceof HTMLElement) f[0].focus();
    }
    function cerrarChat() {
      panel.hidden = true;
      abrir.setAttribute('aria-expanded', 'false');
      if (ultimoFoco instanceof HTMLElement) ultimoFoco.focus();
      if (!inviteDescartada && invitePaso < pasos.length) programarInvitacion();
    }
    abrir.addEventListener('click', function () {
      if (panel.hidden) abrirChat();
      else cerrarChat();
    });
    if (cerrar instanceof HTMLButtonElement) cerrar.addEventListener('click', cerrarChat);
    document.addEventListener('keydown', function (evento) {
      if (evento.key === "Escape" && !panel.hidden) {
        cerrarChat();
        return;
      }
      if (evento.key !== "Tab" || panel.hidden) return;
      var f = enfocables();
      if (f.length === 0) return;
      var primero = f[0];
      var ultimo = f[f.length - 1];
      if (evento.shiftKey && document.activeElement === primero) {
        evento.preventDefault();
        if (ultimo instanceof HTMLElement) ultimo.focus();
      } else if (!evento.shiftKey && document.activeElement === ultimo) {
        evento.preventDefault();
        if (primero instanceof HTMLElement) primero.focus();
      }
    });

    function agregarMensaje(autor, texto) {
      if (!(mensajes instanceof HTMLElement)) return;
      var p = document.createElement('p');
      p.className = autor === 'vos' ? 'chat-yo' : 'chat-ellos';
      p.textContent = texto;
      mensajes.appendChild(p);
      mensajes.scrollTop = mensajes.scrollHeight;
    }
    function mostrarDerivacion(datos) {
      if (derivacion instanceof HTMLElement) {
        derivacion.hidden = false;
        void derivacion.offsetWidth;
        derivacion.classList.add('chat-derivacion--visible');
      }
      if (derivacionWa instanceof HTMLAnchorElement && typeof datos.whatsapp === 'string') {
        derivacionWa.href = datos.whatsapp;
      }
    }
    function enviarTexto(texto) {
      agregarMensaje('vos', texto);
      fetch('/api/landing-chat', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ mensaje: texto }),
      })
        .then(function (r) { return r.json(); })
        .then(function (datos) {
          agregarMensaje('chat', typeof datos.texto === 'string' ? datos.texto : 'Te leo por acá.');
          if (datos && datos.deriva === true) mostrarDerivacion(datos);
        })
        .catch(function (error) {
          console.warn('[chat] no se pudo enviar el mensaje', error);
          agregarMensaje('chat', 'No pude enviar tu mensaje. Probá por WhatsApp.');
          mostrarDerivacion({ whatsapp: waUrl });
        });
    }
    if (form instanceof HTMLFormElement && entrada instanceof HTMLInputElement) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var texto = entrada.value.trim();
        if (!texto) return;
        entrada.value = '';
        enviarTexto(texto);
      });
    }
    var sugerenciasEls = raiz.querySelectorAll('[data-chat-sugerencia]');
    Array.prototype.forEach.call(sugerenciasEls, function (b) {
      if (!(b instanceof HTMLButtonElement)) return;
      b.addEventListener('click', function () {
        var texto = b.getAttribute('data-chat-sugerencia') || '';
        if (texto) enviarTexto(texto);
      });
    });

    programarInvitacion();
  })();
</script>

<style>
  .chat-landing {
    --chat-ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    /* Tailwind no emite los tokens que solo usa este widget, así que el
       flotante los fija acá y no depende de una utility presente. */
    --color-galaxy-deep: #ffffff;
    --color-whatsapp: #25d366;
    --color-llama: #ffd600;
    --color-naranja: #f57c00;
    --color-star-warm: #e64a19;
    --color-ash: #6e695d;
    --radius-button: 5rem;
    --text-body-sm: 0.875rem;
    position: fixed;
    z-index: 30;
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    right: max(1.5rem, env(safe-area-inset-right));
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }
  .chat-invitacion {
    position: relative;
    order: 0;
    max-width: min(16.5rem, calc(100vw - 5.5rem));
    padding: 0.75rem 2rem 0.75rem 0.85rem;
    border-radius: 1rem;
    background: var(--color-star-white);
    color: var(--color-void);
    border: 1px solid var(--color-linen);
    box-shadow: 0 0.5rem 1.25rem rgb(26 26 26 / 0.12);
    opacity: 0;
    transform: translateY(0.5rem) scale(0.96);
    transform-origin: bottom right;
    pointer-events: none;
    transition:
      opacity 200ms var(--chat-ease-out),
      transform 200ms var(--chat-ease-out);
  }
  .chat-invitacion--visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .chat-invitacion-texto {
    margin: 0;
    font-size: var(--text-body-sm);
    line-height: 1.35;
  }
  .chat-invitacion-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.55rem;
  }
  .chat-invitacion-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-button);
    border: 1px solid var(--color-ash);
    background: transparent;
    color: var(--color-void);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35rem 0.7rem;
    text-decoration: none;
    cursor: pointer;
  }
  .chat-invitacion-btn--wa {
    border-color: transparent;
    background: var(--color-whatsapp);
    color: var(--color-void);
  }
  .chat-invitacion-cerrar {
    position: absolute;
    top: 0.2rem;
    right: 0.35rem;
    border: 0;
    background: transparent;
    color: var(--color-ash);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .chat-burbuja {
    order: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    background: var(--color-void);
    color: var(--color-star-white);
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.4);
  }
  .chat-burbuja--modo {
    width: 4rem;
    height: 4rem;
    background: var(--color-star-white);
    border: 1px solid var(--color-linen);
  }
  .chat-burbuja--modo .chat-icono {
    width: 2.75rem;
    height: 2.75rem;
  }
  .chat-modo-ojos {
    transform-box: fill-box;
    transform-origin: center;
  }
  .chat-burbuja--aviso {
    animation: chat-aviso 420ms var(--chat-ease-out) 1;
  }
  @keyframes chat-aviso {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.06);
    }
    100% {
      transform: scale(1);
    }
  }
  @keyframes chat-modo-flotar {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-2px);
    }
  }
  @keyframes chat-modo-parpadeo {
    0%,
    86%,
    100% {
      transform: scaleY(1);
    }
    92% {
      transform: scaleY(0.12);
    }
  }
  @keyframes chat-panel-baja {
    from {
      opacity: 0;
      transform: translateY(-0.6rem) scale(0.92);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .chat-icono {
    width: 1.75rem;
    height: 1.75rem;
  }
  .chat-panel {
    order: 1;
    width: min(22rem, calc(100vw - 2rem));
    max-height: min(28rem, calc(100dvh - 7rem));
    overflow-y: auto;
    background: var(--color-galaxy-deep);
    border-radius: 1rem;
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 0.35);
    padding: 1rem;
    transform-origin: bottom right;
  }
  .chat-panel:not([hidden]) {
    animation: chat-panel-baja 240ms var(--chat-ease-out) 1;
  }
  .chat-cabecera {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .chat-saludo {
    font-weight: 600;
    flex: 1;
  }
  .chat-wa {
    font-weight: 600;
    text-decoration: underline;
  }
  .chat-wa--cta {
    display: inline-flex;
    text-decoration: none;
    border-radius: var(--radius-button);
    background: var(--color-whatsapp);
    color: var(--color-void);
    padding: 0.55rem 0.9rem;
  }
  .chat-wa-bloque {
    margin-top: 0.75rem;
  }
  .chat-wa--panel {
    width: 100%;
    justify-content: center;
    font-weight: 600;
  }
  .chat-wa-numero {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.8rem;
    opacity: 0.8;
  }
  .chat-mensajes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.75rem 0;
  }
  .chat-sugerencias {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chat-derivacion {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0.75rem 0;
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 220ms var(--chat-ease-out),
      transform 220ms var(--chat-ease-out);
  }
  .chat-derivacion--visible {
    opacity: 1;
    transform: none;
  }
  .chat-form {
    font-size: var(--text-body-sm);
  }
  .chat-sugerencia {
    border: 1px solid var(--color-ash);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-void);
    font: inherit;
    font-size: 0.8rem;
    padding: 0.35rem 0.7rem;
    text-align: left;
    cursor: pointer;
  }
  .chat-yo,
  .chat-ellos {
    max-width: 85%;
    margin: 0;
    padding: 0.45rem 0.7rem;
    border-radius: 0.8rem;
    font-size: var(--text-body-sm);
  }
  .chat-yo {
    align-self: flex-end;
    background: var(--color-void);
    color: var(--color-star-white);
  }
  .chat-ellos {
    align-self: flex-start;
    background: var(--color-linen);
    color: var(--color-void);
  }
  .chat-formulario {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .chat-label {
    width: 100%;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .chat-entrada {
    flex: 1 1 8rem;
    min-width: 0;
    border: 1px solid var(--color-ash);
    border-radius: var(--radius-button);
    background: var(--color-star-white);
    color: var(--color-void);
    font: inherit;
    padding: 0.5rem 0.8rem;
  }
  .chat-enviar {
    border: 0;
    border-radius: var(--radius-button);
    background: var(--color-void);
    color: var(--color-star-white);
    font: inherit;
    font-weight: 600;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
  }
  .chat-aviso {
    font-size: 0.8rem;
    opacity: 0.8;
  }
  @media (prefers-reduced-motion: no-preference) {
    .chat-burbuja--modo .chat-icono {
      animation: chat-modo-flotar 2.8s ease-in-out infinite;
    }
    .chat-modo-ojos {
      animation: chat-modo-parpadeo 3.6s ease-in-out infinite;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chat-invitacion,
    .chat-derivacion {
      transition: opacity 160ms ease;
      transform: none;
    }
    .chat-burbuja--aviso {
      animation: none;
    }
    .chat-panel:not([hidden]),
    .chat-burbuja--modo .chat-icono,
    .chat-modo-ojos {
      animation: none;
    }
  }
</style>
