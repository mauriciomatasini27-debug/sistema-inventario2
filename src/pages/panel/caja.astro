---
import PanelShell from "../../components/panel/PanelShell.astro";
const medios = ["Efectivo", "Debito", "Mercado Pago", "QR", "Transferencia"];
---
<PanelShell titulo="Caja" subtitulo="Saldos, movimientos y vencimientos del comercio." activo="caja">
  <div class="grid dos">
    <section class="card">
      <h2>Saldo de caja</h2>
      <div class="kpi">
        <div><b id="caja-total">…</b><small>Total en caja</small></div>
      </div>
      <div class="estado" id="caja-medios">Cargando…</div>
      <div class="estado" id="estado-balance" role="status">Cargando…</div>
    </section>

    <section class="card">
      <h2>Últimos movimientos</h2>
      <table>
        <thead><tr><th>Id</th><th>Tipo</th><th>Medio</th><th>Importe</th><th>Origen</th></tr></thead>
        <tbody id="mov-body"></tbody>
      </table>
      <div class="estado" id="estado-movs" role="status">Cargando…</div>
      <button id="export-enviar" type="button">Exportar CSV</button>
      <div class="estado" id="estado-export" role="status">Descargá el historial de caja.</div>
    </section>
  </div>

  <div class="grid dos">
    <section class="card">
      <h2>Vencimientos de caja</h2>
      <ul class="lista" id="venc-lista"></ul>
      <div class="estado" id="estado-venc" role="status">Cargando…</div>
    </section>

    <section class="card">
      <h2>Registrar movimiento</h2>
      <form id="mov-form">
        <div class="fila">
          <label>Tipo
            <select id="mov-tipo"><option value="ingreso">Ingreso</option><option value="egreso">Egreso</option></select>
          </label>
          <label>Medio
            <select id="mov-metodo">{medios.map((m) => <option value={m}>{m}</option>)}</select>
          </label>
        </div>
        <div class="fila">
          <label>Origen
            <select id="mov-origen">
              <option value="retiro">Retiro</option>
              <option value="sueldo">Sueldo</option>
              <option value="devolucion">Devolución</option>
              <option value="cobro_fiado">Cobro fiado</option>
            </select>
          </label>
          <label>Monto en centavos
            <input id="mov-monto" data-campo="monto_centavos" type="number" min="1" step="1" inputmode="numeric" value="1000" />
          </label>
        </div>
        <button id="mov-enviar" type="submit">Registrar</button>
        <div class="estado" id="estado-form" role="status">Completá el monto y registrá.</div>
      </form>
    </section>
  </div>

  <section class="card">
    <h2>Retiro a caja fuerte</h2>
    <form id="drop-form">
      <div class="fila">
        <label>Fecha de la jornada
          <input id="drop-fecha" data-campo="fecha_jornada" type="date" required />
        </label>
        <label>Monto en centavos
          <input id="drop-monto" data-campo="monto_centavos" type="number" min="1" step="1" inputmode="numeric" />
        </label>
      </div>
      <div class="fila">
        <label>Motivo
          <input id="drop-motivo" data-campo="motivo" type="text" maxlength="280" />
        </label>
        <label>Registrado por
          <input id="drop-creado" data-campo="creado_por" type="text" maxlength="128" value="panel-web" autocomplete="name" />
        </label>
      </div>
      <label>Conteo sorpresa
        <input id="drop-sorpresa" type="checkbox" />
      </label>
      <button id="drop-enviar" type="submit">Registrar retiro</button>
      <div class="estado" id="estado-drop" role="status">Indicá la fecha y el monto del retiro.</div>
    </form>
  </section>

  <section class="card">
    <h2>Revertir movimiento</h2>
    <form id="rev-form">
      <label>Id del movimiento
        <input id="rev-id" data-campo="revierte_a" type="text" maxlength="128" autocomplete="off" spellcheck="false" />
      </label>
      <div class="fila">
        <label>Motivo
          <input id="rev-motivo" data-campo="motivo" type="text" maxlength="280" />
        </label>
        <label>Registrado por
          <input id="rev-actor" data-campo="actor" type="text" maxlength="128" value="panel-web" autocomplete="name" />
        </label>
      </div>
      <button id="rev-enviar" type="submit">Revertir movimiento</button>
      <div class="estado" id="estado-rev" role="status">Pegá el id de la tabla. El motivo es opcional.</div>
    </form>
  </section>

  <section class="card">
    <h2>Cerrar jornada</h2>
    <button id="cierre-enviar" type="button" hidden>Cerrar jornada</button>
    <div class="estado" id="estado-cierre" role="status">Cargando…</div>
  </section>

  <div class="grid dos">
    <section class="card">
      <h2>Abrir turno</h2>
      <form id="turno-form">
        <div class="fila">
          <label>Turno
            <input id="turno-nombre" data-campo="turno" type="text" maxlength="32" autocomplete="off" />
          </label>
          <label>Entregado por
            <input id="turno-entregado" data-campo="entregado_por" type="text" maxlength="128" autocomplete="name" />
          </label>
        </div>
        <label>Esperado en centavos
          <input id="turno-esperado" data-campo="esperado_centavos" type="number" min="0" step="1" inputmode="numeric" value="0" />
        </label>
        <button id="turno-enviar" type="submit">Abrir turno</button>
        <div class="estado" id="estado-turno" role="status">Indicá el turno, quién entrega y el efectivo esperado.</div>
      </form>
    </section>

    <section class="card">
      <h2>Conciliar turno</h2>
      <form id="conciliar-form">
        <label>Turno
          <input id="conciliar-turno" data-campo="turno_id" type="text" maxlength="36" autocomplete="off" spellcheck="false" />
        </label>
        <label>Contado en centavos
          <input id="conciliar-contado" data-campo="contado_centavos" type="number" min="0" step="1" inputmode="numeric" value="0" />
        </label>
        <div class="fila">
          {medios.map((m) => (
            <label>{m}
              <input data-medio={m} data-campo="conteos_por_medio" type="number" min="0" step="1" inputmode="numeric" value="0" />
            </label>
          ))}
        </div>
        <button id="conciliar-enviar" type="submit">Conciliar</button>
        <div class="estado" id="estado-conciliar" role="status">Sumá cada medio. El esperado no se muestra acá.</div>
      </form>
    </section>
  </div>

  <section class="card">
    <h2>Resolver disputa</h2>
    <form id="resolver-form">
      <div class="fila">
        <label>Turno
          <input id="resolver-turno" data-campo="turno_id" type="text" maxlength="36" autocomplete="off" spellcheck="false" />
        </label>
        <label>Resuelto por
          <input id="resolver-quien" data-campo="resuelto_por" type="text" maxlength="128" autocomplete="name" />
        </label>
      </div>
      <label>Nota
        <input id="resolver-nota" data-campo="nota" type="text" maxlength="280" />
      </label>
      <button id="resolver-enviar" type="submit">Resolver disputa</button>
      <div class="estado" id="estado-resolver" role="status">Si el turno quedó en disputa, dejá la nota y cerrala.</div>
    </form>
  </section>
</PanelShell>

<style>
  #drop-sorpresa { width: 44px; justify-self: start; }
  #mov-body td:first-child { overflow-wrap: anywhere; }
  #export-enviar { margin-top: 8px; }
</style>

<script>
  import { derivarEstado, formatearCentavos, textoError } from "../../lib/panel-modulos.js";
  import { FECHA, MONTO, REQUERIDO, enteroMin, erroresDesdeZod, mensajeCampo } from "../../lib/errores-campo.js";
  import { limpiarErrores, mostrarErrores } from "../../lib/errores-campo-dom.js";
  import { confirmar } from "../../lib/confirmar-dom.js";
  import { fechaAR } from "../../lib/fecha-ar.js";

  const $ = (id) => document.getElementById(id);
  const mensaje = (estado, vacio) =>
    estado === "cargando" ? "Cargando…" : estado === "error" ? "Sin conexión con el servidor." : estado === "vacio" ? vacio : "";
  const celdas = (textos) => {
    const tr = document.createElement("tr");
    textos.forEach((t) => {
      const td = document.createElement("td");
      td.textContent = t;
      tr.appendChild(td);
    });
    return tr;
  };

  const cargarBalance = () =>
    fetch("/api/cash/balance")
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((b) => {
        const entradas = Object.entries(b.por_medio || {}).map(([m, c]) => [m, Number(c)]);
        const total = entradas.reduce((a, par) => a + par[1], 0);
        $("caja-total").textContent = formatearCentavos(total);
        $("caja-medios").textContent =
          entradas.length > 0 ? entradas.map(([m, c]) => m + " " + formatearCentavos(c)).join(" · ") : "Sin movimientos por medio.";
        $("estado-balance").textContent = mensaje(
          derivarEstado({ cargando: false, error: false, items: entradas.length }),
          "Todavía no hay movimientos de caja.",
        );
      })
      .catch((error) => {
        console.warn("[panel/caja] balance", error);
        $("caja-total").textContent = "—";
        $("estado-balance").textContent = mensaje("error", "");
      });

  const cargarMovimientos = () =>
    fetch("/api/cash/history?limit=10")
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        const items = j.items || [];
        const tb = $("mov-body");
        tb.textContent = "";
        // P1-50: el id queda en la fila para copiarlo en revierte_a.
        items.forEach((m) => tb.appendChild(celdas([m.id, m.tipo, m.metodo, formatearCentavos(m.monto_centavos), m.origen])));
        $("estado-movs").textContent = mensaje(
          derivarEstado({ cargando: false, error: false, items: items.length }),
          "Sin movimientos registrados.",
        );
      })
      .catch((error) => {
        console.warn("[panel/caja] movimientos", error);
        $("estado-movs").textContent = mensaje("error", "");
      });

  const cargarVencimientos = () =>
    fetch("/api/cash/due-items")
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        const items = j.vencimientos || [];
        const ul = $("venc-lista");
        ul.textContent = "";
        items.forEach((v) => {
          const li = document.createElement("li");
          li.textContent = v.concepto + " · " + formatearCentavos(v.montoCentavos) + " · " + v.estado + (v.avisa ? " · avisa" : "");
          ul.appendChild(li);
        });
        $("estado-venc").textContent = mensaje(
          derivarEstado({ cargando: false, error: false, items: items.length }),
          "Sin vencimientos de caja.",
        );
      })
      .catch((error) => {
        console.warn("[panel/caja] vencimientos", error);
        $("estado-venc").textContent = mensaje("error", "");
      });

  $("mov-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    limpiarErrores(evento.currentTarget as HTMLElement);
    const estado = $("estado-form");
    const form = $("mov-form");
    const monto = Number($("mov-monto").value);
    if (!Number.isInteger(monto) || monto <= 0) {
      mostrarErrores(form, { monto_centavos: mensajeCampo("monto_centavos", MONTO) });
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    if ($("mov-tipo").value === "egreso") {
      const confirmado = await confirmar({
        titulo: "Registrar egreso",
        mensaje: "Vas a sacar " + formatearCentavos(monto) + " de caja por " + $("mov-metodo").value + ".",
        accion: "Registrar egreso",
      });
      if (!confirmado) return;
    }
    estado.textContent = "Registrando…";
    try {
      const r = await fetch("/api/cash/movements", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
        body: JSON.stringify({
          tipo: $("mov-tipo").value,
          metodo: $("mov-metodo").value,
          categoria_id: "manual",
          origen: $("mov-origen").value,
          monto_centavos: Number($("mov-monto").value),
          device_code: "panel-web",
          seq_local: Date.now(),
          client_occurred_at: new Date().toISOString(),
        }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/caja] respuesta sin JSON", r.status, error);
        return {};
      });
      if (!r.ok) {
        if (mostrarErrores(form, erroresDesdeZod(j.error))) {
          estado.textContent = "Revisá los campos marcados.";
          return;
        }
        estado.textContent = "No se registró: " + textoError(j.error, r.status) + ".";
        return;
      }
      estado.textContent = "Movimiento registrado.";
      cargarMovimientos();
      cargarBalance();
    } catch (error) {
      console.warn("[panel/caja] registrar", error);
      estado.textContent = mensaje("error", "");
    }
  });

  // P1-42: el corte de caja es el día civil de Buenos Aires, no el día UTC.
  const fechaJornada = fechaAR(Date.now());
  // P1-49: el retiro cae en la misma jornada que el cierre.
  $("drop-fecha").value = fechaJornada;

  const pintarCierreAbierto = () => {
    const boton = $("cierre-enviar");
    boton.hidden = false;
    boton.disabled = false;
    $("estado-cierre").textContent = "La jornada del " + fechaJornada + " sigue abierta.";
  };

  const pintarCierreCerrado = (total) => {
    $("cierre-enviar").hidden = true;
    $("estado-cierre").textContent = "Jornada cerrada. Total " + formatearCentavos(total) + ".";
  };

  const cargarCierre = () =>
    fetch("/api/cash/close?fecha=" + fechaJornada)
      .then(async (r) => {
        if (r.status === 404) {
          pintarCierreAbierto();
          return;
        }
        if (!r.ok) throw new Error("http " + r.status);
        const j = await r.json();
        pintarCierreCerrado(j.total_centavos);
      })
      .catch((error) => {
        console.warn("[panel/caja] cierre", error);
        $("cierre-enviar").hidden = true;
        $("estado-cierre").textContent = mensaje("error", "");
      });

  $("cierre-enviar").addEventListener("click", async () => {
    const estado = $("estado-cierre");
    const boton = $("cierre-enviar");
    const confirmado = await confirmar({
      titulo: "Cerrar jornada",
      mensaje: "Vas a cerrar la caja del " + fechaJornada + ". El día queda cerrado.",
      accion: "Cerrar jornada",
    });
    if (!confirmado) return;
    boton.disabled = true;
    estado.textContent = "Cerrando jornada…";
    try {
      const r = await fetch("/api/cash/close", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
        body: JSON.stringify({ fecha_jornada: fechaJornada, close_type: "manual" }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/caja] cierre sin JSON", r.status, error);
        return {};
      });
      if (r.status === 201 || (r.status === 409 && j.error === "jornada ya cerrada")) {
        cargarCierre();
        return;
      }
      boton.disabled = false;
      if (r.status === 422 && j.error === "cierre con turno en disputa") {
        estado.textContent = "No se cerró: hay un turno en disputa. Resolvé ese turno y volvé a cerrar.";
        return;
      }
      estado.textContent = "No se cerró: " + textoError(j.error, r.status) + ".";
    } catch (error) {
      console.warn("[panel/caja] cerrar", error);
      boton.disabled = false;
      estado.textContent = mensaje("error", "");
    }
  });

  const esUuid = (valor) =>
    /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(valor);

  const recordarTurno = (id) => {
    if (!esUuid(id)) return;
    $("conciliar-turno").value = id;
    $("resolver-turno").value = id;
  };

  const leerJson = async (r) =>
    r.json().catch((error) => {
      console.warn("[panel/caja] respuesta sin JSON", r.status, error);
      return {};
    });

  // P1-51: la tarjeta no filtra, así que el GET va sin query. Revocar el object URL en el acto corta la descarga.
  $("export-enviar").addEventListener("click", async () => {
    const estado = $("estado-export");
    const boton = $("export-enviar");
    boton.disabled = true;
    estado.textContent = "Descargando…";
    try {
      const r = await fetch("/api/cash/export");
      if (!r.ok) {
        const j = await leerJson(r);
        estado.textContent = "No se exportó: " + textoError(j.error, r.status) + ".";
        return;
      }
      const blob = await r.blob();
      const url = URL.createObjectURL(blob);
      try {
        const a = document.createElement("a");
        a.href = url;
        a.download = "caja-historial.csv";
        document.body.appendChild(a);
        a.click();
        a.remove();
      } finally {
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }
      estado.textContent = "Historial descargado.";
    } catch (error) {
      console.warn("[panel/caja] export", error);
      estado.textContent = mensaje("error", "");
    } finally {
      boton.disabled = false;
    }
  });

  $("drop-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    const form = $("drop-form");
    limpiarErrores(form);
    const estado = $("estado-drop");
    const boton = $("drop-enviar");
    const fecha = $("drop-fecha").value.trim();
    const monto = Number($("drop-monto").value);
    const motivo = $("drop-motivo").value.trim();
    const creado = $("drop-creado").value.trim();
    const sorpresa = ($("drop-sorpresa") as HTMLInputElement).checked;
    const errores: Record<string, string> = {};
    if (!/^\d{4}-\d{2}-\d{2}$/.test(fecha)) errores.fecha_jornada = mensajeCampo("fecha_jornada", FECHA);
    if (!Number.isInteger(monto) || monto <= 0) errores.monto_centavos = mensajeCampo("monto_centavos", MONTO);
    if (creado.length < 1 || creado.length > 128) errores.creado_por = mensajeCampo("creado_por", REQUERIDO);
    if (mostrarErrores(form, errores)) {
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    const confirmado = await confirmar({
      titulo: "Retiro a caja fuerte",
      mensaje: "Vas a retirar " + formatearCentavos(monto) + " de la caja del " + fecha + ".",
      accion: "Registrar retiro",
    });
    if (!confirmado) return;
    boton.disabled = true;
    estado.textContent = "Registrando retiro…";
    try {
      const r = await fetch("/api/cash/drops", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
        body: JSON.stringify({
          fecha_jornada: fecha,
          monto_centavos: monto,
          motivo: motivo || undefined,
          creado_por: creado,
          sorpresa,
        }),
      });
      const j = await leerJson(r);
      if (r.status === 201) {
        estado.textContent = j.drop_id ? "Retiro registrado. " + j.drop_id : "Retiro registrado.";
        cargarBalance();
        cargarMovimientos();
        return;
      }
      if (mostrarErrores(form, erroresDesdeZod(j.error))) {
        estado.textContent = "Revisá los campos marcados.";
        return;
      }
      estado.textContent = "No se registró el retiro: " + textoError(j.error, r.status) + ".";
    } catch (error) {
      console.warn("[panel/caja] retiro", error);
      estado.textContent = mensaje("error", "");
    } finally {
      boton.disabled = false;
    }
  });

  // P1-43: el conteo es a ciegas. El esperado viaja solo en este POST y se borra de la pantalla.
  $("turno-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    const form = $("turno-form");
    limpiarErrores(form);
    const estado = $("estado-turno");
    const boton = $("turno-enviar");
    const turno = $("turno-nombre").value.trim();
    const entregado = $("turno-entregado").value.trim();
    const esperado = Number($("turno-esperado").value);
    const errores: Record<string, string> = {};
    if (turno.length < 1 || turno.length > 32) errores.turno = mensajeCampo("turno", REQUERIDO);
    if (entregado.length < 1 || entregado.length > 128) errores.entregado_por = mensajeCampo("entregado_por", REQUERIDO);
    if (!Number.isInteger(esperado) || esperado < 0) errores.esperado_centavos = mensajeCampo("esperado_centavos", enteroMin(0));
    if (mostrarErrores(form, errores)) {
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    boton.disabled = true;
    estado.textContent = "Abriendo turno…";
    try {
      const r = await fetch("/api/cash/shifts", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
        body: JSON.stringify({
          fecha_jornada: fechaJornada,
          turno,
          entregado_por: entregado,
          esperado_centavos: esperado,
        }),
      });
      const j = await leerJson(r);
      const turnoId = r.status === 201 ? j.turno_id : j.original && j.original.turno_id;
      if (r.status === 201 || (r.status === 409 && esUuid(turnoId))) {
        recordarTurno(turnoId);
        $("turno-esperado").value = "";
        estado.textContent =
          r.status === 201
            ? "Turno abierto. Contá la caja al lado, sin el esperado."
            : "Ese envío ya había abierto el turno. Seguí con el conteo.";
        $("conciliar-contado").focus();
        return;
      }
      if (mostrarErrores(form, erroresDesdeZod(j.error))) {
        estado.textContent = "Revisá los campos marcados.";
        return;
      }
      estado.textContent = "No se abrió: " + textoError(j.error, r.status) + ".";
    } catch (error) {
      console.warn("[panel/caja] abrir turno", error);
      estado.textContent = mensaje("error", "");
    } finally {
      boton.disabled = false;
    }
  });

  $("conciliar-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    const form = $("conciliar-form");
    limpiarErrores(form);
    const estado = $("estado-conciliar");
    const boton = $("conciliar-enviar");
    const turnoId = $("conciliar-turno").value.trim();
    const contado = Number($("conciliar-contado").value);
    const conteos = Array.from(form.querySelectorAll("[data-medio]")).map((nodo) => {
      const input = nodo as HTMLInputElement;
      return { medio: input.dataset.medio ?? "", monto_centavos: Number(input.value) };
    });
    const errores: Record<string, string> = {};
    if (!esUuid(turnoId)) errores.turno_id = "Pegá el identificador del turno.";
    if (!Number.isInteger(contado) || contado < 0) errores.contado_centavos = mensajeCampo("contado_centavos", enteroMin(0));
    if (conteos.some((c) => !c.medio || !Number.isInteger(c.monto_centavos) || c.monto_centavos < 0)) {
      errores.conteos_por_medio = "Revisá el desglose por medio.";
    }
    const suma = conteos.reduce((total, c) => total + (Number.isInteger(c.monto_centavos) ? c.monto_centavos : 0), 0);
    if (!errores.contado_centavos && !errores.conteos_por_medio && suma !== contado) {
      errores.contado_centavos = "La suma de los medios tiene que dar el contado.";
    }
    if (mostrarErrores(form, errores)) {
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    const confirmado = await confirmar({
      titulo: "Conciliar turno",
      mensaje: "Vas a registrar " + formatearCentavos(contado) + " contados. Si no cierra, el turno queda en disputa.",
      accion: "Conciliar",
    });
    if (!confirmado) return;
    boton.disabled = true;
    estado.textContent = "Conciliando…";
    try {
      const r = await fetch("/api/cash/shifts/conciliate", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
        body: JSON.stringify({
          turno_id: turnoId,
          contado_centavos: contado,
          conteos_por_medio: conteos,
        }),
      });
      const j = await leerJson(r);
      if (r.status === 201) {
        recordarTurno(j.turno_id || turnoId);
        const diferencia = formatearCentavos(j.diferencia_centavos ?? 0);
        if (j.estado === "en_disputa") {
          estado.textContent = "Quedó en disputa. Diferencia " + diferencia + ". Dejá una nota para cerrarla.";
          $("resolver-nota").focus();
          return;
        }
        estado.textContent = "Turno conciliado. Diferencia " + diferencia + ".";
        return;
      }
      if (mostrarErrores(form, erroresDesdeZod(j.error))) {
        estado.textContent = "Revisá los campos marcados.";
        return;
      }
      estado.textContent = "No se concilió: " + textoError(j.error, r.status) + ".";
    } catch (error) {
      console.warn("[panel/caja] conciliar", error);
      estado.textContent = mensaje("error", "");
    } finally {
      boton.disabled = false;
    }
  });

  // P1-43: el rol lo toma el servidor de la sesión. Este body no lo incluye.
  $("resolver-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    const form = $("resolver-form");
    limpiarErrores(form);
    const estado = $("estado-resolver");
    const boton = $("resolver-enviar");
    const turnoId = $("resolver-turno").value.trim();
    const nota = $("resolver-nota").value.trim();
    const quien = $("resolver-quien").value.trim();
    const errores: Record<string, string> = {};
    if (!esUuid(turnoId)) errores.turno_id = "Pegá el identificador del turno.";
    if (nota.length < 1 || nota.length > 280) errores.nota = mensajeCampo("nota", REQUERIDO);
    if (quien.length < 1 || quien.length > 128) errores.resuelto_por = mensajeCampo("resuelto_por", REQUERIDO);
    if (mostrarErrores(form, errores)) {
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    const confirmado = await confirmar({
      titulo: "Resolver disputa",
      mensaje: "Vas a cerrar la disputa de este turno con la nota que escribiste.",
      accion: "Resolver disputa",
    });
    if (!confirmado) return;
    boton.disabled = true;
    estado.textContent = "Resolviendo disputa…";
    try {
      const r = await fetch("/api/cash/shifts/resolve", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          turno_id: turnoId,
          nota,
          resuelto_por: quien,
        }),
      });
      const j = await leerJson(r);
      if (r.status === 200 && j.estado === "resuelto") {
        estado.textContent = "Disputa resuelta. Ya podés cerrar la jornada.";
        return;
      }
      if (mostrarErrores(form, erroresDesdeZod(j.error))) {
        estado.textContent = "Revisá los campos marcados.";
        return;
      }
      estado.textContent = "No se resolvió: " + textoError(j.error, r.status) + ".";
    } catch (error) {
      console.warn("[panel/caja] resolver", error);
      estado.textContent = mensaje("error", "");
    } finally {
      boton.disabled = false;
    }
  });

  // P1-50: el compensatorio es inmutable. El panel solo publica el POST.
  $("rev-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    const form = $("rev-form");
    limpiarErrores(form);
    const estado = $("estado-rev");
    const boton = $("rev-enviar");
    const revierte = $("rev-id").value.trim();
    const motivo = $("rev-motivo").value.trim();
    const actor = $("rev-actor").value.trim();
    const errores: Record<string, string> = {};
    if (revierte.length < 1 || revierte.length > 128) errores.revierte_a = "Pegá el id del movimiento.";
    if (actor.length < 1 || actor.length > 128) errores.actor = mensajeCampo("actor", REQUERIDO);
    if (mostrarErrores(form, errores)) {
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    const confirmado = await confirmar({
      titulo: "Revertir movimiento",
      mensaje: "Vas a compensar el movimiento " + revierte + ". El original no se edita.",
      accion: "Revertir",
    });
    if (!confirmado) return;
    boton.disabled = true;
    estado.textContent = "Revirtiendo…";
    try {
      const r = await fetch("/api/cash/reversals", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
        body: JSON.stringify({
          revierte_a: revierte,
          motivo: motivo || undefined,
          actor,
        }),
      });
      const j = await leerJson(r);
      if (r.status === 201) {
        estado.textContent = j.movimiento_id ? "Movimiento revertido. " + j.movimiento_id : "Movimiento revertido.";
        cargarMovimientos();
        cargarBalance();
        return;
      }
      if (mostrarErrores(form, erroresDesdeZod(j.error))) {
        estado.textContent = "Revisá los campos marcados.";
        return;
      }
      estado.textContent = "No se revirtió: " + textoError(j.error, r.status) + ".";
    } catch (error) {
      console.warn("[panel/caja] reversa", error);
      estado.textContent = mensaje("error", "");
    } finally {
      boton.disabled = false;
    }
  });

  cargarBalance();
  cargarMovimientos();
  cargarVencimientos();
  cargarCierre();
</script>
