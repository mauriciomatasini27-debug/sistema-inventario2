---
import PanelShell from "../../components/panel/PanelShell.astro";
const medios = ["Efectivo", "Debito", "Mercado Pago", "QR", "Transferencia"];
---
<PanelShell titulo="Fiado" subtitulo="Saldo por cliente y registro de cobros." activo="fiado">
  <div class="grid dos">
    <section class="card">
      <h2>Saldo del cliente</h2>
      <label>Buscar cliente
        <input id="fiado-q" type="search" placeholder="Nombre o ID" autocomplete="off" />
      </label>
      <ul class="opciones" id="fiado-opciones" aria-label="Clientes encontrados"></ul>
      <div class="estado" id="estado-fiado-q" role="status"></div>
      <div class="fila">
        <label>Cliente
          <input id="fiado-cliente" type="text" placeholder="cliente-1" autocomplete="off" />
        </label>
        <button id="fiado-buscar" type="button">Consultar</button>
      </div>
      <ul class="lista" id="fiado-lista"></ul>
      <div class="estado" id="estado-fiado" role="status">Cargá un cliente para ver su saldo.</div>
    </section>

    <section class="card">
      <h2>Registrar cobro</h2>
      <form id="pago-form">
        <div class="fila">
          <label>Cliente
            <input id="pago-cliente" data-campo="customer_id" type="text" placeholder="cliente-1" autocomplete="off" />
          </label>
          <label>Medio
            <select id="pago-medio">{medios.map((m) => <option value={m}>{m}</option>)}</select>
          </label>
        </div>
        <label>Monto en centavos
          <input id="pago-monto" data-campo="monto_centavos" type="number" min="1" step="1" inputmode="numeric" value="1000" />
        </label>
        <button id="pago-enviar" type="submit">Cobrar</button>
        <div class="estado" id="estado-pago" role="status">Cargá el monto y cobrá.</div>
      </form>
    </section>
  </div>
</PanelShell>

<style is:global>
  .panel-shell .opciones { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 4px; }
  .panel-shell .opciones button { width: 100%; min-height: 44px; text-align: left; background: var(--color-linen); color: var(--color-void); border: 1px solid var(--color-linen); border-radius: 12px; font-weight: 500; }
  .panel-shell .opciones button:hover { border-color: var(--color-ash); }
</style>

<script>
  import { derivarEstado, formatearCentavos, textoError } from "../../lib/panel-modulos.js";
  import { MONTO, REQUERIDO, erroresDesdeZod, mensajeCampo } from "../../lib/errores-campo.js";
  import { limpiarErrores, mostrarErrores } from "../../lib/errores-campo-dom.js";
  import { confirmar } from "../../lib/confirmar-dom.js";

  const $ = (id) => document.getElementById(id);
  const mensaje = (estado, vacio) =>
    estado === "cargando" ? "Cargando…" : estado === "error" ? "Sin conexión con el servidor." : estado === "vacio" ? vacio : "";

  const cargarSaldo = (cliente) => {
    $("estado-fiado").textContent = "Cargando…";
    return fetch("/api/credit/balance?customer_id=" + encodeURIComponent(cliente))
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        const filas = [
          ["Saldo", formatearCentavos(j.saldo_centavos)],
          ["Estado", j.estado === "en_mora" ? "en mora" : "al día"],
          ["Días de atraso", String(j.dias_max) + " (umbral " + j.umbral_mora_dias + ")"],
        ];
        const ul = $("fiado-lista");
        ul.textContent = "";
        filas.forEach(([etiqueta, valor]) => {
          const li = document.createElement("li");
          li.textContent = etiqueta + " · " + valor;
          ul.appendChild(li);
        });
        $("estado-fiado").textContent = mensaje(
          derivarEstado({ cargando: false, error: false, items: filas.length }),
          "Sin movimientos del cliente.",
        );
      })
      .catch((error) => {
        console.warn("[panel/fiado] saldo", error);
        $("fiado-lista").textContent = "";
        $("estado-fiado").textContent = mensaje("error", "");
      });
  };

  $("fiado-buscar").addEventListener("click", () => {
    const cliente = $("fiado-cliente").value.trim();
    if (!cliente) {
      $("estado-fiado").textContent = "Escribí el cliente.";
      return;
    }
    cargarSaldo(cliente);
  });

  const elegirCliente = (item) => {
    $("fiado-cliente").value = item.customer_id;
    $("fiado-cliente").focus();
    $("estado-fiado-q").textContent = "Elegido: " + item.nombre + ".";
  };

  let temporizador = null;
  const buscarClientes = (texto) => {
    const lista = $("fiado-opciones");
    const estado = $("estado-fiado-q");
    lista.textContent = "";
    if (!texto) {
      estado.textContent = "";
      return;
    }
    estado.textContent = "Buscando…";
    fetch("/api/credit/customers?q=" + encodeURIComponent(texto) + "&limit=8")
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        const items = j.items ?? [];
        lista.textContent = "";
        items.forEach((item) => {
          const li = document.createElement("li");
          const boton = document.createElement("button");
          boton.type = "button";
          boton.textContent = item.nombre + " · " + item.customer_id;
          boton.addEventListener("click", () => {
            elegirCliente(item);
            lista.textContent = "";
            estado.textContent = "";
          });
          li.appendChild(boton);
          lista.appendChild(li);
        });
        estado.textContent = items.length > 0 ? "" : "Sin resultados.";
      })
      .catch((error) => {
        console.warn("[panel/fiado] buscador", error);
        lista.textContent = "";
        estado.textContent = mensaje("error", "");
      });
  };

  $("fiado-q").addEventListener("input", () => {
    clearTimeout(temporizador);
    const texto = $("fiado-q").value.trim();
    temporizador = setTimeout(() => buscarClientes(texto), 250);
  });

  $("pago-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    limpiarErrores(evento.currentTarget as HTMLElement);
    const estado = $("estado-pago");
    const form = $("pago-form");
    const cliente = $("pago-cliente").value.trim();
    const monto = Number($("pago-monto").value);
    const errores = {};
    if (!cliente) errores.customer_id = mensajeCampo("customer_id", REQUERIDO);
    if (!Number.isInteger(monto) || monto <= 0) errores.monto_centavos = mensajeCampo("monto_centavos", MONTO);
    if (Object.keys(errores).length > 0) {
      mostrarErrores(form, errores);
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    const confirmado = await confirmar({
      titulo: "Registrar cobro",
      mensaje: "Vas a registrar un cobro de " + formatearCentavos(monto) + " para " + cliente + ".",
      accion: "Cobrar",
    });
    if (!confirmado) return;
    estado.textContent = "Registrando cobro…";
    try {
      const r = await fetch("/api/credit/payments", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
        body: JSON.stringify({
          customer_id: cliente,
          monto_centavos: Number($("pago-monto").value),
          medio: $("pago-medio").value,
        }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/fiado] respuesta sin JSON", r.status, error);
        return {};
      });
      if (!r.ok) {
        if (mostrarErrores(form, erroresDesdeZod(j.error))) {
          estado.textContent = "Revisá los campos marcados.";
          return;
        }
        estado.textContent = "No se cobró: " + textoError(j.error, r.status) + ".";
        return;
      }
      estado.textContent = "Cobro registrado: " + formatearCentavos(j.haber_centavos) + ".";
      $("pago-form").reset();
    } catch (error) {
      console.warn("[panel/fiado] cobro", error);
      estado.textContent = mensaje("error", "");
    }
  });
</script>
