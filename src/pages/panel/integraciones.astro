---
import PanelShell from "../../components/panel/PanelShell.astro";
import IntegracionGmail from "../../components/panel/IntegracionGmail.astro";
import { esDueno, resolverSesion } from "../../lib/control.js";
import { decidirInicioGmail } from "../../modules/integraciones/google-oauth.js";
import { control } from "../../lib/store.js";
import { tenantDeRequest } from "../../lib/tenant-context.js";

const tenant = tenantDeRequest(Astro.request);
let dueno = false;
let emailDueno = "";
if (tenant.ok) {
  const sesion = resolverSesion(Astro.request);
  if (sesion) {
    dueno = esDueno(tenant.tenantId, sesion.googleSub);
    emailDueno = control.users.get(sesion.googleSub)?.email ?? "";
  }
}
const decision = decidirInicioGmail({ email: emailDueno });
---
<PanelShell titulo="Gmail" subtitulo="Conectá la casilla que recibe las facturas de servicios.">
  {!tenant.ok ? (
    <section class="card" id="salud-gmail">
      <h2>Estado de la conexión</h2>
      <p>Iniciá sesión para ver la conexión de Gmail.</p>
    </section>
  ) : (
    <IntegracionGmail server:defer tenantId={tenant.tenantId} dueno={dueno} decision={decision}>
      <section class="card" id="gmail-skeleton" data-cargando="gmail" aria-busy="true" slot="fallback">
        <h2>Estado de la conexión</h2>
        <p>Cargando el estado de Gmail…</p>
      </section>
    </IntegracionGmail>
  )}
</PanelShell>
