---
import PanelShell from "../../components/panel/PanelShell.astro";
import TableroAcciones from "../../components/panel/TableroAcciones.astro";
import TablaCatalogo from "../../components/panel/TablaCatalogo.tsx";
import { modoHarnessCatalogo } from "../../lib/catalogo-panel.js";
import { tenantDeRequest } from "../../lib/tenant-context.js";
import { resolverRolEfectivo } from "../../lib/control.js";
import { puedeCrearProductos, rolParaNav } from "../../lib/panel-modulos.js";

const harness = modoHarnessCatalogo(Astro.url, import.meta.env.DEV);
const tenant = tenantDeRequest(Astro.request);
const tenantId = tenant.ok ? tenant.tenantId : null;
const navRol = rolParaNav(resolverRolEfectivo(Astro.request));
const puedeCrear = puedeCrearProductos(navRol.rol, navRol.permisos);
---
<PanelShell titulo="Stock" subtitulo="Catálogo, lotes FEFO e ingreso de mercadería." activo="stock">
  <TableroAcciones
    acciones={[
      { href: "#alta-producto-card", label: "Agregar producto", ancho: "completo" as const },
      { href: "/panel/stock/importar", label: "Importar CSV o Excel", ancho: "completo" },
      { href: "/panel/alertas/umbrales", label: "Editar umbrales" },
      { href: "/panel/precios", label: "Precios" },
    ]}
  />
  <section class="card" id="alta-producto-card">
    <h2>Agregar producto</h2>
    <p class="estado">Nombre obligatorio. El código es opcional; si no ponés uno, generamos un SKU interno.</p>
    <form id="alta-producto-form">
      <div class="fila">
        <label>Nombre
          <input id="alta-nombre" data-campo="nombre" type="text" maxlength="200" autocomplete="off" required />
        </label>
      </div>
      <div class="fila">
        <label>Código de barras (opcional)
          <input id="alta-codigo" data-campo="codigo" type="text" maxlength="64" autocomplete="off" inputmode="numeric" />
        </label>
        <button id="alta-leer-camara" type="button">Escanear</button>
      </div>
      <div class="fila">
        <label>Precio de venta (pesos, opcional)
          <input id="alta-precio" data-campo="precio" type="text" inputmode="decimal" autocomplete="off" placeholder="Ej. 1.234,50" />
        </label>
        <label>Cantidad inicial (opcional)
          <input id="alta-cantidad" data-campo="cantidad" type="number" min="0" max="99999" step="1" inputmode="numeric" />
        </label>
      </div>
      <div class="fila">
        <label>Ubicación (opcional)
          <select id="alta-ubicacion" data-campo="location_id">
            <option value="">Sin ubicación</option>
          </select>
        </label>
      </div>
      <button id="alta-producto-enviar" type="submit">Guardar producto</button>
      <div class="estado" id="estado-alta-producto" role="status"></div>
      <div class="fila" id="alta-duplicado-acciones" hidden>
        <button id="alta-abrir-existente" type="button">Abrir ese producto en el catálogo</button>
      </div>
    </form>
  </section>
  <p class="resumen-pantalla" id="stock-resumen" aria-live="polite">Cargando catálogo…</p>
  <section class="card" id="catalogo-sugerido" data-tenant={tenantId ?? ""} data-puede-crear={puedeCrear ? "si" : "no"} hidden>
    <h2>Catálogo sugerido para tu rubro</h2>
    <p>Destildá lo que no vendés. Los creamos sin precio para que los completes.</p>
    <ul class="lista" id="catalogo-sugerido-lista"></ul>
    <div class="fila">
      <button id="catalogo-sugerido-crear" type="button">Crear seleccionados</button>
      <button id="catalogo-sugerido-no" type="button">No, gracias</button>
    </div>
    <div class="estado" id="estado-catalogo-sugerido" role="status"></div>
  </section>

  <section class="card" id="stock-inicial" hidden>
    <h2>Cargá el stock inicial</h2>
    <p>Estos productos los diste de alta al vender. Contá cuántos tenés y cargalos; te mostramos los más vendidos primero.</p>
    <ul class="lista" id="stock-inicial-lista"></ul>
    <div class="estado" id="estado-stock-inicial" role="status"></div>
  </section>

  <section class="card" id="precio-pendiente" hidden>
    <h2>Completá el precio</h2>
    <p>Estos productos no tienen precio todavía. Cargalo para poder venderlos bien; primero los más vendidos.</p>
    <ul class="lista" id="precio-pendiente-lista"></ul>
    <div class="estado" id="estado-precio-pendiente" role="status"></div>
  </section>

  <div class="grid dos">
    <section class="card" data-harness={harness}>
      <h2>Catálogo</h2>
      <div class="kpi">
        <div><b id="stock-productos">…</b><small>Productos</small></div>
        <div><b id="stock-umbral">…</b><small>Con stock mínimo</small></div>
      </div>
      <TablaCatalogo client:visible columnas="stock" etiqueta="Catálogo de productos" />
      <div class="estado" id="estado-stock" role="status">Cargando…</div>
    </section>

    <section class="card">
      <h2>Lotes FEFO</h2>
      <div class="fila">
        <label>SKU
          <input id="lote-sku" type="text" placeholder="demo-sku-1" autocomplete="off" />
        </label>
        <button id="lote-buscar" type="button">Buscar</button>
        <button id="leer-camara" type="button">Leer con la cámara</button>
      </div>
      <video id="camara-video" class="camara-video" hidden playsinline muted></video>
      <ul class="lista" id="lote-lista"></ul>
      <div class="estado" id="estado-lotes" role="status">Cargando…</div>
    </section>
  </div>

  <div class="grid">
    <section class="card" id="ubicaciones">
      <h2>Ubicaciones</h2>
      <div class="aviso" id="aviso-ubicaciones" hidden>
        <p>Estas ubicaciones las armamos según tu rubro. Cambiales el nombre para que coincidan con tu local</p>
        <button id="aviso-ubicaciones-cerrar" type="button">Entendido</button>
      </div>
      <ul class="lista" id="ubicaciones-lista"></ul>
      <form id="ubicacion-form">
        <div class="fila">
          <label>Nueva ubicación
            <input id="ubicacion-nombre" data-campo="nombre" type="text" maxlength="80" autocomplete="off" />
          </label>
          <button id="ubicacion-crear" type="submit">Nueva ubicación</button>
        </div>
        <div class="estado" id="estado-ubicaciones" role="status">Cargando…</div>
      </form>
    </section>
  </div>

  <div class="grid dos">
    <section class="card">
      <h2>Ingreso de mercadería</h2>
      <form id="ingreso-form">
        <div class="fila">
          <label>SKU
            <input id="ingreso-sku" data-campo="sku" type="text" placeholder="demo-sku-1" autocomplete="off" />
          </label>
          <label>Cantidad
            <input id="ingreso-cantidad" data-campo="cantidad" type="number" min="1" step="1" inputmode="numeric" value="1" />
          </label>
        </div>
        <div class="fila">
          <label>Costo (pesos)
            <input id="ingreso-costo" data-campo="costo_centavos" type="text" inputmode="decimal" placeholder="Ej. 1.234,50" autocomplete="off" value="0" />
          </label>
          <label>Vence el
            <input id="ingreso-vence" data-campo="vence_el" type="datetime-local" />
          </label>
        </div>
        <button id="ingreso-enviar" type="submit">Ingresar</button>
        <div class="estado" id="estado-ingreso" role="status">Completá el SKU y la cantidad.</div>
      </form>
    </section>

    <section class="card">
      <h2>Conteo ciego</h2>
      <p class="estado">Creá un conteo CAT-S6 y confirmalo como dueño para ajustar stock.</p>
      <form id="conteo-form">
        <label>SKU
          <input id="conteo-sku" data-campo="sku" type="text" autocomplete="off" />
        </label>
        <label>Cantidad física
          <input id="conteo-fisico" data-campo="fisico" type="number" min="0" max="9999" step="1" value="0" />
        </label>
        <label>Contado por
          <input id="conteo-por" data-campo="contado_por" type="text" value="panel" autocomplete="off" />
        </label>
        <label>Motivo (dueño)
          <input id="conteo-motivo" data-campo="motivo" type="text" maxlength="280" placeholder="Ajuste por conteo" autocomplete="off" />
        </label>
        <button id="conteo-enviar" type="submit">Crear y confirmar conteo</button>
        <div class="estado" id="estado-conteo" role="status">Completá SKU y cantidad física.</div>
      </form>
    </section>
  </div>
</PanelShell>

<style>
  .camara-video { width: 100%; max-height: 180px; border-radius: 8px; background: var(--color-void); }
  .aviso {
    margin-bottom: 12px;
    padding: 12px;
    border: 1px solid var(--tema-acento);
    border-radius: 12px;
    background: var(--tema-superficie);
  }
  .aviso[hidden] {
    display: none;
  }
  .aviso p {
    margin: 0 0 8px;
  }
  #ubicaciones-lista li button {
    margin-left: 8px;
  }
  #stock-inicial-lista li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  #precio-pendiente-lista li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  #catalogo-sugerido-lista li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  #catalogo-sugerido-lista label {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  #stock-inicial-lista input {
    width: 96px;
  }
  #precio-pendiente-lista input {
    width: 160px;
  }
  .editor-ubicacion {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: end;
    animation: aparecer-editor 120ms ease-out;
  }
  .editor-ubicacion label input {
    display: block;
  }
  @keyframes aparecer-editor {
    from {
      opacity: 0;
      transform: translateY(-2px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .editor-ubicacion {
      animation: none;
    }
  }
</style>

<script>
  import { toast } from "sonner";
  import { derivarEstado, textoError } from "../../lib/panel-modulos.js";
  import { catalogoMil, marcarSkuSeleccionado, publicarCatalogo } from "../../lib/catalogo-panel.js";
  import { REQUERIDO, enteroMin, erroresDesdeZod, mensajeCampo } from "../../lib/errores-campo.js";
  import { limpiarErrores, mostrarErrores } from "../../lib/errores-campo-dom.js";
  import { mensajePesos, parsearPesos } from "../../lib/pesos.js";
  import { CLAVE_AVISO_UBICACIONES, mostrarAvisoUbicaciones } from "../../modules/onboarding/ubicaciones-aviso.js";
  import { avisoCatalogoDescartado, descartarAvisoCatalogo } from "../../modules/onboarding/catalogo-aviso.js";
  import {
    accionSiCodigoDuplicado,
    armarAltaProducto,
    mensajeErrorAlta,
  } from "../../modules/stock/alta-producto-panel.js";
  import {
    efectoCodigoDesconocido,
    efectoDeTecla,
    resolverLectura,
    sesionCamara,
  } from "../../modules/stock/escaner.js";

  const $ = (id) => document.getElementById(id);
  const tenantId = $("catalogo-sugerido")?.dataset.tenant ?? "";
  const mensaje = (estado, vacio) =>
    estado === "cargando" ? "Cargando…" : estado === "error" ? "Sin conexión con el servidor." : estado === "vacio" ? vacio : "";

  const pintarCatalogo = (items) => {
    publicarCatalogo(items);
    const conUmbral = items.filter((p) => p.min_stock !== null && p.min_stock !== undefined).length;
    $("stock-productos").textContent = String(items.length);
    $("stock-umbral").textContent = String(conUmbral);
    const resumen = $("stock-resumen");
    if (resumen) {
      resumen.textContent =
        items.length === 0
          ? "Sin productos cargados."
          : `${items.length} producto${items.length === 1 ? "" : "s"} · ${conUmbral} con stock mínimo`;
    }
    $("estado-stock").textContent = mensaje(
      derivarEstado({ cargando: false, error: false, items: items.length }),
      "Todavía no hay productos cargados.",
    );
  };

  const cargarCatalogo = () => {
    const harness = document.querySelector<HTMLElement>("[data-harness]")?.dataset.harness;
    if (harness === "mil") {
      pintarCatalogo(catalogoMil());
      return;
    }
    fetch("/api/products")
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => pintarCatalogo(j.productos || []))
      .catch((error) => {
        console.warn("[panel/stock] catálogo", error);
        $("stock-productos").textContent = "—";
        $("stock-umbral").textContent = "—";
        const resumen = $("stock-resumen");
        if (resumen) resumen.textContent = "No pudimos cargar el catálogo.";
        $("estado-stock").textContent = mensaje("error", "");
      });
  };

  const guardarStockInicial = async (item, input) => {
    const estado = $("estado-stock-inicial");
    // Vacío no es 0: un clic sin cargar nada no saca el producto de pendientes.
    const cantidad = input.value.trim() === "" ? NaN : Number(input.value);
    if (!Number.isInteger(cantidad) || cantidad < 0 || cantidad > 99999) {
      estado.textContent = "Escribí una cantidad entera entre 0 y 99999.";
      input.focus();
      return;
    }
    estado.textContent = "Guardando…";
    try {
      const r = await fetch("/api/stock/inicial", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ sku: item.sku, cantidad }),
      });
      if (r.status === 409) {
        estado.textContent = "Ese producto ya no está pendiente.";
        cargarStockInicialPanel();
        return;
      }
      if (!r.ok) {
        estado.textContent = "No se guardó la cantidad inicial.";
        return;
      }
      toast.success("Stock inicial guardado.");
      estado.textContent = "Cantidad guardada.";
      cargarStockInicialPanel();
      cargarCatalogo();
    } catch (error) {
      console.warn("[panel/stock] guardar stock inicial", error);
      estado.textContent = mensaje("error", "");
    }
  };

  const pintarStockInicial = (items, total) => {
    $("stock-inicial").hidden = total === 0;
    const lista = $("stock-inicial-lista");
    lista.textContent = "";
    items.forEach((p) => {
      const li = document.createElement("li");
      const nombre = document.createElement("span");
      nombre.textContent = p.nombre;
      const vendidas = document.createElement("span");
      vendidas.textContent = "vendidas en 30 días: " + p.vendidas30d;
      const input = document.createElement("input");
      input.type = "number";
      input.min = "0";
      input.max = "99999";
      input.step = "1";
      input.inputMode = "numeric";
      input.placeholder = "Cantidad";
      input.setAttribute("aria-label", "Cantidad inicial de " + p.nombre);
      const boton = document.createElement("button");
      boton.type = "button";
      boton.textContent = "Guardar";
      boton.addEventListener("click", () => guardarStockInicial(p, input));
      li.append(nombre, vendidas, input, boton);
      lista.appendChild(li);
    });
  };

  const cargarStockInicialPanel = () => {
    fetch("/api/stock/inicial")
      .then((r) => {
        if (r.status === 403) {
          $("stock-inicial").hidden = true;
          return null;
        }
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        if (j) pintarStockInicial(j.items || [], j.total || 0);
      })
      .catch((error) => {
        console.warn("[panel/stock] stock inicial", error);
        $("estado-stock-inicial").textContent = mensaje("error", "");
      });
  };

  const guardarPrecio = async (item, input) => {
    const estado = $("estado-precio-pendiente");
    const parseo = parsearPesos(input.value);
    if (!parseo.ok) {
      estado.textContent = mensajePesos(parseo.motivo);
      input.focus();
      return;
    }
    if (parseo.centavos < 1) {
      estado.textContent = "El precio tiene que ser mayor a 0.";
      input.focus();
      return;
    }
    estado.textContent = "Guardando…";
    try {
      const r = await fetch("/api/stock/precio", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ sku: item.sku, precio_centavos: parseo.centavos }),
      });
      if (r.status === 409) {
        estado.textContent = "Ese producto ya tiene precio.";
        cargarPreciosPendientes();
        return;
      }
      if (!r.ok) {
        estado.textContent = "No se guardó el precio.";
        return;
      }
      toast.success("Precio guardado.");
      estado.textContent = "Precio guardado.";
      cargarPreciosPendientes();
      cargarCatalogo();
    } catch (error) {
      console.warn("[panel/stock] guardar precio", error);
      estado.textContent = mensaje("error", "");
    }
  };

  const pintarPreciosPendientes = (items, total) => {
    $("precio-pendiente").hidden = total === 0;
    const lista = $("precio-pendiente-lista");
    lista.textContent = "";
    items.forEach((p) => {
      const li = document.createElement("li");
      const nombre = document.createElement("span");
      nombre.textContent = p.nombre;
      const vendidas = document.createElement("span");
      vendidas.textContent = "vendidas en 30 días: " + p.vendidas30d;
      const input = document.createElement("input");
      input.type = "text";
      input.inputMode = "decimal";
      input.placeholder = "Ej. 1.234,50";
      input.autocomplete = "off";
      input.setAttribute("aria-label", "Precio (pesos) de " + p.nombre);
      const etiqueta = document.createElement("label");
      etiqueta.textContent = "Precio (pesos)";
      etiqueta.appendChild(input);
      const boton = document.createElement("button");
      boton.type = "button";
      boton.textContent = "Guardar";
      boton.addEventListener("click", () => guardarPrecio(p, input));
      li.append(nombre, vendidas, etiqueta, boton);
      lista.appendChild(li);
    });
  };

  const cargarPreciosPendientes = () => {
    fetch("/api/stock/precio")
      .then((r) => {
        if (r.status === 403) {
          $("precio-pendiente").hidden = true;
          return null;
        }
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        if (j) pintarPreciosPendientes(j.items || [], j.total || 0);
      })
      .catch((error) => {
        console.warn("[panel/stock] precio pendiente", error);
        $("estado-precio-pendiente").textContent = mensaje("error", "");
      });
  };

  const ocultarCatalogoSugerido = () => {
    $("catalogo-sugerido").hidden = true;
  };

  const catalogoSugeridoDescartado = () => {
    try {
      return avisoCatalogoDescartado(localStorage, tenantId);
    } catch (error) {
      console.warn("[panel/stock] aviso catálogo", error);
      return false;
    }
  };

  const pintarCatalogoSugerido = (j) => {
    const productos = Array.isArray(j.productos) ? j.productos : [];
    if (j.sembrado === true || productos.length === 0 || catalogoSugeridoDescartado()) {
      ocultarCatalogoSugerido();
      return;
    }
    const lista = $("catalogo-sugerido-lista");
    lista.textContent = "";
    productos.forEach((nombre) => {
      const li = document.createElement("li");
      const label = document.createElement("label");
      const check = document.createElement("input");
      check.type = "checkbox";
      check.checked = true;
      check.value = nombre;
      label.append(check, " ", nombre);
      li.appendChild(label);
      lista.appendChild(li);
    });
    $("estado-catalogo-sugerido").textContent = "";
    $("catalogo-sugerido").hidden = false;
  };

  const cargarCatalogoSugerido = () => {
    if ($("catalogo-sugerido").dataset.puedeCrear === "no") return;
    fetch("/api/stock/plantilla")
      .then((r) => {
        if (r.status === 403) {
          ocultarCatalogoSugerido();
          return null;
        }
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        if (j) pintarCatalogoSugerido(j);
      })
      .catch((error) => {
        console.warn("[panel/stock] catálogo sugerido", error);
        $("estado-catalogo-sugerido").textContent = mensaje("error", "");
      });
  };

  const sembrarCatalogoSugerido = async (nombres) => {
    const estado = $("estado-catalogo-sugerido");
    estado.textContent = "Creando productos…";
    try {
      const r = await fetch("/api/stock/plantilla", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ nombres }),
      });
      if (r.status === 409) {
        estado.textContent = "Ya elegiste tu catálogo.";
        ocultarCatalogoSugerido();
        return;
      }
      if (!r.ok) {
        estado.textContent =
          r.status === 422 ? "Revisá los productos elegidos." : "No se crearon los productos.";
        return;
      }
      const j = await r.json().catch((error) => {
        console.warn("[panel/stock] respuesta sin JSON", r.status, error);
        return {};
      });
      toast.success("Productos creados sin precio.");
      estado.textContent = "Creados " + (j.cantidad ?? nombres.length) + " productos sin precio.";
      ocultarCatalogoSugerido();
      cargarCatalogo();
    } catch (error) {
      console.warn("[panel/stock] sembrar catálogo sugerido", error);
      estado.textContent = mensaje("error", "");
    }
  };

  $("catalogo-sugerido-crear").addEventListener("click", () => {
    const nombres = [...document.querySelectorAll<HTMLInputElement>("#catalogo-sugerido-lista input:checked")].map(
      (input) => input.value,
    );
    if (nombres.length === 0) {
      $("estado-catalogo-sugerido").textContent = "Elegí al menos un producto o usá \"No, gracias\".";
      return;
    }
    sembrarCatalogoSugerido(nombres);
  });
  $("catalogo-sugerido-no").addEventListener("click", () => {
    try {
      descartarAvisoCatalogo(localStorage, tenantId);
    } catch (error) {
      console.warn("[panel/stock] aviso catálogo", error);
    }
    ocultarCatalogoSugerido();
  });

  const buscarLotes = () => {
    const sku = $("lote-sku").value.trim().toUpperCase();
    return fetch("/api/lots?sku=" + encodeURIComponent(sku))
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        const items = j.lotes || [];
        const ul = $("lote-lista");
        ul.textContent = "";
        items.forEach((l) => {
          const li = document.createElement("li");
          li.textContent =
            l.sku + " · restante " + l.cantidadRestante + " de " + l.cantidad + " · " + (l.venceEl ? l.venceEl.slice(0, 10) : "sin vencimiento");
          ul.appendChild(li);
        });
        $("estado-lotes").textContent = mensaje(
          derivarEstado({ cargando: false, error: false, items: items.length }),
          sku ? "Sin lotes para " + sku + "." : "Sin lotes cargados.",
        );
      })
      .catch((error) => {
        console.warn("[panel/stock] lotes", error);
        $("estado-lotes").textContent = mensaje("error", "");
      });
  };

  const avisoDescartado = () => {
    try {
      return localStorage.getItem(CLAVE_AVISO_UBICACIONES) === "1";
    } catch (error) {
      console.warn("[panel/stock] aviso ubicaciones", error);
      return false;
    }
  };

  type UbicacionPanel = { id: string; nombre: string; archivada: boolean };

  const textoUbicacion = (u: UbicacionPanel) => (u.archivada ? u.nombre + " (archivada)" : u.nombre);

  const editarUbicacion = (
    li: HTMLLIElement,
    ubicacion: UbicacionPanel,
    texto: HTMLSpanElement,
    boton: HTMLButtonElement,
  ) => {
    if (li.querySelector(".editor-ubicacion")) return;
    texto.hidden = true;
    boton.hidden = true;
    const form = document.createElement("form");
    form.className = "editor-ubicacion";
    const label = document.createElement("label");
    label.textContent = "Nuevo nombre";
    const input = document.createElement("input");
    input.type = "text";
    input.maxLength = 80;
    input.autocomplete = "off";
    input.value = ubicacion.nombre;
    label.appendChild(input);
    const guardar = document.createElement("button");
    guardar.type = "submit";
    guardar.textContent = "Guardar";
    const cancelar = document.createElement("button");
    cancelar.type = "button";
    cancelar.textContent = "Cancelar";
    const estado = document.createElement("span");
    estado.className = "estado";
    estado.setAttribute("role", "status");
    estado.setAttribute("aria-live", "polite");
    form.append(label, guardar, cancelar, estado);

    const cerrar = (enfocar: boolean) => {
      form.remove();
      texto.hidden = false;
      boton.hidden = false;
      if (enfocar) boton.focus();
    };

    cancelar.addEventListener("click", () => cerrar(true));
    input.addEventListener("keydown", (evento) => {
      if (evento.key === "Escape") {
        evento.preventDefault();
        cerrar(true);
      }
    });
    form.addEventListener("submit", async (evento) => {
      evento.preventDefault();
      const nombre = input.value.trim();
      if (!nombre) {
        estado.textContent = "Escribí un nombre para la ubicación.";
        input.focus();
        return;
      }
      estado.textContent = "Guardando…";
      try {
        const r = await fetch("/api/locations", {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: ubicacion.id, nombre }),
        });
        const j = await r.json().catch((error) => {
          console.warn("[panel/stock] respuesta sin JSON", r.status, error);
          return {};
        });
        if (r.status === 409) {
          estado.textContent = "Ya tenés una ubicación con ese nombre. Elegí otro.";
          input.focus();
          return;
        }
        if (!r.ok) {
          estado.textContent =
            r.status === 404 ? "Esa ubicación ya no existe. Recargá la lista." : "No se renombró la ubicación.";
          return;
        }
        ubicacion.nombre = typeof j.nombre === "string" ? j.nombre : nombre;
        ubicacion.archivada = j.archivada === true;
        texto.textContent = textoUbicacion(ubicacion);
        boton.setAttribute("aria-label", "Renombrar " + ubicacion.nombre);
        toast.success("Ubicación renombrada.");
        cerrar(true);
      } catch (error) {
        console.warn("[panel/stock] renombrar ubicación", error);
        estado.textContent = mensaje("error", "");
      }
    });
    li.appendChild(form);
    input.focus();
    input.select();
  };

  const pintarSelectUbicaciones = (ubicaciones: UbicacionPanel[]) => {
    const select = $("alta-ubicacion");
    if (!(select instanceof HTMLSelectElement)) return;
    const elegida = select.value;
    select.replaceChildren();
    const vacia = document.createElement("option");
    vacia.value = "";
    vacia.textContent = "Sin ubicación";
    select.appendChild(vacia);
    ubicaciones.filter((u) => !u.archivada).forEach((u) => {
      const opt = document.createElement("option");
      opt.value = u.id;
      opt.textContent = u.nombre;
      select.appendChild(opt);
    });
    if (elegida && [...select.options].some((o) => o.value === elegida)) select.value = elegida;
  };

  const pintarUbicaciones = (ubicaciones: UbicacionPanel[], sembradas: boolean) => {
    pintarSelectUbicaciones(ubicaciones);
    const lista = $("ubicaciones-lista");
    lista.textContent = "";
    ubicaciones.forEach((u) => {
      const li = document.createElement("li");
      const texto = document.createElement("span");
      texto.textContent = textoUbicacion(u);
      const boton = document.createElement("button");
      boton.type = "button";
      boton.textContent = "Renombrar";
      boton.setAttribute("aria-label", "Renombrar " + u.nombre);
      boton.addEventListener("click", () => editarUbicacion(li, u, texto, boton));
      li.append(texto, " ", boton);
      lista.appendChild(li);
    });
    $("estado-ubicaciones").textContent = mensaje(
      derivarEstado({ cargando: false, error: false, items: ubicaciones.length }),
      "Todavía no hay ubicaciones.",
    );
    $("aviso-ubicaciones").hidden = !mostrarAvisoUbicaciones({
      sembradasPorRubro: sembradas,
      descartado: avisoDescartado(),
    });
  };

  const cargarUbicaciones = () => {
    fetch("/api/locations")
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => pintarUbicaciones(j.ubicaciones || [], j.sembradas_por_rubro === true))
      .catch((error) => {
        console.warn("[panel/stock] ubicaciones", error);
        $("estado-ubicaciones").textContent = mensaje("error", "");
      });
  };

  $("aviso-ubicaciones-cerrar").addEventListener("click", () => {
    $("aviso-ubicaciones").hidden = true;
    try {
      localStorage.setItem(CLAVE_AVISO_UBICACIONES, "1");
    } catch (error) {
      console.warn("[panel/stock] aviso ubicaciones", error);
    }
  });

  $("ubicacion-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    const form = evento.currentTarget as HTMLFormElement;
    limpiarErrores(form);
    const estado = $("estado-ubicaciones");
    const nombre = $("ubicacion-nombre").value.trim();
    if (!nombre) {
      mostrarErrores(form, { nombre: mensajeCampo("nombre", REQUERIDO) });
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    estado.textContent = "Creando ubicación…";
    try {
      const r = await fetch("/api/locations", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ nombre }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/stock] respuesta sin JSON", r.status, error);
        return {};
      });
      if (r.status === 409) {
        toast.error("Ya tenés una ubicación con ese nombre. Elegí otro nombre.");
        estado.textContent = "Esa ubicación ya existe. Cambiale el nombre para crearla.";
        $("ubicacion-nombre").focus();
        return;
      }
      if (!r.ok) {
        if (mostrarErrores(form, erroresDesdeZod(j.error))) {
          estado.textContent = "Revisá los campos marcados.";
          return;
        }
        toast.error(textoError(j.error, r.status));
        estado.textContent = "No se creó la ubicación.";
        return;
      }
      toast.success("Ubicación creada.");
      form.reset();
      cargarUbicaciones();
    } catch (error) {
      console.warn("[panel/stock] alta ubicación", error);
      toast.error("Sin conexión con el servidor.");
      estado.textContent = mensaje("error", "");
    }
  });

  const abrirAltaConCodigo = (codigo: string, destinoSku?: HTMLInputElement | null) => {
    const seccion = $("alta-producto-card");
    const codigoInput = $("alta-codigo");
    if (!(seccion instanceof HTMLElement) || !(codigoInput instanceof HTMLInputElement)) return;
    seccion.scrollIntoView({ behavior: "smooth", block: "start" });
    codigoInput.value = codigo.trim();
    $("alta-nombre").focus();
    if (destinoSku) destinoSku.value = "";
  };

  const mostrarDesconocidoConAlta = (estado: HTMLElement, codigo: string, destinoSku?: HTMLInputElement | null) => {
    const efecto = efectoCodigoDesconocido();
    estado.replaceChildren();
    estado.append(efecto.mensaje + " ");
    // STOCK-S2 [rol]: el alta por código desconocido no pide crear_productos;
    // el alta al vuelo crea el producto sin chequear rol, igual que en /venta.
    if (!efecto.crearProducto) return;
    const btn = document.createElement("button");
    btn.type = "button";
    btn.textContent = "Crear producto con este código";
    btn.addEventListener("click", () => abrirAltaConCodigo(codigo, destinoSku));
    estado.appendChild(btn);
  };

  const ocultarDuplicadoAlta = () => {
    const acciones = $("alta-duplicado-acciones");
    if (acciones) acciones.hidden = true;
  };

  $("alta-producto-form")?.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    const form = evento.currentTarget as HTMLFormElement;
    limpiarErrores(form);
    ocultarDuplicadoAlta();
    const estado = $("estado-alta-producto");
    const nombre = $("alta-nombre").value.trim();
    const codigo = $("alta-codigo").value.trim();
    const errores: Record<string, string> = {};
    if (!nombre) errores.nombre = mensajeCampo("nombre", REQUERIDO);
    const precio = parsearPesos($("alta-precio").value);
    if ($("alta-precio").value.trim() !== "" && !precio.ok) errores.precio = mensajePesos(precio.motivo);
    const cantidadRaw = $("alta-cantidad").value.trim();
    const cantidad = cantidadRaw === "" ? 0 : Number($("alta-cantidad").value);
    if (cantidadRaw !== "" && (!Number.isInteger(cantidad) || cantidad < 0)) {
      errores.cantidad = mensajeCampo("cantidad", enteroMin(0));
    }
    if (Object.keys(errores).length > 0) {
      mostrarErrores(form, errores);
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    const ubicacion = $("alta-ubicacion");
    const locationId = ubicacion instanceof HTMLSelectElement && ubicacion.value ? ubicacion.value : undefined;
    const cuerpo = armarAltaProducto({
      nombre,
      ...(codigo ? { codigo } : {}),
      precioCentavos: precio.ok ? precio.centavos : 0,
      entropiaSku: crypto.randomUUID(),
      ...(locationId ? { locationId } : {}),
    });
    estado.textContent = "Guardando producto…";
    const idemAlta = crypto.randomUUID();
    try {
      const r = await fetch("/api/products", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Idempotency-Key": idemAlta },
        body: JSON.stringify(cuerpo),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/stock] alta producto sin JSON", r.status, error);
        return {};
      });
      if (!r.ok) {
        if (mostrarErrores(form, erroresDesdeZod(j.error))) {
          estado.textContent = "Revisá los campos marcados.";
          return;
        }
        const accionDuplicado = accionSiCodigoDuplicado(
          r.status,
          j.error,
          Array.isArray(j.productos) ? j.productos : [],
        );
        if (accionDuplicado.tipo === "abrir") {
          estado.textContent = accionDuplicado.mensaje;
          const acciones = $("alta-duplicado-acciones");
          const abrir = $("alta-abrir-existente");
          if (acciones && abrir) {
            acciones.hidden = false;
            abrir.onclick = () => {
              marcarSkuSeleccionado(accionDuplicado.sku);
              $("lote-sku").value = accionDuplicado.sku;
              $("ingreso-sku").value = accionDuplicado.sku;
              toast.success("SKU " + accionDuplicado.sku + " listo para ingreso o lotes.");
            };
          }
          return;
        }
        if (r.status === 409 && codigo) {
          const busqueda = await fetch("/api/products?codigo=" + encodeURIComponent(codigo));
          if (busqueda.ok) {
            const jb = await busqueda.json();
            const dup = accionSiCodigoDuplicado(409, "codigo duplicado", jb.productos ?? []);
            if (dup.tipo === "abrir") {
              estado.textContent = dup.mensaje;
              const acciones = $("alta-duplicado-acciones");
              const abrir = $("alta-abrir-existente");
              if (acciones && abrir) {
                acciones.hidden = false;
                abrir.onclick = () => {
                  marcarSkuSeleccionado(dup.sku);
                  $("lote-sku").value = dup.sku;
                  $("ingreso-sku").value = dup.sku;
                };
              }
              return;
            }
          }
        }
        toast.error(mensajeErrorAlta(r.status, j.error));
        estado.textContent = mensajeErrorAlta(r.status, j.error);
        return;
      }
      const skuCreado = typeof j.sku === "string" ? j.sku : cuerpo.sku;
      if (cantidad > 0) {
        const idemIngreso = idemAlta;
        const ingreso = await fetch("/api/stock/ingreso", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Idempotency-Key": idemIngreso },
          body: JSON.stringify({
            sku: skuCreado,
            cantidad,
            costo_centavos: precio.ok ? precio.centavos : 0,
            controla_vencimiento: false,
            vence_el: null,
          }),
        });
        if (!ingreso.ok) {
          toast.error("Producto creado, pero no se cargó el stock inicial.");
          estado.textContent = "Producto creado. Revisá el ingreso de mercadería para cargar stock.";
        }
      }
      toast.success("Producto guardado.");
      estado.textContent = "Producto " + skuCreado + " guardado.";
      form.reset();
      ocultarDuplicadoAlta();
      cargarCatalogo();
      marcarSkuSeleccionado(skuCreado);
    } catch (error) {
      console.warn("[panel/stock] alta producto", error);
      estado.textContent = mensaje("error", "");
    }
  });

  ["lote-sku", "ingreso-sku"].forEach((id) =>
    $(id).addEventListener("input", (evento) => marcarSkuSeleccionado((evento.currentTarget as HTMLInputElement).value)),
  );
  $("lote-buscar").addEventListener("click", buscarLotes);

  // STOCK-E4: Enter es el cierre del lector. No abre la cámara ni crea el producto.
  const resolverEnPantalla = (raw: string) => resolverLectura({
    raw,
    tenantId,
    skusLocales: [],
    fetch: (url) => fetch(url),
  });
  const avisarDesconocido = (estado: HTMLElement, codigo: string, destinoSku?: HTMLInputElement | null) => {
    mostrarDesconocidoConAlta(estado, codigo, destinoSku);
  };
  const alEnter = (input: HTMLInputElement, estado: HTMLElement, despues: (sku: string) => void) => {
    input.addEventListener("keydown", async (ev) => {
      const efecto = efectoDeTecla(ev.key);
      if (!efecto.buscar || efecto.abrirCamara) return;
      ev.preventDefault();
      const res = await resolverEnPantalla(input.value);
      if (res.estado === "encontrado") {
        input.value = res.sku;
        input.dispatchEvent(new Event("input"));
        despues(res.sku);
        return;
      }
      if (res.estado === "desconocido") avisarDesconocido(estado, input.value, input);
    });
  };
  alEnter($("lote-sku"), $("estado-lotes"), () => { buscarLotes(); });
  alEnter($("ingreso-sku"), $("estado-ingreso"), () => {});
  let campoCamara = $("lote-sku");
  for (const id of ["lote-sku", "ingreso-sku", "alta-codigo"]) {
    $(id)?.addEventListener("focus", () => { campoCamara = $(id); });
  }
  $("alta-leer-camara")?.addEventListener("click", () => {
    const altaCodigo = $("alta-codigo");
    if (altaCodigo instanceof HTMLInputElement) {
      campoCamara = altaCodigo;
      $("leer-camara").click();
    }
  });
  let sesion: { cerrar: () => void } | null = null;
  $("leer-camara").addEventListener("click", async () => {
    const video = $("camara-video");
    if (!(video instanceof HTMLVideoElement)) return;
    if (sesion) {
      sesion.cerrar();
      sesion = null;
      return;
    }
    const destino = campoCamara;
    sesion = sesionCamara(video);
    try {
      const codigo = await sesion.leer();
      sesion = null;
      if (!codigo) return;
      const estado =
        destino.id === "ingreso-sku"
          ? $("estado-ingreso")
          : destino.id === "alta-codigo"
            ? $("estado-alta-producto")
            : $("estado-lotes");
      const res = await resolverEnPantalla(codigo);
      if (res.estado === "encontrado") {
        destino.value = res.sku;
        destino.dispatchEvent(new Event("input"));
        if (destino.id === "lote-sku") buscarLotes();
        return;
      }
      avisarDesconocido(estado, codigo, destino);
    } catch (error) {
      console.warn("[panel/stock] cámara", error);
      if (sesion) sesion.cerrar();
      sesion = null;
      $("estado-lotes").textContent = "No se pudo abrir la cámara.";
    }
  });

  $("ingreso-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    limpiarErrores(evento.currentTarget as HTMLElement);
    const estado = $("estado-ingreso");
    const form = $("ingreso-form");
    const sku = $("ingreso-sku").value.trim();
    const cantidad = Number($("ingreso-cantidad").value);
    const costo = parsearPesos($("ingreso-costo").value);
    const errores = {};
    if (!sku) errores.sku = mensajeCampo("sku", REQUERIDO);
    if (!Number.isInteger(cantidad) || cantidad < 1) errores.cantidad = mensajeCampo("cantidad", enteroMin(1));
    if (!costo.ok) errores.costo_centavos = mensajePesos(costo.motivo);
    if (Object.keys(errores).length > 0) {
      mostrarErrores(form, errores);
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    const vence = $("ingreso-vence").value;
    estado.textContent = "Ingresando…";
    try {
      const r = await fetch("/api/stock/ingreso", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
        body: JSON.stringify({
          sku,
          cantidad: Number($("ingreso-cantidad").value),
          costo_centavos: costo.ok ? costo.centavos : 0,
          controla_vencimiento: vence !== "",
          vence_el: vence === "" ? null : new Date(vence).toISOString(),
        }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/stock] respuesta sin JSON", r.status, error);
        return {};
      });
      if (!r.ok) {
        if (mostrarErrores(form, erroresDesdeZod(j.error))) {
          estado.textContent = "Revisá los campos marcados.";
          return;
        }
        estado.textContent = "No se ingresó: " + textoError(j.error, r.status) + ".";
        return;
      }
      estado.textContent = "Lote ingresado: " + (j.id || sku) + ".";
      cargarCatalogo();
      if ($("lote-sku").value.trim()) buscarLotes();
    } catch (error) {
      console.warn("[panel/stock] ingreso", error);
      estado.textContent = mensaje("error", "");
    }
  });

  // P1-39: formulario CAT-S6 (POST /api/counts + PATCH confirmar dueño).
  $("conteo-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    limpiarErrores(evento.currentTarget as HTMLElement);
    const estado = $("estado-conteo");
    const form = $("conteo-form");
    const sku = $("conteo-sku").value.trim();
    const fisico = Number($("conteo-fisico").value);
    const contadoPor = $("conteo-por").value.trim() || "panel";
    const motivo = $("conteo-motivo").value.trim() || "Ajuste por conteo";
    const errores = {};
    if (!sku) errores.sku = mensajeCampo("sku", REQUERIDO);
    if (!Number.isInteger(fisico) || fisico < 0) errores.fisico = mensajeCampo("fisico", REQUERIDO);
    if (Object.keys(errores).length > 0) {
      mostrarErrores(form, errores);
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    estado.textContent = "Creando conteo…";
    try {
      const crear = await fetch("/api/counts", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
        body: JSON.stringify({ contado_por: contadoPor, lineas: [{ sku, fisico }] }),
      });
      const creado = await crear.json().catch((error) => {
        console.warn("[panel/stock] conteo sin JSON", crear.status, error);
        return {};
      });
      if (!crear.ok) {
        if (mostrarErrores(form, erroresDesdeZod(creado.error))) {
          estado.textContent = "Revisá los campos marcados.";
          return;
        }
        estado.textContent = "No se creó el conteo: " + textoError(creado.error, crear.status) + ".";
        return;
      }
      estado.textContent = "Confirmando ajuste…";
      const conf = await fetch("/api/counts?id=" + encodeURIComponent(creado.id), {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ rol: "dueno", confirmado_por: contadoPor, motivo }),
      });
      const j = await conf.json().catch((error) => {
        console.warn("[panel/stock] confirmar conteo sin JSON", conf.status, error);
        return {};
      });
      if (!conf.ok) {
        estado.textContent =
          "Conteo " + creado.id + " creado, pero no se confirmó: " + textoError(j.error, conf.status) + ".";
        return;
      }
      estado.textContent = "Conteo confirmado: " + creado.id + " · " + (j.estado || "confirmado") + ".";
      cargarCatalogo();
    } catch (error) {
      console.warn("[panel/stock] conteo", error);
      estado.textContent = mensaje("error", "");
    }
  });

  cargarCatalogo();
  cargarCatalogoSugerido();
  cargarStockInicialPanel();
  cargarPreciosPendientes();
  buscarLotes();
  cargarUbicaciones();
</script>
