---
import PanelShell from "../../components/panel/PanelShell.astro";
---
<PanelShell titulo="Proveedores" subtitulo="Alta, órdenes de compra y cuenta corriente." activo="proveedores">
  <div class="grid dos">
    <section class="card">
      <h2>Alta de proveedor</h2>
      <form id="prov-form">
        <div class="fila">
          <label>CUIT
            <input id="prov-cuit" data-campo="cuit" type="text" inputmode="numeric" placeholder="20123456789" autocomplete="off" />
          </label>
          <label>Nombre
            <input id="prov-nombre" data-campo="nombre" type="text" placeholder="Distribuidora Sur" autocomplete="off" />
          </label>
        </div>
        <div class="fila">
          <label>Email
            <input id="prov-email" data-campo="email" type="email" inputmode="email" placeholder="ventas@proveedor.com" autocomplete="off" />
          </label>
          <label>Teléfono
            <input id="prov-telefono" data-campo="telefono" type="tel" inputmode="tel" placeholder="1145551234" autocomplete="off" />
          </label>
        </div>
        <button id="prov-enviar" type="submit">Dar de alta</button>
        <div class="estado" id="estado-prov" role="status">Completá CUIT y nombre.</div>
      </form>
    </section>

    <section class="card">
      <h2>Cuenta corriente</h2>
      <label>Buscar proveedor
        <input id="cta-q" type="search" placeholder="Nombre o CUIT" autocomplete="off" />
      </label>
      <ul class="opciones" id="cta-opciones" aria-label="Proveedores encontrados"></ul>
      <div class="estado" id="estado-cta-q" role="status"></div>
      <div class="fila">
        <label>CUIT
          <input id="cta-cuit" type="text" inputmode="numeric" placeholder="20123456789" autocomplete="off" />
        </label>
        <button id="cta-buscar" type="button">Consultar</button>
      </div>
      <ul class="lista" id="cta-lista"></ul>
      <div class="estado" id="estado-cta" role="status">Cargá un CUIT para ver el saldo.</div>
    </section>
  </div>

  <div class="grid dos">
    <section class="card">
      <h2>Nueva orden de compra</h2>
      <form id="oc-form">
        <div class="fila">
          <label>CUIT proveedor
            <input id="oc-cuit" data-campo="supplier_cuit" type="text" inputmode="numeric" placeholder="20123456789" autocomplete="off" />
          </label>
          <label>Creada por
            <input id="oc-creado-por" data-campo="creado_por" type="text" value="panel-web" autocomplete="off" />
          </label>
        </div>
        <div class="fila">
          <label>SKU
            <input id="oc-sku" data-campo="sku" type="text" placeholder="demo-sku-1" autocomplete="off" />
          </label>
          <label>Cantidad
            <input id="oc-cantidad" data-campo="qty" type="number" min="1" step="1" inputmode="numeric" value="1" />
          </label>
          <label>Costo en centavos
            <input id="oc-costo" data-campo="costo_centavos" type="number" min="0" step="1" inputmode="numeric" value="0" />
          </label>
        </div>
        <button id="oc-enviar" type="submit">Crear orden</button>
        <div class="estado" id="estado-oc" role="status">Cargá CUIT, SKU y cantidad.</div>
      </form>
    </section>

    <section class="card">
      <h2>Cerrar orden</h2>
      <form id="oc-cerrar-form">
        <div class="fila">
          <label>Orden
            <input id="oc-cerrar-id" data-campo="order_id" type="text" maxlength="128" placeholder="Se completa al crear" autocomplete="off" />
          </label>
          <label>Cerrada por
            <input id="oc-cerrar-quien" data-campo="quien" type="text" maxlength="128" value="panel-web" autocomplete="off" />
          </label>
        </div>
        <button id="oc-cerrar-enviar" type="submit">Cerrar orden</button>
        <div class="estado" id="estado-oc-cerrar" role="status">Se completa con la orden que acabás de crear.</div>
      </form>
    </section>
  </div>

  <section class="card">
    <h2>Invitación de proveedores por WhatsApp</h2>
    <p class="estado">El proveedor manda <span style="font-family:monospace">PROV &lt;código&gt;</span> al WhatsApp del comercio. El código vence en 30 minutos y se usa una sola vez.</p>
    <button id="prov-invitar" type="button">Generar código de invitación</button>
    <div class="estado" id="estado-prov-invitar" role="status">Se usa el CUIT del formulario de alta si ya lo cargaste.</div>
    <ul class="lista" id="prov-invitar-lista"></ul>
    <h3>Contactos de proveedores</h3>
    <ul class="lista" id="prov-contactos"></ul>
    <div class="estado" id="estado-prov-contactos" role="status">Sin contactos todavía.</div>
  </section>
</PanelShell>

<style is:global>
  .panel-shell .opciones { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 4px; }
  .panel-shell .opciones button { width: 100%; min-height: 44px; text-align: left; background: var(--tema-linea); color: var(--tema-texto); border: 1px solid var(--tema-linea); border-radius: 12px; font-weight: 500; }
  .panel-shell .opciones button:hover { border-color: var(--tema-texto-suave); }
</style>

<script>
  import { derivarEstado, formatearCentavos, textoError } from "../../lib/panel-modulos.js";
  import { CUIT, EMAIL, REQUERIDO, TELEFONO, enteroMin, erroresDesdeZod, mensajeCampo } from "../../lib/errores-campo.js";
  import { limpiarErrores, mostrarErrores } from "../../lib/errores-campo-dom.js";
  import { confirmar } from "../../lib/confirmar-dom.js";

  const $ = (id) => document.getElementById(id);
  const mensaje = (estado, vacio) =>
    estado === "cargando" ? "Cargando…" : estado === "error" ? "Sin conexión con el servidor." : estado === "vacio" ? vacio : "";

  const cargarCuenta = (cuit) => {
    $("estado-cta").textContent = "Cargando…";
    return fetch("/api/supplier-invoices/account?cuit=" + encodeURIComponent(cuit))
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        const filas = [
          ["Facturado", formatearCentavos(j.totalFacturadoCentavos)],
          ["Pagado", formatearCentavos(j.totalPagadoCentavos)],
          ["Saldo", formatearCentavos(j.saldoCentavos)],
        ];
        const ul = $("cta-lista");
        ul.textContent = "";
        filas.forEach(([etiqueta, valor]) => {
          const li = document.createElement("li");
          li.textContent = etiqueta + " · " + valor;
          ul.appendChild(li);
        });
        const debe = Number(j.saldoCentavos) > 0;
        $("estado-cta").textContent =
          mensaje(derivarEstado({ cargando: false, error: false, items: filas.length }), "Sin movimientos con el proveedor.") ||
          (debe ? "Saldo pendiente con el proveedor." : "Cuenta al día.");
      })
      .catch((error) => {
        console.warn("[panel/proveedores] cuenta", error);
        $("cta-lista").textContent = "";
        $("estado-cta").textContent = mensaje("error", "");
      });
  };

  $("cta-buscar").addEventListener("click", () => {
    const cuit = $("cta-cuit").value.trim();
    if (!cuit) {
      $("estado-cta").textContent = "Escribí el CUIT del proveedor.";
      return;
    }
    cargarCuenta(cuit);
  });

  const elegirProveedor = (item) => {
    $("cta-cuit").value = item.cuit;
    $("oc-cuit").value = item.cuit;
    $("cta-cuit").focus();
    $("estado-cta-q").textContent = "Elegido: " + item.nombre + ".";
  };

  let temporizador = null;
  const buscarProveedores = (texto) => {
    const lista = $("cta-opciones");
    const estado = $("estado-cta-q");
    lista.textContent = "";
    if (!texto) {
      estado.textContent = "";
      return;
    }
    estado.textContent = "Buscando…";
    fetch("/api/suppliers?q=" + encodeURIComponent(texto) + "&limit=8")
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        const items = j.items ?? [];
        lista.textContent = "";
        items.forEach((item) => {
          const li = document.createElement("li");
          const boton = document.createElement("button");
          boton.type = "button";
          boton.textContent = item.nombre + " · " + item.cuit;
          boton.addEventListener("click", () => {
            elegirProveedor(item);
            lista.textContent = "";
            estado.textContent = "";
          });
          li.appendChild(boton);
          lista.appendChild(li);
        });
        estado.textContent = items.length > 0 ? "" : "Sin resultados.";
      })
      .catch((error) => {
        console.warn("[panel/proveedores] buscador", error);
        lista.textContent = "";
        estado.textContent = mensaje("error", "");
      });
  };

  $("cta-q").addEventListener("input", () => {
    clearTimeout(temporizador);
    const texto = $("cta-q").value.trim();
    temporizador = setTimeout(() => buscarProveedores(texto), 250);
  });

  $("prov-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    limpiarErrores(evento.currentTarget as HTMLElement);
    const estado = $("estado-prov");
    const form = $("prov-form");
    const cuit = $("prov-cuit").value.trim();
    const nombre = $("prov-nombre").value.trim();
    const email = $("prov-email").value.trim();
    const telefono = $("prov-telefono").value.trim();
    const errores = {};
    if (!cuit) errores.cuit = mensajeCampo("cuit", REQUERIDO);
    else if (cuit.replace(/\D/g, "").length !== 11) errores.cuit = mensajeCampo("cuit", CUIT);
    if (!nombre) errores.nombre = mensajeCampo("nombre", REQUERIDO);
    if (email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) errores.email = mensajeCampo("email", EMAIL);
    if (telefono && telefono.replace(/\D/g, "").length < 6) errores.telefono = mensajeCampo("telefono", TELEFONO);
    if (Object.keys(errores).length > 0) {
      mostrarErrores(form, errores);
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    estado.textContent = "Dando de alta…";
    try {
      const r = await fetch("/api/suppliers", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          cuit,
          nombre,
          ...(email ? { email } : {}),
          ...(telefono ? { telefono } : {}),
        }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/proveedores] respuesta sin JSON", r.status, error);
        return {};
      });
      if (!r.ok) {
        if (mostrarErrores(form, erroresDesdeZod(j.error))) {
          estado.textContent = "Revisá los campos marcados.";
          return;
        }
        estado.textContent = "No se dio de alta: " + textoError(j.error, r.status) + ".";
        return;
      }
      estado.textContent = "Proveedor " + (j.cuit || cuit) + " creado.";
      $("prov-form").reset();
    } catch (error) {
      console.warn("[panel/proveedores] alta", error);
      estado.textContent = mensaje("error", "");
    }
  });

  const decidirContacto = (numero, estado) => {
    fetch("/api/suppliers/contactos/decidir", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ numero, estado }),
    })
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return refrescarContactos();
      })
      .catch((error) => {
        console.warn("[panel/proveedores] decidir contacto", error);
        $("estado-prov-contactos").textContent = "No se pudo actualizar el contacto.";
      });
  };

  const refrescarContactos = () => {
    const lista = $("prov-contactos");
    const estado = $("estado-prov-contactos");
    estado.textContent = "Cargando…";
    return fetch("/api/suppliers/contactos")
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        const items = j.items ?? [];
        lista.textContent = "";
        items.forEach((item) => {
          const li = document.createElement("li");
          const texto = document.createElement("span");
          const etiqueta = item.estado === "verificado" ? "verificado" : item.estado === "revocado" ? "revocado" : "pendiente";
          texto.textContent = item.numeroE164 + " · " + etiqueta;
          li.appendChild(texto);
          if (item.estado !== "verificado") {
            const aprobar = document.createElement("button");
            aprobar.type = "button";
            aprobar.textContent = "Aprobar";
            aprobar.addEventListener("click", () => decidirContacto(item.numeroE164, "verificado"));
            li.appendChild(aprobar);
          }
          if (item.estado !== "revocado") {
            const revocar = document.createElement("button");
            revocar.type = "button";
            revocar.textContent = "Revocar";
            revocar.addEventListener("click", () => decidirContacto(item.numeroE164, "revocado"));
            li.appendChild(revocar);
          }
          lista.appendChild(li);
        });
        estado.textContent = items.length > 0 ? "" : "Sin contactos todavía.";
      })
      .catch((error) => {
        console.warn("[panel/proveedores] contactos", error);
        lista.textContent = "";
        estado.textContent = mensaje("error", "");
      });
  };

  $("prov-invitar").addEventListener("click", async () => {
    const estado = $("estado-prov-invitar");
    const lista = $("prov-invitar-lista");
    const cuit = $("prov-cuit").value.trim();
    estado.textContent = "Generando…";
    lista.textContent = "";
    try {
      const r = await fetch("/api/suppliers/invitar", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(cuit ? { cuit } : {}),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/proveedores] invitar sin JSON", r.status, error);
        return {};
      });
      if (!r.ok) {
        estado.textContent = "No se generó: " + textoError(j.error, r.status) + ".";
        return;
      }
      estado.textContent = "Código válido por " + j.vence_en_min + " minutos.";
      const li = document.createElement("li");
      li.textContent = "Mandale al proveedor: PROV " + j.codigo;
      lista.appendChild(li);
      refrescarContactos();
    } catch (error) {
      console.warn("[panel/proveedores] invitar", error);
      estado.textContent = mensaje("error", "");
    }
  });

  refrescarContactos();

  $("oc-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    limpiarErrores(evento.currentTarget as HTMLElement);
    const estado = $("estado-oc");
    const form = $("oc-form");
    const cuit = $("oc-cuit").value.trim();
    const sku = $("oc-sku").value.trim();
    const cantidad = Number($("oc-cantidad").value);
    const costo = Number($("oc-costo").value);
    const errores = {};
    if (!cuit) errores.supplier_cuit = mensajeCampo("supplier_cuit", REQUERIDO);
    else if (cuit.replace(/\D/g, "").length !== 11) errores.supplier_cuit = mensajeCampo("supplier_cuit", CUIT);
    if (!sku) errores.sku = mensajeCampo("sku", REQUERIDO);
    if (!Number.isInteger(cantidad) || cantidad < 1) errores.qty = mensajeCampo("qty", enteroMin(1));
    if (!Number.isInteger(costo) || costo < 0) errores.costo_centavos = mensajeCampo("costo_centavos", enteroMin(0));
    if (Object.keys(errores).length > 0) {
      mostrarErrores(form, errores);
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    estado.textContent = "Creando orden…";
    try {
      const r = await fetch("/api/purchase-orders", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
        body: JSON.stringify({
          supplier_cuit: cuit,
          lineas: [
            {
              sku,
              qty: Number($("oc-cantidad").value),
              costo_centavos: Number($("oc-costo").value),
            },
          ],
          creado_por: $("oc-creado-por").value.trim() || "panel-web",
        }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/proveedores] respuesta sin JSON", r.status, error);
        return {};
      });
      if (!r.ok) {
        if (mostrarErrores(form, erroresDesdeZod(j.error))) {
          estado.textContent = "Revisá los campos marcados.";
          return;
        }
        estado.textContent = "No se creó: " + textoError(j.error, r.status) + ".";
        return;
      }
      estado.textContent = "Orden " + j.order_id + " creada por " + formatearCentavos(j.total_centavos) + ".";
      if (j.order_id) $("oc-cerrar-id").value = j.order_id;
    } catch (error) {
      console.warn("[panel/proveedores] orden", error);
      estado.textContent = mensaje("error", "");
    }
  });

  // P1-44: el dueño cierra acá la OC que acaba de crear. El cierre es terminal
  // y la ruta no lee Idempotency-Key.
  $("oc-cerrar-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    limpiarErrores(evento.currentTarget as HTMLElement);
    const estado = $("estado-oc-cerrar");
    const form = $("oc-cerrar-form");
    const orderId = $("oc-cerrar-id").value.trim();
    const quien = $("oc-cerrar-quien").value.trim() || "panel-web";
    if (!$("oc-cerrar-quien").value.trim()) $("oc-cerrar-quien").value = quien;
    if (!orderId) {
      mostrarErrores(form, { order_id: mensajeCampo("order_id", REQUERIDO) });
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    const confirmado = await confirmar({
      titulo: "Cerrar orden de compra",
      mensaje: "Vas a cerrar " + orderId + ". No se puede reabrir.",
      accion: "Cerrar orden",
    });
    if (!confirmado) return;
    estado.textContent = "Cerrando orden…";
    try {
      const r = await fetch("/api/purchase-orders/close", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ order_id: orderId, quien }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/proveedores] cierre sin JSON", r.status, error);
        return {};
      });
      if (!r.ok) {
        if (mostrarErrores(form, erroresDesdeZod(j.error))) {
          estado.textContent = "Revisá los campos marcados.";
          return;
        }
        estado.textContent = "No se cerró: " + textoError(j.error, r.status) + ".";
        return;
      }
      estado.textContent = "Orden " + (j.order_id || orderId) + " cerrada.";
      $("oc-cerrar-id").value = "";
    } catch (error) {
      console.warn("[panel/proveedores] cierre", error);
      estado.textContent = mensaje("error", "");
    }
  });
</script>
