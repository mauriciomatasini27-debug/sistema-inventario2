---
import PanelShell from "../../components/panel/PanelShell.astro";
import TablaCatalogo from "../../components/panel/TablaCatalogo.tsx";
import { modoHarnessCatalogo } from "../../lib/catalogo-panel.js";
import { tenantDeRequest } from "../../lib/tenant-context.js";

const harness = modoHarnessCatalogo(Astro.url, import.meta.env.DEV);
const tenant = tenantDeRequest(Astro.request);
const tenantId = tenant.ok ? tenant.tenantId : "";
---
<PanelShell titulo="Precios" subtitulo="Precios vigentes y previsualización de ajustes." activo="precios">
  <div class="grid dos" data-tenant={tenantId}>
    <section class="card" data-harness={harness}>
      <h2>Precios vigentes</h2>
      <TablaCatalogo client:visible columnas="precios" etiqueta="Precios vigentes" />
      <div class="estado" id="estado-precios" role="status">Cargando…</div>
    </section>

    <section class="card">
      <h2>Previsualizar ajuste</h2>
      <form id="preview-form">
        <label>Producto
          <select id="preview-sku" data-campo="sku"></select>
        </label>
        <div class="fila">
          <label>Dirección
            <select id="preview-direccion" data-campo="direccion"><option value="suba">Suba</option><option value="baja">Baja</option></select>
          </label>
          <label>Porcentaje
            <input id="preview-porcentaje" data-campo="porcentaje" type="number" min="0.01" max="3000" step="0.01" inputmode="decimal" value="10" />
          </label>
        </div>
        <button id="preview-enviar" type="submit">Previsualizar</button>
        <button id="ajuste-confirmar" type="button" hidden>Confirmar ajuste</button>
        <div class="estado" id="estado-preview" role="status">Elegí un producto y previsualizá el ajuste.</div>
      </form>
    </section>
  </div>
</PanelShell>

<script>
  import { formatearPesos } from "../../lib/pesos.js";
  import { derivarEstado, textoError } from "../../lib/panel-modulos.js";
  import { catalogoMil, marcarSkuSeleccionado, publicarCatalogo } from "../../lib/catalogo-panel.js";
  import { cargarCatalogoPanel, type CargaEnCurso } from "../../lib/catalogo-carga.js";
  import { PORCENTAJE, REQUERIDO, erroresDesdeZod, mensajeCampo } from "../../lib/errores-campo.js";
  import { limpiarErrores, mostrarErrores } from "../../lib/errores-campo-dom.js";
  import { confirmar } from "../../lib/confirmar-dom.js";

  const $ = (id) => document.getElementById(id);
  const mensaje = (estado, vacio) =>
    estado === "cargando" ? "Cargando…" : estado === "error" ? "Sin conexión con el servidor." : estado === "vacio" ? vacio : "";
  let vigentes = [];
  // P1-40: último preview listo para POST /api/prices/adjustments.
  let pendienteAjuste = null;
  const tenantId = document.querySelector("[data-tenant]")?.dataset.tenant ?? "";

  const pintarCatalogo = (items) => {
    vigentes = items;
    publicarCatalogo(items);
    const select = $("preview-sku");
    select.textContent = "";
    items.forEach((p) => {
      const option = document.createElement("option");
      option.value = p.sku;
      option.textContent = p.sku + " · " + p.nombre;
      select.appendChild(option);
    });
    $("estado-precios").textContent = mensaje(
      derivarEstado({ cargando: false, error: false, items: items.length }),
      "Todavía no hay productos cargados.",
    );
    marcarSkuSeleccionado(select.value);
  };

  let cargaCatalogo: CargaEnCurso | undefined;

  const cargarPrecios = () => {
    const harness = document.querySelector<HTMLElement>("[data-harness]")?.dataset.harness;
    if (harness === "mil") {
      pintarCatalogo(catalogoMil());
      return;
    }
    cargaCatalogo?.cancelar();
    const carga = cargarCatalogoPanel({
      url: "/api/products",
      alCargar: ({ productos }) => pintarCatalogo(productos),
      alError: (error) => {
        console.warn("[panel/precios] catálogo", error);
        $("estado-precios").textContent = mensaje("error", "");
      },
    });
    cargaCatalogo = carga;
    void carga.terminada
      .catch((error) => {
        console.error("[panel/precios] reporte del catálogo", error);
      })
      .finally(() => {
        if (cargaCatalogo === carga) cargaCatalogo = undefined;
      });
  };

  $("preview-sku").addEventListener("change", (evento) => marcarSkuSeleccionado((evento.currentTarget as HTMLSelectElement).value));

  $("preview-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    limpiarErrores(evento.currentTarget as HTMLElement);
    const estado = $("estado-preview");
    const form = $("preview-form");
    const sku = $("preview-sku").value;
    const producto = vigentes.find((p) => p.sku === sku);
    const porcentaje = Number($("preview-porcentaje").value);
    const errores = {};
    if (!producto) errores.sku = mensajeCampo("sku", REQUERIDO);
    if (!Number.isFinite(porcentaje) || porcentaje <= 0) errores.porcentaje = mensajeCampo("porcentaje", PORCENTAJE);
    if (Object.keys(errores).length > 0) {
      mostrarErrores(form, errores);
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    estado.textContent = "Calculando…";
    try {
      const r = await fetch("/api/prices/preview", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          direccion: $("preview-direccion").value,
          porcentaje: Number($("preview-porcentaje").value),
          items: [{ sku: producto.sku, vigente_centavos: Number(producto.precioCentavos) }],
        }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/precios] respuesta sin JSON", r.status, error);
        return {};
      });
      if (!r.ok) {
        if (mostrarErrores(form, erroresDesdeZod(j.error))) {
          estado.textContent = "Revisá los campos marcados.";
          return;
        }
        estado.textContent = "No se pudo previsualizar: " + textoError(j.error, r.status) + ".";
        return;
      }
      const linea = (j.lineas || [])[0];
      if (!linea) {
        pendienteAjuste = null;
        $("ajuste-confirmar").hidden = true;
        estado.textContent = "Sin líneas para previsualizar.";
        return;
      }
      pendienteAjuste = {
        direccion: $("preview-direccion").value,
        porcentaje: Number($("preview-porcentaje").value),
        sku: producto.sku,
        vigente_centavos: Number(producto.precioCentavos),
        nuevo_centavos: Number(linea.nuevo_centavos),
      };
      $("ajuste-confirmar").hidden = false;
      estado.textContent =
        producto.sku +
        ": " +
        formatearPesos(producto.precioCentavos) +
        " → " +
        formatearPesos(linea.nuevo_centavos) +
        ". Confirmá para aplicar.";
    } catch (error) {
      console.warn("[panel/precios] preview", error);
      estado.textContent = mensaje("error", "");
    }
  });

  // P1-40: aplica el preview con confirmación de dueño (GP1).
  $("ajuste-confirmar").addEventListener("click", async () => {
    const estado = $("estado-preview");
    if (!pendienteAjuste) {
      estado.textContent = "Previsualizá un ajuste antes de confirmar.";
      return;
    }
    if (!tenantId) {
      estado.textContent = "No hay comercio en la sesión para aplicar el ajuste.";
      return;
    }
    const ok = await confirmar({
      titulo: "Confirmar ajuste de precio",
      mensaje:
        "Vas a " +
        pendienteAjuste.direccion +
        " " +
        pendienteAjuste.porcentaje +
        "% en " +
        pendienteAjuste.sku +
        " (" +
        formatearPesos(pendienteAjuste.vigente_centavos) +
        " → " +
        formatearPesos(pendienteAjuste.nuevo_centavos) +
        ").",
      accion: "Aplicar",
    });
    if (!ok) return;
    estado.textContent = "Aplicando ajuste…";
    try {
      const r = await fetch("/api/prices/adjustments", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
        body: JSON.stringify({
          direccion: pendienteAjuste.direccion,
          porcentaje: pendienteAjuste.porcentaje,
          vigencia_tipo: "ahora",
          aplica_en: null,
          confirmado: true,
          creado_por: "panel",
          tenant_id: tenantId,
          items: [{ sku: pendienteAjuste.sku, vigente_centavos: pendienteAjuste.vigente_centavos }],
        }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/precios] ajuste sin JSON", r.status, error);
        return {};
      });
      if (!r.ok) {
        estado.textContent = "No se aplicó: " + textoError(j.error, r.status) + ".";
        return;
      }
      estado.textContent = "Ajuste aplicado en " + pendienteAjuste.sku + ".";
      pendienteAjuste = null;
      $("ajuste-confirmar").hidden = true;
      cargarPrecios();
    } catch (error) {
      console.warn("[panel/precios] ajuste", error);
      estado.textContent = mensaje("error", "");
    }
  });

  cargarPrecios();
</script>
