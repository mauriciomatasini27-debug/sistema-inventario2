---
import PanelShell from "../../../components/panel/PanelShell.astro";
import UpsellPantalla from "../../../components/panel/UpsellPantalla.astro";
---
<PanelShell titulo="Historial de alertas" subtitulo="Alertas de stock bajo que salieron por día." activo="stock">
  <UpsellPantalla superficie="alertas_whatsapp">
  <section class="card">
    <h2>Alertas enviadas</h2>
    <table>
      <thead><tr><th>Fecha</th><th>Producto</th><th>Stock</th><th>Mínimo</th><th>Urgente</th><th>Canal</th><th>Estado</th><th></th></tr></thead>
      <tbody id="hist-body"></tbody>
    </table>
    <div class="estado" id="estado-hist" role="status">Cargando…</div>
  </section>
  </UpsellPantalla>
</PanelShell>

<script>
  interface Fila {
    sku: string;
    nombre: string;
    stock: number;
    umbral: number;
    urgente: boolean;
    fecha: string;
    canal?: string;
    estado?: string;
  }
  function textoCanal(canal: string | undefined): string {
    if (canal === "email") return "Email";
    if (canal === "whatsapp") return "WhatsApp";
    return "WhatsApp";
  }
  function textoEstado(estado: string | undefined): string {
    if (estado === "enviado") return "Enviado";
    return estado && estado.length > 0 ? estado : "Enviado";
  }
  const body = document.getElementById("hist-body");
  const estado = document.getElementById("estado-hist");
  async function cargar(): Promise<void> {
    if (!body || !estado) return;
    try {
      const r = await fetch("/api/alertas/historial", { credentials: "same-origin" });
      const j = (await r.json()) as { alertas?: Fila[]; error?: string };
      if (!r.ok) { estado.textContent = j.error ?? "No se pudo cargar el historial."; return; }
      const filas = j.alertas ?? [];
      body.replaceChildren(...filas.map((f) => {
        const tr = document.createElement("tr");
        for (const v of [
          f.fecha,
          `${f.nombre} (${f.sku})`,
          String(f.stock),
          String(f.umbral),
          f.urgente ? "Sí" : "No",
          textoCanal(f.canal),
          textoEstado(f.estado),
        ]) {
          const td = document.createElement("td");
          td.textContent = v;
          tr.append(td);
        }
        const tdAcc = document.createElement("td");
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = "Armar pedido";
        const estadoFila = document.createElement("div");
        estadoFila.className = "estado-fila";
        estadoFila.setAttribute("role", "status");
        btn.addEventListener("click", async () => {
          if (!confirm("¿Armás un borrador de pedido con este producto? No se envía nada al proveedor.")) return;
          estadoFila.textContent = "Armando…";
          try {
            const pr = await fetch("/api/alertas/armar-pedido", {
              method: "POST",
              credentials: "same-origin",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ sku: f.sku, fecha: f.fecha }),
            });
            const pj = (await pr.json()) as { ok?: boolean; texto?: string; error?: string; ver_en?: string };
            if (!pj.ok) {
              estadoFila.textContent = pj.error ?? "No se pudo armar el pedido.";
              return;
            }
            estadoFila.textContent = pj.texto ?? "";
            if (pj.ver_en) {
              const link = document.createElement("a");
              link.href = pj.ver_en;
              link.textContent = " Ver en Proveedores";
              estadoFila.append(link);
            }
          } catch (e) {
            console.warn("[historial] armar pedido", e);
            estadoFila.textContent = "No se pudo armar el pedido.";
          }
        });
        tdAcc.append(btn, estadoFila);
        tr.append(tdAcc);
        return tr;
      }));
      estado.textContent = filas.length === 0 ? "Todavía no salió ninguna alerta." : "";
    } catch (e) {
      console.warn("[historial] no se pudo cargar", e);
      estado.textContent = "No se pudo cargar el historial.";
    }
  }
  void cargar();
</script>
