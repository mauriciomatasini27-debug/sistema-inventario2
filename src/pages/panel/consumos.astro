---
import PanelShell from "../../components/panel/PanelShell.astro";
const medios = ["Efectivo", "Debito", "Mercado Pago", "QR", "Transferencia"];
---
<PanelShell titulo="Consumos" subtitulo="Cuentas de servicio, vencimientos y pagos." activo="consumos">
  <div class="grid dos">
    <section class="card">
      <h2>Cuentas de servicio</h2>
      <form id="cuenta-form">
        <div class="fila">
          <label>Servicio
            <select id="cuenta-servicio" data-campo="servicio">
              <option value="">Elegí un servicio</option>
              <option value="luz">Luz</option>
              <option value="gas">Gas</option>
              <option value="agua">Agua</option>
              <option value="internet">Internet</option>
              <option value="telefono">Teléfono</option>
              <option value="tasas">Tasas</option>
              <option value="arca">ARCA</option>
              <option value="otro">Otro</option>
            </select>
          </label>
          <label>Proveedor
            <input id="cuenta-proveedor" data-campo="proveedor" autocomplete="off" />
          </label>
          <label>Titular
            <input id="cuenta-titular" data-campo="titular" autocomplete="off" />
          </label>
        </div>
        <div class="fila">
          <label>Alias (opcional)
            <input id="cuenta-alias" data-campo="alias" autocomplete="off" maxlength="100" />
          </label>
          <label>Email de origen (opcional)
            <input id="cuenta-email" data-campo="email_origen" type="email" autocomplete="off" maxlength="320" />
          </label>
          <label>Día de vencimiento (opcional)
            <input id="cuenta-dia" data-campo="vencimiento_tipico_dia" type="number" min="1" max="31" step="1" inputmode="numeric" />
          </label>
        </div>
        <button id="cuenta-enviar" type="submit">Crear cuenta</button>
        <div class="estado" id="estado-cuenta" role="status"></div>
      </form>
      <ul class="lista" id="consumos-cuentas"></ul>
      <div class="estado" id="estado-cuentas" role="status">Cargando…</div>
    </section>

    <section class="card">
      <h2>Próximas a vencer</h2>
      <ul class="lista" id="consumos-proximas"></ul>
      <h2>Vencidas</h2>
      <ul class="lista" id="consumos-vencidas"></ul>
      <div class="estado" id="estado-vencimientos" role="status">Cargando…</div>
    </section>
  </div>

  <section class="card">
    <h2>Borradores de email</h2>
    <p class="estado">Facturas detectadas en Gmail. No se registran hasta que las confirmes.</p>
    <ul class="lista" id="consumos-borradores"></ul>
    <div class="estado" id="estado-borradores" role="status">Cargando…</div>
    <form id="borrador-form" hidden>
      <input type="hidden" id="borrador-id" />
      <img id="borrador-comprobante" alt="Comprobante del cuerpo del correo" hidden />
      <div class="fila">
        <label>Cuenta <select id="borrador-cuenta" data-campo="account_id"></select></label>
        <label>Monto <input id="borrador-monto" data-campo="monto" inputmode="decimal" autocomplete="off" /></label>
      </div>
      <div class="fila">
        <label>Vencimiento <input id="borrador-vencimiento" data-campo="vencimiento" type="date" /></label>
        <label>Período <input id="borrador-periodo" data-campo="periodo" type="month" /></label>
      </div>
      <div class="fila">
        <button type="submit" id="borrador-confirmar">Confirmar factura</button>
        <button type="button" id="borrador-descartar">Descartar</button>
      </div>
      <div class="estado" id="estado-borrador" role="status"></div>
    </form>
  </section>

  <section class="card">
    <h2>Pagar factura</h2>
    <p class="estado">El pago registra el egreso en caja en el mismo paso.</p>
    <form id="pago-form">
      <div class="fila">
        <label>Factura
          <select id="pago-bill" data-campo="bill_id"></select>
        </label>
        <label>Medio
          <select id="pago-medio" data-campo="medio">{medios.map((m) => <option value={m}>{m}</option>)}</select>
        </label>
      </div>
      <button id="pago-enviar" type="submit">Pagar</button>
      <div class="estado" id="estado-pago" role="status">Elegí una factura de la lista.</div>
    </form>
  </section>
</PanelShell>

<script>
  import { derivarEstado, formatearCentavos, montoParaInput, textoError } from "../../lib/panel-modulos.js";
  import { crearCargadorCuentasConsumos } from "../../lib/panel-consumos-carga.js";
  import { REQUERIDO, erroresDesdeZod, mensajeCampo } from "../../lib/errores-campo.js";
  import { limpiarErrores, mostrarErrores } from "../../lib/errores-campo-dom.js";
  import { confirmar } from "../../lib/confirmar-dom.js";
  import { toast } from "sonner";

  const $ = (id) => document.getElementById(id);
  const mensaje = (estado, vacio) =>
    estado === "cargando" ? "Cargando…" : estado === "error" ? "Sin conexión con el servidor." : estado === "vacio" ? vacio : "";

  const cuentasPorId = new Map();
  const facturasPorId = new Map();
  const borradoresPorId = new Map();
  let borradorAbierto = null;
  const nombreCuenta = (id) => {
    const c = cuentasPorId.get(id);
    return c ? (c.alias || c.proveedor) + " · " + c.servicio : "cuenta";
  };

  const pintarLista = (id, filas, vacio) => {
    const ul = $(id);
    ul.textContent = "";
    filas.forEach((f) => {
      const li = document.createElement("li");
      li.textContent = f;
      ul.appendChild(li);
    });
    return filas.length;
  };

  const cargadorCuentas = crearCargadorCuentasConsumos(() =>
    fetch("/api/service-accounts")
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        const items = j.items || [];
        items.forEach((c) => cuentasPorId.set(c.account_id, c));
        const filas = items.map((c) => (c.alias || c.proveedor) + " · " + c.servicio + " · " + (c.activa ? c.titular : "inactiva"));
        pintarLista("consumos-cuentas", filas, "");
        $("estado-cuentas").textContent = mensaje(
          derivarEstado({ cargando: false, error: false, items: items.length }),
          "Todavía no hay cuentas cargadas.",
        );
        const select = $("borrador-cuenta");
        select.textContent = "";
        const vacia = document.createElement("option");
        vacia.value = "";
        vacia.textContent = "Elegí una cuenta";
        select.appendChild(vacia);
        items
          .filter((c) => c.activa)
          .forEach((c) => {
            const option = document.createElement("option");
            option.value = c.account_id;
            option.textContent = (c.alias || c.proveedor) + " · " + c.servicio;
            select.appendChild(option);
          });
        return items;
      })
      .catch((error) => {
        console.warn("[panel/consumos] cuentas", error);
        cargadorCuentas.invalidar();
        pintarLista("consumos-cuentas", [], "");
        $("estado-cuentas").textContent = mensaje("error", "");
        return [];
      }),
  );

  const cargarCuentas = () => cargadorCuentas.cargar();

  const cargarVencimientos = () =>
    fetch("/api/utility-bills/due?dentro_dias=7")
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        const proximas = j.proximas || [];
        const vencidas = j.vencidas || [];
        const texto = (f) => nombreCuenta(f.account_id) + " · " + f.periodo + " · " + formatearCentavos(f.monto_centavos) + " · vence " + f.vencimiento;
        pintarLista("consumos-proximas", proximas.map(texto), "");
        pintarLista("consumos-vencidas", vencidas.map(texto), "");
        const select = $("pago-bill");
        select.textContent = "";
        [...proximas, ...vencidas].forEach((f) => {
          facturasPorId.set(f.bill_id, f);
          const option = document.createElement("option");
          option.value = f.bill_id;
          option.textContent = nombreCuenta(f.account_id) + " · " + formatearCentavos(f.monto_centavos);
          select.appendChild(option);
        });
        $("estado-vencimientos").textContent = mensaje(
          derivarEstado({ cargando: false, error: false, items: proximas.length + vencidas.length }),
          "Sin facturas por vencer ni vencidas.",
        );
      })
      .catch((error) => {
        console.warn("[panel/consumos] vencimientos", error);
        pintarLista("consumos-proximas", [], "");
        pintarLista("consumos-vencidas", [], "");
        $("estado-vencimientos").textContent = mensaje("error", "");
      });

  const cargarBorradores = () =>
    fetch("/api/email-drafts")
      .then((r) => {
        if (!r.ok) throw new Error("http " + r.status);
        return r.json();
      })
      .then((j) => {
        const items = j.items || [];
        borradoresPorId.clear();
        const ul = $("consumos-borradores");
        ul.textContent = "";
        if (items.length === 0) {
          const li = document.createElement("li");
          li.textContent = "No hay borradores pendientes.";
          ul.appendChild(li);
        }
        items.forEach((b) => {
          borradoresPorId.set(b.draft_id, b);
          const li = document.createElement("li");
          const span = document.createElement("span");
          let texto = [
            b.remitente_dominio || "Gmail",
            b.periodo || "sin período",
            b.monto_centavos === null ? "falta monto" : formatearCentavos(b.monto_centavos),
            b.vencimiento ? "vence " + b.vencimiento : "falta vencimiento",
          ].join(" · ");
          if (b.vencido) texto += " · vencido";
          if (b.confianza_monto === "baja" || b.confianza_vencimiento === "baja") texto += " · confianza baja";
          if (b.pide_revision) texto += " · pide revisión";
          span.textContent = texto;
          const button = document.createElement("button");
          button.type = "button";
          button.textContent = "Revisar";
          button.setAttribute("aria-label", "Revisar " + texto);
          button.dataset.borrador = b.draft_id;
          li.append(span, button);
          ul.appendChild(li);
        });
        if (borradorAbierto !== null && !borradoresPorId.has(borradorAbierto)) {
          borradorAbierto = null;
          $("borrador-form").hidden = true;
        }
        $("estado-borradores").textContent = mensaje(
          derivarEstado({ cargando: false, error: false, items: items.length }),
          "No hay borradores pendientes.",
        );
      })
      .catch((error) => {
        console.warn("[panel/consumos] borradores", error);
        borradoresPorId.clear();
        pintarLista("consumos-borradores", [], "");
        $("estado-borradores").textContent = mensaje("error", "");
      });

  const abrirBorrador = async (id) => {
    await cargarCuentas();
    const borrador = borradoresPorId.get(id);
    if (!borrador) return;
    borradorAbierto = id;
    $("borrador-id").value = id;
    $("borrador-monto").value = montoParaInput(borrador.monto_centavos);
    $("borrador-vencimiento").value = borrador.vencimiento || "";
    $("borrador-periodo").value =
      borrador.periodo || (borrador.vencimiento ? borrador.vencimiento.slice(0, 7) : "");
    const select = $("borrador-cuenta");
    const cuentaValida =
      borrador.account_id !== null && Array.from(select.options).some((o) => o.value === borrador.account_id);
    select.value = cuentaValida ? borrador.account_id : "";
    limpiarErrores($("borrador-form"));
    $("borrador-form").hidden = false;
    const estado = $("estado-borrador");
    const boton = $("borrador-confirmar");
    // GGL-S10b: la imagen es el comprobante; el texto pide revisión porque la confianza es baja.
    const comprobante = $("borrador-comprobante");
    const png = typeof borrador.comprobante_cuerpo_png === "string" ? borrador.comprobante_cuerpo_png : "";
    if (png && /^[A-Za-z0-9+/=]+$/.test(png)) {
      comprobante.src = "data:image/png;base64," + png;
      comprobante.hidden = false;
    } else {
      comprobante.removeAttribute("src");
      comprobante.hidden = true;
    }
    if (borrador.vencido) {
      estado.textContent = "Este borrador venció; descartalo y esperá el próximo correo.";
      boton.disabled = true;
    } else if (borrador.pide_revision) {
      estado.textContent = "Revisá este borrador: la factura está en el cuerpo del correo y la confianza es baja.";
      boton.disabled = false;
    } else {
      estado.textContent = "";
      boton.disabled = false;
    }
    $("borrador-monto").focus();
    $("borrador-form").scrollIntoView({ block: "nearest" });
  };

  $("consumos-borradores").addEventListener("click", (evento) => {
    const target = evento.target;
    if (!(target instanceof Element)) return;
    const boton = target.closest("button[data-borrador]");
    if (!(boton instanceof HTMLButtonElement)) return;
    const id = boton.dataset.borrador;
    if (id) abrirBorrador(id);
  });

  $("borrador-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    const form = $("borrador-form");
    limpiarErrores(form);
    const estado = $("estado-borrador");
    const id = $("borrador-id").value;
    if (!id || borradorAbierto === null) {
      estado.textContent = "Elegí un borrador de la lista.";
      return;
    }
    const cuentaId = $("borrador-cuenta").value;
    const monto = $("borrador-monto").value.trim();
    const vencimiento = $("borrador-vencimiento").value.trim();
    const periodo = $("borrador-periodo").value.trim();
    const errores = {
      ...(!cuentaId ? { account_id: mensajeCampo("account_id", REQUERIDO) } : {}),
      ...(!monto ? { monto: mensajeCampo("monto", REQUERIDO) } : {}),
      ...(!vencimiento ? { vencimiento: mensajeCampo("vencimiento", REQUERIDO) } : {}),
    };
    if (mostrarErrores(form, errores)) {
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    const confirmado = await confirmar({
      titulo: "Confirmar factura",
      mensaje:
        "Vas a registrar " +
        monto +
        " de " +
        nombreCuenta(cuentaId) +
        " con vencimiento " +
        vencimiento +
        ".",
      accion: "Confirmar",
    });
    if (!confirmado) return;
    estado.textContent = "Registrando…";
    try {
      const r = await fetch("/api/email-drafts/confirm", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          draft_id: id,
          account_id: cuentaId,
          monto,
          vencimiento,
          ...(periodo ? { periodo } : {}),
        }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/consumos] respuesta sin JSON", r.status, error);
        return {};
      });
      if (r.status === 410 || r.status === 409) {
        estado.textContent = textoError(j.error, r.status);
        toast.error(textoError(j.error, r.status));
        form.hidden = true;
        borradorAbierto = null;
        cargarBorradores();
        return;
      }
      if (!r.ok) {
        if (r.status === 422 && mostrarErrores(form, erroresDesdeZod(j.error))) {
          estado.textContent = "Revisá los campos marcados.";
          return;
        }
        estado.textContent = textoError(j.error, r.status);
        return;
      }
      estado.textContent = "Factura registrada. Ya aparece en vencimientos.";
      toast.success("Factura registrada.");
      form.hidden = true;
      borradorAbierto = null;
      cargarBorradores();
      cargarVencimientos();
    } catch (error) {
      console.warn("[panel/consumos] confirmar borrador", error);
      estado.textContent = "Sin conexión con el servidor.";
    }
  });

  $("borrador-descartar").addEventListener("click", async () => {
    const estado = $("estado-borrador");
    const id = $("borrador-id").value;
    if (!id || borradorAbierto === null) {
      estado.textContent = "Elegí un borrador de la lista.";
      return;
    }
    const confirmado = await confirmar({
      titulo: "Descartar borrador",
      mensaje: "El correo no se va a registrar como factura.",
      accion: "Descartar",
    });
    if (!confirmado) return;
    estado.textContent = "Descartando…";
    try {
      const r = await fetch("/api/email-drafts/discard", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ draft_id: id }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/consumos] respuesta sin JSON", r.status, error);
        return {};
      });
      if (!r.ok) {
        estado.textContent = textoError(j.error, r.status);
        return;
      }
      $("borrador-form").hidden = true;
      borradorAbierto = null;
      toast("Borrador descartado.");
      cargarBorradores();
    } catch (error) {
      console.warn("[panel/consumos] descartar borrador", error);
      estado.textContent = "Sin conexión con el servidor.";
    }
  });

  $("cuenta-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    const form = $("cuenta-form") as HTMLFormElement;
    limpiarErrores(form);
    const estado = $("estado-cuenta");
    const servicio = ($("cuenta-servicio") as HTMLSelectElement).value;
    const proveedor = ($("cuenta-proveedor") as HTMLInputElement).value.trim();
    const titular = ($("cuenta-titular") as HTMLInputElement).value.trim();
    const alias = ($("cuenta-alias") as HTMLInputElement).value.trim();
    const emailOrigen = ($("cuenta-email") as HTMLInputElement).value.trim();
    const diaVencimiento = ($("cuenta-dia") as HTMLInputElement).value.trim();
    const errores = {
      ...(!servicio ? { servicio: mensajeCampo("servicio", REQUERIDO) } : {}),
      ...(proveedor.length < 2 ? { proveedor: mensajeCampo("proveedor", REQUERIDO) } : {}),
      ...(titular.length < 2 ? { titular: mensajeCampo("titular", REQUERIDO) } : {}),
    };
    if (mostrarErrores(form, errores)) {
      estado.textContent = "Revisá los campos marcados.";
      return;
    }
    estado.textContent = "Creando…";
    try {
      const r = await fetch("/api/service-accounts", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          servicio, proveedor, titular,
          ...(alias ? { alias } : {}),
          ...(emailOrigen ? { email_origen: emailOrigen } : {}),
          ...(diaVencimiento ? { vencimiento_tipico_dia: Number(diaVencimiento) } : {}),
        }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/consumos] respuesta sin JSON", r.status, error);
        return {};
      });
      if (!r.ok) {
        if (r.status === 422 && mostrarErrores(form, erroresDesdeZod(j.error))) {
          estado.textContent = "Revisá los campos marcados.";
          return;
        }
        estado.textContent = textoError(j.error, r.status);
        return;
      }
      // P1-48 [plataforma]: sin invalidar, la cuenta nueva no entra a la lista ni al selector.
      cargadorCuentas.invalidar();
      limpiarErrores(form);
      form.reset();
      estado.textContent = "Cuenta creada. Ya aparece en la lista.";
      await cargarCuentas();
      cargarVencimientos();
    } catch (error) {
      console.warn("[panel/consumos] alta cuenta", error);
      estado.textContent = "Sin conexión con el servidor.";
    }
  });

  $("pago-form").addEventListener("submit", async (evento) => {
    evento.preventDefault();
    limpiarErrores(evento.currentTarget as HTMLElement);
    const estado = $("estado-pago");
    const form = $("pago-form");
    const billId = $("pago-bill").value;
    const factura = facturasPorId.get(billId);
    const cuenta = factura ? cuentasPorId.get(factura.account_id) : undefined;
    if (!factura || !cuenta) {
      mostrarErrores(form, { bill_id: mensajeCampo("bill_id", REQUERIDO) });
      estado.textContent = "Elegí una factura de la lista.";
      return;
    }
    const confirmado = await confirmar({
      titulo: "Pagar factura",
      mensaje:
        "Vas a pagar " +
        formatearCentavos(factura.monto_centavos) +
        " de " +
        nombreCuenta(factura.account_id) +
        " con " +
        $("pago-medio").value +
        ".",
      accion: "Pagar",
    });
    if (!confirmado) return;
    estado.textContent = "Pagando…";
    try {
      const r = await fetch("/api/utility-bills/pay", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          bill_id: factura.bill_id,
          servicio: cuenta.servicio,
          proveedor: cuenta.proveedor,
          medio: $("pago-medio").value,
        }),
      });
      const j = await r.json().catch((error) => {
        console.warn("[panel/consumos] respuesta sin JSON", r.status, error);
        return {};
      });
      if (!r.ok) {
        if (mostrarErrores(form, erroresDesdeZod(j.error))) {
          estado.textContent = "Revisá los campos marcados.";
          return;
        }
        estado.textContent = "No se pagó: " + textoError(j.error, r.status) + ".";
        return;
      }
      estado.textContent = "Factura " + j.bill_id + " · " + j.estado + ".";
      cargarVencimientos();
    } catch (error) {
      console.warn("[panel/consumos] pago", error);
      estado.textContent = mensaje("error", "");
    }
  });

  cargarCuentas();
  cargarBorradores();
  cargarVencimientos();
</script>

<style>
  #consumos-borradores li {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
  }
  #consumos-borradores li button {
    min-height: 36px;
    padding: 6px 12px;
    font-size: 13px;
  }
  #borrador-form {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--tema-linea);
  }
  #borrador-form[hidden] {
    display: none;
  }
  #borrador-comprobante {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 8px 0;
    border: 1px solid var(--tema-linea);
  }
  #borrador-comprobante[hidden] {
    display: none;
  }
  #borrador-descartar {
    background: transparent;
    color: var(--tema-texto);
    border: 1px solid var(--tema-linea);
  }
</style>
