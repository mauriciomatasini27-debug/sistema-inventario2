---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import { business, contact, seo } from '../data/business';

export const prerender = true;

const titulo = 'Términos de servicio';
const title = `${titulo} — ${business.marca}`;
const description = `Condiciones de uso de ${business.marca}: cuenta, datos del comercio, bot de WhatsApp, planes y baja.`;
const email = contact.email.trim() || '[COMPLETAR: email de contacto]';
---

<BaseLayout {title} {description} canonical={`${seo.site}/terminos`} ogImage={seo.ogImage}>
  <main>
    <Section variant="white" id="terminos">
      <h1 class="landing-section-title text-core-cream">{titulo}</h1>
      <p class="landing-lead mt-4 max-w-3xl text-ash-gray">
        Estas condiciones regulan el uso de {business.marca}. Al usar el servicio aceptás lo que se explica acá.
      </p>

      <h2 class="landing-card-title mt-10">Uso del servicio</h2>
      <p class="mt-3 max-w-3xl text-[length:var(--text-body-lg)]">
        {business.marca} sirve para gestionar el inventario de un comercio: caja, stock, compras, ventas y reposición. Te comprometés a usarlo de manera lícita y a no interferir en su funcionamiento ni en el de otros comercios.
      </p>

      <h2 class="landing-card-title mt-10">Cuenta</h2>
      <p class="mt-3 max-w-3xl text-[length:var(--text-body-lg)]">
        El ingreso se hace con tu cuenta de Google. Sos responsable de mantener el acceso a esa cuenta y de la veracidad de los datos que asociás a tu comercio.
      </p>

      <h2 class="landing-card-title mt-10">Responsabilidad por tus datos</h2>
      <p class="mt-3 max-w-3xl text-[length:var(--text-body-lg)]">
        Vos cargás y mantenés la información de tu comercio (productos, precios, stock, clientes y ventas) y respondés por ella. Podés consultar cómo la tratamos en nuestra <a href="/privacidad" class="text-trust underline hover:text-nebula-cyan">política de privacidad</a>.
      </p>

      <h2 class="landing-card-title mt-10">Bot de WhatsApp</h2>
      <p class="mt-3 max-w-3xl text-[length:var(--text-body-lg)]">
        El bot usa la WhatsApp Cloud API de Meta y su uso está sujeto a las políticas de WhatsApp y a sus términos. El bot responde consultas de stock y envía avisos solo a quienes dieron su consentimiento; respondé <strong>BAJA</strong> o <strong>STOP</strong> para dejar de recibirlos.
      </p>

      <h2 class="landing-card-title mt-10">Planes y baja</h2>
      <p class="mt-3 max-w-3xl text-[length:var(--text-body-lg)]">
        Los planes se eligen según la operación de tu comercio y se detallan en la landing. No hay permanencia: cancelás cuando quieras. Si querés borrar tu información, consultá <a href="/eliminar-datos" class="text-trust underline hover:text-nebula-cyan">Eliminar datos</a>.
      </p>

      <h2 class="landing-card-title mt-10">Limitación de responsabilidad</h2>
      <p class="mt-3 max-w-3xl text-[length:var(--text-body-lg)]">
        El servicio se ofrece tal cual. Dentro de lo permitido por la ley, no respondemos por daños derivados de un uso indebido, de decisiones comerciales propias o de fallas de plataformas terceras como Meta, WhatsApp o Google.
      </p>

      <h2 class="landing-card-title mt-10">Cambios</h2>
      <p class="mt-3 max-w-3xl text-[length:var(--text-body-lg)]">
        Podemos actualizar estas condiciones. La versión vigente se publica en esta página. Vigencia: [COMPLETAR: fecha de vigencia].
      </p>

      <h2 class="landing-card-title mt-10">Ley aplicable</h2>
      <p class="mt-3 max-w-3xl text-[length:var(--text-body-lg)]">
        Estos términos se rigen por la legislación de la República Argentina.
      </p>

      <h2 class="landing-card-title mt-10">Contacto</h2>
      <ul class="mt-3 max-w-3xl list-disc space-y-2 pl-6 text-[length:var(--text-body-lg)]">
        <li>Email: <a href={`mailto:${email}`} class="text-trust underline hover:text-nebula-cyan">{email}</a></li>
        <li>Teléfono: {business.contacto.telefono}</li>
        <li>
          WhatsApp:
          <a href={contact.whatsapp} target="_blank" rel="noopener noreferrer" class="text-trust underline hover:text-nebula-cyan">
            {business.contacto.telefono}
          </a>
        </li>
      </ul>
    </Section>
  </main>
</BaseLayout>
