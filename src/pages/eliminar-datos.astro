---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import { business, contact, seo } from '../data/business';

export const prerender = true;

const titulo = 'Eliminar datos';
const title = `${titulo} — ${business.marca}`;
const description = `Cómo desvincular tu número de WhatsApp, dejar de recibir avisos y pedir la eliminación completa de tus datos en ${business.marca}.`;
const email = contact.email.trim() || '[COMPLETAR: email de contacto]';
---

<BaseLayout {title} {description} canonical={`${seo.site}/eliminar-datos`} ogImage={seo.ogImage}>
  <main>
    <Section variant="white" id="eliminar-datos">
      <h1 class="landing-section-title text-core-cream">{titulo}</h1>
      <p class="landing-lead mt-4 max-w-3xl text-ash-gray">
        Elegí lo que querés hacer: dejar de recibir avisos, desvincular tu número o pedir que borremos tus datos.
      </p>

      <h2 class="landing-card-title mt-10">1. Dejar de recibir avisos</h2>
      <p class="mt-3 max-w-3xl text-[length:var(--text-body-lg)]">
        Respondé <strong>BAJA</strong> o <strong>STOP</strong> a cualquier aviso de WhatsApp para dejar de recibir mensajes.
      </p>

      <h2 class="landing-card-title mt-10">2. Desvincular tu número de WhatsApp</h2>
      <p class="mt-3 max-w-3xl text-[length:var(--text-body-lg)]">
        Escribinos por email a <a href={`mailto:${email}`} class="text-trust underline hover:text-nebula-cyan">{email}</a> desde la cuenta con la que ingresás, o pedíselo al dueño del comercio, indicando el número. Desvinculamos el número y deja de estar asociado a ese comercio.
      </p>

      <h2 class="landing-card-title mt-10">3. Pedir la eliminación completa</h2>
      <p class="mt-3 max-w-3xl text-[length:var(--text-body-lg)]">
        Escribinos por email a <a href={`mailto:${email}`} class="text-trust underline hover:text-nebula-cyan">{email}</a> e indicá el número de WhatsApp y/o la cuenta con la que ingresás. Verificamos que el pedido sea tuyo y lo resolvemos dentro de las 48 horas de verificado y, en todo caso, dentro del plazo máximo de 5 días hábiles desde que lo recibimos que fija el art. 16 de la Ley 25.326.
      </p>
      <p class="mt-3 max-w-3xl text-[length:var(--text-body-lg)]">
        El bot de WhatsApp no tiene un comando para borrar datos: la eliminación completa se realiza a pedido, por email, según lo explicado en la <a href="/privacidad" class="text-trust underline hover:text-nebula-cyan">política de privacidad</a>.
      </p>

      <h2 class="landing-card-title mt-10">Alcance</h2>
      <p class="mt-3 max-w-3xl text-[length:var(--text-body-lg)]">
        Al eliminar o anonimizar tus datos dejás de poder recuperarlos desde {business.marca}. Los mensajes transmitidos por WhatsApp siguen sujetos a las políticas de esa plataforma.
      </p>

      <h2 class="landing-card-title mt-10">Contacto</h2>
      <ul class="mt-3 max-w-3xl list-disc space-y-2 pl-6 text-[length:var(--text-body-lg)]">
        <li>Email: <a href={`mailto:${email}`} class="text-trust underline hover:text-nebula-cyan">{email}</a></li>
        <li>Teléfono: {business.contacto.telefono}</li>
        <li>
          WhatsApp:
          <a href={contact.whatsapp} target="_blank" rel="noopener noreferrer" class="text-trust underline hover:text-nebula-cyan">
            {business.contacto.telefono}
          </a>
        </li>
      </ul>
      <p class="mt-8 max-w-3xl text-[length:var(--text-body-lg)]">
        También podés leer los <a href="/terminos" class="text-trust underline hover:text-nebula-cyan">términos de servicio</a>.
      </p>
    </Section>
  </main>
</BaseLayout>
