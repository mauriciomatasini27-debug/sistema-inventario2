---
// UI mínima Slice-0: escaneo + cobro a 360px. Sin descuentos/fiados/devoluciones.
// (Movida desde / a /venta por ADR-0020: el home pasa a ser el dashboard índice.)
import "../styles/tokens-papel.css";
import "../styles/tema.css";
import TemaInicial from "../components/ui/TemaInicial.astro";
import TemaToggle from "../components/ui/TemaToggle.astro";
import { VENTA_WORST, modoHarness } from "../lib/venta-worst.js";

const medios = ["Efectivo", "Debito", "Mercado Pago", "QR", "Transferencia"];
const harness = modoHarness(Astro.url, import.meta.env.DEV);
---
<!doctype html>
<html lang="es" dir={harness.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Venta mostrador</title>
    <TemaInicial />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0; font-family: var(--font-sans); background: var(--tema-fondo); color: var(--tema-texto);
        /* DS-S17: con viewport-fit=cover, solo suma el inset del notch/barra (0 en el resto).
           Insets físicos, por eso padding-left/right y no padding-inline. */
        padding-left: env(safe-area-inset-left, 0px);
        padding-right: env(safe-area-inset-right, 0px);
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      .barra { display: flex; align-items: center; gap: 8px; padding: 8px 12px; padding-top: calc(8px + env(safe-area-inset-top, 0px)); }
      .barra h1 { flex: 1 1 auto; margin: 0; font-size: 20px; min-width: 0; overflow-wrap: anywhere; }
      main { max-width: 360px; margin-inline: auto; padding: 12px; }
      input, select, button:not(.tema-toggle) { min-height: 44px; font-family: inherit; font-size: 16px; width: 100%; margin-block: 6px; }
      button:not(.tema-toggle) { background: var(--color-void); color: var(--color-star-white); border: 0; border-radius: 8px; }
      .card { border-radius: 12px; padding: 12px; margin-block: 8px; min-width: 0; }
      #estado { font-size: 14px; white-space: pre-wrap; overflow-wrap: anywhere; text-align: start; }
      #catalogo-estado { margin: 0 4px 10px; font-size: 13px; color: var(--tema-texto-suave); text-align: start; overflow-wrap: anywhere; }
      #balance, h1, .producto, .producto .nombre, .provisorio { overflow-wrap: anywhere; text-align: start; }
      .producto { display: flex; gap: 8px; align-items: baseline; justify-content: space-between; min-width: 0; }
      .producto .nombre { min-width: 0; flex: 1 1 auto; }
      .producto .monto { font-variant-numeric: tabular-nums; white-space: nowrap; flex: 0 0 auto; }
      ul { list-style: none; margin: 0; padding-inline: 0; }
      li { padding-block: 4px; }
      :root[data-tema="oscuro"] input, :root[data-tema="oscuro"] select { background: var(--color-charcoal); color: var(--color-star-white); border: 1px solid var(--color-ash); }
      :root[data-tema="oscuro"] button:not(.tema-toggle) { background: var(--color-star-white); color: var(--color-void); }
    </style>
  </head>
  <body>
    <header class="barra vidrio-barra">
      <h1>Venta mostrador</h1>
      <TemaToggle />
    </header>
    <main>
      <div class="card vidrio-card">
        <label>Código / SKU <input id="sku" value={harness.data === "worst" ? VENTA_WORST.sku : "demo-sku-1"} /></label>
        <label>Cantidad <input id="qty" type="number" value={harness.data === "worst" ? VENTA_WORST.qty : 1} min="1" /></label>
        <label>Precio centavos <input id="precio" type="number" value={harness.data === "worst" ? VENTA_WORST.precioCentavos : 15000} min="0" /></label>
        <label>Medio
          <select id="medio">
            {medios.map((m) => <option value={m} selected={harness.data === "worst" && m === VENTA_WORST.medio}>{m}</option>)}
          </select>
        </label>
        <button id="cobrar">Cobrar</button>
        <button id="sync" type="button">Reintentar sync</button>
        <button id="compartir" type="button">Compartir por WhatsApp</button>
        <button id="imprimir" type="button">Imprimir ticket</button>
        <button id="imprimir-bt" type="button">Imprimir BT</button>
      </div>
      <p id="catalogo-estado">Sin catálogo descargado</p>
      <div class="card vidrio-card"><div id="estado" role="status">{harness.data === "worst" ? VENTA_WORST.errorApi : "Lista."}</div></div>
      <div class="card vidrio-card"><div id="balance" role="status">{harness.data === "worst" ? VENTA_WORST.balanceTexto : "Balance: —"}</div></div>
      {harness.data === "worst" && (
        <div class="card vidrio-card">
          <ul id="lineas-worst">
            {VENTA_WORST.lineas.map((l) => (
              <li class="producto">
                <span class="nombre">{l.nombre} ({l.sku})</span>
                <span class="monto">{l.precioCentavos}</span>
              </li>
            ))}
          </ul>
          <ul id="cola-worst">
            {VENTA_WORST.cola.map((op) => (
              <li class="provisorio">{op.device_code}-{op.device_seq} {op.op_id}</li>
            ))}
          </ul>
        </div>
      )}
    </main>
    <script>
      import { sincronizarColaVenta } from "../offline/cola-venta.js";
      import { debeDescargar, descargarCatalogo, leerCatalogoLocal, precioLocal } from "../offline/catalogo-local.js";
      import { fechaAR, horaMinutoAR } from "../lib/fecha-ar.js";
      const $ = (id) => document.getElementById(id);
      const seqKey = "slice0-seq";
      const outboxKey = "slice0-outbox";
      const nextSeq = () => {
        const n = Number(localStorage.getItem(seqKey) ?? "0") + 1;
        localStorage.setItem(seqKey, String(n));
        return n;
      };
      const estado = (t) => { $("estado").textContent = t; };
      const esHarnessWorst = Boolean(document.getElementById("lineas-worst"));
      let catalogo = leerCatalogoLocal(localStorage);
      const fechaCatalogo = (iso) => {
        const partes = fechaAR(new Date(iso)).split("-");
        return (partes[2] ?? "") + "/" + (partes[1] ?? "") + " " + horaMinutoAR(new Date(iso));
      };
      const mostrarCatalogo = () => {
        $("catalogo-estado").textContent = catalogo
          ? "Catálogo del " + fechaCatalogo(catalogo.descargadoEl)
          : "Sin catálogo descargado";
      };
      mostrarCatalogo();
      let precioEditado = false;
      let skuElegido = $("sku").value;
      const completarPrecio = () => {
        if (precioEditado) return;
        const precio = precioLocal(catalogo, $("sku").value);
        if (precio !== null) $("precio").value = String(precio);
      };
      $("sku").addEventListener("input", () => {
        if ($("sku").value !== skuElegido) {
          skuElegido = $("sku").value;
          precioEditado = false;
        }
        completarPrecio();
      });
      $("precio").addEventListener("input", () => { precioEditado = true; });
      const refrescarCatalogo = async () => {
        if (esHarnessWorst) return;
        if (!debeDescargar(catalogo, new Date(), navigator.onLine)) return;
        const r = await descargarCatalogo({
          fetch: async (url) => {
            const res = await fetch(url);
            return { ok: res.ok, status: res.status, desdeCache: res.headers.get("x-desde-cache") === "1", json: () => res.json() };
          },
          storage: localStorage,
        });
        if (!r.ok) return;
        catalogo = r.snapshot;
        mostrarCatalogo();
      };
      refrescarCatalogo();
      window.addEventListener("online", refrescarCatalogo);
      // 8.Ticket salida: último sale_id para compartir (TV11) + snapshot
      // térmico para BT (TV15 P2: el navegador no importa .ts, se guarda acá).
      let lastSaleId = null;
      let lastTicket = null;
      async function balance() {
        try {
          const r = await fetch("/api/cash/balance");
          $("balance").textContent = "Balance: " + (await r.text());
        } catch { /* sin red: se reintenta en sync */ }
      }
      $("cobrar").onclick = async () => {
        const seq = nextSeq();
        const device_code = "caja-01";
        const op_id = crypto.randomUUID();
        const payload = {
          lineas: [{ product_id: $("sku").value, qty: Number($("qty").value), precio_centavos: Number($("precio").value) }],
          medio: $("medio").value,
          device_code,
          seq_local: seq,
          client_occurred_at: new Date().toISOString(),
          offline: !navigator.onLine,
        };
        try {
          const r = await fetch("/api/sales", {
            method: "POST",
            headers: { "Content-Type": "application/json", "Idempotency-Key": op_id },
            body: JSON.stringify(payload),
          });
          const txt = await r.text();
          estado(r.status + " " + txt);
          try {
            const j = JSON.parse(txt);
            if (j.sale_id) {
              lastSaleId = j.sale_id;
              lastTicket = {
                definitivo: j.ticket_definitivo ?? null,
                provisorio: j.ticket_provisorio,
                total: String(j.total_centavos),
                medio: payload.medio,
                lineas: payload.lineas.map((l) => ({ sku: l.product_id, cantidad: l.qty, precio: String(l.precio_centavos) })),
              };
            }
          } catch { /* no json */ }
        } catch {
          // Por qué localStorage y no memoria: el corte de red en cobro (Slice-0 E2E)
          // exige provisorio DeviceCode-SeqLocal y reintento sin duplicar por op_id.
          const q = JSON.parse(localStorage.getItem(outboxKey) ?? "[]");
          q.push({ op_id, device_code, device_seq: seq, payload });
          localStorage.setItem(outboxKey, JSON.stringify(q));
          estado("offline provisorio " + device_code + "-" + seq + " encolado " + op_id);
        }
        balance();
      };
      $("sync").onclick = async () => {
        const r = await sincronizarColaVenta({
          leer: () => JSON.parse(localStorage.getItem(outboxKey) ?? "[]"),
          escribir: (items) => localStorage.setItem(outboxKey, JSON.stringify(items)),
          enviar: async (item) => {
            const res = await fetch("/api/sync/push", {
              method: "POST",
              headers: { "Content-Type": "application/json", "Idempotency-Key": item.op_id },
              body: JSON.stringify({ op_id: item.op_id, device_code: item.device_code, device_seq: item.device_seq, hlc: String(Date.now()) + ":0", modulo: "sales", payload: item.payload, client_occurred_at: new Date().toISOString() }),
            });
            const cuerpo = await res.json().catch((error) => { console.warn("[venta] sync sin JSON", res.status, error); return {}; });
            return { status: res.status, cuerpo };
          },
        });
        // SYNC-S7: lo sensible solo va online; se avisa en vez de fallar.
        if (r.cortado) estado("sync cortado: " + r.pendientes + " pendiente(s)");
        else if (r.sensibles > 0) estado("Necesita conexión (" + r.sensibles + " sensible(s) solo online)");
        else estado("sync intentado (" + r.confirmados + ")");
        balance();
      };
      // TV11: wa.me gratis default. Pide teléfono E.164 y abre el share.
      $("compartir").onclick = async () => {
        if (!lastSaleId) { estado("sin venta para compartir (cobrá primero)"); return; }
        const to = prompt("Teléfono E.164 (ej. +5491100000000)", "+5491100000000") ?? "";
        try {
          const r = await fetch("/api/tickets/compartir", {
            method: "POST",
            headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
            body: JSON.stringify({ sale_id: lastSaleId, toE164: to, dentroVentana24h: true, optIn: false, comercio: "Comercio" }),
          });
          const j = await r.json().catch((error) => { console.warn("[venta] respuesta sin JSON", r.status, error); return {}; });
          if (j.wa_me_url) window.open(j.wa_me_url, "_blank");
          else estado(r.status + " " + JSON.stringify(j));
        } catch { estado("sin red para compartir"); }
      };
      // TV15 P2: impresión básica con window.print (térmica 58/80 vía CSS).
      $("imprimir").onclick = () => window.print();
      // TV15 P2: térmica BLE (58mm/32 cols). El <script> del navegador no puede
      // importar .ts, así que el envío GATT se espeja acá en compacto; el
      // canónico es src/modules/sales/escpos_bt.ts (chunks 512B + corte GS V).
      // Requiere gesto (click) + HTTPS/localhost; iOS/Safari no soporta BT.
      $("imprimir-bt").onclick = async () => {
        if (!lastTicket) { estado("sin ticket para BT (cobrá primero)"); return; }
        try {
          const t = await fetch("/api/tickets/thermal", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              comercio: "Comercio",
              ticketDefinitivo: lastTicket.definitivo,
              provisorio: lastTicket.provisorio,
              fechaIso: new Date().toISOString(),
              medio: lastTicket.medio,
              lineas: lastTicket.lineas.map((l) => ({ sku: l.sku, cantidad: l.cantidad, precioCentavos: l.precio })),
              totalBrutoCentavos: lastTicket.total,
              totalDescuentoCentavos: "0",
              totalNetoCentavos: lastTicket.total,
            }),
          });
          const th = await t.json().catch((error) => { console.warn("[venta] respuesta sin JSON", t.status, error); return {}; });
          if (!t.ok || !th.cols32) { estado("thermal: " + JSON.stringify(th)); return; }
          const nav = navigator;
          if (!nav.bluetooth) { estado("BT no soportado acá; usá Imprimir"); window.print(); return; }
          estado("BT: elegí la impresora…");
          const device = await nav.bluetooth.requestDevice({
            filters: [{ services: ["6e400001-b5a3-f393-e0a9-e50e24dcca9e"] }],
            optionalServices: ["6e400001-b5a3-f393-e0a9-e50e24dcca9e"],
          });
          if (!device.gatt) { estado("BT: sin GATT"); return; }
          if (!device.gatt.connected) await device.gatt.connect();
          const service = await device.gatt.getPrimaryService("6e400001-b5a3-f393-e0a9-e50e24dcca9e");
          const ch = await service.getCharacteristic("6e400002-b5a3-f393-e0a9-e50e24dcca9e");
          const bytes = new TextEncoder().encode(th.cols32 + "\n");
          for (let i = 0; i < bytes.length; i += 512) {
            const buf = bytes.slice(i, i + 512).buffer;
            if (ch.writeValueWithResponse) await ch.writeValueWithResponse(buf);
            else await ch.writeValue(buf);
          }
          const corte = new Uint8Array([0x0a, 0x0a, 0x0a, 0x1d, 0x56, 0x00]).buffer;
          if (ch.writeValueWithResponse) await ch.writeValueWithResponse(corte);
          else await ch.writeValue(corte);
          try { device.gatt.disconnect(); } catch { /* best-effort */ }
          estado("BT: impreso + corte");
        } catch (e) {
          const name = e && e.name ? e.name : "";
          if (name === "NotFoundError" || name === "AbortError") estado("BT: no elegiste impresora");
          else estado("BT falló; usá Imprimir");
        }
      };
      if (!(import.meta.env.DEV && document.getElementById("lineas-worst"))) balance();
    </script>
  </body>
</html>
