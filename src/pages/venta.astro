---
// UI mínima Slice-0: escaneo + cobro a 360px. Sin descuentos ni devoluciones.
// P1-41: medio "A cuenta" llama POST /api/credit/sales-on-account (solo online).
// (Movida desde / a /venta por ADR-0020: el home pasa a ser el dashboard índice.)
import "../styles/tokens-papel.css";
import "../styles/tema.css";
import TemaInicial from "../components/ui/TemaInicial.astro";
import TemaToggle from "../components/ui/TemaToggle.astro";
import PwaRegistro from "../components/ui/PwaRegistro.astro";
import { pesosParaInput } from "../lib/pesos.js";
import { VENTA_WORST, modoHarness } from "../lib/venta-worst.js";
import { tenantDeRequest } from "../lib/tenant-context.js";
import ConfirmDialog from "../components/ui/ConfirmDialog.astro";
import NavTablero from "../components/panel/NavTablero.astro";
import Modo from "../components/panel/Modo.astro";
import PanelBuscar from "../components/panel/PanelBuscar.astro";
import ReportesComercioDialog from "../components/panel/ReportesComercioDialog.astro";
import { resolverRolEfectivo } from "../lib/control.js";
import { puedeCrearProductos, puedeVerSaldoCaja, rolParaNav } from "../lib/panel-modulos.js";

const medios = ["Efectivo", "Debito", "Mercado Pago", "QR", "Transferencia", "A cuenta"];
const harness = modoHarness(Astro.url, import.meta.env.DEV);
// P10-13: el catálogo offline es por tenant. El servidor resuelve con
// tenantDeRequest (valida la membership como el resto de rutas) y lo inyecta
// al cliente por data-attribute; sin tenant conocido no se lee ni escribe.
const tenant = tenantDeRequest(Astro.request);
const tenantId = tenant.ok ? tenant.tenantId : null;
const navRol = rolParaNav(resolverRolEfectivo(Astro.request));
const verSaldo = puedeVerSaldoCaja(navRol.rol, navRol.permisos);
const puedeCrear = puedeCrearProductos(navRol.rol, navRol.permisos);
---
<!doctype html>
<html lang="es" dir={harness.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Venta mostrador</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <TemaInicial />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0; font-family: var(--font-sans); background: var(--color-void); color: var(--color-star-white);
        /* DS-S17: con viewport-fit=cover, solo suma el inset del notch/barra (0 en el resto).
           Insets físicos, por eso padding-left/right y no padding-inline. */
        padding-left: env(safe-area-inset-left, 0px);
        padding-right: env(safe-area-inset-right, 0px);
        padding-bottom: 0;
      }
      /* TB-158: el mostrador scrollea por encima de la barra. El inset queda en el contenido. */
      .tablero-contenido { padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px)); }
      /* TB-AUDIT-MOBILE: mismos tokens B que PanelShell; las vidrio-card no aclaran sobre void. */
      .tablero {
        --tema-fondo: var(--color-void);
        --tema-superficie: var(--color-charcoal);
        --tema-linea: var(--color-mid);
        --tema-texto: var(--color-star-white);
        --tema-texto-suave: var(--color-muted-dark);
        --tema-vidrio: var(--color-charcoal);
      }
      .tablero .vidrio-card {
        background: var(--color-charcoal);
        border: 1px solid var(--color-mid);
        color: var(--color-star-white);
      }
      @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .tablero .vidrio-card {
          background: color-mix(in srgb, var(--color-charcoal) 92%, transparent);
          -webkit-backdrop-filter: blur(16px);
          backdrop-filter: blur(16px);
        }
      }
      @media (prefers-reduced-transparency: reduce) {
        .tablero .vidrio-card { background: var(--color-charcoal); backdrop-filter: none; -webkit-backdrop-filter: none; }
      }
      @media (min-width: 900px) {
        .tablero-contenido { padding-bottom: 16px; }
      }
      .barra { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 8px 12px; padding-top: calc(8px + env(safe-area-inset-top, 0px)); }
      /* TB-159: el blur de la barra recortaría el panel. El mostrador no lo necesita. */
      .barra.vidrio-barra { overflow: visible; backdrop-filter: none; -webkit-backdrop-filter: none; }
      .barra h1 { flex: 1 1 auto; margin: 0; font-size: 20px; min-width: 0; overflow-wrap: anywhere; }
      /* P1-29: el texto ámbar no entra al lado del título en 320px. El chip
         baja de línea y --estado-* ya cambia con el tema. */
      #indicador-sync { flex: 1 0 100%; font-size: 12px; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; border-radius: 999px; padding: 2px 8px; }
      #indicador-sync:empty { display: none; }
      #indicador-sync[data-tono="verde"] { background: var(--estado-ok-tint); color: var(--estado-ok); }
      #indicador-sync[data-tono="ambar"] { background: var(--estado-aviso-tint); color: var(--estado-aviso); }
      #indicador-sync[data-tono="azul"] { background: var(--estado-pendiente-tint); color: var(--estado-pendiente); }
      #indicador-sync[data-tono="rojo"] { background: var(--estado-peligro-tint); color: var(--estado-peligro); }
      main { max-width: 360px; margin-inline: auto; padding: 12px; }
      input, select, button:not(.tema-toggle):not([data-nav-mas]):not(.modo-control) { min-height: 44px; font-family: inherit; font-size: 16px; width: 100%; margin-block: 6px; }
      button:not(.tema-toggle):not([data-nav-mas]):not(.modo-control) { background: var(--color-void); color: var(--color-star-white); border: 0; border-radius: 8px; }
      .card { border-radius: 12px; padding: 12px; margin-block: 8px; min-width: 0; }
      #estado { font-size: 14px; white-space: pre-wrap; overflow-wrap: anywhere; text-align: start; }
      #visor-camara { width: min(360px, calc(100vw - 24px)); padding: 0; border: 0; border-radius: 16px; background: var(--tema-superficie, var(--color-charcoal)); color: var(--tema-texto, var(--color-star-white)); }
      #visor-camara::backdrop { background: color-mix(in srgb, var(--color-void) 55%, transparent); }
      #visor-camara[open] { display: grid; gap: 12px; padding: 16px; margin: auto; }
      #visor-camara-titulo { margin: 0; font-size: 18px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
      #visor-camara-cerrar { width: auto; min-width: 44px; min-height: 44px; margin: 0; padding-inline: 12px; }
      #visor-camara-ayuda { margin: 0; font-size: 14px; color: var(--tema-texto-suave, var(--color-muted-dark)); }
      .visor-camara-marco { border: 2px solid var(--color-star-glow); border-radius: 12px; overflow: hidden; background: var(--color-void); }
      #camara-video { display: block; width: 100%; max-height: 240px; object-fit: cover; background: var(--color-void); }
      #visor-camara-cancelar { width: 100%; min-height: 44px; margin: 0; }
      #catalogo-estado { margin: 0 4px 10px; font-size: 13px; color: var(--tema-texto-suave); text-align: start; overflow-wrap: anywhere; }
      #balance, h1, .producto, .producto .nombre, .provisorio { overflow-wrap: anywhere; text-align: start; }
      .producto { display: flex; gap: 8px; align-items: baseline; justify-content: space-between; min-width: 0; }
      .producto .nombre { min-width: 0; flex: 1 1 auto; }
      .producto .monto { font-variant-numeric: tabular-nums; white-space: nowrap; flex: 0 0 auto; }
      ul { list-style: none; margin: 0; padding-inline: 0; }
      li { padding-block: 4px; }
      :root[data-tema="oscuro"] input, :root[data-tema="oscuro"] select { background: var(--color-charcoal); color: var(--color-star-white); border: 1px solid var(--color-ash); }
      :root[data-tema="oscuro"] button:not(.tema-toggle):not([data-nav-mas]):not(.modo-control) { background: var(--color-star-white); color: var(--color-void); }
      #lista-carrito .fila { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
      #lista-carrito button { width: auto; flex: 0 0 auto; margin-block: 0; padding-inline: 12px; min-width: 44px; min-height: 44px; }
      #carrito-total, #ticket-total, #cobro-total { font-variant-numeric: tabular-nums; font-weight: 700; }
      .buscador { display: flex; gap: 8px; align-items: flex-end; flex-wrap: wrap; }
      .buscador-campo { flex: 1 1 160px; min-width: 0; }
      .buscador-campo input { width: 100%; margin-block: 0; }
      #leer-camara { width: auto; flex: 0 0 auto; margin-block: 0; min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding-inline: 12px; }
      #leer-camara svg { flex: 0 0 auto; }
      #resultados { list-style: none; margin: 8px 0 0; padding: 0; }
      #resultados[hidden] { display: none; }
      #resultados button { width: 100%; min-height: 44px; text-align: start; }
      .datos-linea { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
      .datos-linea input { margin-block: 0; }
      #ticket-vacio { margin: 8px 0; color: var(--tema-texto-suave); }
      #volver-ticket { width: auto; min-width: 44px; min-height: 44px; margin-block: 0; padding-inline: 12px; }
      /* TB-160: el apagado es mid sobre el flame. Sin opacidad ni pointer-events como único apagado. */
      #cobrar.cobrar-apagado { background: var(--color-mid); color: var(--color-muted-dark); box-shadow: none; cursor: not-allowed; }
      #cobrar.sg-flame-cta, #confirmar-cobro.sg-flame-cta { background-color: var(--color-star-glow); color: var(--color-star-white); box-shadow: var(--sombra-cta); }
      #paso-ticket[hidden], #paso-cobro[hidden] { display: none; }
      #efectivo-vuelto { margin: 4px 0 0; font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums; }
    </style>
    <style is:global>
      /* TB-160: los botones del ticket nacen en el script y no heredan el style con scope. */
      #lista-carrito button,
      #resultados button,
      #leer-camara,
      #visor-camara-cerrar,
      #visor-camara-cancelar,
      #volver-ticket,
      #cobrar,
      #confirmar-cobro {
        box-sizing: border-box;
        min-width: 44px;
        min-height: 44px;
      }
      #lista-carrito .fila { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
      #lista-carrito .nombre { min-width: 0; flex: 1 1 8rem; overflow-wrap: anywhere; }
      #lista-carrito .monto, #lista-carrito .qty { font-variant-numeric: tabular-nums; }
      #lista-carrito button { width: auto; flex: 0 0 auto; padding-inline: 12px; }
      #resultados button { width: 100%; text-align: start; }
      #cliente-fiado-elegido, #cliente-fiado-preview { margin: 4px 0 0; font-size: 14px; }
      #tarjeta-ticket h2 { margin: 0 0 6px; font-size: 18px; }
      #ticket-leyenda { font-size: 12px; font-weight: 700; }
      @media print {
        body * { visibility: hidden; }
        #tarjeta-ticket, #tarjeta-ticket * { visibility: visible; }
        #tarjeta-ticket { position: absolute; left: 0; top: 0; width: 100%; }
      }
    </style>
  </head>
  <body data-ver-saldo={verSaldo ? "si" : "no"} data-crear-productos={puedeCrear ? "si" : "no"}>
    <div class="tablero">
      <NavTablero activo="ventas" />
      <div class="tablero-contenido">
    <header class="barra vidrio-barra">
      <h1>Venta mostrador</h1>
      <PanelBuscar />
      <Modo />
      <TemaToggle />
      <span id="indicador-sync" role="status"></span>
    </header>
    <main data-tenant={tenantId ?? ""}>
      <section id="paso-ticket" class="card vidrio-card" aria-label="Ticket">
        <div class="buscador">
          <label class="buscador-campo">Buscar
            <input id="sku" type="search" autocomplete="off" enterkeyhint="search" placeholder="Nombre o código" value={harness.data === "worst" ? VENTA_WORST.sku : ""} />
          </label>
          <button id="leer-camara" type="button">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M9 4l1.5 2h3L15 4h4a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2h4zm3 4a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6z"></path>
            </svg>
            Escanear
          </button>
        </div>
        <dialog id="visor-camara" aria-labelledby="visor-camara-titulo-texto">
          <h2 id="visor-camara-titulo">
            <span id="visor-camara-titulo-texto">Escanear etiqueta</span>
            <button id="visor-camara-cerrar" type="button" aria-label="Cerrar visor de cámara">✕</button>
          </h2>
          <p id="visor-camara-ayuda">Apuntá al código de barras de la etiqueta del producto. No es un lector de tickets ni de facturas.</p>
          <div class="visor-camara-marco">
            <video id="camara-video" hidden playsinline muted aria-label="Vista de la cámara"></video>
          </div>
          <button id="visor-camara-cancelar" type="button">Cancelar</button>
        </dialog>
        <div class="datos-linea">
          <label>Cantidad <input id="qty" type="number" value={harness.data === "worst" ? VENTA_WORST.qty : 1} min="1" /></label>
          <label>Precio (pesos) <input id="precio" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" placeholder="Ej. 1.234,50" value={pesosParaInput(harness.data === "worst" ? VENTA_WORST.precioCentavos : 15000)} /></label>
        </div>
        <label id="alta-nombre-label" hidden>Nombre del producto nuevo <input id="alta-nombre" maxlength="120" /></label>
        <ul id="resultados" hidden aria-label="Resultados"></ul>
        <p id="catalogo-estado">Sin catálogo descargado</p>
        <section id="panel-carrito" aria-label="Ticket de la venta">
          <p id="ticket-vacio">Buscá o escaneá para armar el ticket.</p>
          <ul id="lista-carrito"></ul>
          <p id="carrito-total">Total: $0.00</p>
        </section>
        <button id="cobrar" type="button" class="cobrar-apagado" disabled>Cobrar</button>
      </section>
      <section id="paso-cobro" class="card vidrio-card" hidden aria-label="Cobro">
        <button id="volver-ticket" type="button">Volver</button>
        <h2 id="cobro-titulo" tabindex="-1">Cobrar</h2>
        <ul id="cobro-lineas"></ul>
        <p id="cobro-total">Total: $0.00</p>
        <label>Medio
          <select id="medio">
            {medios.map((m) => <option value={m} selected={harness.data === "worst" && m === VENTA_WORST.medio}>{m}</option>)}
          </select>
        </label>
        <div id="efectivo-recibido-label" hidden>
          <label>¿Con cuánto paga? (opcional, para ver el vuelto)
            <input id="efectivo-recibido" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" placeholder="Monto recibido" />
          </label>
          <p id="efectivo-vuelto" hidden role="status"></p>
        </div>
        <div id="cliente-fiado-label" hidden>
          <label>Cliente (fiado)
            <input id="cliente-fiado-q" type="search" autocomplete="off" placeholder="Buscar por nombre" />
          </label>
          <button type="button" id="cliente-fiado-nuevo">+ Nuevo cliente</button>
          <div id="cliente-fiado-alta" hidden>
            <label>Nombre <input id="cliente-fiado-alta-nombre" maxlength="80" autocomplete="name" /></label>
            <label>Teléfono <input id="cliente-fiado-alta-telefono" maxlength="40" inputmode="tel" autocomplete="tel" /></label>
            <button type="button" id="cliente-fiado-alta-guardar">Guardar y elegir</button>
            <button type="button" id="cliente-fiado-alta-cancelar">Cancelar</button>
            <div id="cliente-fiado-alta-aviso" role="status" hidden></div>
          </div>
          <ul id="cliente-fiado-opciones" aria-label="Clientes encontrados"></ul>
          <p id="cliente-fiado-elegido"></p>
          <p id="cliente-fiado-preview"></p>
        </div>
        <button id="confirmar-cobro" type="button" class="sg-flame-cta">Confirmar cobro</button>
      </section>
      <div class="card vidrio-card">
        <button id="sync" type="button">Reintentar sync</button>
        <button id="compartir" type="button">Compartir por WhatsApp</button>
        <button id="imprimir" type="button">Imprimir ticket</button>
        <button id="imprimir-bt" type="button">Imprimir BT</button>
      </div>
      <div class="card vidrio-card"><div id="estado" role="status">{harness.data === "worst" ? VENTA_WORST.errorApi : "Lista."}</div></div>
      <section id="tarjeta-ticket" class="card vidrio-card" hidden aria-label="Ticket">
        <h2 id="ticket-numero"></h2>
        <p id="ticket-medio"></p>
        <ul id="ticket-lineas"></ul>
        <p id="ticket-total"></p>
        <p id="ticket-leyenda">DOCUMENTO NO VÁLIDO COMO FACTURA</p>
        <p id="ticket-modo" hidden>Sin conexión — número provisorio</p>
      </section>
      <div class="card vidrio-card"><div id="balance" role="status">{harness.data === "worst" ? VENTA_WORST.balanceTexto : "Balance: —"}</div></div>
      {harness.data === "worst" && (
        <div class="card vidrio-card">
          <ul id="lineas-worst">
            {VENTA_WORST.lineas.map((l) => (
              <li class="producto">
                <span class="nombre">{l.nombre} ({l.sku})</span>
                <span class="monto">{l.precioCentavos}</span>
              </li>
            ))}
          </ul>
          <ul id="cola-worst">
            {VENTA_WORST.cola.map((op) => (
              <li class="provisorio">{op.device_code}-{op.device_seq} {op.op_id}</li>
            ))}
          </ul>
        </div>
      )}
    </main>
    <PwaRegistro />
    <script>
      import { claveOutboxCola, claveSeqCola, copiarSeqLegado } from "../offline/cola-venta.js";
      import { codigoDispositivoLocal } from "../offline/device-code-local.js";
      import { debeDrenarPorVisibilidad, drenadoUnico, textoDeDrenado } from "../offline/drenado-unico.js";
      import { contarPendientesCola, reducirIndicadorSync } from "../offline/indicador-sync.js";
      import { agregarProvisorio, debeDescargar, descargarCatalogo, descartarCatalogoLegado, leerCatalogoLocal, precioLocal } from "../offline/catalogo-local.js";
      import { avisoStockLocalAgotado, stockLocal } from "../offline/stock-local.js";
      import { fechaAR, horaMinutoAR } from "../lib/fecha-ar.js";
      import { formatearCentavos } from "../lib/panel-modulos.js";
      import { mensajePesos, parsearPesos, pesosParaInput } from "../lib/pesos.js";
      import { fusionarLinea, armarCobroDesdeCarrito } from "../modules/sales/carrito_armar_cobro.js";
      import { evaluarVueltoEfectivo, totalCentavosCarrito } from "../modules/sales/vuelto_efectivo.js";
      import { hitsCatalogoLocal, unirHits } from "../modules/sales/buscar_venta_ticket.js";
      import { construir_resumen_ticket, construir_wa_me_url } from "../modules/sales/ticket_share.js";
      import { confirmar } from "../lib/confirmar-dom.js";
      import {
        efectoCodigoDesconocido,
        efectoDeTecla,
        mensajeCamaraNoDisponible,
        mensajeErrorCamara,
        motivoCamaraNoDisponible,
        resolverLectura,
        sesionCamara,
      } from "../modules/stock/escaner.js";
      const $ = (id) => document.getElementById(id);
      const tenant = document.querySelector("[data-tenant]")?.dataset.tenant ?? "";
      const storage = localStorage;
      // P10-14: cola y separador por tenant; sin tenant (anónimo/harness) quedan las legadas.
      const seqKey = claveSeqCola(tenant || null);
      const outboxKey = claveOutboxCola(tenant || null);
      const nextSeq = () => {
        const n = Number(storage.getItem(seqKey) ?? "0") + 1;
        storage.setItem(seqKey, String(n));
        return n;
      };
      // P10-14: el contador nuevo hereda el valor legado para no reusar device_seq ya confirmados.
      copiarSeqLegado(storage, tenant || null);
      const estado = (t) => { $("estado").textContent = t; };
      const esHarnessWorst = Boolean(document.getElementById("lineas-worst"));
      // P1-29: online y #sync pueden esperar el mismo vuelo. Un booleano se
      // apaga cuando vuelve el primero y la barra deja de decir Sincronizando.
      let vuelosIndicador = 0;
      let cortadoIndicador = false;
      const refrescarIndicador = () => {
        const vista = reducirIndicadorSync({
          online: navigator.onLine,
          pendientes: contarPendientesCola(storage, tenant || null),
          sincronizando: vuelosIndicador > 0,
          cortado: cortadoIndicador,
        });
        const chip = $("indicador-sync");
        chip.textContent = vista.etiqueta;
        chip.dataset.tono = vista.tono;
      };
      // P10-13: con tenant conocido se descarta la clave legada global (sin
      // migrarla); sin tenant no se lee ni se escribe catálogo.
      if (tenant) descartarCatalogoLegado(storage, tenant);
      let catalogo = leerCatalogoLocal(storage, tenant);
      const fechaCatalogo = (iso) => {
        const partes = fechaAR(new Date(iso)).split("-");
        return (partes[2] ?? "") + "/" + (partes[1] ?? "") + " " + horaMinutoAR(new Date(iso));
      };
      // STOCK-S2 (ADR-0106): si el SKU no está en el catálogo local, se pide
      // el nombre para darlo de alta al cobrar. El precio es el de la línea.
      const puedeCrear = document.body.dataset.crearProductos !== "no";
      // TB-160: el alta solo sigue a un código desconocido. Una búsqueda a medias no es un alta.
      let pedirNombre = false;
      const mostrarAlta = () => {
        const sku = $("sku").value.trim();
        $("alta-nombre-label").hidden = !puedeCrear || !pedirNombre || sku === "" || precioLocal(catalogo, sku) !== null;
      };
      const mostrarCatalogo = () => {
        // STOCK-S1: un snapshot con solo provisorios trae fecha epoch (no hubo descarga).
        $("catalogo-estado").textContent = catalogo && new Date(catalogo.descargadoEl).getTime() > 0
          ? "Catálogo del " + fechaCatalogo(catalogo.descargadoEl)
          : "Sin catálogo descargado";
        mostrarAlta();
      };
      mostrarCatalogo();
      let precioEditado = false;
      let skuElegido = $("sku").value;
      const completarPrecio = () => {
        if (precioEditado) return;
        const centavos = precioLocal(catalogo, $("sku").value);
        if (centavos === null) return;
        $("precio").value = pesosParaInput(centavos);
      };
      $("sku").addEventListener("input", () => {
        if ($("sku").value !== skuElegido) {
