---
// UI mínima Slice-0: escaneo + cobro a 360px. Sin descuentos ni devoluciones.
// P1-41: medio "A cuenta" llama POST /api/credit/sales-on-account (solo online).
// (Movida desde / a /venta por ADR-0020: el home pasa a ser el dashboard índice.)
import "../styles/tokens-papel.css";
import "../styles/tema.css";
import TemaInicial from "../components/ui/TemaInicial.astro";
import TemaToggle from "../components/ui/TemaToggle.astro";
import PwaRegistro from "../components/ui/PwaRegistro.astro";
import { VENTA_WORST, modoHarness } from "../lib/venta-worst.js";
import { tenantDeRequest } from "../lib/tenant-context.js";

const medios = ["Efectivo", "Debito", "Mercado Pago", "QR", "Transferencia", "A cuenta"];
const harness = modoHarness(Astro.url, import.meta.env.DEV);
// P10-13: el catálogo offline es por tenant. El servidor resuelve con
// tenantDeRequest (valida la membership como el resto de rutas) y lo inyecta
// al cliente por data-attribute; sin tenant conocido no se lee ni escribe.
const tenant = tenantDeRequest(Astro.request);
const tenantId = tenant.ok ? tenant.tenantId : null;
---
<!doctype html>
<html lang="es" dir={harness.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Venta mostrador</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <TemaInicial />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0; font-family: var(--font-sans); background: var(--tema-fondo); color: var(--tema-texto);
        /* DS-S17: con viewport-fit=cover, solo suma el inset del notch/barra (0 en el resto).
           Insets físicos, por eso padding-left/right y no padding-inline. */
        padding-left: env(safe-area-inset-left, 0px);
        padding-right: env(safe-area-inset-right, 0px);
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      .barra { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 8px 12px; padding-top: calc(8px + env(safe-area-inset-top, 0px)); }
      .barra h1 { flex: 1 1 auto; margin: 0; font-size: 20px; min-width: 0; overflow-wrap: anywhere; }
      /* P1-29: el texto ámbar no entra al lado del título en 320px. El chip
         baja de línea y --estado-* ya cambia con el tema. */
      #indicador-sync { flex: 1 0 100%; font-size: 12px; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; border-radius: 999px; padding: 2px 8px; }
      #indicador-sync:empty { display: none; }
      #indicador-sync[data-tono="verde"] { background: var(--estado-ok-tint); color: var(--estado-ok); }
      #indicador-sync[data-tono="ambar"] { background: var(--estado-aviso-tint); color: var(--estado-aviso); }
      #indicador-sync[data-tono="azul"] { background: var(--estado-pendiente-tint); color: var(--estado-pendiente); }
      #indicador-sync[data-tono="rojo"] { background: var(--estado-peligro-tint); color: var(--estado-peligro); }
      main { max-width: 360px; margin-inline: auto; padding: 12px; }
      input, select, button:not(.tema-toggle) { min-height: 44px; font-family: inherit; font-size: 16px; width: 100%; margin-block: 6px; }
      button:not(.tema-toggle) { background: var(--color-void); color: var(--color-star-white); border: 0; border-radius: 8px; }
      .card { border-radius: 12px; padding: 12px; margin-block: 8px; min-width: 0; }
      #estado { font-size: 14px; white-space: pre-wrap; overflow-wrap: anywhere; text-align: start; }
      #camara-video { width: 100%; max-height: 180px; border-radius: 8px; background: var(--color-void); }
      #catalogo-estado { margin: 0 4px 10px; font-size: 13px; color: var(--tema-texto-suave); text-align: start; overflow-wrap: anywhere; }
      #balance, h1, .producto, .producto .nombre, .provisorio { overflow-wrap: anywhere; text-align: start; }
      .producto { display: flex; gap: 8px; align-items: baseline; justify-content: space-between; min-width: 0; }
      .producto .nombre { min-width: 0; flex: 1 1 auto; }
      .producto .monto { font-variant-numeric: tabular-nums; white-space: nowrap; flex: 0 0 auto; }
      ul { list-style: none; margin: 0; padding-inline: 0; }
      li { padding-block: 4px; }
      :root[data-tema="oscuro"] input, :root[data-tema="oscuro"] select { background: var(--color-charcoal); color: var(--color-star-white); border: 1px solid var(--color-ash); }
      :root[data-tema="oscuro"] button:not(.tema-toggle) { background: var(--color-star-white); color: var(--color-void); }
      #lista-carrito .fila { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
      #lista-carrito button { width: auto; flex: 0 0 auto; margin-block: 0; padding-inline: 12px; }
      #carrito-total, #ticket-total { font-variant-numeric: tabular-nums; font-weight: 700; }
      #cliente-fiado-elegido, #cliente-fiado-preview { margin: 4px 0 0; font-size: 14px; }
      #tarjeta-ticket h2 { margin: 0 0 6px; font-size: 18px; }
      #ticket-leyenda { font-size: 12px; font-weight: 700; }
      @media print {
        body * { visibility: hidden; }
        #tarjeta-ticket, #tarjeta-ticket * { visibility: visible; }
        #tarjeta-ticket { position: absolute; left: 0; top: 0; width: 100%; }
      }
    </style>
  </head>
  <body>
    <header class="barra vidrio-barra">
      <h1>Venta mostrador</h1>
      <TemaToggle />
      <span id="indicador-sync" role="status"></span>
    </header>
    <main data-tenant={tenantId ?? ""}>
      <div class="card vidrio-card">
        <label>Código / SKU <input id="sku" value={harness.data === "worst" ? VENTA_WORST.sku : "demo-sku-1"} /></label>
        <button id="leer-camara" type="button">Leer con la cámara</button>
        <video id="camara-video" hidden playsinline muted></video>
        <label>Cantidad <input id="qty" type="number" value={harness.data === "worst" ? VENTA_WORST.qty : 1} min="1" /></label>
        <label>Precio centavos <input id="precio" type="number" value={harness.data === "worst" ? VENTA_WORST.precioCentavos : 15000} min="0" /></label>
        <label id="alta-nombre-label" hidden>Nombre del producto nuevo <input id="alta-nombre" maxlength="120" /></label>
        <label>Medio
          <select id="medio">
            {medios.map((m) => <option value={m} selected={harness.data === "worst" && m === VENTA_WORST.medio}>{m}</option>)}
          </select>
        </label>
        <div id="cliente-fiado-label" hidden>
          <label>Cliente (fiado)
            <input id="cliente-fiado-q" type="search" autocomplete="off" placeholder="Buscar por nombre" />
          </label>
          <ul id="cliente-fiado-opciones" aria-label="Clientes encontrados"></ul>
          <p id="cliente-fiado-elegido"></p>
          <p id="cliente-fiado-preview"></p>
        </div>
        <section id="panel-carrito" aria-label="Carrito">
          <ul id="lista-carrito"></ul>
          <p id="carrito-total">Total: —</p>
        </section>
        <button id="cobrar">Cobrar</button>
        <button id="sync" type="button">Reintentar sync</button>
        <button id="compartir" type="button">Compartir por WhatsApp</button>
        <button id="imprimir" type="button">Imprimir ticket</button>
        <button id="imprimir-bt" type="button">Imprimir BT</button>
      </div>
      <p id="catalogo-estado">Sin catálogo descargado</p>
      <div class="card vidrio-card"><div id="estado" role="status">{harness.data === "worst" ? VENTA_WORST.errorApi : "Lista."}</div></div>
      <section id="tarjeta-ticket" class="card vidrio-card" hidden aria-label="Ticket">
        <h2 id="ticket-numero"></h2>
        <p id="ticket-medio"></p>
        <ul id="ticket-lineas"></ul>
        <p id="ticket-total"></p>
        <p id="ticket-leyenda">DOCUMENTO NO VÁLIDO COMO FACTURA</p>
        <p id="ticket-modo" hidden>Sin conexión — número provisorio</p>
      </section>
      <div class="card vidrio-card"><div id="balance" role="status">{harness.data === "worst" ? VENTA_WORST.balanceTexto : "Balance: —"}</div></div>
      {harness.data === "worst" && (
        <div class="card vidrio-card">
          <ul id="lineas-worst">
            {VENTA_WORST.lineas.map((l) => (
              <li class="producto">
                <span class="nombre">{l.nombre} ({l.sku})</span>
                <span class="monto">{l.precioCentavos}</span>
              </li>
            ))}
          </ul>
          <ul id="cola-worst">
            {VENTA_WORST.cola.map((op) => (
              <li class="provisorio">{op.device_code}-{op.device_seq} {op.op_id}</li>
            ))}
          </ul>
        </div>
      )}
    </main>
    <PwaRegistro />
    <script>
      import { claveOutboxCola, claveSeqCola, copiarSeqLegado } from "../offline/cola-venta.js";
      import { codigoDispositivoLocal } from "../offline/device-code-local.js";
      import { debeDrenarPorVisibilidad, drenadoUnico, textoDeDrenado } from "../offline/drenado-unico.js";
      import { contarPendientesCola, reducirIndicadorSync } from "../offline/indicador-sync.js";
      import { agregarProvisorio, debeDescargar, descargarCatalogo, descartarCatalogoLegado, leerCatalogoLocal, precioLocal } from "../offline/catalogo-local.js";
      import { avisoStockLocalAgotado, stockLocal } from "../offline/stock-local.js";
      import { fechaAR, horaMinutoAR } from "../lib/fecha-ar.js";
      import { formatearCentavos } from "../lib/panel-modulos.js";
      import { fusionarLinea, armarCobroDesdeCarrito } from "../modules/sales/carrito_armar_cobro.js";
      import { construir_resumen_ticket, construir_wa_me_url } from "../modules/sales/ticket_share.js";
      import {
        efectoDeTecla,
        resolverLectura,
        sesionCamara,
      } from "../modules/stock/escaner.js";
      const $ = (id) => document.getElementById(id);
      const tenant = document.querySelector("[data-tenant]")?.dataset.tenant ?? "";
      const storage = localStorage;
      // P10-14: cola y separador por tenant; sin tenant (anónimo/harness) quedan las legadas.
      const seqKey = claveSeqCola(tenant || null);
      const outboxKey = claveOutboxCola(tenant || null);
      const nextSeq = () => {
        const n = Number(storage.getItem(seqKey) ?? "0") + 1;
        storage.setItem(seqKey, String(n));
        return n;
      };
      // P10-14: el contador nuevo hereda el valor legado para no reusar device_seq ya confirmados.
      copiarSeqLegado(storage, tenant || null);
      const estado = (t) => { $("estado").textContent = t; };
      const esHarnessWorst = Boolean(document.getElementById("lineas-worst"));
      // P1-29: online y #sync pueden esperar el mismo vuelo. Un booleano se
      // apaga cuando vuelve el primero y la barra deja de decir Sincronizando.
      let vuelosIndicador = 0;
      let cortadoIndicador = false;
      const refrescarIndicador = () => {
        const vista = reducirIndicadorSync({
          online: navigator.onLine,
          pendientes: contarPendientesCola(storage, tenant || null),
          sincronizando: vuelosIndicador > 0,
          cortado: cortadoIndicador,
        });
        const chip = $("indicador-sync");
        chip.textContent = vista.etiqueta;
        chip.dataset.tono = vista.tono;
      };
      // P10-13: con tenant conocido se descarta la clave legada global (sin
      // migrarla); sin tenant no se lee ni se escribe catálogo.
      if (tenant) descartarCatalogoLegado(storage, tenant);
      let catalogo = leerCatalogoLocal(storage, tenant);
      const fechaCatalogo = (iso) => {
        const partes = fechaAR(new Date(iso)).split("-");
        return (partes[2] ?? "") + "/" + (partes[1] ?? "") + " " + horaMinutoAR(new Date(iso));
      };
      // STOCK-S2 (ADR-0106): si el SKU no está en el catálogo local, se pide
      // el nombre para darlo de alta al cobrar. El precio es el de la línea.
      const mostrarAlta = () => {
        $("alta-nombre-label").hidden = precioLocal(catalogo, $("sku").value) !== null;
      };
      const mostrarCatalogo = () => {
        // STOCK-S1: un snapshot con solo provisorios trae fecha epoch (no hubo descarga).
        $("catalogo-estado").textContent = catalogo && new Date(catalogo.descargadoEl).getTime() > 0
          ? "Catálogo del " + fechaCatalogo(catalogo.descargadoEl)
          : "Sin catálogo descargado";
        mostrarAlta();
      };
      mostrarCatalogo();
      let precioEditado = false;
      let skuElegido = $("sku").value;
      const completarPrecio = () => {
        if (precioEditado) return;
        const precio = precioLocal(catalogo, $("sku").value);
        if (precio !== null) $("precio").value = String(precio);
      };
      $("sku").addEventListener("input", () => {
        if ($("sku").value !== skuElegido) {
          skuElegido = $("sku").value;
          precioEditado = false;
        }
        completarPrecio();
        mostrarAlta();
      });
      $("precio").addEventListener("input", () => { precioEditado = true; });
      const aplicarSkuEncontrado = (sku) => {
        $("sku").value = sku;
        skuElegido = sku;
        precioEditado = false;
        completarPrecio();
        mostrarAlta();
        estado("Lista.");
      };
      // P1-58: el EAN sale del mapa del snapshot. Sin esa entrada el lector pide la red.
      const resolverEnPantalla = (raw) => resolverLectura({
        raw,
        tenantId: tenant,
        skusLocales: catalogo ? Object.keys(catalogo.productos) : [],
        codigosLocales: catalogo ? catalogo.codigos : {},
        fetch: (url) => fetch(url),
      });
      const textoCarrito = (codigo) => {
        if (codigo === "demasiadas_lineas") return "máximo 50 productos";
        if (codigo === "qty_invalida") return "la cantidad tiene que ser un entero de 1 a 999";
        if (codigo === "precio_invalido") return "el precio tiene que ser centavos enteros, de 0 para arriba";
        if (codigo === "sku_invalido") return "el código tiene que tener entre 1 y 64 caracteres";
        if (codigo === "nombre_invalido") return "el nombre tiene que tener entre 1 y 120 caracteres";
        return "carrito vacío";
      };
      let carrito = [];
      let cobrando = false;
      // P1-56: un 5xx no cierra el cobro. El segundo tap reusa op_id y seq
      // para no emitir otro ticket de la misma venta.
      let cobroEnVuelo = null;
      const pintarCarrito = () => {
        const ul = $("lista-carrito");
        ul.replaceChildren();
        if (carrito.length === 0) {
          const vacio = document.createElement("li");
          vacio.textContent = "Carrito vacío";
          ul.appendChild(vacio);
        } else {
          for (const linea of carrito) {
            const li = document.createElement("li");
            li.className = "fila";
            const nombre = document.createElement("span");
            nombre.className = "nombre";
            nombre.textContent = (linea.alta ? linea.alta.nombre + " · " : "") + linea.product_id;
            const qty = document.createElement("span");
            qty.textContent = String(linea.qty);
            const monto = document.createElement("span");
            monto.className = "monto";
            monto.textContent = formatearCentavos(linea.qty * linea.precio_centavos);
            const menos = document.createElement("button");
            menos.type = "button";
            menos.textContent = "−";
            menos.setAttribute("aria-label", "Bajar cantidad " + linea.product_id);
            menos.addEventListener("click", () => cambiarQty(linea.product_id, -1));
            const mas = document.createElement("button");
            mas.type = "button";
            mas.textContent = "+";
            mas.setAttribute("aria-label", "Subir cantidad " + linea.product_id);
            mas.addEventListener("click", () => cambiarQty(linea.product_id, 1));
            const quitar = document.createElement("button");
            quitar.type = "button";
            quitar.textContent = "Quitar";
            quitar.setAttribute("aria-label", "Quitar " + linea.product_id);
            quitar.addEventListener("click", () => quitarLinea(linea.product_id));
            li.append(nombre, menos, qty, mas, monto, quitar);
            ul.appendChild(li);
          }
        }
        const total = carrito.reduce((acc, l) => acc + l.qty * l.precio_centavos, 0);
        $("carrito-total").textContent = carrito.length === 0 ? "Total: —" : "Total: " + formatearCentavos(total);
      };
      const cobroTomado = () => {
        if (!cobrando && !cobroEnVuelo) return false;
        estado("hay un cobro sin cerrar, tocá Cobrar de nuevo");
        return true;
      };
      const quitarLinea = (product_id) => {
        if (cobroTomado()) return;
        carrito = carrito.filter((l) => l.product_id !== product_id);
        pintarCarrito();
      };
      const cambiarQty = (product_id, delta) => {
        if (cobroTomado()) return;
        const idx = carrito.findIndex((l) => l.product_id === product_id);
        const linea = carrito[idx];
        if (!linea) return;
        const qty = linea.qty + delta;
        if (qty < 1) {
          carrito = carrito.filter((l) => l.product_id !== product_id);
          pintarCarrito();
          return;
        }
        if (qty > 999) {
          estado("la cantidad tiene que ser un entero de 1 a 999");
          return;
        }
        const next = carrito.slice();
        next[idx] = { ...linea, qty };
        carrito = next;
        pintarCarrito();
      };
      const agregarLineaDesdeFormulario = () => {
        if (cobroTomado()) return;
        const product_id = $("sku").value.trim();
        const qty = Number($("qty").value);
        const precio_centavos = Number($("precio").value);
        const nombre = $("alta-nombre-label").hidden ? "" : $("alta-nombre").value.trim();
        const linea = {
          product_id,
          qty,
          precio_centavos,
          ...(nombre ? { alta: { nombre } } : {}),
        };
        const r = fusionarLinea(carrito, linea);
        if (!r.ok) {
          estado(textoCarrito(r.codigo));
          return;
        }
        carrito = r.carrito;
        pintarCarrito();
        $("qty").value = "1";
        $("alta-nombre").value = "";
        $("sku").focus();
        $("sku").select();
        estado("Lista.");
      };
      // P1-56: Cobrar ya no lee el formulario. Enter y la cámara suman al carrito,
      // también si el código no está en el catálogo. El alta viaja solo si hay nombre.
      const incorporarLectura = async (raw) => {
        const texto = String(raw ?? "").trim();
        if (!texto) return;
        const res = await resolverEnPantalla(texto);
        if (res.estado === "encontrado") aplicarSkuEncontrado(res.sku);
        else if (res.estado === "desconocido") {
          $("sku").value = texto;
          skuElegido = texto;
          mostrarAlta();
        } else {
          return;
        }
        agregarLineaDesdeFormulario();
      };
      pintarCarrito();
      $("sku").addEventListener("keydown", async (ev) => {
        const efecto = efectoDeTecla(ev.key);
        if (!efecto.buscar || efecto.abrirCamara) return;
        ev.preventDefault();
        await incorporarLectura($("sku").value);
      });
      let sesion = null;
      $("leer-camara").addEventListener("click", async () => {
        const video = $("camara-video");
        if (!(video instanceof HTMLVideoElement)) return;
        if (sesion) {
          sesion.cerrar();
          sesion = null;
          return;
        }
        sesion = sesionCamara(video);
        try {
          const codigo = await sesion.leer();
          sesion = null;
          if (!codigo) return;
          await incorporarLectura(codigo);
        } catch (error) {
          console.warn("[venta] cámara", error);
          if (sesion) sesion.cerrar();
          sesion = null;
          estado("No se pudo abrir la cámara.");
        }
      });
      const refrescarCatalogo = async () => {
        if (esHarnessWorst || !tenant) return;
        if (!debeDescargar(catalogo, new Date(), navigator.onLine)) return;
        const r = await descargarCatalogo({
          tenantId: tenant,
          fetch: async (url) => {
            const res = await fetch(url);
            return { ok: res.ok, status: res.status, desdeCache: res.headers.get("x-desde-cache") === "1", json: () => res.json() };
          },
          storage,
        });
        if (!r.ok) return;
        catalogo = r.snapshot;
        mostrarCatalogo();
      };
      refrescarCatalogo();
      // 8.Ticket salida: snapshot para la tarjeta y para BT (TV15 P2).
      let lastSaleId = null;
      let lastTicket = null;
      const pintarTicket = () => {
        const card = $("tarjeta-ticket");
        if (!lastTicket) {
          card.hidden = true;
          return;
        }
        card.hidden = false;
        $("ticket-numero").textContent = lastTicket.definitivo || lastTicket.provisorio;
        $("ticket-medio").textContent = lastTicket.medio;
        const ul = $("ticket-lineas");
        ul.replaceChildren();
        for (const l of lastTicket.lineas) {
          const li = document.createElement("li");
          li.className = "producto";
          const nombre = document.createElement("span");
          nombre.className = "nombre";
          nombre.textContent = l.sku + " × " + l.cantidad;
          const monto = document.createElement("span");
          monto.className = "monto";
          const unit = Number(l.precio);
          monto.textContent = formatearCentavos(Number.isFinite(unit) ? unit * l.cantidad : 0);
          li.append(nombre, monto);
          ul.appendChild(li);
        }
        $("ticket-total").textContent = "Total: " + formatearCentavos(lastTicket.total);
        $("ticket-modo").hidden = Boolean(lastTicket.sale_id);
      };
      const publicarTicket = (ticket) => {
        lastTicket = ticket;
        lastSaleId = ticket.sale_id;
        pintarTicket();
        carrito = [];
        pintarCarrito();
        cobroEnVuelo = null;
        $("sku").focus();
      };
      const aplicarTicketDefinitivoSiVisible = (item, ticket_definitivo) => {
        if (!ticket_definitivo || !lastTicket) return;
        const provisorio = item.device_code + "-" + item.device_seq;
        if (lastTicket.op_id !== item.op_id && lastTicket.provisorio !== provisorio) return;
        lastTicket = { ...lastTicket, definitivo: ticket_definitivo };
        pintarTicket();
      };
      // P1-36: mismo contrato que /panel/caja (JSON por_medio), no el body crudo.
      async function balance() {
        try {
          const r = await fetch("/api/cash/balance");
          if (!r.ok) {
            $("balance").textContent = "Balance: no disponible";
            return;
          }
          const b = await r.json();
          const entradas = Object.entries(b.por_medio || {}).map(([m, c]) => [m, Number(c)]);
          const total = entradas.reduce((a, par) => a + par[1], 0);
          const detalle =
            entradas.length > 0
              ? entradas.map(([m, c]) => m + " " + formatearCentavos(c)).join(" · ")
              : "Sin movimientos por medio.";
          $("balance").textContent = "Balance: " + formatearCentavos(total) + " · " + detalle;
        } catch { /* sin red: se reintenta en sync */ }
      }
      const syncClienteFiado = () => {
        const aCuenta = $("medio").value === "A cuenta";
        $("cliente-fiado-label").hidden = !aCuenta;
      };
      $("medio").addEventListener("change", syncClienteFiado);
      syncClienteFiado();

      let clienteConfirmado = null;
      let buscaFiado = null;
      const pintarPreviewFiado = (item, j) => {
        if (!clienteConfirmado || clienteConfirmado.customerId !== item.customer_id) return;
        const preview = $("cliente-fiado-preview");
        if (j.existe === false) {
          preview.textContent = "Este cliente no está en la ficha.";
          return;
        }
        const saldo = formatearCentavos(j.saldo_centavos ?? 0);
        if (j.sin_tope) {
          preview.textContent = "Saldo " + saldo + ". Sin tope.";
          return;
        }
        preview.textContent = "Saldo " + saldo + ". Disponible " + formatearCentavos(j.disponible_centavos ?? 0) + ".";
      };
      const elegirClienteFiado = (item) => {
        clienteConfirmado = { customerId: item.customer_id, nombre: item.nombre };
        $("cliente-fiado-elegido").textContent = "Elegido: " + item.nombre;
        $("cliente-fiado-opciones").textContent = "";
        $("cliente-fiado-preview").textContent = "Consultando saldo…";
        fetch("/api/credit/balance?customer_id=" + encodeURIComponent(item.customer_id))
          .then((r) => {
            if (!r.ok) throw new Error("http " + r.status);
            return r.json();
          })
          .then((j) => pintarPreviewFiado(item, j))
          .catch((error) => {
            console.warn("[venta] fiado balance", error);
            if (clienteConfirmado && clienteConfirmado.customerId === item.customer_id) {
              $("cliente-fiado-preview").textContent = "No se pudo leer el saldo.";
            }
          });
      };
      const buscarClientesFiado = (texto) => {
        const lista = $("cliente-fiado-opciones");
        lista.textContent = "";
        if (!texto) return;
        fetch("/api/credit/customers?q=" + encodeURIComponent(texto) + "&limit=8")
          .then((r) => {
            if (!r.ok) throw new Error("http " + r.status);
            return r.json();
          })
          .then((j) => {
            lista.textContent = "";
            const items = j.items ?? [];
            items.forEach((item) => {
              const li = document.createElement("li");
              const boton = document.createElement("button");
              boton.type = "button";
              boton.textContent = item.nombre + " · " + item.customer_id;
              boton.addEventListener("click", () => elegirClienteFiado(item));
              li.appendChild(boton);
              lista.appendChild(li);
            });
            if (items.length === 0) $("cliente-fiado-preview").textContent = "Sin resultados.";
          })
          .catch((error) => {
            console.warn("[venta] fiado buscador", error);
            lista.textContent = "";
            $("cliente-fiado-preview").textContent = "No se pudo buscar clientes.";
          });
      };
      $("cliente-fiado-q").addEventListener("input", () => {
        clienteConfirmado = null;
        $("cliente-fiado-elegido").textContent = "";
        $("cliente-fiado-preview").textContent = "";
        clearTimeout(buscaFiado);
        const texto = $("cliente-fiado-q").value.trim();
        buscaFiado = setTimeout(() => buscarClientesFiado(texto), 250);
      });

      const armarVuelo = (medioCobro, offline) => {
        // P1-31: el perfil persiste su código. Dos teléfonos no comparten seq.
        const device_code = codigoDispositivoLocal(storage);
        // El primer armado solo valida. El seq se gasta después, si el carrito entra.
        const previo = armarCobroDesdeCarrito({
          carrito,
          medio: medioCobro,
          device_code,
          seq_local: 1,
          offline,
          occurredAtIso: new Date().toISOString(),
        });
        if (!previo.ok) return previo;
        const seq = nextSeq();
        const armado = armarCobroDesdeCarrito({
          carrito,
          medio: medioCobro,
          device_code,
          seq_local: seq,
          offline,
          occurredAtIso: new Date().toISOString(),
        });
        if (!armado.ok) return armado;
        return { ok: true, armado, op_id: crypto.randomUUID() };
      };
      $("cobrar").onclick = async () => {
        if (cobrando) return;
        const medio = $("medio").value;
        const fiado = medio === "A cuenta";
        if (!cobroEnVuelo && carrito.length === 0) {
          estado("carrito vacío");
          return;
        }
        // P1-41: venta a cuenta solo online. No encola ni llama /api/sales.
        if (fiado && !cobroEnVuelo) {
          if (!clienteConfirmado) {
            estado("Elegí un cliente de la lista.");
            return;
          }
          if (!navigator.onLine) {
            estado("La venta a cuenta necesita conexión.");
            return;
          }
        }
        cobrando = true;
        try {
          if (!cobroEnVuelo) {
            const preparado = armarVuelo(fiado ? "A cuenta" : medio, fiado ? false : !navigator.onLine);
            if (!preparado.ok) {
              estado(textoCarrito(preparado.codigo));
              return;
            }
            const { armado, op_id } = preparado;
            if (fiado) {
              const elegido = clienteConfirmado;
              if (!elegido) {
                estado("Elegí un cliente de la lista.");
                return;
              }
              cobroEnVuelo = {
                op_id,
                fiado: true,
                payload: {
                  customer_id: elegido.customerId,
                  lineas: armado.payload.lineas,
                  device_code: armado.payload.device_code,
                  seq_local: armado.payload.seq_local,
                },
                ticketBase: armado.ticketBase,
              };
            } else {
              cobroEnVuelo = { op_id, fiado: false, payload: armado.payload, ticketBase: armado.ticketBase };
            }
          }
          const vuelo = cobroEnVuelo;
          if (vuelo.fiado) {
            if (!navigator.onLine) {
              estado("La venta a cuenta necesita conexión.");
              return;
            }
            try {
              const r = await fetch("/api/credit/sales-on-account", {
                method: "POST",
                headers: { "Content-Type": "application/json", "Idempotency-Key": vuelo.op_id },
                body: JSON.stringify(vuelo.payload),
              });
              const j = await r.json().catch((error) => {
                console.warn("[venta] fiado sin JSON", r.status, error);
                return {};
              });
              if (r.ok || r.status === 409) {
                const ticket = j.ticket_definitivo || j.original?.ticket_definitivo || vuelo.ticketBase.provisorio;
                publicarTicket({
                  definitivo: j.ticket_definitivo ?? j.original?.ticket_definitivo ?? null,
                  provisorio: vuelo.ticketBase.provisorio,
                  total: String(j.total_centavos ?? j.original?.total_centavos ?? vuelo.ticketBase.total),
                  medio: "A cuenta",
                  lineas: vuelo.ticketBase.lineas,
                  sale_id: null,
                  op_id: vuelo.op_id,
                });
                estado(
                  r.status +
                    " fiado " +
                    (vuelo.payload.customer_id || "") +
                    " ticket " +
                    ticket +
                    " total " +
                    (j.total_centavos ?? ""),
                );
                return;
              }
              if (r.status === 403 && j.codigo === "TOPE_SUPERADO") {
                cobroEnVuelo = null;
                estado(j.error || "Supera el tope. Cobrá con otro medio o pedile al dueño.");
                return;
              }
              if (r.status === 404) {
                cobroEnVuelo = null;
                estado("Ese cliente no está en la ficha. Elegí uno de la lista.");
                return;
              }
              if (r.status >= 400 && r.status < 500) {
                cobroEnVuelo = null;
                estado(r.status + " " + (j.error || "venta a cuenta falló"));
                return;
              }
              estado(r.status + " " + (j.error || "venta a cuenta falló"));
            } catch (error) {
              console.warn("[venta] fiado", error);
              estado("La venta a cuenta necesita conexión.");
            }
            return;
          }
          try {
            const r = await fetch("/api/sales", {
              method: "POST",
              headers: { "Content-Type": "application/json", "Idempotency-Key": vuelo.op_id },
              body: JSON.stringify(vuelo.payload),
            });
            const txt = await r.text();
            let j = {};
            try { j = JSON.parse(txt); } catch { /* no json */ }
            if (r.ok) {
              publicarTicket({
                definitivo: j.ticket_definitivo ?? null,
                provisorio: j.ticket_provisorio || vuelo.ticketBase.provisorio,
                total: String(j.total_centavos ?? vuelo.ticketBase.total),
                medio: vuelo.payload.medio,
                lineas: vuelo.ticketBase.lineas,
                sale_id: j.sale_id ?? null,
                op_id: vuelo.op_id,
              });
              estado(r.status + " " + txt);
              return;
            }
            if (r.status === 409) {
              const orig = j.original && typeof j.original === "object" ? j.original : {};
              publicarTicket({
                definitivo: orig.ticket_definitivo ?? null,
                provisorio: orig.ticket_provisorio || vuelo.ticketBase.provisorio,
                total: String(orig.total_centavos ?? vuelo.ticketBase.total),
                medio: vuelo.payload.medio,
                lineas: vuelo.ticketBase.lineas,
                sale_id: null,
                op_id: vuelo.op_id,
              });
              estado(r.status + " " + txt);
              return;
            }
            if (r.status >= 400 && r.status < 500) {
              cobroEnVuelo = null;
              estado(r.status + " " + txt);
              return;
            }
            estado(r.status + " " + txt);
          } catch {
            // Por qué localStorage y no memoria: el corte de red en cobro (Slice-0 E2E)
            // exige provisorio DeviceCode-SeqLocal y reintento sin duplicar por op_id.
            const q = JSON.parse(storage.getItem(outboxKey) ?? "[]");
            q.push({
              op_id: vuelo.op_id,
              device_code: vuelo.payload.device_code,
              device_seq: vuelo.payload.seq_local,
              payload: vuelo.payload,
            });
            storage.setItem(outboxKey, JSON.stringify(q));
            refrescarIndicador();
            // STOCK-S1 (ADR-0106): la próxima venta del SKU autocompleta precio
            // desde el snapshot local en vez de volver a pedir el nombre.
            if (tenant) {
              for (const linea of vuelo.payload.lineas) {
                if (!linea.alta) continue;
                catalogo = agregarProvisorio(storage, tenant, linea.product_id, linea.precio_centavos);
              }
              mostrarCatalogo();
            }
            publicarTicket({
              definitivo: null,
              provisorio: vuelo.ticketBase.provisorio,
              total: vuelo.ticketBase.total,
              medio: vuelo.payload.medio,
              lineas: vuelo.ticketBase.lineas,
              sale_id: null,
              op_id: vuelo.op_id,
            });
            // P1-59: el aviso mira el stock proyectado después de encolar y no frena el cobro.
            let avisoAgotado = "";
            for (const linea of vuelo.payload.lineas) {
              if (avisoStockLocalAgotado(stockLocal(catalogo, q, linea.product_id))) {
                avisoAgotado = " El stock registrado de este producto ya estaba en 0";
                break;
              }
            }
            estado("offline provisorio " + vuelo.ticketBase.provisorio + " encolado " + vuelo.op_id + avisoAgotado);
          }
        } finally {
          cobrando = false;
          balance();
        }
      };
      const enviar = async (item) => {
        const res = await fetch("/api/sync/push", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Idempotency-Key": item.op_id },
          body: JSON.stringify({ op_id: item.op_id, device_code: item.device_code, device_seq: item.device_seq, hlc: String(Date.now()) + ":0", modulo: "sales", payload: item.payload, client_occurred_at: new Date().toISOString() }),
        });
        const cuerpo = await res.json().catch((error) => { console.warn("[venta] sync sin JSON", res.status, error); return {}; });
        return { status: res.status, cuerpo };
      };
      // P1-38: tras push OK pide el T-* (ADR-0017). Fallo no re-encola.
      const promover = async (item) => {
        const res = await fetch("/api/sync/promote", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Idempotency-Key": item.op_id },
          body: JSON.stringify({
            op_id: item.op_id,
            device_code: item.device_code,
            device_seq: item.device_seq,
          }),
        });
        const cuerpo = await res.json().catch((error) => {
          console.warn("[venta] promote sin JSON", res.status, error);
          return {};
        });
        if (!res.ok) throw new Error("promote http " + res.status);
        const resultado = {
          ticket_definitivo:
            typeof cuerpo.ticket_definitivo === "string" ? cuerpo.ticket_definitivo : undefined,
        };
        aplicarTicketDefinitivoSiVisible(item, resultado.ticket_definitivo);
        return resultado;
      };
      // P1-28: online y Reintentar sync comparten drenadoUnico (un vuelo).
      const drenado = drenadoUnico({ storage, tenantId: tenant || null, enviar, promover });
      async function aplicarDrenado(origen) {
        const hayCola = contarPendientesCola(storage, tenant || null) > 0;
        if (hayCola) {
          vuelosIndicador += 1;
          refrescarIndicador();
        }
        try {
          const resultado = await drenado.drenar();
          cortadoIndicador = resultado.tenant.cortado || (resultado.legado !== null && resultado.legado.cortado);
          const texto = textoDeDrenado(origen, resultado);
          if (texto !== null) {
            estado(texto);
            balance();
          }
        } finally {
          if (hayCola) vuelosIndicador -= 1;
          refrescarIndicador();
        }
      }
      $("sync").onclick = () => {
        void aplicarDrenado("boton");
      };
      window.addEventListener("offline", () => {
        refrescarIndicador();
      });
      window.addEventListener("online", () => {
        void refrescarCatalogo();
        if (esHarnessWorst) {
          refrescarIndicador();
          return;
        }
        void aplicarDrenado("linea");
      });
      // P1-30: volver a la pestaña usa el mismo vuelo que online. Origen "linea"
      // para que una cola vacía no pise #estado.
      document.addEventListener("visibilitychange", () => {
        if (!debeDrenarPorVisibilidad(document.visibilityState, esHarnessWorst)) return;
        void aplicarDrenado("linea");
      });
      // P1-56: el resumen sale de la tarjeta. Sin sale_id no hay ticket en el
      // servidor, y con sale_id wa.me local alcanza para este corte.
      $("compartir").onclick = () => {
        if (!lastTicket) { estado("sin ticket (cobrá primero)"); return; }
        const to = prompt("Teléfono E.164 (ej. +5491100000000)", "+5491100000000") ?? "";
        const resumen = construir_resumen_ticket({
          definitivo: lastTicket.definitivo,
          provisorio: lastTicket.provisorio,
          totalCentavos: BigInt(lastTicket.total),
          medio: lastTicket.medio,
          comercio: "Comercio",
        });
        const wa = construir_wa_me_url({ toE164: to, resumen });
        if (!wa.ok) { estado("teléfono inválido"); return; }
        window.open(wa.url, "_blank");
      };
      $("imprimir").onclick = () => {
        if (!lastTicket) { estado("sin ticket (cobrá primero)"); return; }
        window.print();
      };
      // TV15 P2: térmica BLE (58mm/32 cols). El <script> del navegador no puede
      // importar .ts, así que el envío GATT se espeja acá en compacto; el
      // canónico es src/modules/sales/escpos_bt.ts (chunks 512B + corte GS V).
      // Requiere gesto (click) + HTTPS/localhost; iOS/Safari no soporta BT.
      $("imprimir-bt").onclick = async () => {
        if (!lastTicket) { estado("sin ticket para BT (cobrá primero)"); return; }
        try {
          const t = await fetch("/api/tickets/thermal", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              comercio: "Comercio",
              ticketDefinitivo: lastTicket.definitivo,
              provisorio: lastTicket.provisorio,
              fechaIso: new Date().toISOString(),
              medio: lastTicket.medio,
              lineas: lastTicket.lineas.map((l) => ({ sku: l.sku, cantidad: l.cantidad, precioCentavos: l.precio })),
              totalBrutoCentavos: lastTicket.total,
              totalDescuentoCentavos: "0",
              totalNetoCentavos: lastTicket.total,
            }),
          });
          const th = await t.json().catch((error) => { console.warn("[venta] respuesta sin JSON", t.status, error); return {}; });
          if (!t.ok || !th.cols32) { estado("thermal: " + JSON.stringify(th)); return; }
          const nav = navigator;
          if (!nav.bluetooth) { estado("BT no soportado acá; usá Imprimir"); window.print(); return; }
          estado("BT: elegí la impresora…");
          const device = await nav.bluetooth.requestDevice({
            filters: [{ services: ["6e400001-b5a3-f393-e0a9-e50e24dcca9e"] }],
            optionalServices: ["6e400001-b5a3-f393-e0a9-e50e24dcca9e"],
          });
          if (!device.gatt) { estado("BT: sin GATT"); return; }
          if (!device.gatt.connected) await device.gatt.connect();
          const service = await device.gatt.getPrimaryService("6e400001-b5a3-f393-e0a9-e50e24dcca9e");
          const ch = await service.getCharacteristic("6e400002-b5a3-f393-e0a9-e50e24dcca9e");
          const bytes = new TextEncoder().encode(th.cols32 + "\n");
          for (let i = 0; i < bytes.length; i += 512) {
            const buf = bytes.slice(i, i + 512).buffer;
            if (ch.writeValueWithResponse) await ch.writeValueWithResponse(buf);
            else await ch.writeValue(buf);
          }
          const corte = new Uint8Array([0x0a, 0x0a, 0x0a, 0x1d, 0x56, 0x00]).buffer;
          if (ch.writeValueWithResponse) await ch.writeValueWithResponse(corte);
          else await ch.writeValue(corte);
          try { device.gatt.disconnect(); } catch { /* best-effort */ }
          estado("BT: impreso + corte");
        } catch (e) {
          const name = e && e.name ? e.name : "";
          if (name === "NotFoundError" || name === "AbortError") estado("BT: no elegiste impresora");
          else estado("BT falló; usá Imprimir");
        }
      };
      refrescarIndicador();
      if (!(import.meta.env.DEV && document.getElementById("lineas-worst"))) balance();
    </script>
  </body>
</html>
