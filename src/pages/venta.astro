        boton.textContent = "Usar " + existente.nombre;
        boton.addEventListener("click", () => {
          clearTimeout(buscaFiado);
          $("cliente-fiado-q").value = "";
          cerrarAltaFiado();
          elegirClienteFiado({ customer_id: existente.customer_id, nombre: existente.nombre });
        });
        aviso.appendChild(boton);
      };
      const altaClienteFiado = async () => {
        if (altaFiadoEnVuelo) return;
        if (!navigator.onLine) {
          estado("La venta a cuenta necesita conexión.");
          return;
        }
        altaFiadoEnVuelo = true;
        $("cliente-fiado-alta-guardar").disabled = true;
        limpiarAvisoAltaFiado();
        try {
          const r = await fetch("/api/credit/customers", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              nombre: $("cliente-fiado-alta-nombre").value,
              telefono: $("cliente-fiado-alta-telefono").value,
            }),
          });
          const j = await r.json().catch((error) => {
            console.warn("[venta] alta cliente sin JSON", r.status, error);
            return {};
          });
          if (r.status === 201) {
            clearTimeout(buscaFiado);
            $("cliente-fiado-q").value = "";
            cerrarAltaFiado();
            elegirClienteFiado({ customer_id: j.customer_id, nombre: j.nombre });
            return;
          }
          if (r.status === 409 && j.codigo === "DUPLICADO" && j.existente) {
            pintarOfertaDuplicado(j.existente);
            return;
          }
          if (r.status === 503) {
            pintarAvisoAltaFiado("La venta a cuenta necesita la ficha en el servidor.");
            return;
          }
          if (r.status === 422) {
            pintarAvisoAltaFiado(typeof j.error === "string" ? j.error : "Revisá nombre y teléfono.");
            return;
          }
          pintarAvisoAltaFiado(typeof j.error === "string" ? j.error : "No se pudo crear el cliente.");
        } catch (error) {
          console.warn("[venta] alta cliente", error);
          pintarAvisoAltaFiado("No se pudo crear el cliente.");
        } finally {
          altaFiadoEnVuelo = false;
          $("cliente-fiado-alta-guardar").disabled = false;
        }
      };
      $("cliente-fiado-nuevo").addEventListener("click", () => {
        $("cliente-fiado-alta").hidden = false;
        limpiarAvisoAltaFiado();
        if (!$("cliente-fiado-alta-nombre").value) {
          $("cliente-fiado-alta-nombre").value = $("cliente-fiado-q").value.trim();
        }
        $("cliente-fiado-alta-nombre").focus();
      });
      $("cliente-fiado-alta-cancelar").addEventListener("click", () => {
        cerrarAltaFiado();
      });
      $("cliente-fiado-alta-guardar").addEventListener("click", () => {
        void altaClienteFiado();
      });

      const armarVuelo = (medioCobro, offline) => {
        // P1-31: el perfil persiste su código. Dos teléfonos no comparten seq.
        const device_code = codigoDispositivoLocal(storage);
        // El primer armado solo valida. El seq se gasta después, si el carrito entra.
        const previo = armarCobroDesdeCarrito({
          carrito,
          medio: medioCobro,
          device_code,
          seq_local: 1,
          offline,
          occurredAtIso: new Date().toISOString(),
        });
        if (!previo.ok) return previo;
        const seq = nextSeq();
        const armado = armarCobroDesdeCarrito({
          carrito,
          medio: medioCobro,
          device_code,
          seq_local: seq,
          offline,
          occurredAtIso: new Date().toISOString(),
        });
        if (!armado.ok) return armado;
        return { ok: true, armado, op_id: crypto.randomUUID() };
      };
      // TB-160: el paso abre sin POST. Confirmar reusa el mismo vuelo, sin un cobro de demostración.
      $("cobrar").addEventListener("click", () => {
        if ($("cobrar").disabled || carrito.length === 0) return;
        pintarCobro();
        syncEfectivoRecibido();
        mostrarPaso("cobro");
        $("cobro-titulo").focus();
      });
      $("volver-ticket").addEventListener("click", () => {
        mostrarPaso("ticket");
        pintarCarrito();
        $("sku").focus();
      });
      $("confirmar-cobro").onclick = async () => {
        if (cobrando) return;
        const medio = $("medio").value;
        const fiado = medio === "A cuenta";
        if (!cobroEnVuelo && carrito.length === 0) {
          estado("carrito vacío");
          return;
        }
        // TB-162: el vuelto es de interfaz. Con recibido cargado, no confirma si alcanza menos que el total.
        if (medio === "Efectivo" && !cobroEnVuelo) {
          const evaluacion = evaluarVueltoEfectivo(totalCentavosCarrito(carrito), $("efectivo-recibido").value);
          if (!evaluacion.ok) {
            if (evaluacion.codigo === "recibido_insuficiente") {
              estado("El monto recibido no alcanza para el total.");
              return;
            }
            estado("Revisá el monto recibido.");
            return;
          }
        }
        // P1-41: venta a cuenta solo online. No encola ni llama /api/sales.
        if (fiado && !cobroEnVuelo) {
          if (!navigator.onLine) {
            estado("La venta a cuenta necesita conexión.");
            return;
          }
          if (!clienteConfirmado) {
            estado("Elegí un cliente de la lista.");
            return;
          }
        }
        cobrando = true;
        syncCobrar();
        syncModoCobrando();
        try {
          if (!cobroEnVuelo) {
            const preparado = armarVuelo(fiado ? "A cuenta" : medio, fiado ? false : !navigator.onLine);
            if (!preparado.ok) {
              estado(textoCarrito(preparado.codigo));
              return;
            }
            const { armado, op_id } = preparado;
            if (fiado) {
              const elegido = clienteConfirmado;
              if (!elegido) {
                estado("Elegí un cliente de la lista.");
                return;
              }
              cobroEnVuelo = {
                op_id,
                fiado: true,
                payload: {
                  customer_id: elegido.customerId,
                  lineas: armado.payload.lineas,
                  device_code: armado.payload.device_code,
                  seq_local: armado.payload.seq_local,
                },
                ticketBase: armado.ticketBase,
              };
            } else {
              cobroEnVuelo = { op_id, fiado: false, payload: armado.payload, ticketBase: armado.ticketBase };
            }
          }
          const vuelo = cobroEnVuelo;
          if (vuelo.fiado) {
            if (!navigator.onLine) {
              estado("La venta a cuenta necesita conexión.");
              return;
            }
            try {
              const pedirFiado = async () => {
                const respuesta = await fetch("/api/credit/sales-on-account", {
                  method: "POST",
                  headers: { "Content-Type": "application/json", "Idempotency-Key": vuelo.op_id },
                  body: JSON.stringify(vuelo.payload),
                });
                const cuerpo = await respuesta.json().catch((error) => {
                  console.warn("[venta] fiado sin JSON", respuesta.status, error);
                  return {};
                });
                return { respuesta, cuerpo };
              };
              let { respuesta: r, cuerpo: j } = await pedirFiado();
              // P1-67: este 403 no suelta el vuelo. Cancelar sí. Aceptar reintenta la misma clave una vez.
              if (r.status === 403 && j.codigo === "CONFIRMACION_EXCESO") {
                const c = j.confirmacion && typeof j.confirmacion === "object" ? j.confirmacion : {};
                const acepta = await confirmar({
                  titulo: typeof c.titulo === "string" ? c.titulo : "",
                  mensaje: typeof c.mensaje === "string" ? c.mensaje : (typeof j.error === "string" ? j.error : ""),
                  accion: typeof c.accion === "string" ? c.accion : "",
                });
                if (!acepta) {
                  cobroEnVuelo = null;
                  estado("Venta a cuenta cancelada.");
                  return;
                }
                vuelo.payload = { ...vuelo.payload, confirmado_exceso: true };
                ({ respuesta: r, cuerpo: j } = await pedirFiado());
              }
              if (r.ok || r.status === 409) {
                const ticket = j.ticket_definitivo || j.original?.ticket_definitivo || vuelo.ticketBase.provisorio;
                publicarTicket({
                  definitivo: j.ticket_definitivo ?? j.original?.ticket_definitivo ?? null,
                  provisorio: vuelo.ticketBase.provisorio,
                  total: String(j.total_centavos ?? j.original?.total_centavos ?? vuelo.ticketBase.total),
                  medio: "A cuenta",
                  lineas: vuelo.ticketBase.lineas,
                  sale_id: null,
                  op_id: vuelo.op_id,
                });
                estado(
                  r.status +
                    " fiado " +
                    (vuelo.payload.customer_id || "") +
                    " ticket " +
                    ticket +
                    " total " +
                    (j.total_centavos ?? ""),
                );
                return;
              }
              if (r.status === 403 && j.codigo === "TOPE_SUPERADO") {
                cobroEnVuelo = null;
                estado(j.error || "Supera el tope. Cobrá con otro medio o pedile al dueño.");
                return;
              }
              if (r.status === 403 && j.codigo === "MORA") {
                cobroEnVuelo = null;
                estado(j.error || "Este cliente está en mora. Pedile al dueño.");
                return;
              }
              if (r.status === 404) {
                cobroEnVuelo = null;
                estado("Ese cliente no está en la ficha. Elegí uno de la lista.");
                return;
              }
              if (r.status >= 400 && r.status < 500) {
                cobroEnVuelo = null;
                estado(r.status + " " + (j.error || "venta a cuenta falló"));
                return;
              }
              estado(r.status + " " + (j.error || "venta a cuenta falló"));
            } catch (error) {
              console.warn("[venta] fiado", error);
              estado("La venta a cuenta necesita conexión.");
            }
            return;
          }
          try {
            const r = await fetch("/api/sales", {
              method: "POST",
              headers: { "Content-Type": "application/json", "Idempotency-Key": vuelo.op_id },
              body: JSON.stringify(vuelo.payload),
            });
            const txt = await r.text();
            let j = {};
            try { j = JSON.parse(txt); } catch { /* no json */ }
            if (r.ok) {
              publicarTicket({
                definitivo: j.ticket_definitivo ?? null,
                provisorio: j.ticket_provisorio || vuelo.ticketBase.provisorio,
                total: String(j.total_centavos ?? vuelo.ticketBase.total),
                medio: vuelo.payload.medio,
                lineas: vuelo.ticketBase.lineas,
                sale_id: j.sale_id ?? null,
                op_id: vuelo.op_id,
              });
              estado(r.status + " " + txt);
              return;
            }
            if (r.status === 409) {
              const orig = j.original && typeof j.original === "object" ? j.original : {};
              publicarTicket({
                definitivo: orig.ticket_definitivo ?? null,
                provisorio: orig.ticket_provisorio || vuelo.ticketBase.provisorio,
                total: String(orig.total_centavos ?? vuelo.ticketBase.total),
                medio: vuelo.payload.medio,
                lineas: vuelo.ticketBase.lineas,
                sale_id: null,
                op_id: vuelo.op_id,
              });
              estado(r.status + " " + txt);
              return;
            }
            if (r.status >= 400 && r.status < 500) {
              cobroEnVuelo = null;
              estado(r.status + " " + txt);
              return;
            }
            estado(r.status + " " + txt);
          } catch {
            // Por qué localStorage y no memoria: el corte de red en cobro (Slice-0 E2E)
            // exige provisorio DeviceCode-SeqLocal y reintento sin duplicar por op_id.
            const q = JSON.parse(storage.getItem(outboxKey) ?? "[]");
            q.push({
              op_id: vuelo.op_id,
              device_code: vuelo.payload.device_code,
              device_seq: vuelo.payload.seq_local,
              payload: vuelo.payload,
            });
            storage.setItem(outboxKey, JSON.stringify(q));
            refrescarIndicador();
            // STOCK-S1 (ADR-0106): la próxima venta del SKU autocompleta precio
            // desde el snapshot local en vez de volver a pedir el nombre.
            if (tenant) {
              for (const linea of vuelo.payload.lineas) {
                if (!linea.alta) continue;
                catalogo = agregarProvisorio(storage, tenant, linea.product_id, linea.precio_centavos);
              }
              mostrarCatalogo();
            }
            publicarTicket({
              definitivo: null,
              provisorio: vuelo.ticketBase.provisorio,
              total: vuelo.ticketBase.total,
              medio: vuelo.payload.medio,
              lineas: vuelo.ticketBase.lineas,
              sale_id: null,
              op_id: vuelo.op_id,
            });
            // P1-59: el aviso mira el stock proyectado después de encolar y no frena el cobro.
            let avisoAgotado = "";
            for (const linea of vuelo.payload.lineas) {
              if (avisoStockLocalAgotado(stockLocal(catalogo, q, linea.product_id))) {
                avisoAgotado = " El stock registrado de este producto ya estaba en 0";
                break;
              }
            }
            estado("offline provisorio " + vuelo.ticketBase.provisorio + " encolado " + vuelo.op_id + avisoAgotado);
          }
        } finally {
          cobrando = false;
          syncCobrar();
          syncModoCobrando();
          balance();
        }
      };
      const enviar = async (item) => {
        const res = await fetch("/api/sync/push", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Idempotency-Key": item.op_id },
          body: JSON.stringify({ op_id: item.op_id, device_code: item.device_code, device_seq: item.device_seq, hlc: String(Date.now()) + ":0", modulo: "sales", payload: item.payload, client_occurred_at: new Date().toISOString() }),
        });
        const cuerpo = await res.json().catch((error) => { console.warn("[venta] sync sin JSON", res.status, error); return {}; });
        return { status: res.status, cuerpo };
      };
      // P1-38: tras push OK pide el T-* (ADR-0017). Fallo no re-encola.
      const promover = async (item) => {
        const res = await fetch("/api/sync/promote", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Idempotency-Key": item.op_id },
          body: JSON.stringify({
            op_id: item.op_id,
            device_code: item.device_code,
            device_seq: item.device_seq,
          }),
        });
        const cuerpo = await res.json().catch((error) => {
          console.warn("[venta] promote sin JSON", res.status, error);
          return {};
        });
        if (!res.ok) throw new Error("promote http " + res.status);
        const resultado = {
          ticket_definitivo:
            typeof cuerpo.ticket_definitivo === "string" ? cuerpo.ticket_definitivo : undefined,
        };
        aplicarTicketDefinitivoSiVisible(item, resultado.ticket_definitivo);
        return resultado;
      };
      // P1-28: online y Reintentar sync comparten drenadoUnico (un vuelo).
      const drenado = drenadoUnico({ storage, tenantId: tenant || null, enviar, promover });
      async function aplicarDrenado(origen) {
        const hayCola = contarPendientesCola(storage, tenant || null) > 0;
        if (hayCola) {
          vuelosIndicador += 1;
          refrescarIndicador();
        }
        try {
          const resultado = await drenado.drenar();
          cortadoIndicador = resultado.tenant.cortado || (resultado.legado !== null && resultado.legado.cortado);
          const texto = textoDeDrenado(origen, resultado);
          if (texto !== null) {
            estado(texto);
            balance();
          }
        } finally {
          if (hayCola) vuelosIndicador -= 1;
          refrescarIndicador();
        }
      }
      $("sync").onclick = () => {
        void aplicarDrenado("boton");
      };
      window.addEventListener("offline", () => {
        refrescarIndicador();
      });
      window.addEventListener("online", () => {
        void refrescarCatalogo();
        if (esHarnessWorst) {
          refrescarIndicador();
          return;
        }
        void aplicarDrenado("linea");
      });
      // P1-30: volver a la pestaña usa el mismo vuelo que online. Origen "linea"
      // para que una cola vacía no pise #estado.
      document.addEventListener("visibilitychange", () => {
        if (!debeDrenarPorVisibilidad(document.visibilityState, esHarnessWorst)) return;
        void aplicarDrenado("linea");
      });
      // P1-56: el resumen sale de la tarjeta. Sin sale_id no hay ticket en el
      // servidor, y con sale_id wa.me local alcanza para este corte.
      $("compartir").onclick = () => {
        if (!lastTicket) { estado("sin ticket (cobrá primero)"); return; }
        const to = prompt("Teléfono E.164 (ej. +5491100000000)", "+5491100000000") ?? "";
        const resumen = construir_resumen_ticket({
          definitivo: lastTicket.definitivo,
          provisorio: lastTicket.provisorio,
          totalCentavos: BigInt(lastTicket.total),
          medio: lastTicket.medio,
          comercio: "Comercio",
        });
        const wa = construir_wa_me_url({ toE164: to, resumen });
        if (!wa.ok) { estado("teléfono inválido"); return; }
        window.open(wa.url, "_blank");
      };
      $("imprimir").onclick = () => {
        if (!lastTicket) { estado("sin ticket (cobrá primero)"); return; }
        window.print();
      };
      // TV15 P2: térmica BLE (58mm/32 cols). El <script> del navegador no puede
      // importar .ts, así que el envío GATT se espeja acá en compacto; el
      // canónico es src/modules/sales/escpos_bt.ts (chunks 512B + corte GS V).
      // Requiere gesto (click) + HTTPS/localhost; iOS/Safari no soporta BT.
      $("imprimir-bt").onclick = async () => {
        if (!lastTicket) { estado("sin ticket para BT (cobrá primero)"); return; }
        try {
          const t = await fetch("/api/tickets/thermal", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              comercio: "Comercio",
              ticketDefinitivo: lastTicket.definitivo,
              provisorio: lastTicket.provisorio,
              fechaIso: new Date().toISOString(),
              medio: lastTicket.medio,
              lineas: lastTicket.lineas.map((l) => ({ sku: l.sku, cantidad: l.cantidad, precioCentavos: l.precio })),
              totalBrutoCentavos: lastTicket.total,
              totalDescuentoCentavos: "0",
              totalNetoCentavos: lastTicket.total,
            }),
          });
          const th = await t.json().catch((error) => { console.warn("[venta] respuesta sin JSON", t.status, error); return {}; });
          if (!t.ok || !th.cols32) { estado("thermal: " + JSON.stringify(th)); return; }
          const nav = navigator;
          if (!nav.bluetooth) { estado("BT no soportado acá; usá Imprimir"); window.print(); return; }
          estado("BT: elegí la impresora…");
          const device = await nav.bluetooth.requestDevice({
            filters: [{ services: ["6e400001-b5a3-f393-e0a9-e50e24dcca9e"] }],
            optionalServices: ["6e400001-b5a3-f393-e0a9-e50e24dcca9e"],
          });
          if (!device.gatt) { estado("BT: sin GATT"); return; }
          if (!device.gatt.connected) await device.gatt.connect();
          const service = await device.gatt.getPrimaryService("6e400001-b5a3-f393-e0a9-e50e24dcca9e");
          const ch = await service.getCharacteristic("6e400002-b5a3-f393-e0a9-e50e24dcca9e");
          const bytes = new TextEncoder().encode(th.cols32 + "\n");
          for (let i = 0; i < bytes.length; i += 512) {
            const buf = bytes.slice(i, i + 512).buffer;
            if (ch.writeValueWithResponse) await ch.writeValueWithResponse(buf);
            else await ch.writeValue(buf);
          }
          const corte = new Uint8Array([0x0a, 0x0a, 0x0a, 0x1d, 0x56, 0x00]).buffer;
          if (ch.writeValueWithResponse) await ch.writeValueWithResponse(corte);
          else await ch.writeValue(corte);
          try { device.gatt.disconnect(); } catch { /* best-effort */ }
          estado("BT: impreso + corte");
        } catch (e) {
          const name = e && e.name ? e.name : "";
          if (name === "NotFoundError" || name === "AbortError") estado("BT: no elegiste impresora");
          else estado("BT falló; usá Imprimir");
        }
      };
      refrescarIndicador();
      if (!(import.meta.env.DEV && document.getElementById("lineas-worst"))) balance();
    </script>
      </div>
    </div>
    <ConfirmDialog />
    <ReportesComercioDialog />
  </body>
