---
import { Toaster } from "../components/ui/Toaster";
import { hrefModulo, pillsPanel } from "../lib/panel-modulos.js";
const pills = pillsPanel("dashboard");
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel del comercio</title>
    <style>
      :root {
        --papel: #f7f5f2; --canvas: #efecea; --tinta: #1a1a1a;
        --llama: #ffd600; --llama-hover: #ffe033; --muted: #8a8578;
        --card: #ffffff; --radio: 16px;
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: system-ui, sans-serif; background: var(--papel); color: var(--tinta); }
      .wrap { max-width: 1180px; margin: 0 auto; padding: 16px; }
      .topbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .logo { border: 1px solid #ddd6c4; border-radius: 999px; padding: 8px 16px; font-weight: 700; background: var(--card); }
      nav.pills { display: flex; gap: 4px; background: var(--canvas); border-radius: 999px; padding: 4px; overflow-x: auto; max-width: 100%; }
      nav.pills a { white-space: nowrap; text-decoration: none; color: #55524a; font-size: 14px; padding: 8px 14px; border-radius: 999px; min-height: 36px; display: inline-flex; align-items: center; }
      nav.pills a.active, nav.pills a:hover { background: var(--tinta); color: #fff; }
      .top-right { margin-left: auto; display: flex; gap: 8px; align-items: center; }
      .top-right input { border: 1px solid #ddd6c4; border-radius: 999px; padding: 8px 14px; font-size: 14px; background: var(--card); min-height: 36px; }
      .avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--tinta); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; }
      h1.hello { font-size: clamp(28px, 4vw, 44px); margin: 20px 0 4px; font-weight: 600; }
      .sub { color: var(--muted); font-size: 14px; margin-bottom: 12px; }
      .kpis { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
      .segbar { display: flex; height: 34px; border-radius: 999px; overflow: hidden; background: var(--canvas); min-width: min(420px, 100%); font-size: 12px; font-weight: 700; }
      .segbar span { display: inline-flex; align-items: center; padding: 0 12px; }
      .bignums { display: flex; gap: 28px; }
      .bignum { text-align: left; }
      .bignum b { font-size: clamp(28px, 4vw, 44px); font-weight: 600; display: block; }
      .bignum small { color: var(--muted); font-size: 12px; }
      .grid { display: grid; gap: 16px; }
      .grid.r1 { grid-template-columns: 240px 1fr 300px; }
      .grid.r2 { grid-template-columns: 1fr 300px; margin-top: 16px; }
      .grid.r3 { grid-template-columns: repeat(5, 1fr); margin-top: 16px; }
      .card { background: var(--card); border-radius: var(--radio); padding: 16px; box-shadow: 0 1px 3px rgba(0,0,0,.06); min-width: 0; }
      .card h2 { font-size: 18px; margin: 0 0 8px; display: flex; justify-content: space-between; align-items: center; }
      .card h2 a { text-decoration: none; color: var(--muted); border: 1px solid #e3ddcd; border-radius: 50%; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; }
      .demo { font-size: 11px; background: var(--llama); border-radius: 999px; padding: 2px 8px; font-weight: 700; }
      .live { font-size: 11px; background: #d9f2e2; color: #1c6b3a; border-radius: 999px; padding: 2px 8px; font-weight: 700; }
      .tl { list-style: none; margin: 0; padding: 0; font-size: 13px; }
      .tl li { border-left: 2px solid #e3ddcd; margin-left: 8px; padding: 6px 0 6px 12px; position: relative; }
      .tl li::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--llama); position: absolute; left: -5px; top: 10px; }
      .hora { display: inline-block; border: 1px solid #e3ddcd; border-radius: 999px; padding: 1px 8px; font-size: 11px; margin-right: 6px; }
      table.mov { width: 100%; border-collapse: collapse; font-size: 13px; }
      table.mov th { text-align: left; color: var(--muted); font-weight: 500; padding: 6px; border-bottom: 1px solid var(--canvas); }
      table.mov td { padding: 8px 6px; border-bottom: 1px solid var(--canvas); }
      .pill { border-radius: 999px; padding: 2px 10px; font-size: 12px; }
      .ok { background: #ece7f8; color: #5b4fa6; } .warn { background: #eef0f1; color: #6b6f73; } .pend { background: #e8f7d9; color: #4c7a1f; }
      .dark { background: var(--tinta); color: #fff; }
      .dark h2 a { color: #fff; border-color: #444; }
      .heat { display: grid; grid-template-columns: repeat(24, 1fr); gap: 3px; margin-top: 12px; }
      .heat i { aspect-ratio: 1; border-radius: 50%; background: #3a3a3a; }
      .heat i.on { background: var(--llama); }
      .bign { font-size: 30px; }
      svg.chart { width: 100%; height: 170px; }
      .dona { display: flex; align-items: center; justify-content: center; }
      .legend { display: flex; gap: 16px; justify-content: center; font-size: 14px; margin-top: 8px; }
      .banner { display: flex; align-items: center; gap: 12px; background: var(--tinta); color: #fff; border-radius: var(--radio); padding: 14px 18px; margin-bottom: 16px; }
      .banner a { background: var(--llama); color: var(--tinta); font-weight: 700; border-radius: 999px; padding: 10px 22px; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
      .mini { font-size: 13px; color: #55524a; }
      .mini a { color: var(--tinta); font-weight: 600; }
      .estado { font-size: 12px; color: var(--muted); margin-top: 8px; }
      :target { outline: 2px solid var(--llama); outline-offset: 4px; }
      @media (max-width: 900px) {
        .grid.r1, .grid.r2, .grid.r3 { grid-template-columns: 1fr; }
        .top-right input { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="topbar">
        <a class="logo" href="/" style="text-decoration:none;color:inherit">Inventario</a>
        <nav class="pills" aria-label="Módulos">
          {pills.map((p) => <a href={p.href} class={p.activo ? "active" : ""} aria-current={p.activo ? "page" : undefined}>{p.label}</a>)}
        </nav>
        <span class="top-right">
          <input id="q" type="search" placeholder="Buscar" aria-label="Buscar en movimientos" />
          <span class="avatar" title="Comercio">C</span>
        </span>
      </div>

      <h1 class="hello">Hola</h1>
      <div class="sub">Panel del comercio · todo lo hecho, visible de un vistazo</div>

      <div class="kpis">
        <div class="segbar" title="Distribución de la operatoria">
          <span style="background:#1a1a1a;color:#fff;width:70%">Ventas 70%</span>
          <span style="background:#ffd600;width:10%">10%</span>
          <span style="width:15%;background:repeating-linear-gradient(45deg,#efecea,#efecea 4px,#fff 4px,#fff 8px)">15%</span>
          <span style="width:5%;border:1px solid #ddd6c4;border-radius:0 999px 999px 0">5%</span>
        </div>
        <div class="bignums">
          <div class="bignum"><b id="n-tickets">…</b><small>Tickets hoy</small></div>
          <div class="bignum"><b id="n-stock">…</b><small>Stock bajo</small></div>
          <div class="bignum"><b id="n-caja">—</b><small>Caja total <span class="live">en vivo</span></small></div>
        </div>
      </div>
      <div class="estado" id="kpi-estado">Resumen: cargando…</div>

      <div class="banner">
        <div><b>Venta mostrador</b><br /><span class="mini" style="color:#cfc9b8">Cobrar, sync offline y balance — como siempre.</span></div>
        <span style="margin-left:auto"></span>
        <a href="/venta">Vender →</a>
      </div>

      <div class="grid r1">
        <section class="card" id="caja">
          <h2>Turnos <a href={hrefModulo("caja")} aria-label="Ir a caja">↗</a></h2>
          <ul class="tl" id="turnos-lista"></ul>
          <div class="estado" id="turnos-estado">Turnos: cargando…</div>
          <div class="mini"><a href="/api/cash/balance">Ver balance JSON</a> · turnos full en P1</div>
        </section>

        <section class="card" id="movimientos">
          <h2>Últimos movimientos <a href={hrefModulo("reportes")} aria-label="Ir a reportes">↗</a></h2>
          <table class="mov">
            <thead><tr><th></th><th>Detalle</th><th>Medio</th><th>Importe</th><th>Estado</th></tr></thead>
            <tbody id="mov-body">
              <tr><td colspan="5">Cargando…</td></tr>
            </tbody>
          </table>
          <div class="estado" id="movimientos-estado">Movimientos: cargando…</div>
          <div class="mini">Historial real en <span style="font-family:monospace">GET /api/cash/history</span> · tickets en <span style="font-family:monospace">GET /api/tickets?numero=</span></div>
          <div class="estado" id="balance-estado">Balance: cargando…</div>
        </section>

        <section class="card dark" id="reportes">
          <h2>Reporte del día <a href="#ventas" aria-label="Ir a ventas">↗</a></h2>
          <div><span class="bign"><span id="heat-ventas">…</span> ↗</span> &nbsp; <span class="bign" style="color:#cfc9b8"><span id="heat-dev">—</span> ↘</span></div>
          <div class="mini" style="color:#cfc9b8">ventas · devoluciones/pendientes <span class="demo">demo</span></div>
          <div class="heat" id="heat" aria-hidden="true"></div>
          <div class="estado" id="heatmap-estado" style="color:#cfc9b8">Heatmap: cargando…</div>
        </section>
      </div>

      <div class="grid r2">
        <section class="card" id="ventas">
          <h2>Ventas por mes <a href="#ventas" aria-label="Ir a ventas">↗</a></h2>
          <div class="mini">— Efectivo &nbsp; ┄ Digital · <span id="ventas-periodo">…</span></div>
          <svg class="chart" id="ventas-chart" viewBox="0 0 600 170" role="img" aria-label="Ventas por mes">
            <line x1="30" y1="10" x2="30" y2="150" stroke="#e3ddcd" />
            <line x1="30" y1="150" x2="590" y2="150" stroke="#e3ddcd" />
            <polyline id="serie-efectivo" fill="none" stroke="#1a1a1a" stroke-width="2" />
            <polyline id="serie-digital" fill="none" stroke="#ffd600" stroke-width="2" stroke-dasharray="5 4" />
            <g id="ventas-meses" font-size="10" fill="#8a8578"></g>
          </svg>
          <div class="estado" id="ventas-estado">Ventas por mes: cargando…</div>
        </section>

        <section class="card" id="medios">
          <h2>Composición por medio <a href="#medios" aria-label="Ir a medios">↗</a></h2>
          <div class="dona">
            <svg width="150" height="150" viewBox="0 0 150 150" role="img" aria-label="Composición por medio">
              <circle cx="75" cy="75" r="60" fill="none" stroke="#efecea" stroke-width="16" />
              <circle id="dona-arco" cx="75" cy="75" r="60" fill="none" stroke="#ffd600" stroke-width="16" stroke-dasharray="0 377" stroke-linecap="round" transform="rotate(-90 75 75)" />
              <text id="dona-pct" x="75" y="72" text-anchor="middle" font-size="26" font-weight="600">—</text>
              <text x="75" y="90" text-anchor="middle" font-size="11" fill="#8a8578">Efectivo</text>
            </svg>
          </div>
          <div class="legend" id="medios-legend"><span>—</span></div>
          <div class="estado" id="medios-estado">Composición por medio: cargando…</div>
        </section>
      </div>

      <div class="grid r2">
        <section class="card" id="consumos">
          <h2>Consumos de servicios <a href={hrefModulo("consumos")} aria-label="Ir a consumos">↗</a></h2>
          <div class="mini">Cuentas · próximas a vencer (7 días) · vencidas <span class="live">en vivo</span></div>
          <ul class="tl" id="consumos-cuentas"></ul>
          <h3 style="font-size:13px;margin:12px 0 4px">Próximas a vencer</h3>
          <ul class="tl" id="consumos-proximas"></ul>
          <h3 style="font-size:13px;margin:12px 0 4px">Vencidas</h3>
          <ul class="tl" id="consumos-vencidas"></ul>
          <div class="estado" id="consumos-estado">Consumos: cargando…</div>
        </section>

        <section class="card" id="pagar-servicio">
          <h2>Pagar servicio <a href="#pagar-servicio" aria-label="Ir a pagar">↗</a></h2>
          <div class="mini">Elegí una factura de la lista y pagala con <span style="font-family:monospace">POST /api/utility-bills/pay</span> (<span style="font-family:monospace">bill_id</span>). El pago registra el egreso en caja en el mismo paso.</div>
          <div class="mini"><a href="/api/utility-bills/due?dentro_dias=7">Ver vencimientos JSON</a></div>
        </section>
      </div>

      <div class="grid r3">
        <section class="card" id="stock"><h2>Stock <a href={hrefModulo("stock")}>↗</a></h2><div class="mini"><span class="live">en vivo</span> <a href="/api/products">/api/products</a> · <a href="/api/lots">/api/lots</a> · conteo <a href="/api/stock/conteo">/api/stock/conteo</a></div><div class="estado" id="stock-estado">Stock: cargando…</div>
          <h3 style="font-size:13px;margin:12px 0 4px">Umbrales de alerta (ALR-S1)</h3>
          <div class="mini">SKU + <label for="umb-min">Stock mínimo</label> y <label for="umb-re">Cantidad a reponer</label>. Vacío = sin valor (la alerta usa la rotación 7d).</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">
            <input id="umb-sku" placeholder="SKU" aria-label="SKU del producto" style="flex:1;min-width:110px;border:1px solid #ddd6c4;border-radius:8px;padding:8px;min-height:36px" />
            <input id="umb-min" type="number" min="0" step="1" placeholder="Stock mínimo" aria-label="Stock mínimo" style="width:110px;border:1px solid #ddd6c4;border-radius:8px;padding:8px;min-height:36px" />
            <input id="umb-re" type="number" min="1" step="1" placeholder="A reponer" aria-label="Cantidad a reponer" style="width:110px;border:1px solid #ddd6c4;border-radius:8px;padding:8px;min-height:36px" />
          </div>
          <div style="display:flex;gap:8px;margin-top:8px">
            <button id="umb-cargar" type="button" style="border:1px solid #ddd6c4;background:#fff;border-radius:999px;padding:8px 16px;min-height:36px">Cargar</button>
            <button id="umb-guardar" type="button" style="border:0;background:#1a1a1a;color:#fff;border-radius:999px;padding:8px 16px;min-height:36px">Guardar</button>
          </div>
          <div class="estado" id="umb-estado">Umbrales: cargá un SKU para ver sus valores.</div>
        </section>
        <section class="card" id="precios"><h2>Precios <a href={hrefModulo("precios")}>↗</a></h2><div class="mini"><span class="live">en vivo</span> <span style="font-family:monospace">POST /api/prices/preview</span> · ajustes <span style="font-family:monospace">/api/prices/adjustments</span></div></section>
        <section class="card" id="proveedores"><h2>Proveedores <a href={hrefModulo("proveedores")}>↗</a></h2><div class="mini"><span class="live">en vivo</span> <span style="font-family:monospace">POST /api/suppliers</span> · OC <span style="font-family:monospace">/api/purchase-orders</span></div></section>
        <section class="card" id="fiado"><h2>Fiado <a href={hrefModulo("fiado")}>↗</a></h2><div class="mini"><span class="live">en vivo</span> <span style="font-family:monospace">GET /api/credit/balance?customer_id=</span></div><div class="estado" id="fiado-estado">Fiado: sin cliente seleccionado.</div></section>
        <section class="card" id="bot-modulos">
          <h2>Módulos del bot <a href="#bot-modulos">↗</a></h2>
          <div class="mini">Lo que el bot de WhatsApp puede hacer en tu comercio (BOT-S1). Solo el Dueño edita.</div>
          <div id="bot-lista"></div>
          <div class="estado" id="bot-estado">Módulos: cargando…</div>
        </section>
        <section class="card" id="ajustes"><h2>APIs <a href="#ajustes">↗</a></h2><div class="mini">Índice JSON en vivo:<br /><a href="/api/cash/balance">/api/cash/balance</a> · <a href="/api/tickets">/api/tickets</a><br />Fiscal, WA y email en sus PRDs.</div></section>
      </div>
    </div>
    <script>
      const fmt = (c) => "$" + (Number(c) / 100).toFixed(2);
      const setTexto = (id, t) => { const el = document.getElementById(id); if (el) el.textContent = t; };
      fetch("/api/cash/balance").then(async (r) => {
        if (!r.ok) throw new Error("http " + r.status);
        const b = await r.json();
        const medios = b.por_medio || {};
        const total = Object.values(medios).map(Number).reduce((a, v) => a + v, 0);
        setTexto("n-caja", fmt(total));
        setTexto("balance-estado", "Balance en vivo: total " + fmt(total) + ".");
      }).catch(() => {
        setTexto("n-caja", "—");
        setTexto("balance-estado", "Sin conexión con el servidor: caja no disponible.");
      });
      // ALR-S1: carga y guarda min_stock/reorder_qty por SKU (Dueño).
      const umbEstado = (t) => { document.getElementById("umb-estado").textContent = t; };
      const umbNum = (id) => {
        const v = document.getElementById(id).value.trim();
        if (v === "") return { ok: true, valor: null };
        const n = Number(v);
        if (!Number.isInteger(n)) return { ok: false, error: "tiene que ser un número entero o quedar vacío" };
        return { ok: true, valor: n };
      };
      document.getElementById("umb-cargar").onclick = async () => {
        const sku = document.getElementById("umb-sku").value.trim().toUpperCase();
        if (!sku) { umbEstado("Escribí el SKU del producto."); return; }
        umbEstado("Cargando…");
        try {
          const r = await fetch("/api/products?q=" + encodeURIComponent(sku));
          if (!r.ok) throw new Error("http " + r.status);
          const j = await r.json();
          const f = (j.productos || []).find((p) => p.sku === sku);
          if (!f) { umbEstado("No hay un producto con ese SKU."); return; }
          document.getElementById("umb-min").value = f.min_stock ?? "";
          document.getElementById("umb-re").value = f.reorder_qty ?? "";
          umbEstado(f.nombre + ": mínimo " + (f.min_stock ?? "sin valor") + " · a reponer " + (f.reorder_qty ?? "sin valor") + ".");
        } catch {
          umbEstado("Sin conexión: no se pudo cargar.");
        }
      };
      document.getElementById("umb-guardar").onclick = async () => {
        const sku = document.getElementById("umb-sku").value.trim().toUpperCase();
        if (!sku) { umbEstado("Escribí el SKU del producto."); return; }
        const min = umbNum("umb-min");
        if (!min.ok) { umbEstado("Stock mínimo " + min.error + "."); return; }
        if (min.valor !== null && min.valor < 0) { umbEstado("Stock mínimo tiene que ser 0 o más, o quedar vacío."); return; }
        const re = umbNum("umb-re");
        if (!re.ok) { umbEstado("Cantidad a reponer " + re.error + "."); return; }
        if (re.valor !== null && re.valor <= 0) { umbEstado("Cantidad a reponer tiene que ser 1 o más, o quedar vacío."); return; }
        umbEstado("Guardando…");
        try {
          const r = await fetch("/api/products?sku=" + encodeURIComponent(sku), {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ rol: "dueno", min_stock: min.valor, reorder_qty: re.valor }),
          });
          let j = {};
          try {
            j = await r.json();
          } catch {
            j = { error: "respuesta no json (error " + r.status + ")" };
          }
          if (r.status === 403) { umbEstado("Solo Dueño o encargado editan umbrales."); return; }
          if (!r.ok) { umbEstado("No se guardó: " + (j.error ?? ("error " + r.status)) + "."); return; }
          umbEstado("Guardado: mínimo " + (j.min_stock ?? "sin valor") + " · a reponer " + (j.reorder_qty ?? "sin valor") + ".");
        } catch {
          umbEstado("Sin conexión: no se pudo guardar.");
        }
      };
      // P3-7c: un solo GET /api/sales/resumen alimenta KPIs, turnos, heatmap,
      // ventas por mes y composición por medio. Sin conexión => — + mensaje.
      const MESES_AR = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];
      const nombreMes = (mes) => MESES_AR[Number(mes.slice(5, 7)) - 1] || mes;
      const pintarTurnos = (turnos) => {
        const ul = document.getElementById("turnos-lista");
        ul.innerHTML = "";
        if (!turnos.length) {
          ul.innerHTML = "<li>Sin turnos hoy.</li>";
          setTexto("turnos-estado", "Sin turnos registrados hoy.");
          return;
        }
        turnos.forEach((t) => {
          const li = document.createElement("li");
          const hora = document.createElement("span"); hora.className = "hora"; hora.textContent = t.hora;
          const b = document.createElement("b"); b.textContent = t.turno;
          const mini = document.createElement("span"); mini.className = "mini";
          mini.textContent = (t.entregado_por || "—") + " · " + t.estado;
          li.append(hora, b, document.createElement("br"), mini);
          ul.appendChild(li);
        });
        setTexto("turnos-estado", turnos.length + " turno(s) hoy.");
      };
      const pintarHeat = (buckets) => {
        const cont = document.getElementById("heat");
        cont.innerHTML = "";
        const dias = ["Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"];
        const mapa = new Map(buckets.map((b) => [b.dia_semana + ":" + b.hora, b.tickets]));
        let total = 0;
        for (let d = 0; d < 7; d++) {
          for (let h = 0; h < 24; h++) {
            const i = document.createElement("i");
            const t = mapa.get(d + ":" + h) || 0;
            total += t;
            if (t > 0) { i.className = "on"; i.title = dias[d] + " " + h + ":00 · " + t + " ticket(s)"; }
            cont.appendChild(i);
          }
        }
        setTexto("heatmap-estado", total ? total + " tickets en los últimos 28 días." : "Sin ventas en los últimos 28 días.");
      };
      const pintarVentas = (meses) => {
        if (!meses.length) { setTexto("ventas-estado", "Sin ventas registradas."); return; }
        const X0 = 30, X1 = 590, Y0 = 150, Y1 = 10;
        const max = Math.max(1, ...meses.map((m) => Math.max(Number(m.efectivo_centavos), Number(m.digital_centavos))));
        const paso = meses.length > 1 ? (X1 - X0) / (meses.length - 1) : 0;
        const puntos = (clave) => meses.map((m, i) => {
          const x = X0 + i * paso;
          const y = Y0 - (Number(m[clave]) / max) * (Y0 - Y1);
          return x.toFixed(1) + "," + y.toFixed(1);
        }).join(" ");
        document.getElementById("serie-efectivo").setAttribute("points", puntos("efectivo_centavos"));
        document.getElementById("serie-digital").setAttribute("points", puntos("digital_centavos"));
        const g = document.getElementById("ventas-meses");
        g.innerHTML = "";
        meses.forEach((m, i) => {
          if (i % 2 !== 0 && i !== meses.length - 1) return;
          const t = document.createElementNS("http://www.w3.org/2000/svg", "text");
          t.setAttribute("x", String(X0 + i * paso));
          t.setAttribute("y", "165");
          t.setAttribute("text-anchor", "middle");
          t.textContent = nombreMes(m.mes);
          g.appendChild(t);
        });
        setTexto("ventas-periodo", meses[0].mes + " a " + meses[meses.length - 1].mes);
        const ultimo = meses[meses.length - 1];
        setTexto("ventas-estado", "En vivo: " + ultimo.mes + " " + fmt(ultimo.efectivo_centavos) + " efectivo · " + fmt(ultimo.digital_centavos) + " digital.");
      };
      const pintarDona = (porMedio) => {
        const arco = document.getElementById("dona-arco");
        const legend = document.getElementById("medios-legend");
        const total = porMedio.reduce((a, m) => a + Number(m.centavos), 0);
        if (!total) {
          arco.setAttribute("stroke-dasharray", "0 377");
          setTexto("dona-pct", "—");
          legend.innerHTML = "<span>Sin ventas este mes.</span>";
          setTexto("medios-estado", "Sin movimientos este mes.");
          return;
        }
        const efectivo = porMedio.filter((m) => m.medio === "Efectivo").reduce((a, m) => a + Number(m.centavos), 0);
        const pct = Math.round((efectivo / total) * 100);
        const C = 2 * Math.PI * 60;
        arco.setAttribute("stroke-dasharray", ((C * pct) / 100).toFixed(1) + " " + C.toFixed(1));
        setTexto("dona-pct", pct + "%");
        legend.innerHTML = "";
        porMedio.slice(0, 4).forEach((m) => {
          const s = document.createElement("span");
          s.textContent = Math.round((Number(m.centavos) / total) * 100) + "% " + m.medio;
          legend.appendChild(s);
        });
        setTexto("medios-estado", "En vivo: este mes " + fmt(total) + " en " + porMedio.length + " medio(s).");
      };
      fetch("/api/sales/resumen").then(async (r) => {
        if (!r.ok) throw new Error("http " + r.status);
        const j = await r.json();
        setTexto("n-tickets", String(j.tickets_hoy ?? 0));
        setTexto("n-stock", String(j.stock_bajo ?? 0));
        setTexto("heat-ventas", String(j.tickets_hoy ?? 0));
        setTexto("kpi-estado", "En vivo: " + (j.tickets_hoy ?? 0) + " tickets hoy · " + (j.stock_bajo ?? 0) + " con stock bajo.");
        pintarVentas(j.ventas_por_mes || []);
        pintarDona(j.por_medio || []);
        pintarHeat(j.heatmap || []);
        pintarTurnos(j.turnos || []);
      }).catch(() => {
        setTexto("n-tickets", "—");
        setTexto("n-stock", "—");
        setTexto("heat-ventas", "—");
        setTexto("kpi-estado", "Sin conexión con el servidor: resumen no disponible.");
        setTexto("ventas-estado", "Sin conexión: ventas por mes no disponibles.");
        setTexto("medios-estado", "Sin conexión: composición por medio no disponible.");
        setTexto("heatmap-estado", "Sin conexión: heatmap no disponible.");
        setTexto("turnos-estado", "Sin conexión: turnos no disponibles.");
      });
      fetch("/api/products").then(async (r) => {
        if (!r.ok) throw new Error("http " + r.status);
        const j = await r.json();
        const n = (j.productos || []).length;
        document.getElementById("stock-estado").textContent = "En vivo: " + n + " productos en catálogo.";
      }).catch(() => {
        setTexto("stock-estado", "Sin conexión: stock no disponible.");
      });
      document.getElementById("mov-body").innerHTML = "<tr><td colspan='5'>Cargando…</td></tr>";
      fetch("/api/cash/history?limit=5").then(async (r) => {
        if (!r.ok) throw new Error("http " + r.status);
        const j = await r.json();
        const filas = (j.items || []).slice(0, 5);
        const tbody = document.getElementById("mov-body");
        tbody.innerHTML = "";
        if (!filas.length) {
          tbody.innerHTML = "<tr><td colspan='5'>Sin movimientos todavía.</td></tr>";
          setTexto("movimientos-estado", "Sin movimientos.");
          return;
        }
        filas.forEach((m) => {
          const detalle = m.origen === "venta" ? "Venta"
            : m.origen.startsWith("vencimiento:") ? "Pago de servicio"
            : m.origen === "reversion" ? "Reversión" : m.origen;
          const tr = document.createElement("tr");
          tr.innerHTML = "<td>◉</td><td></td><td></td><td></td><td>" + (m.tipo === "ingreso" ? "<span class='pill ok'>Ingreso</span>" : "<span class='pill warn'>Egreso</span>") + "</td>";
          tr.children[1].textContent = detalle;
          tr.children[2].textContent = m.metodo;
          tr.children[3].textContent = fmt(m.monto_centavos);
          tbody.appendChild(tr);
        });
        setTexto("movimientos-estado", "En vivo: " + filas.length + " movimiento(s) reciente(s).");
      }).catch(() => {
        const tbody = document.getElementById("mov-body");
        tbody.innerHTML = "<tr><td colspan='5'>—</td></tr>";
        setTexto("movimientos-estado", "Sin conexión: movimientos no disponibles.");
      });
      document.getElementById("q").addEventListener("input", (e) => {
        const q = e.target.value.toLowerCase();
        document.querySelectorAll("#mov-body tr").forEach((tr) => {
          tr.style.display = tr.textContent.toLowerCase().includes(q) ? "" : "none";
        });
      });
      Promise.all([
        fetch("/api/service-accounts").then((r) => { if (!r.ok) throw new Error("http " + r.status); return r.json(); }),
        fetch("/api/utility-bills/due?dentro_dias=7").then((r) => { if (!r.ok) throw new Error("http " + r.status); return r.json(); }),
      ]).then(([cuentas, due]) => {
        const nombres = {};
        (cuentas.items || []).forEach((c) => { nombres[c.account_id] = (c.alias || c.proveedor) + " · " + c.servicio; });
        const ulCuentas = document.getElementById("consumos-cuentas");
        (cuentas.items || []).forEach((c) => {
          const li = document.createElement("li");
          li.innerHTML = "<b></b> <span class='mini'></span>";
          li.querySelector("b").textContent = (c.alias || c.proveedor) + " · " + c.servicio;
          li.querySelector(".mini").textContent = c.activa ? c.titular : "inactiva";
          ulCuentas.appendChild(li);
        });
        if ((cuentas.items || []).length === 0) ulCuentas.innerHTML = "<li>Sin cuentas cargadas todavía.</li>";
        const pintar = (id, filas, vacio) => {
          const ul = document.getElementById(id);
          filas.forEach((f) => {
            const li = document.createElement("li");
            li.innerHTML = "<span class='hora'></span><b></b> <span class='mini'></span>";
            li.querySelector(".hora").textContent = f.vencimiento.slice(5);
            li.querySelector("b").textContent = fmt(f.monto_centavos);
            li.querySelector(".mini").textContent = (nombres[f.account_id] || "cuenta") + " · " + f.periodo;
            ul.appendChild(li);
          });
          if (filas.length === 0) ul.innerHTML = "<li>" + vacio + "</li>";
        };
        pintar("consumos-proximas", due.proximas || [], "Nada por vencer en 7 días.");
        pintar("consumos-vencidas", due.vencidas || [], "Sin facturas vencidas.");
        document.getElementById("consumos-estado").textContent =
          "En vivo: " + (cuentas.items || []).length + " cuentas · " +
          (due.proximas || []).length + " próximas · " + (due.vencidas || []).length + " vencidas.";
      }).catch(() => {
        document.getElementById("consumos-estado").textContent = "Sin conexión con el servidor: consumos no disponibles.";
      });
      // BOT-S1: prender/apagar módulos del bot (solo Dueño; el server decide).
      const botEtiquetas = { rotacion: "Rotación y reposición", vencimientos: "Vencimientos", flujo_caja: "Flujo de caja", cobranza: "Cobranza", ordenes_produccion: "Órdenes de producción", entregas: "Entregas" };
      fetch("/api/bot-modulos").then(async (r) => {
        if (!r.ok) throw new Error("http " + r.status);
        const j = await r.json();
        const cont = document.getElementById("bot-lista");
        const estado = document.getElementById("bot-estado");
        const activos = new Set(j.activos || []);
        (j.modulos || []).forEach((m) => {
          const label = document.createElement("label");
          label.style.cssText = "display:flex;align-items:center;gap:8px;margin:6px 0;font-size:13px";
          const cb = document.createElement("input");
          cb.type = "checkbox";
          cb.checked = activos.has(m);
          cb.disabled = !j.puede_editar;
          cb.dataset.modulo = m;
          cb.onchange = async () => {
            cb.disabled = true;
            try {
              const r2 = await fetch("/api/bot-modulos", {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ modulo: m, activo: cb.checked }),
              });
              if (!r2.ok) throw new Error("http " + r2.status);
              const j2 = await r2.json();
              const ahora = new Set(j2.activos || []);
              cont.querySelectorAll("input[type=checkbox]").forEach((c) => { c.checked = ahora.has(c.dataset.modulo); });
              estado.textContent = "Guardado.";
            } catch {
              cb.checked = !cb.checked;
              estado.textContent = "No se pudo guardar.";
            } finally {
              cb.disabled = !j.puede_editar;
            }
          };
          label.appendChild(cb);
          label.appendChild(document.createTextNode(botEtiquetas[m] || m));
          cont.appendChild(label);
        });
        estado.textContent = (j.activos || []).length + " módulos activos" + (j.puede_editar ? "" : " · solo el Dueño edita");
      }).catch(() => {
        document.getElementById("bot-estado").textContent = "Sin conexión: módulos no disponibles.";
      });
    </script>
    <Toaster client:idle />
  </body>
</html>
