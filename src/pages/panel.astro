---
import PanelShell from "../components/panel/PanelShell.astro";
import BienvenidaDialog from "../components/panel/BienvenidaDialog.astro";
import KpiStrip from "../components/panel/KpiStrip.astro";
import UpsellCard from "../components/panel/UpsellCard.astro";
import AsistenteDrawer from "../components/panel/AsistenteDrawer.astro";
import { esDueno, resolverRolEfectivo, resolverSesion } from "../lib/control.js";
import { control } from "../lib/store.js";
import { tenantDeRequest } from "../lib/tenant-context.js";
import { puedeVerSaldoCaja, rolParaNav } from "../lib/panel-modulos.js";

// BIEN-S2 (ADR-0115): tenant y sub en servidor; el diálogo solo para Dueño.
// P1-35: el nombre del comercio activo va en el saludo (antes era genérico).
const tenantRes = tenantDeRequest(Astro.request);
const sesion = resolverSesion(Astro.request);
const mostrarBienvenida =
  tenantRes.ok &&
  sesion !== null &&
  esDueno(tenantRes.tenantId, sesion.googleSub);
const bienvenidaTenantId = mostrarBienvenida ? tenantRes.tenantId : "";
const bienvenidaGoogleSub = mostrarBienvenida ? sesion.googleSub : "";
// TB-165: el cuestionario es una ruta opcional del Dueño, nunca la entrada
// post-login. El mismo guard del diálogo decide quién ve el enlace.
const accesoCuestionario = mostrarBienvenida
  ? `/onboarding?tenant_id=${encodeURIComponent(tenantRes.tenantId)}`
  : null;
const nombreComercio = tenantRes.ok
  ? (control.tenants.get(tenantRes.tenantId)?.nombreComercio?.trim() || null)
  : null;
const tituloPanel = nombreComercio ? `Inicio · ${nombreComercio}` : "Inicio";
const nav = rolParaNav(resolverRolEfectivo(Astro.request));
const verSaldo = puedeVerSaldoCaja(nav.rol, nav.permisos);
---

<PanelShell titulo={tituloPanel} comercio={nombreComercio ?? ""} activo="dashboard" ocultarTitulo>
  <h1 class="hello">Hola{nombreComercio ? ` · ${nombreComercio}` : ""}</h1>
  <p class="sub">Números de hoy, avisos y los tres accesos del día.</p>

  <KpiStrip verSaldo={verSaldo} />

  <section class="card" aria-label="Avisos">
    <h2>Avisos</h2>
    <p id="aviso-stock" hidden></p>
    <p id="aviso-stock-vacio" class="estado">Sin avisos de stock por ahora.</p>
  </section>

  <nav class="atajos" aria-label="Atajos">
    <a class="sg-flame-cta atajo" href="/venta">Vender</a>
    <a class="atajo" href="/panel/stock">Productos</a>
    <a class="atajo" href="/panel/fiado">Fiado</a>
    {accesoCuestionario && (
      <a class="atajo" data-cuestionario-link href={accesoCuestionario}>Configurar comercio</a>
    )}
  </nav>

  <UpsellCard />
  <AsistenteDrawer />

  <style is:global>
    .atajos { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
    .atajos a {
      min-height: 44px;
      min-width: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      padding: 8px 16px;
      border-radius: 999px;
      text-decoration: none;
      white-space: nowrap;
      flex-shrink: 0;
      font-weight: 700;
    }
    .panel-shell .atajos a.sg-flame-cta { color: var(--color-star-white); }
    .panel-shell .atajos a:not(.sg-flame-cta) {
      background: var(--color-charcoal);
      color: var(--color-star-white);
      border: 1px solid var(--color-mid);
    }
  </style>

  <script>
    import { renderResumen, renderResumenError } from "../lib/panel-dashboard.js";
    import {
      CLAVE_DESCARTES_UPSELL,
      elegirOferta,
      esOfertaUpsell,
      type OfertaUpsell,
    } from "../lib/panel-upsell.js";

    const CLAVE_DESCARTES = CLAVE_DESCARTES_UPSELL;

    function leerDescartes(): Record<string, number> | null {
      try {
        const crudo = localStorage.getItem(CLAVE_DESCARTES);
        if (crudo === null) return {};
        const datos: unknown = JSON.parse(crudo);
        if (typeof datos !== "object" || datos === null || Array.isArray(datos)) return null;
        const salida: Record<string, number> = {};
        for (const [modulo, marca] of Object.entries(datos)) {
          if (typeof marca === "number" && Number.isFinite(marca)) salida[modulo] = marca;
        }
        return salida;
      } catch (error) {
        console.warn("[panel] no pudimos leer los descartes de upsell", error);
        return null;
      }
    }

    function pintarAvisoStock(crudo: { stock_bajo?: unknown }): void {
      const aviso = document.getElementById("aviso-stock");
      const vacio = document.getElementById("aviso-stock-vacio");
      if (!aviso || !vacio) return;
      // TB-159: con cero avisos el nodo sigue hidden y vacío. Sin esta marca Modo no ve que la carga terminó.
      aviso.dataset.cargado = "si";
      const n = Number(crudo.stock_bajo ?? 0);
      aviso.replaceChildren();
      if (!Number.isFinite(n) || n <= 0) {
        aviso.hidden = true;
        vacio.hidden = false;
        return;
      }
      const texto = document.createTextNode(
        n === 1 ? "1 producto con stock bajo. " : `${n} productos con stock bajo. `,
      );
      const link = document.createElement("a");
      link.href = "/panel/stock";
      link.textContent = "Ver productos";
      aviso.append(texto, link);
      aviso.hidden = false;
      vacio.hidden = true;
    }

    function aplicarUpsell(crudo: unknown): void {
      if (typeof crudo !== "object" || crudo === null) return;
      const card = document.querySelector<HTMLElement>("[data-upsell]");
      if (!card) return;
      const datos = crudo as { upsell?: unknown; rol?: unknown };
      if (!Array.isArray(datos.upsell)) return;
      const ofertas: OfertaUpsell[] = [];
      for (const item of datos.upsell) {
        if (esOfertaUpsell(item)) ofertas.push(item);
      }
      const descartes = leerDescartes();
      if (descartes === null) return;
      const oferta = elegirOferta({ ofertas, descartes, ahora: Date.now() });
      if (oferta === null) return;

      const titulo = card.querySelector<HTMLElement>("[data-upsell-titulo]");
      const texto = card.querySelector<HTMLElement>("[data-upsell-texto]");
      const link = card.querySelector<HTMLElement>("[data-upsell-link]");
      const empleado = card.querySelector<HTMLElement>("[data-upsell-empleado]");
      if (!titulo || !texto || !link || !empleado) return;

      titulo.textContent = oferta.titulo;
      texto.textContent = oferta.texto;
      const dueno = datos.rol === "dueno";
      link.hidden = !dueno;
      empleado.hidden = dueno;
      card.dataset.upsellModulo = oferta.modulo;
      card.hidden = false;
    }

    function descartarUpsell(): void {
      const card = document.querySelector<HTMLElement>("[data-upsell]");
      if (!card) return;
      const modulo = card.dataset.upsellModulo;
      if (modulo) {
        const descartes = leerDescartes() ?? {};
        descartes[modulo] = Date.now();
        try {
          localStorage.setItem(CLAVE_DESCARTES, JSON.stringify(descartes));
        } catch (error) {
          console.warn("[panel] no pudimos guardar el descarte de upsell", error);
        }
      }
      card.hidden = true;
    }

    document
      .querySelector<HTMLButtonElement>("[data-upsell-descartar]")
      ?.addEventListener("click", descartarUpsell);

    fetch("/api/panel/indice")
      .then((r) => (r.ok ? r.json() : null))
      .then((crudo) => {
        aplicarUpsell(crudo);
      })
      .catch((error) => {
        console.warn("[panel] no pudimos leer el índice de módulos", error);
      });

    fetch("/api/sales/resumen").then(async (r) => {
      if (!r.ok) throw new Error("http " + r.status);
      const resumen = await r.json();
      renderResumen(resumen);
      pintarAvisoStock(resumen);
    }).catch(() => {
      renderResumenError();
      const aviso = document.getElementById("aviso-stock");
      if (aviso) aviso.dataset.cargado = "error";
    });
  </script>
  {mostrarBienvenida ? (
    <BienvenidaDialog tenantId={bienvenidaTenantId} googleSub={bienvenidaGoogleSub} />
  ) : null}
</PanelShell>
