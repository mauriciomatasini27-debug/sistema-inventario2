---
// ONBOARDING-WIZARD (T2/T4/T5): ruta dedicada post-login, con productos y caja inline.
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Onboarding</title>
    <style>
      :root { --bg:#f7f5f2; --fg:#1a1a1a; --muted:#6e695d; --card:#efecea; --accent:#255c7a; --ok:#2e6b1f; --line:#6e695d; }
      body.dark { --bg:#1a1a1a; --fg:#f7f5f2; --muted:#cfc9b8; --card:#2b2b2b; --accent:#8cc4e3; --ok:#7fd468; --line:#6e695d; }
      * { box-sizing:border-box; }
      body { margin:0; font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif; background:var(--bg); color:var(--fg); min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; overflow-x:hidden; }
      .topbar { position:fixed; top:12px; right:12px; }
      .topbar button { background:var(--card); border:1px solid var(--line); color:var(--fg); padding:6px 10px; border-radius:8px; cursor:pointer; font-size:12px; }
      .phone { width:360px; max-width:100%; background:var(--card); border:1px solid var(--line); border-radius:20px; overflow:hidden; display:flex; flex-direction:column; }
      .phone-head { padding:14px 16px; border-bottom:1px solid var(--line); display:flex; align-items:center; gap:10px; }
      .avatar { width:32px; height:32px; border-radius:50%; background:var(--accent); display:grid; place-items:center; font-weight:700; color:#fff; }
      .phone-head .name { font-weight:600; font-size:14px; }
      .phone-head .sub { font-size:11px; color:var(--muted); }
      .progress { height:4px; background:var(--line); }
      .progress > div { height:100%; background:var(--accent); transition:width .3s; }
      .body { padding:16px; display:flex; flex-direction:column; gap:10px; min-height:320px; }
      .card { background:var(--bg); border:1px solid var(--line); border-radius:12px; padding:16px; text-align:center; }
      .card h3 { margin:0 0 6px; font-size:18px; }
      .card p { margin:0; font-size:12px; color:var(--muted); }
      .stepinfo { font-size:12px; color:var(--muted); margin-bottom:8px; }
      .choices { display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-top:12px; }
      .chip { background:var(--card); color:var(--fg); border:1px solid var(--line); padding:10px 16px; border-radius:999px; font-size:14px; cursor:pointer; }
      .chip:hover { background:var(--accent); color:#fff; }
      .input { width:100%; margin-top:12px; background:var(--bg); border:1px solid var(--line); color:var(--fg); padding:12px; border-radius:10px; font-size:16px; }
      .state { font-size:11px; color:var(--muted); font-family:ui-monospace,monospace; white-space:pre-wrap; margin-top:8px; }
      label.file { display:block; margin-top:12px; font-size:13px; }
    </style>
  </head>
  <body>
    <div class="topbar"><button id="temaToggle">Tema</button></div>
    <div class="phone">
      <div class="phone-head"><div class="avatar">M</div><div><div class="name">Modo</div><div class="sub">Onboarding</div></div></div>
      <div class="progress"><div id="p" style="width:0%"></div></div>
      <div class="body" id="body"></div>
    </div>
    <script is:inline>
      const steps = [
        { key:"negocio", q:"¿Cómo se llama tu negocio?", type:"text" },
        { key:"dueno", q:"¿Cómo te llamás?", type:"text" },
        { key:"empleados", q:"¿Tenés empleados?", type:"choice", options:["Sí, tengo empleados","No, trabajo solo"] },
        { key:"productos", q:"¿Querés cargar tus productos ahora?", type:"choice", options:["Sí, cargar productos","Más tarde"] },
        { key:"caja", q:"¿Tenés dinero en la caja para empezar a vender?", type:"choice", options:["Sí, cargar monto","Empezar en 0"] },
      ];
      const storageKey = "onboarding-wizard";
      let state = JSON.parse(localStorage.getItem(storageKey) || "null") || { paso:0, respuestas:{}, empleados:[], empleadosDone:false, saltados:[] };
      if (!state.empleadosDone) state.empleadosDone = false;
      if (!state.saltados) state.saltados = [];
      const body = document.getElementById("body");
      // estado auxiliar para importación inline
      let archivoActual = null;
      let shaActual = null;
      let keyImportacion = null;

      function save(){ localStorage.setItem(storageKey, JSON.stringify(state)); }
      function render() {
        body.innerHTML = "";
        if (state.paso >= steps.length) {
          body.innerHTML = '<div class="card"><h3>🎉 ¡Listo!</h3><p class="stepinfo">5 de 5 pasos completados</p><p>Ya podés vender.</p><button class="chip" id="irPanel" style="margin-top:12px;background:var(--accent);color:#fff;">Ir al panel</button></div>';
          document.getElementById("p").style.width = "100%";
          fetch("/api/onboarding/completar", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ empleados: state.empleados }) }).catch((e) => { console.warn("onboarding completar falló", e); });
          const btn = document.getElementById("irPanel");
          if (btn) btn.onclick = () => { window.location.href = "/panel"; };
          return;
        }
        // sub-flujo empleados
        if (state.paso === 2 && state.respuestas.empleados && String(state.respuestas.empleados).startsWith("Sí") && !state.empleadosDone) {
          const card = document.createElement("div"); card.className="card";
          card.innerHTML = "<h3>Cargá los emails de tus empleados</h3><p>Les enviaremos un link para sumarse.</p>";
          const list = document.createElement("div"); list.style.marginTop="8px";
          state.empleados.forEach(e => { const d=document.createElement("div"); d.textContent=e; list.appendChild(d); });
          card.appendChild(list);
          const inp = document.createElement("input"); inp.className="input"; inp.type="email"; inp.placeholder="email@ejemplo.com";
          const add = document.createElement("button"); add.className="chip"; add.textContent="Agregar"; add.style.marginTop="8px";
          add.onclick = () => { if(!inp.value.trim()) return; state.empleados.push(inp.value.trim()); inp.value=""; save(); render(); };
          card.appendChild(inp); card.appendChild(add);
          const done = document.createElement("button"); done.className="chip"; done.textContent="Enviar links y continuar"; done.style.marginTop="12px"; done.style.background="var(--accent)"; done.style.color="#fff";
          done.onclick = async () => {
             for (const email of state.empleados) {
               try { await fetch("/api/invitations", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ email }) }); }
               catch (e) { console.warn("invitación falló", e); }
             }
             state.empleadosDone=true; state.paso++; save(); render();
           };
          card.appendChild(done);
          body.appendChild(card);
          document.getElementById("p").style.width = (state.paso/steps.length*100)+"%";
          return;
        }
        // sub-flujo productos inline (T4)
        if (state.paso === 3 && state.respuestas.productos && String(state.respuestas.productos).startsWith("Sí")) {
          const card = document.createElement("div"); card.className="card";
          card.innerHTML = "<h3>Cargá tus productos</h3><p>CSV o foto + datos manuales. Podés saltar y hacerlo después.</p>";
          // Cámara
          const camBtn = document.createElement("button"); camBtn.className="chip"; camBtn.textContent="Tomar foto"; camBtn.style.marginTop="8px";
          const video = document.createElement("video"); video.style.width="100%"; video.style.marginTop="8px"; video.autoplay=true; video.playsInline=true; video.hidden=true;
          const snapBtn = document.createElement("button"); snapBtn.className="chip"; snapBtn.textContent="Capturar"; snapBtn.style.marginTop="8px"; snapBtn.hidden=true;
          const canvas = document.createElement("canvas"); canvas.hidden=true;
          const fotoPreview = document.createElement("img"); fotoPreview.style.width="100%"; fotoPreview.style.marginTop="8px"; fotoPreview.hidden=true;
          camBtn.onclick = async () => {
            try {
              const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" } });
              video.srcObject = stream;
              video.hidden = false;
              snapBtn.hidden = false;
              camBtn.hidden = true;
            } catch (e) { estado.textContent = "No se pudo acceder a la cámara."; }
          };
          snapBtn.onclick = () => {
            const ctx = canvas.getContext("2d");
            canvas.width = video.videoWidth || 320;
            canvas.height = video.videoHeight || 240;
            if (ctx) ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            fotoPreview.src = canvas.toDataURL("image/jpeg", 0.7);
            fotoPreview.hidden = false;
            const tracks = (video.srcObject as MediaStream | null)?.getTracks() || [];
            tracks.forEach((t) => t.stop());
            video.hidden = true;
            snapBtn.hidden = true;
            camBtn.hidden = false;
            estado.textContent = "Foto capturada. Completá los datos del producto.";
          };
          // Formulario manual
          const skuInp = document.createElement("input"); skuInp.className="input"; skuInp.placeholder="SKU (ej. PROD-001)";
          const nomInp = document.createElement("input"); nomInp.className="input"; nomInp.placeholder="Nombre del producto";
          const preInp = document.createElement("input"); preInp.className="input"; preInp.type="number"; preInp.min="0"; preInp.step="0.01"; preInp.placeholder="Precio";
          const cantInp = document.createElement("input"); cantInp.className="input"; cantInp.type="number"; cantInp.min="1"; cantInp.step="1"; cantInp.placeholder="Cantidad";
          const addProd = document.createElement("button"); addProd.className="chip"; addProd.textContent="Agregar producto"; addProd.style.marginTop="8px"; addProd.style.background="var(--accent)"; addProd.style.color="#fff";
          const estado = document.createElement("div"); estado.className="state"; estado.textContent="";
          addProd.onclick = async () => {
            const sku = skuInp.value.trim().toUpperCase();
            const nombre = nomInp.value.trim();
            const precio = Number(preInp.value);
            const cantidad = Number(cantInp.value);
            if (!sku || !nombre) { estado.textContent="SKU y nombre son obligatorios."; return; }
            if (!isFinite(precio) || precio < 0) { estado.textContent="Precio inválido."; return; }
            if (!Number.isInteger(cantidad) || cantidad < 1) { estado.textContent="Cantidad inválida."; return; }
            estado.textContent="Creando producto…";
            try {
              const r = await fetch("/api/products", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ sku, nombre, precio_centavos: Math.round(precio*100), sector:"general", permisos:[] }) });
              const j = await r.json();
              if (!r.ok) { estado.textContent = "Error: " + (j.error || r.status); return; }
              // ingreso de stock inicial
              await fetch("/api/stock/ingreso", { method:"POST", headers:{"Content-Type":"application/json","Idempotency-Key":crypto.randomUUID()}, body: JSON.stringify({ sku, cantidad, costo_centavos:0, controla_vencimiento:false }) });
              estado.textContent = "Producto creado: " + nombre;
              skuInp.value=""; nomInp.value=""; preInp.value=""; cantInp.value="";
            } catch (e) { estado.textContent="Falló la creación."; }
          };
          // CSV
          const fileInput = document.createElement("input"); fileInput.type="file"; fileInput.accept=".csv,.xlsx"; fileInput.className="input";
          const previewBtn = document.createElement("button"); previewBtn.className="chip"; previewBtn.textContent="Vista previa CSV"; previewBtn.style.marginTop="8px";
          const confirmBtn = document.createElement("button"); confirmBtn.className="chip"; confirmBtn.textContent="Confirmar importación"; confirmBtn.style.marginTop="8px"; confirmBtn.style.background="var(--accent)"; confirmBtn.style.color="#fff"; confirmBtn.hidden=true;
          const cont = document.createElement("div"); cont.style.marginTop="8px";
          previewBtn.onclick = async () => {
            if (!fileInput.files || !fileInput.files[0]) { estado.textContent="Elegí un archivo."; return; }
            archivoActual = fileInput.files[0];
            const fd = new FormData(); fd.append("archivo", archivoActual);
            estado.textContent="Previsualizando…";
            try {
              const r = await fetch("/api/stock/importar/preview", { method:"POST", body: fd });
              const j = await r.json();
              if (!r.ok) { estado.textContent = "Error: " + (j.error || r.status); return; }
              shaActual = j.archivo.sha256;
              keyImportacion = crypto.randomUUID();
              estado.textContent = `Filas: ${j.resumen.total}, válidas: ${j.resumen.validas}, nuevas: ${j.resumen.nuevas}`;
              confirmBtn.hidden = false;
            } catch (e) { estado.textContent="Falló la vista previa."; }
          };
          confirmBtn.onclick = async () => {
            if (!archivoActual || !shaActual) { estado.textContent="Primero vista previa."; return; }
            const fd = new FormData(); fd.append("archivo", archivoActual); fd.append("archivo_sha256", shaActual);
            estado.textContent="Importando…";
            try {
              const r = await fetch("/api/stock/importar/confirmar", { method:"POST", headers:{"Idempotency-Key": keyImportacion}, body: fd });
              const j = await r.json();
              if (!r.ok) { estado.textContent = "Error: " + (j.error || r.status); return; }
              estado.textContent = `Importado: ${j.filas_importadas} filas.`;
              confirmBtn.hidden = true;
              const contBtn = document.createElement("button"); contBtn.className="chip"; contBtn.textContent="Continuar"; contBtn.style.marginTop="8px"; contBtn.style.background="var(--ok)"; contBtn.style.color="#fff";
              contBtn.onclick = () => { state.paso++; save(); render(); };
              card.appendChild(contBtn);
            } catch (e) { estado.textContent="Falló la importación."; }
          };
          card.appendChild(camBtn);
          card.appendChild(video);
          card.appendChild(snapBtn);
          card.appendChild(canvas);
          card.appendChild(fotoPreview);
          card.appendChild(skuInp);
          card.appendChild(nomInp);
          card.appendChild(preInp);
          card.appendChild(cantInp);
          card.appendChild(addProd);
          card.appendChild(fileInput);
          card.appendChild(previewBtn);
          card.appendChild(confirmBtn);
          const skip = document.createElement("button"); skip.className="chip"; skip.textContent="Saltar productos"; skip.style.marginTop="8px"; skip.style.opacity="0.7";
          skip.onclick = () => { state.paso++; save(); render(); };
          card.appendChild(skip);
          const cont = document.createElement("button"); cont.className="chip"; cont.textContent="Continuar"; cont.style.marginTop="8px"; cont.style.background="var(--ok)"; cont.style.color="#fff";
          cont.onclick = () => { state.paso++; save(); render(); };
          card.appendChild(cont);
          card.appendChild(estado);
          body.appendChild(card);
          document.getElementById("p").style.width = (state.paso/steps.length*100)+"%";
          return;
        }
        // sub-flujo caja inline (T5)
        if (state.paso === 4 && state.respuestas.caja && String(state.respuestas.caja).startsWith("Sí")) {
          const card = document.createElement("div"); card.className="card";
          card.innerHTML = "<h3>Monto inicial en caja</h3><p>Ingresá el dinero que hay en caja para empezar a vender.</p>";
          const inp = document.createElement("input"); inp.className="input"; inp.type="number"; inp.min="0"; inp.step="0.01"; inp.placeholder="0.00";
          const reg = document.createElement("button"); reg.className="chip"; reg.textContent="Registrar y continuar"; reg.style.marginTop="10px"; reg.style.background="var(--accent)"; reg.style.color="#fff";
          const estado = document.createElement("div"); estado.className="state"; estado.textContent="";
          reg.onclick = async () => {
            const monto = Number(inp.value);
            if (!isFinite(monto) || monto < 0) { estado.textContent="Monto inválido."; return; }
            const centavos = Math.round(monto*100);
            if (centavos <= 0) { state.paso++; save(); render(); return; }
            estado.textContent="Registrando…";
            try {
              const r = await fetch("/api/cash/movements", {
                method:"POST",
                headers:{"Content-Type":"application/json","Idempotency-Key":crypto.randomUUID()},
                body: JSON.stringify({
                  tipo:"ingreso",
                  metodo:"efectivo",
                  categoria_id:"manual",
                  origen:"retiro",
                  monto_centavos: centavos,
                  device_code:"panel-web",
                  seq_local: Date.now(),
                  client_occurred_at: new Date().toISOString(),
                }),
              });
              if (!r.ok) { const j=await r.json().catch((e) => { console.warn("respuesta sin JSON", e); return {}; }); estado.textContent="Error: "+(j.error||r.status); return; }
              state.paso++; save(); render();
            } catch (e) { estado.textContent="Falló el registro."; }
          };
          const skip = document.createElement("button"); skip.className="chip"; skip.textContent="Empezar en 0"; skip.style.marginTop="8px"; skip.style.opacity="0.7";
          skip.onclick = () => { state.paso++; save(); render(); };
          card.appendChild(inp); card.appendChild(reg); card.appendChild(skip); card.appendChild(estado);
          body.appendChild(card);
          document.getElementById("p").style.width = (state.paso/steps.length*100)+"%";
          return;
        }

        const s = steps[state.paso];
        const card = document.createElement("div"); card.className="card";
        card.innerHTML = `<p class="stepinfo">${state.paso+1} de ${steps.length} pasos</p><h3>${s.q}</h3>`;
        if (s.type === "choice") {
          const wrap = document.createElement("div"); wrap.className="choices";
          s.options.forEach(o => {
            const b = document.createElement("button"); b.className="chip"; b.textContent=o;
            b.onclick = () => {
              state.respuestas[s.key]=o;
              if (s.key==="empleados" && o.startsWith("Sí")) { state.empleadosDone=false; save(); render(); return; }
              if (s.key==="empleados" && o.startsWith("No")) { state.paso++; save(); render(); return; }
              if (s.key==="productos" && o.startsWith("Sí")) { save(); render(); return; }
              if (s.key==="productos" && o.startsWith("Más")) { state.paso++; save(); render(); return; }
              if (s.key==="caja" && o.startsWith("Sí")) { save(); render(); return; }
              if (s.key==="caja" && o.startsWith("Empezar")) { state.paso++; save(); render(); return; }
              state.paso++; save(); render();
            };
            wrap.appendChild(b);
          });
          card.appendChild(wrap);
        } else {
          const inp = document.createElement("input"); inp.className="input";
          const btn = document.createElement("button"); btn.className="chip"; btn.textContent="Continuar"; btn.style.marginTop="10px";
          btn.onclick = () => { if(!inp.value.trim()) return; state.respuestas[s.key]=inp.value.trim(); state.paso++; save(); render(); };
          card.appendChild(inp); card.appendChild(btn);
        }
        const skip = document.createElement("button"); skip.className="chip"; skip.textContent="Saltar por ahora"; skip.style.marginTop="8px"; skip.style.opacity="0.7";
        skip.onclick = () => { state.saltados = state.saltados || []; if(!state.saltados.includes(s.key)) state.saltados.push(s.key); state.paso++; save(); render(); };
        card.appendChild(skip);
        body.appendChild(card);
        document.getElementById("p").style.width = (state.paso/steps.length*100)+"%";
      }
      const temaBtn = document.getElementById("temaToggle");
      if (localStorage.getItem("proto-tema")==="dark") document.body.classList.add("dark");
      temaBtn.onclick = () => {
        document.body.classList.toggle("dark");
        localStorage.setItem("proto-tema", document.body.classList.contains("dark")?"dark":"light");
      };
      render();
    </script>
  </body>
</html>