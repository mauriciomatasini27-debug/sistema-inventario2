---
import "../styles/tokens-papel.css";
import "../styles/tema.css";
import TemaInicial from "../components/ui/TemaInicial.astro";
import TemaToggle from "../components/ui/TemaToggle.astro";
import CerrarSesion from "../components/ui/CerrarSesion.astro";
import { resolverSesion } from "../lib/control.js";
import { esAdminAllowlist, leerAllowlist } from "../modules/admin/guard.js";
// PA1: la página solo existe para el sub del allowlist. Sin sesión o con otra
// cuenta, 404 (no revela que hay panel); el ingreso va por /api/auth/login?next=/admin.
const sesionAdmin = resolverSesion(Astro.request);
if (!sesionAdmin || !esAdminAllowlist(sesionAdmin.googleSub, leerAllowlist())) {
  return new Response(null, { status: 404 });
}
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel admin · Plataforma</title>
    <TemaInicial />
    <style>
      :root {
        --papel: var(--tema-fondo); --canvas: var(--tema-linea); --tinta: var(--tema-texto);
        --llama: var(--color-llama); --llama-hover: var(--color-llama-hover); --muted: var(--tema-texto-suave);
        --card: var(--tema-superficie); --radio: 16px;
      }
      :root[data-tema="oscuro"] {
        /* TB-163: en oscuro admin mantiene la piel B del tablero. */
        --papel: var(--color-void); --canvas: var(--color-mid); --tinta: var(--color-void);
        --muted: var(--color-muted-dark); --card: var(--color-charcoal);
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: var(--font-sans); background: var(--papel); color: var(--tema-texto); }
      .wrap { max-width: 1180px; margin: 0 auto; padding: 16px; }
      .topbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .logo { border: 1px solid var(--tema-linea); border-radius: 999px; padding: 8px 16px; font-weight: 700; background: var(--card); }
      .buscar { border: 1px solid var(--tema-linea); border-radius: 999px; padding: 8px 14px; font-size: 14px; background: var(--card); color: var(--tema-texto); min-height: 44px; min-width: min(280px, 100%); flex: 1; }
      .top-right { margin-left: auto; display: flex; gap: 8px; align-items: center; }
      .badge { position: relative; border: 1px solid var(--tema-linea); border-radius: 999px; padding: 8px 14px; min-height: 44px; background: var(--card); color: inherit; font: inherit; font-weight: 600; cursor: pointer; }
      .badge b { display: inline-flex; min-width: 20px; height: 20px; padding: 0 6px; margin-left: 6px; border-radius: 999px; background: var(--llama); color: var(--color-void); font-size: 12px; align-items: center; justify-content: center; }
      .kpis { display: flex; gap: 28px; flex-wrap: wrap; margin: 20px 0 16px; }
      .bignum { text-align: left; }
      .bignum b { font-size: clamp(28px, 4vw, 44px); font-weight: 600; display: block; }
      .bignum small { color: var(--muted); font-size: 12px; }
      .card { background: var(--card); border-radius: var(--radio); padding: 16px; box-shadow: 0 1px 3px rgba(0,0,0,.06); min-width: 0; }
      .card h2 { font-size: 18px; margin: 0 0 8px; }
      .aviso { margin: 0 0 12px; padding: 10px 14px; border-radius: 12px; background: var(--estado-peligro-tint); color: var(--estado-peligro); font-size: 14px; }
      .aviso[hidden], .vacio[hidden] { display: none; }
      .vacio { color: var(--muted); padding: 24px 8px; text-align: center; }
      table.mov { width: 100%; border-collapse: collapse; font-size: 13px; }
      table.mov th { text-align: left; color: var(--muted); font-weight: 500; padding: 6px; border-bottom: 1px solid var(--canvas); }
      table.mov td { padding: 10px 6px; border-bottom: 1px solid var(--canvas); overflow-wrap: anywhere; }
      table.mov tbody tr { cursor: pointer; }
      table.mov tbody tr:hover, table.mov tbody tr.activa { background: color-mix(in srgb, var(--llama) 10%, transparent); }
      .pill { border-radius: 999px; padding: 2px 10px; font-size: 12px; }
      .ok { background: var(--estado-ok-tint); color: var(--estado-ok); }
      .warn { background: var(--estado-aviso-tint); color: var(--estado-aviso); }
      .pend { background: var(--estado-pendiente-tint); color: var(--estado-pendiente); }
      .peligro { background: var(--estado-peligro-tint); color: var(--estado-peligro); }
      .menu { position: relative; display: inline-block; }
      .menu summary { list-style: none; cursor: pointer; min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; }
      :global(.menu summary::-webkit-details-marker),
      :global(.menu summary::marker) { display: none; content: none; }
      .menu ul { position: absolute; right: 0; z-index: 3; margin: 0; padding: 6px; list-style: none; background: var(--card); border: 1px solid var(--tema-linea); border-radius: 12px; min-width: 200px; box-shadow: 0 8px 24px rgba(0,0,0,.12); }
      .menu button { width: 100%; text-align: left; background: none; border: 0; font: inherit; padding: 10px 12px; min-height: 44px; border-radius: 8px; cursor: pointer; color: inherit; }
      .menu button:hover { background: var(--canvas); }
      .fondo { position: fixed; inset: 0; background: color-mix(in srgb, var(--color-void) 40%, transparent); z-index: 20; }
      .fondo[hidden] { display: none; }
      .cajon { position: fixed; top: 0; right: 0; height: 100%; width: min(440px, 100%); background: var(--papel); color: var(--tema-texto); z-index: 21; overflow: auto; padding: 20px 20px 40px; box-shadow: -8px 0 24px rgba(0,0,0,.12); }
      .cajon[hidden] { display: none; }
      .cajon header { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px; }
      .cajon header h2 { margin: 0; font-size: 22px; flex: 1; }
      .cerrar { border: 1px solid var(--tema-linea); background: var(--card); border-radius: 999px; min-width: 44px; min-height: 44px; cursor: pointer; font: inherit; }
      .dato { display: grid; grid-template-columns: 110px 1fr; gap: 4px 12px; font-size: 14px; margin-bottom: 16px; }
      .dato dt { color: var(--muted); }
      .acciones { display: grid; gap: 8px; margin-bottom: 16px; }
      .btn { border: 1px solid var(--tema-linea); background: var(--card); border-radius: 999px; padding: 10px 16px; min-height: 44px; font: inherit; font-weight: 600; cursor: pointer; color: inherit; }
      .btn.llama { background: var(--llama); color: var(--color-void); border: 0; }
      .btn:disabled { opacity: 0.55; cursor: wait; }
      form.confirm { display: grid; gap: 8px; margin: 8px 0 16px; }
      form.confirm[hidden] { display: none; }
      form.confirm input, form.confirm select, form.confirm textarea {
        border: 1px solid var(--tema-linea); border-radius: 12px; padding: 8px 12px;
        font: inherit; background: var(--card); color: var(--tema-texto); min-height: 44px; width: 100%;
      }
      form.confirm textarea { min-height: 72px; resize: vertical; }
      .flags { display: grid; gap: 8px; margin: 0 0 16px; }
      .flag { display: flex; align-items: center; gap: 10px; min-height: 44px; }
      .flag input { width: 20px; height: 20px; }
      .mini { font-size: 13px; color: var(--muted); }
      .audit { list-style: none; margin: 0; padding: 0; font-size: 13px; }
      .audit li { border-bottom: 1px solid var(--canvas); padding: 8px 0; }
      #reportes { position: fixed; top: 72px; right: 16px; width: min(420px, calc(100% - 32px)); max-height: min(70vh, 560px); overflow: auto; z-index: 15; }
      #reportes[hidden] { display: none; }
      #reportes ul { list-style: none; margin: 0; padding: 0; }
      #reportes li { border-bottom: 1px solid var(--canvas); padding: 10px 0; display: grid; gap: 6px; }
      :global(:root[data-tema="oscuro"]) .cajon { border-left: 1px solid var(--color-mid); }
      @media (max-width: 700px) {
        .buscar { min-width: 100%; order: 3; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="topbar">
        <span class="logo">Plataforma</span>
        <input id="buscar" class="buscar" type="search" placeholder="Buscar comercio" aria-label="Buscar comercio" />
        <div class="top-right">
          <button type="button" class="badge" id="btn-reportes" aria-expanded="false" aria-controls="reportes">
            Reportes <b id="n-reportes">0</b>
          </button>
          <TemaToggle />
          <CerrarSesion />
        </div>
      </div>

      <div class="kpis" id="kpis">
        <div class="bignum"><b id="n-activos">—</b><small>Activos</small></div>
        <div class="bignum"><b id="n-gracia">—</b><small>En gracia</small></div>
        <div class="bignum"><b id="n-suspendidos">—</b><small>Suspendidos</small></div>
      </div>

      <div id="error-lista" class="aviso" hidden></div>

      <section class="card">
        <h2>Comercios</h2>
        <table class="mov" id="tenants-tabla">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Plan</th>
              <th>Estado</th>
              <th>Vencimiento</th>
              <th>Costo alto</th>
              <th><span class="sr">Acciones</span></th>
            </tr>
          </thead>
          <tbody id="tenants-body"></tbody>
        </table>
        <div id="tenants-vacio" class="vacio" hidden>No hay comercios.</div>
      </section>
    </div>

    <div id="fondo" class="fondo" hidden></div>
    <aside id="tenant-detalle" class="cajon" hidden aria-labelledby="detalle-nombre">
      <header>
        <h2 id="detalle-nombre">Comercio</h2>
        <button type="button" class="cerrar" id="cerrar-detalle" aria-label="Cerrar">✕</button>
      </header>
      <dl class="dato" id="detalle-datos"></dl>
      <div class="acciones">
        <button type="button" class="btn" data-abrir="suspender">Suspender por mora</button>
        <button type="button" class="btn" data-abrir="suspender_abuso">Suspender por abuso</button>
        <button type="button" class="btn" data-abrir="reactivar">Reactivar</button>
        <button type="button" class="btn" data-abrir="cobro">Registrar cobro</button>
      </div>
      <form class="confirm" id="form-accion" hidden>
        <div class="mini" id="form-accion-titulo"></div>
        <label>Motivo <textarea name="motivo" required></textarea></label>
        <label>Escribí el ID del comercio <input name="confirmo_id" autocomplete="off" required /></label>
        <button type="submit" class="btn llama">Confirmar</button>
        <button type="button" class="btn" data-cancelar>Cancelar</button>
      </form>
      <form class="confirm" id="form-cobro" hidden>
        <div class="mini">Registrar cobro (en pesos)</div>
        <label>Monto en pesos <input name="pesos" type="number" min="0.01" step="0.01" required /></label>
        <label>Medio <input name="medio" placeholder="transferencia" required /></label>
        <label>Referencia <input name="referencia" required /></label>
        <button type="submit" class="btn llama">Asentar cobro</button>
        <button type="button" class="btn" data-cancelar>Cancelar</button>
      </form>
      <h2>Módulos</h2>
      <div class="flags" id="flags-lista"></div>
      <form class="confirm" id="form-flag" style="margin-top:0">
        <label>Agregar módulo <input name="flag" placeholder="nombre del flag" autocomplete="off" /></label>
        <button type="submit" class="btn">Agregar y activar</button>
      </form>
      <h2>Auditoría</h2>
      <ul class="audit" id="detalle-audit"></ul>
      <div class="mini" id="detalle-estado"></div>
    </aside>

    <section class="card" id="reportes" hidden>
      <header style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <h2 style="flex:1;margin:0">Reportes</h2>
        <button type="button" class="cerrar" id="cerrar-reportes" aria-label="Cerrar reportes">✕</button>
      </header>
      <ul id="reportes-lista"></ul>
      <div class="mini" id="reportes-estado"></div>
    </section>
    <style>
      .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    </style>

    <script>
      import { fechaAR } from "../lib/fecha-ar.js";
      import { clasificarCubetaMoraVista, diasAtrasoDesdeVencimiento } from "../modules/admin/mora-vista.js";

      // PA1.8: las acciones del panel piden reauth reciente. Ante 401
      // reauth_requerida se confirma con Google y se vuelve a /admin.
      const fetchOriginal = window.fetch.bind(window);
      window.fetch = async (...args) => {
        const r = await fetchOriginal(...args);
        const tipo = r.headers.get("content-type") ?? "";
        if (r.status === 401 && tipo.includes("application/json")) {
          let cuerpo;
          try { cuerpo = await r.clone().json(); }
          catch (e) { console.warn("reauth: el cuerpo no era JSON", e); }
          if (cuerpo && cuerpo.codigo === "reauth_requerida" && cuerpo.reauth_url) {
            window.location.assign(cuerpo.reauth_url);
          }
        }
        return r;
      };

      /** @typedef {{ id: string, nombre: string|null, slug: string|null, estado: string, plan: string, vencimiento: string|null, suspension_tipo: string|null, uso_wa: number, costo_alto: boolean }} Tenant */

      /** @type {Tenant[]} */
      let tenants = [];
      /** @type {Tenant | null} */
      let abierto = null;
      /** @type {"suspender"|"suspender_abuso"|"reactivar"|null} */
      let accionPendiente = null;

      const $ = (id) => document.getElementById(id);
      const buscar = /** @type {HTMLInputElement} */ ($("buscar"));
      const errorLista = $("error-lista");
      const body = $("tenants-body");
      const vacio = $("tenants-vacio");
      const cajon = $("tenant-detalle");
      const fondo = $("fondo");

      function hoy() { return fechaAR(); }

      function textoEstado(t) {
        const dias = diasAtrasoDesdeVencimiento(t.vencimiento, hoy());
        if (t.estado === "suspendido") {
          if (t.suspension_tipo === "abuso") return { label: "Suspendido · abuso", cls: "peligro" };
          if (t.suspension_tipo === "mora") return { label: "Suspendido · mora", cls: "peligro" };
          return { label: "Suspendido", cls: "peligro" };
        }
        const cubeta = clasificarCubetaMoraVista(t, hoy());
        if (cubeta === "en_gracia") return { label: `En gracia · ${dias} días`, cls: "warn" };
        if (cubeta === "por_suspender") return { label: `Por suspender · ${dias} días`, cls: "pend" };
        return { label: "Activo", cls: "ok" };
      }

      function filtrados() {
        const q = (buscar.value || "").trim().toLowerCase();
        if (!q) return tenants;
        return tenants.filter((t) =>
          [t.nombre, t.slug, t.id, t.plan].some((v) => (v ?? "").toLowerCase().includes(q)),
        );
      }

      function pintarContadores() {
        const h = hoy();
        let activos = 0, gracia = 0, suspendidos = 0;
        for (const t of tenants) {
          if (t.estado === "suspendido") suspendidos += 1;
          else if (clasificarCubetaMoraVista(t, h) === "en_gracia") gracia += 1;
          else if (t.estado === "activo") activos += 1;
        }
        $("n-activos").textContent = String(activos);
        $("n-gracia").textContent = String(gracia);
        $("n-suspendidos").textContent = String(suspendidos);
      }

      function pintarTabla() {
        const filas = filtrados();
        body.replaceChildren();
        if (!filas.length) {
          vacio.hidden = false;
          vacio.textContent = tenants.length ? "Ningún comercio coincide con la búsqueda." : "No hay comercios.";
          return;
        }
        vacio.hidden = true;
        for (const t of filas) {
          const est = textoEstado(t);
          const tr = document.createElement("tr");
          if (abierto && abierto.id === t.id) tr.classList.add("activa");
          tr.dataset.id = t.id;
          tr.innerHTML = `
            <td><strong>${esc(t.nombre || t.slug || t.id)}</strong><div class="mini">${esc(t.slug || t.id)}</div></td>
            <td>${esc(t.plan || "—")}</td>
            <td><span class="pill ${est.cls}">${esc(est.label)}</span></td>
            <td>${esc(t.vencimiento ? t.vencimiento.slice(0, 10) : "—")}</td>
            <td>${t.costo_alto ? "Sí" : "No"}</td>
            <td>
              <details class="menu">
                <summary aria-label="Acciones">⋯</summary>
                <ul>
                  <li><button type="button" data-ver>Ver detalle</button></li>
                  <li><button type="button" data-abrir="suspender">Suspender por mora</button></li>
                  <li><button type="button" data-abrir="suspender_abuso">Suspender por abuso</button></li>
                  <li><button type="button" data-abrir="reactivar">Reactivar</button></li>
                </ul>
              </details>
            </td>`;
          tr.addEventListener("click", (ev) => {
            const btn = ev.target.closest("button");
            const menu = ev.target.closest("details");
            if (menu && !btn) { ev.stopPropagation(); return; }
            const ten = tenants.find((x) => x.id === t.id);
            if (!ten) return;
            if (btn && btn.dataset.abrir) {
              ev.preventDefault();
              abrirDetalle(ten, btn.dataset.abrir);
            } else {
              abrirDetalle(ten, null);
            }
          });
          body.appendChild(tr);
        }
      }

      function esc(s) {
        return String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
      }

      async function cargarTenants() {
        errorLista.hidden = true;
        try {
          const r = await fetch("/api/admin/tenants");
          if (!r.ok) throw new Error(await errorDe(r, "No se pudieron cargar los comercios."));
          const data = await r.json();
          tenants = Array.isArray(data.tenants) ? data.tenants : [];
          pintarContadores();
          pintarTabla();
          if (abierto) {
            abierto = tenants.find((t) => t.id === abierto.id) ?? abierto;
            pintarDetalle();
          }
        } catch (e) {
          tenants = [];
          $("n-activos").textContent = "—";
          $("n-gracia").textContent = "—";
          $("n-suspendidos").textContent = "—";
          pintarTabla();
          errorLista.hidden = false;
          errorLista.textContent = e instanceof Error ? e.message : "No se pudieron cargar los comercios.";
        }
      }

      async function errorDe(r, fallback) {
        try {
          const j = await r.json();
          if (j && typeof j.error === "string") return j.error;
        } catch (e) {
          console.warn("respuesta no JSON", e);
        }
        return fallback;
      }

      async function cargarReportesBadge() {
        try {
          const r = await fetch("/api/admin/reportes?estado=recibido");
          if (!r.ok) throw new Error("fail");
          const data = await r.json();
          $("n-reportes").textContent = String((data.items ?? []).length);
        } catch {
          $("n-reportes").textContent = "—";
        }
      }

      function abrirDetalle(t, accion) {
        abierto = t;
        cajon.hidden = false;
        fondo.hidden = false;
        pintarDetalle();
        pintarTabla();
        if (accion === "cobro") mostrarForm("cobro");
        else if (accion) mostrarForm(accion);
        else ocultarForms();
      }

      function cerrarDetalle() {
        abierto = null;
        cajon.hidden = true;
        fondo.hidden = true;
        ocultarForms();
        pintarTabla();
      }

      function ocultarForms() {
        $("form-accion").hidden = true;
        $("form-cobro").hidden = true;
        accionPendiente = null;
      }

      function mostrarForm(accion) {
        if (accion === "cobro") {
          $("form-accion").hidden = true;
          $("form-cobro").hidden = false;
          $("form-cobro").reset();
          return;
        }
        accionPendiente = accion;
        $("form-cobro").hidden = true;
        const form = $("form-accion");
        form.hidden = false;
        form.reset();
        const titulos = {
          suspender: "Suspender por mora",
          suspender_abuso: "Suspender por abuso",
          reactivar: "Reactivar comercio",
        };
        $("form-accion-titulo").textContent = titulos[accion] + ". El ID tiene que coincidir.";
      }

      function pintarDetalle() {
        if (!abierto) return;
        const t = abierto;
        const est = textoEstado(t);
        $("detalle-nombre").textContent = t.nombre || t.slug || t.id;
        $("detalle-datos").innerHTML = `
          <dt>ID</dt><dd>${esc(t.id)}</dd>
          <dt>Slug</dt><dd>${esc(t.slug || "—")}</dd>
          <dt>Plan</dt><dd>${esc(t.plan || "—")}</dd>
          <dt>Estado</dt><dd>${esc(est.label)}</dd>
          <dt>Vencimiento</dt><dd>${esc(t.vencimiento ? t.vencimiento.slice(0, 10) : "—")}</dd>
          <dt>Costo alto</dt><dd>${t.costo_alto ? "Sí" : "No"}</dd>`;
        void cargarFlags();
        void cargarAudit();
      }

      async function cargarFlags() {
        const box = $("flags-lista");
        box.textContent = "Cargando módulos…";
        if (!abierto) return;
        try {
          const r = await fetch("/api/admin/flags?tenant_id=" + encodeURIComponent(abierto.id));
          if (!r.ok) throw new Error(await errorDe(r, "No se pudieron cargar los módulos."));
          const data = await r.json();
          const flags = Array.isArray(data.flags) ? data.flags : [];
          box.replaceChildren();
          if (!flags.length) {
            box.innerHTML = '<div class="mini">Sin módulos cargados.</div>';
            return;
          }
          for (const f of flags) {
            const row = document.createElement("label");
            row.className = "flag";
            const on = !!(f.resuelto ?? f.valor);
            row.innerHTML = `<input type="checkbox" ${on ? "checked" : ""} /> <span>${esc(f.flag)}</span>`;
            row.querySelector("input").addEventListener("change", async (ev) => {
              const checked = ev.target.checked;
              const motivo = window.prompt("Motivo del cambio de módulo:");
              if (!motivo || !motivo.trim()) { ev.target.checked = !checked; return; }
              const ok = await postFlag(abierto.id, f.flag, checked, motivo.trim());
              if (!ok) ev.target.checked = !checked;
            });
            box.appendChild(row);
          }
        } catch (e) {
          box.textContent = e instanceof Error ? e.message : "No se pudieron cargar los módulos.";
        }
      }

      async function postFlag(tenantId, flag, valor, motivo) {
        const r = await fetch("/api/admin/flags", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ tenant_id: tenantId, flag, valor, motivo }),
        });
        if (!r.ok) {
          $("detalle-estado").textContent = await errorDe(r, "No se pudo guardar el módulo.");
          return false;
        }
        $("detalle-estado").textContent = "Módulo actualizado.";
        return true;
      }

      async function cargarAudit() {
        const lista = $("detalle-audit");
        lista.textContent = "";
        if (!abierto) return;
        try {
          const r = await fetch("/api/admin/actos?tenant_id=" + encodeURIComponent(abierto.id) + "&limite=30");
          if (!r.ok) throw new Error(await errorDe(r, "No se pudo cargar la auditoría."));
          const data = await r.json();
          const actos = Array.isArray(data.actos) ? data.actos : [];
          if (!actos.length) {
            lista.innerHTML = '<li class="mini">Sin actos todavía.</li>';
            return;
          }
          lista.replaceChildren();
          for (const a of actos) {
            const li = document.createElement("li");
            const cuando = a.creadoEn ? String(a.creadoEn).slice(0, 19).replace("T", " ") : "";
            li.innerHTML = `<strong>${esc(a.kind)}</strong> · ${esc(cuando)} <div class="mini">${esc(a.origen || "")} · ${esc(a.hash || "")}</div>`;
            lista.appendChild(li);
          }
        } catch (e) {
          lista.innerHTML = `<li>${esc(e instanceof Error ? e.message : "No se pudo cargar la auditoría.")}</li>`;
        }
      }

      $("form-accion").addEventListener("submit", async (ev) => {
        ev.preventDefault();
        if (!abierto || !accionPendiente) return;
        const fd = new FormData(ev.currentTarget);
        const r = await fetch("/api/admin/tenants", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            tenant_id: abierto.id,
            accion: accionPendiente,
            motivo: String(fd.get("motivo") ?? ""),
            confirmo_id: String(fd.get("confirmo_id") ?? ""),
          }),
        });
        if (!r.ok) {
          $("detalle-estado").textContent = await errorDe(r, "No se pudo completar la acción.");
          return;
        }
        $("detalle-estado").textContent = "Listo.";
        ocultarForms();
        await cargarTenants();
      });

      $("form-cobro").addEventListener("submit", async (ev) => {
        ev.preventDefault();
        if (!abierto) return;
        const fd = new FormData(ev.currentTarget);
        const pesos = Number(fd.get("pesos"));
        if (!Number.isFinite(pesos) || pesos <= 0) {
          $("detalle-estado").textContent = "El monto tiene que ser mayor a 0.";
          return;
        }
        const centavos = Math.round(pesos * 100);
        const r = await fetch("/api/admin/ledger/asentar", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            tenant_id: abierto.id,
            monto_centavos: String(centavos),
            medio: String(fd.get("medio") ?? "").trim(),
            referencia_externa: String(fd.get("referencia") ?? "").trim(),
            idempotency_key: `cobro:${abierto.id}:${crypto.randomUUID()}`,
          }),
        });
        if (!r.ok) {
          $("detalle-estado").textContent = await errorDe(r, "No se pudo registrar el cobro.");
          return;
        }
        $("detalle-estado").textContent = "Cobro asentado.";
        ocultarForms();
        await cargarAudit();
      });

      $("form-flag").addEventListener("submit", async (ev) => {
        ev.preventDefault();
        if (!abierto) return;
        const fd = new FormData(ev.currentTarget);
        const flag = String(fd.get("flag") ?? "").trim();
        if (!flag) return;
        const motivo = window.prompt("Motivo para activar el módulo:");
        if (!motivo || !motivo.trim()) return;
        if (await postFlag(abierto.id, flag, true, motivo.trim())) {
          ev.currentTarget.reset();
          await cargarFlags();
        }
      });

      for (const form of [$("form-accion"), $("form-cobro")]) {
        form.querySelector("[data-cancelar]").addEventListener("click", () => ocultarForms());
      }
      for (const btn of document.querySelectorAll("[data-abrir]")) {
        if (btn.closest("#tenants-tabla")) continue;
        btn.addEventListener("click", () => { if (abierto) mostrarForm(btn.dataset.abrir); });
      }
      $("cerrar-detalle").addEventListener("click", cerrarDetalle);
      fondo.addEventListener("click", cerrarDetalle);
      document.addEventListener("keydown", (ev) => {
        if (ev.key === "Escape") {
          if (!$("reportes").hidden) { $("reportes").hidden = true; return; }
          if (!cajon.hidden) cerrarDetalle();
        }
      });
      buscar.addEventListener("input", pintarTabla);

      const panelReportes = $("reportes");
      $("btn-reportes").addEventListener("click", async () => {
        const abrir = panelReportes.hidden;
        panelReportes.hidden = !abrir;
        $("btn-reportes").setAttribute("aria-expanded", String(abrir));
        if (abrir) await cargarReportesLista();
      });
      $("cerrar-reportes").addEventListener("click", () => {
        panelReportes.hidden = true;
        $("btn-reportes").setAttribute("aria-expanded", "false");
      });

      async function cargarReportesLista() {
        const lista = $("reportes-lista");
        const estado = $("reportes-estado");
        lista.replaceChildren();
        estado.textContent = "Cargando…";
        try {
          const r = await fetch("/api/admin/reportes");
          if (!r.ok) throw new Error(await errorDe(r, "No se pudieron cargar los reportes."));
          const data = await r.json();
          const items = Array.isArray(data.items) ? data.items : [];
          if (!items.length) {
            estado.textContent = "No hay reportes.";
            return;
          }
          estado.textContent = "";
          for (const item of items) {
            const li = document.createElement("li");
            li.innerHTML = `<strong>${esc(item.tipo || "reporte")}</strong> · ${esc(item.estado)}
              <div>${esc(item.nombre_comercio || item.tenant_id || "")}</div>
              <div class="mini">${esc(item.texto || "")}</div>
              <div>
                <button type="button" class="btn" data-est="en_revision">En revisión</button>
                <button type="button" class="btn" data-est="resuelto">Resuelto</button>
              </div>`;
            li.querySelectorAll("button").forEach((b) => {
              b.addEventListener("click", async () => {
                const motivo = window.prompt("Motivo del cambio de estado:");
                if (!motivo || !motivo.trim()) return;
                const pr = await fetch("/api/admin/reportes/" + encodeURIComponent(item.id), {
                  method: "PATCH",
                  headers: { "content-type": "application/json" },
                  body: JSON.stringify({ accion: "estado", estado: b.dataset.est, confirmo_id: item.id, motivo: motivo.trim() }),
                });
                if (!pr.ok) {
                  estado.textContent = await errorDe(pr, "No se pudo actualizar el reporte.");
                  return;
                }
                await cargarReportesLista();
                await cargarReportesBadge();
              });
            });
            lista.appendChild(li);
          }
        } catch (e) {
          estado.textContent = e instanceof Error ? e.message : "No se pudieron cargar los reportes.";
        }
      }

      void cargarTenants();
      void cargarReportesBadge();
    </script>
  </body>
</html>
