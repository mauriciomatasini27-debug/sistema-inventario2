CONTROL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/control
TENANT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tenant_demo

# Supabase (ADR-0048): para dev/demo usa la misma URL del Session pooler (5432) en ambas vars.
# Formato solo, sin contraseña real:
# CONTROL_DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# TENANT_DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Auth Google (app de login: solo openid email profile, nunca Gmail/Photos)
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT=http://localhost:4321/api/auth/callback

# Integraciones opcionales del Dueño (Gmail/Photos): otra app OAuth aparte.
# Gmail ya tiene flujo OAuth y conexión cifrada; Photos sigue pendiente.
GOOGLE_INTEGRATIONS_CLIENT_ID=
GOOGLE_INTEGRATIONS_CLIENT_SECRET=
GOOGLE_INTEGRATIONS_REDIRECT=http://localhost:4321/api/integrations/callback
# GGL-S12. testing (default si falta): solo los mails de la lista inician OAuth
# y la UI avisa que el refresh vence a los 7 días. verificada: sin lista y sin ese aviso.
GOOGLE_INTEGRATIONS_MODO=testing
# Mails del Dueño, separados por coma, máximo 100. Vacío en testing = nadie conecta.
GOOGLE_INTEGRATIONS_USUARIOS_PRUEBA=

# Gmail (ADR-0102/0099). Vacío => integración apagada.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_EMAIL=
# Pepper del HMAC de la casilla en la tabla de ruteo del webhook.
GMAIL_ROUTE_PEPPER=

# Photos (ADR-0104, PROPUESTO sin implementar): cliente OAuth propio para
# desconectar sin tocar Gmail. GGL-E4 no tiene código: la ruta
# /api/integrations/photos/callback no existe todavía.
# GOOGLE_PHOTOS_CLIENT_ID=
# GOOGLE_PHOTOS_CLIENT_SECRET=
# GOOGLE_PHOTOS_REDIRECT=http://localhost:4321/api/integrations/photos/callback

# KMS de integraciones: AES-256-GCM local, separado de FISCAL_KMS_*.
INTEGRATIONS_KMS_KEY_B64=
INTEGRATIONS_KMS_KEY_ID=homo-local-1
# Firma la cookie de state del OAuth; si falta usa JOBS_SECRET.
INTEGRATIONS_STATE_SECRET=

# Asistente IA: proveedor LLM compatible con OpenAI (ADR-0045). Vacío => fake.
# Puente free: OpenRouter (ASSISTANT_LLM_BASE_URL=https://openrouter.ai/api/v1, ASSISTANT_LLM_MODEL=<modelo :free>).
# Groq descartado: bloquea IP de datacenter/VPN con 403 antes de mirar la clave.
ASSISTANT_LLM_KEY=
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_MODEL=

# Lista única de admins (subs de Google separados por coma, por google_sub
# nunca por email). Gobierna exigirAdmin y esSuperadmin (POST /api/tenants).
ADMIN_ALLOWLIST_SUBS=

# SUPERADMIN_SUBS deprecada: fallback que se une a la lista única (P9-12).
# Movida pendiente: copiar sus subs a ADMIN_ALLOWLIST_SUBS y vaciarla.
SUPERADMIN_SUBS=

# Sesiones: inactividad en horas (default 720 = 30 días, AU8.3)
SESSION_TTL_HOURS=720

# Jobs como Sistema (middleware los deja pasar con este secreto)
JOBS_SECRET=

# Mercado Pago: secreto del webhook para verificar x-signature (ADR-0092).
MP_WEBHOOK_SECRET=
# Access token para crear la preaprobación y consultar el estado en el webhook.
MP_ACCESS_TOKEN=
# Solo laboratorio: permitir POST sin secreto con header x-test (nunca en producción).
# MP_WEBHOOK_ALLOW_TEST=1

# OCR Fase 0: endpoint de PaddleOCR autohospedado (ADR-0089). Vacío => fake.
OCR_PADDLE_ENDPOINT=

# Fiscal ARCA slice homo (ADR-0018/0019, solo servidor, nunca cliente).
# Sin estas vars el sistema usa fake en memoria; con ellas, ArcaProvider real.
ARCA_AMBIENTE=homo
ARCA_CUIT_PROVEEDOR=
ARCA_CERT_PEM=
ARCA_KEY_PEM=
# D8 homo: envoltura KMS local (AES-256-GCM). Prod inyecta AWS KMS misma interfaz.
FISCAL_KMS_KEY_B64=
FISCAL_KMS_KEY_ID=homo-local-1
# D3: backoff WSAA tras error no-alreadyAuthenticated (default 60s).
WSAA_BACKOFF_MS=60000

# Landing contacto (ADR-0010 LP-S6): Formspree. Sin esto, Contacto muestra mailto + wa.me.
PUBLIC_FORMSPREE_FORM_ID=tu_form_id_aqui
